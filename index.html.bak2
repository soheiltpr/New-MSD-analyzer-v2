        results.unknowns.forEach(unk => {
          const wellId = unk.well;
          const row = wellId[0];
          const col = parseInt(wellId.slice(1));
          const compound = wellCompounds[row] && wellCompounds[row][col] ? wellCompounds[row][col] : '';
          const role = wellRoles[row] && wellRoles[row][col] ? wellRoles[row][col] : 'unknown';
          const actualConc = unk.actualConcentration || unk.concentration || 'N/A';
          const actualConcFormatted = typeof actualConc === 'number' ? actualConc.toFixed(decimals) : actualConc;
          
          html += `<tr><td>${wellId}</td><td>${role}</td><td>${compound}</td><td>${unk.signal.toFixed(decimals)}</td><td>${actualConcFormatted}</td></tr>`;
        });
        
        html += `</table>`;
      }
    });
    
    html += `</div>`;
