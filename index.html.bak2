  if (settings.showSignalValues !== undefined) document.getElementById('showSignalValues').checked = settings.showSignalValues;
  if (settings.showGradient !== undefined) document.getElementById('showGradient').checked = settings.showGradient;
  
  // Analysis settings
  if (settings.analysisMethod) document.getElementById('analysisMethod').value = settings.analysisMethod;
  if (settings.dilutionFactor) document.getElementById('dilutionFactor').value = settings.dilutionFactor;
  if (settings.minR2) document.getElementById('minR2').value = settings.minR2;
