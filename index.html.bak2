// Plot Editor Functions
function openPlotEditor() {
  console.log('📊 Opening Plot Editor...');
  // Open the plot editor in a new window/tab
  const plotEditorUrl = './plot-editor.html';
  const plotEditorWindow = window.open(plotEditorUrl, 'plotEditor', 'width=1400,height=900,scrollbars=yes,resizable=yes');
  
