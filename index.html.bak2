// Add a new layout section
function addLayoutSection(type) {
  console.log('%c📦 ADDING SECTION: ' + type, 'background: blue; color: white; font-size: 14px; padding: 5px;');
  
  const container = document.getElementById('layout_sections_area');
  const emptyMsg = document.getElementById('layout_empty_msg');
  
  if (!container) {
    alert('ERROR: Container not found!');
    console.error('Container not found!');
    return;
  }
  
  // Hide empty message
  if (emptyMsg) {
    emptyMsg.style.display = 'none';
  }
  
  // Create unique ID
  const sectionId = 'layout_section_' + LAYOUT_ID_COUNTER++;
  
  // Get section config
  const config = getLayoutSectionConfig(type);
  
  // Create section div
  const section = document.createElement('div');
  section.id = sectionId;
  section.style.cssText = `
    background: white;
    border: 3px solid ${config.borderColor};
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 15px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  `;
  
  // Create header
  const header = document.createElement('div');
  header.style.cssText = `
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 10px;
    margin-bottom: 10px;
    border-bottom: 2px solid ${config.borderColor};
  `;
  header.innerHTML = `
    <div style="display: flex; align-items: center; gap: 10px;">
      <span style="font-size: 24px;">${config.icon}</span>
      <span style="font-size: 18px; font-weight: bold; color: #333;">${config.title}</span>
    </div>
    <div style="display: flex; gap: 8px;">
      <button onclick="moveLayoutSectionUp('${sectionId}')" style="background: #2196f3; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-weight: bold;">▲ Up</button>
      <button onclick="moveLayoutSectionDown('${sectionId}')" style="background: #2196f3; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-weight: bold;">▼ Down</button>
      <button onclick="removeLayoutSection('${sectionId}')" style="background: #f44336; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-weight: bold;">✕ Remove</button>
    </div>
  `;
  
  // Create content area
  const content = document.createElement('div');
  content.style.cssText = `
    padding: 15px;
    background: #f9f9f9;
    border-radius: 6px;
    min-height: 150px;
  `;
  content.innerHTML = config.contentHTML;
  
  // Append to section
  section.appendChild(header);
  section.appendChild(content);
  
  // Append to container
  container.appendChild(section);
  
  // Store in array
  LAYOUT_SECTIONS.push({
    id: sectionId,
    type: type,
    element: section
  });
  
  console.log('%c✅ SECTION ADDED: ' + sectionId, 'background: green; color: white; padding: 5px;');
}

