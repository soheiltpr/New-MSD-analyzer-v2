// Excel-like Cytokine Setup Modal Functions
let selectedCell = null;
let excelData = []; // Stores the Excel-like table data

function openCytokineSetup() {
  const modal = document.getElementById('cytokineSetupModal');
  modal.style.display = 'flex';
  initializeExcelTable();
  
  // Setup Excel paste detection after modal is visible
  setTimeout(() => {
    setupExcelPasteDetection();
  }, 100);
}

function closeCytokineSetup() {
  const modal = document.getElementById('cytokineSetupModal');
  modal.style.display = 'none';
}

function initializeExcelTable() {
  const tbody = document.getElementById('excelTableBody');
  tbody.innerHTML = '';
  
  // Initialize with empty rows (no defaults)
  for (let i = 0; i < MAX_SPOTS; i++) {
    if (!excelData[i]) {
      excelData[i] = {
        spot: i + 1,
        cytokine: '',
        maxConc: '',
        dilutionFactor: '4',
        standards: ''
      };
    }
    
    const row = document.createElement('tr');
    row.innerHTML = `
      <td class="excel-cell excel-row-header">${i + 1}</td>
      <td class="excel-cell" data-row="${i}" data-col="cytokine">
        <div class="excel-cell-display" onclick="editCell(${i}, 'cytokine')">${excelData[i].cytokine}</div>
      </td>
      <td class="excel-cell" data-row="${i}" data-col="maxConc">
        <div class="excel-cell-display" onclick="editCell(${i}, 'maxConc')">${excelData[i].maxConc}</div>
      </td>
      <td class="excel-cell" data-row="${i}" data-col="dilutionFactor">
        <div class="excel-cell-display" onclick="editCell(${i}, 'dilutionFactor')">${excelData[i].dilutionFactor}</div>
      </td>
      <td class="excel-cell excel-cell-readonly">
        <div class="excel-cell-display" id="standards_${i}">${excelData[i].standards}</div>
      </td>
    `;
    
    tbody.appendChild(row);
  }
  
  // Update all standard previews
  updateAllStandardPreviews();
}

function calculateStandardConcentrations(maxConc, dilutionFactor, numDilutions) {
  const concentrations = [];
  for (let i = 0; i < numDilutions; i++) {
    const conc = maxConc / Math.pow(dilutionFactor, i);
    if (i === numDilutions - 1) {
      concentrations.push(0); // Last one is always 0 (blank)
    } else {
      concentrations.push(Math.round(conc * 100) / 100); // Round to 2 decimals
    }
  }
  return concentrations;
}

// Excel-like cell editing functions
function editCell(row, col) {
  // Clear any existing editing
  const existingInput = document.querySelector('.excel-cell-input');
  if (existingInput) {
    finishEditing();
  }
  
  const cell = document.querySelector(`[data-row="${row}"][data-col="${col}"]`);
  const display = cell.querySelector('.excel-cell-display');
  
  // Create input element
  const input = document.createElement('input');
  input.className = 'excel-cell-input';
  input.value = excelData[row][col];
  input.type = col === 'maxConc' ? 'number' : 'text';
  if (col === 'maxConc') {
    input.step = 'any';
    input.min = '0';
  }
  
  // Replace display with input
  display.style.display = 'none';
  cell.appendChild(input);
  cell.classList.add('editing');
  
  // Focus and select
  input.focus();
  input.select();
  
  // Store current editing info
  selectedCell = { row, col, input, display, cell };
  
  // Handle events
  input.addEventListener('blur', finishEditing);
  input.addEventListener('keydown', handleCellKeydown);
  input.addEventListener('paste', handleCellPaste);
}

function finishEditing() {
  if (!selectedCell) return;
  
  const { row, col, input, display, cell } = selectedCell;
  const newValue = input.value.trim();
  
  // Update data
  excelData[row][col] = newValue;
  
  // Update display
  display.textContent = newValue;
  display.style.display = 'block';
  
  // Remove input and editing state
  input.remove();
  cell.classList.remove('editing');
  
  // Update standards preview if concentration changed
  if (col === 'maxConc') {
    updateStandardPreview(row);
  }
  
  selectedCell = null;
}

function handleCellKeydown(e) {
  if (e.key === 'Enter') {
    e.preventDefault();
    finishEditing();
    // Move to next row
    const nextRow = selectedCell ? selectedCell.row + 1 : 0;
    if (nextRow < MAX_SPOTS) {
      setTimeout(() => editCell(nextRow, selectedCell ? selectedCell.col : 'cytokine'), 50);
    }
  } else if (e.key === 'Tab') {
    e.preventDefault();
    finishEditing();
    // Move to next column
    const currentRow = selectedCell ? selectedCell.row : 0;
    const currentCol = selectedCell ? selectedCell.col : 'cytokine';
    const nextCol = currentCol === 'cytokine' ? 'maxConc' : 'cytokine';
    const nextRow = nextCol === 'cytokine' ? currentRow + 1 : currentRow;
    
    if (nextRow < MAX_SPOTS) {
      setTimeout(() => editCell(nextRow, nextCol), 50);
    }
  } else if (e.key === 'Escape') {
    // Cancel editing
    const { display, input, cell } = selectedCell;
    display.style.display = 'block';
    input.remove();
    cell.classList.remove('editing');
    selectedCell = null;
  }
}

function handleCellPaste(e) {
  e.preventDefault();
  
  if (!selectedCell) return;
  
  const pastedData = (e.clipboardData || window.clipboardData).getData('text');
  
  // Check if it's multi-line data (Excel selection)
  const lines = pastedData.split('\n').filter(line => line.trim());
  
  if (lines.length > 1) {
    // Multi-row paste - handle Excel-style paste
    finishEditing(); // Finish current edit first
    
    let startRow = selectedCell.row;
    let startCol = selectedCell.col;
    let parsedCount = 0;
    
    lines.forEach((line, lineIndex) => {
      const rowIndex = startRow + lineIndex;
      if (rowIndex >= MAX_SPOTS) return;
      
      const parts = line.split('\t').map(p => p.trim());
      
      if (parts.length >= 1) {
        // First column is cytokine name
        if (parts[0] && startCol === 'cytokine') {
          excelData[rowIndex].cytokine = parts[0];
          parsedCount++;
        }
        
        // Second column is concentration (if available)
        if (parts.length >= 2 && parts[1] && startCol === 'cytokine') {
          const conc = parseFloat(parts[1].replace(/[^0-9.-]/g, ''));
          if (!isNaN(conc) && conc > 0) {
            excelData[rowIndex].maxConc = conc.toString();
          }
        } else if (parts[0] && startCol === 'maxConc') {
          const conc = parseFloat(parts[0].replace(/[^0-9.-]/g, ''));
          if (!isNaN(conc) && conc > 0) {
            excelData[rowIndex].maxConc = conc.toString();
            parsedCount++;
          }
        }
      }
    });
    
    if (parsedCount > 0) {
      initializeExcelTable();
      updateStatus(`Pasted ${parsedCount} entries into cells`, 'complete');
    }
  } else {
    // Single cell paste - just paste the value
    const { input } = selectedCell;
    input.value = pastedData.trim();
  }
}

function updateStandardPreview(row) {
  const dilutionFactor = parseFloat(document.getElementById('setupDilutionFactor').value) || 4;
  const numDilutions = parseInt(document.getElementById('setupNumDilutions').value) || 8;
  const maxConc = parseFloat(excelData[row].maxConc) || 0;
  
  if (maxConc > 0) {
    const concentrations = calculateStandardConcentrations(maxConc, dilutionFactor, numDilutions);
    excelData[row].standards = concentrations.join(', ');
  } else {
    excelData[row].standards = '';
  }
  
  const preview = document.getElementById(`standards_${row}`);
  if (preview) {
    preview.textContent = excelData[row].standards;
  }
}

function updateAllStandardPreviews() {
  for (let i = 0; i < MAX_SPOTS; i++) {
    updateStandardPreview(i);
  }
}

function loadDefaultCytokines() {
  // Load the original 10 cytokines with their default concentrations
  const defaultData = [
    { cytokine: 'GM-CSF', maxConc: '4620' },
    { cytokine: 'IFN-γ', maxConc: '16050' },
    { cytokine: 'IL-1β', maxConc: '2220' },
    { cytokine: 'IL-2', maxConc: '945' },
    { cytokine: 'IL-4', maxConc: '825' },
    { cytokine: 'IL-5', maxConc: '2140' },
    { cytokine: 'IL-6', maxConc: '1040' },
    { cytokine: 'IL-10', maxConc: '2015' },
    { cytokine: 'MCP-1', maxConc: '2700' },
    { cytokine: 'TNF-α', maxConc: '1355' }
  ];
  
  // Clear existing data first
  for (let i = 0; i < MAX_SPOTS; i++) {
    excelData[i] = {
      spot: i + 1,
      cytokine: '',
      maxConc: '',
      standards: ''
    };
  }
  
  // Load default data
  defaultData.forEach((item, index) => {
    if (index < MAX_SPOTS) {
      excelData[index].cytokine = item.cytokine;
      excelData[index].maxConc = item.maxConc;
    }
  });
  
  initializeExcelTable();
  updateStatus('Default 10 cytokines loaded with original concentrations', 'complete');
}

function clearAllCytokines() {
  // Clear all data
  for (let i = 0; i < MAX_SPOTS; i++) {
    excelData[i] = {
      spot: i + 1,
      cytokine: '',
      maxConc: '',
      standards: ''
    };
  }
  
  initializeExcelTable();
  updateStatus('All cytokines cleared', 'complete');
}

function applyCytokineSetup() {
  // Finish any current editing
  if (selectedCell) {
    finishEditing();
  }
  
  const dilutionFactor = parseFloat(document.getElementById('setupDilutionFactor').value) || 4;
  const numDilutions = parseInt(document.getElementById('setupNumDilutions').value) || 8;
  
  // Extract valid cytokine data (only rows with both name and concentration)
  const validCytokines = [];
  const newCytokines = [];
  const newStandardConcentrations = {};
  const newDilutionFactors = {};
  
  excelData.forEach((row, index) => {
    const name = row.cytokine.trim();
    const maxConc = parseFloat(row.maxConc);
    const rowDilutionFactor = parseFloat(row.dilutionFactor) || dilutionFactor;
    
    if (name && maxConc > 0) {
      validCytokines.push({ name, maxConc, index });
      newCytokines.push(name);
      newStandardConcentrations[name] = calculateStandardConcentrations(maxConc, rowDilutionFactor, numDilutions);
      newDilutionFactors[name] = rowDilutionFactor;
    }
  });
  
  if (validCytokines.length === 0) {
    updateStatus('Please enter at least one cytokine with a valid concentration', 'error');
    return;
  }
  
  // Update global variables - COMPLETELY REPLACE everything
  CYTOKINES.length = 0; // Clear array
  CYTOKINES.push(...newCytokines);
  
  // Clear and rebuild STANDARD_CONCENTRATIONS
  Object.keys(STANDARD_CONCENTRATIONS).forEach(key => delete STANDARD_CONCENTRATIONS[key]);
  Object.assign(STANDARD_CONCENTRATIONS, newStandardConcentrations);
  
  // Clear and rebuild DILUTION_FACTORS
  Object.keys(DILUTION_FACTORS).forEach(key => delete DILUTION_FACTORS[key]);
  Object.assign(DILUTION_FACTORS, newDilutionFactors);
  
  // Rebuild standardConcentrationsByCytokine
  standardConcentrationsByCytokine = {};
  CYTOKINES.forEach((cytokine, index) => {
    standardConcentrationsByCytokine[index] = [...STANDARD_CONCENTRATIONS[cytokine]];
  });
  
  // Rebuild calculatedConcentrations structure
  calculatedConcentrations = {};
  for (let i = 0; i < CYTOKINES.length; i++) {
    calculatedConcentrations[i] = {};
    for (let row of ROWS) {
      calculatedConcentrations[i][row] = {};
    }
  }
  
  // Reset current cytokine to 0 if we have cytokines
  if (CYTOKINES.length > 0) {
    currentCytokine = 0;
  }
  
  // Refresh ALL UI components
  populateCytokineSelect();
  populateResultsCytokineSelect();
  populateAnalytePreset();
  updateStandardInputsForCytokine();
  renderPlate();
  closeCytokineSetup();
  
  updateStatus(`✅ Configuration applied! ${validCytokines.length} cytokines configured: ${newCytokines.join(', ')}`, 'complete');
  
  console.log('✅ Updated cytokines:', CYTOKINES);
  console.log('✅ Updated standard concentrations:', STANDARD_CONCENTRATIONS);
  console.log('✅ Updated standardConcentrationsByCytokine:', standardConcentrationsByCytokine);
}

// Excel Paste Functionality for new Excel-like table
function parseExcelData() {
  const pasteArea = document.getElementById('excelPasteArea');
  const data = pasteArea.value.trim();
  
  if (!data) {
    updateStatus('Please paste data first', 'error');
    return;
  }
  
  try {
    // Split by lines and process each row
    const lines = data.split('\n').filter(line => line.trim());
    let parsedCount = 0;
    
    lines.forEach((line, index) => {
      if (index >= MAX_SPOTS) return; // Don't exceed available spots
      
      // Split by tab (Excel default) or fallback to other separators
      let parts = line.split('\t');
      if (parts.length < 2) {
        parts = line.split(','); // Try comma
      }
      if (parts.length < 2) {
        parts = line.split(/\s{2,}/); // Try multiple spaces
      }
      
      if (parts.length >= 2) {
        const cytokine = parts[0].trim();
        const concentration = parseFloat(parts[1].trim().replace(/[^0-9.-]/g, ''));
        
        if (cytokine && !isNaN(concentration) && concentration > 0) {
          // Update the Excel data directly
          excelData[index].cytokine = cytokine;
          excelData[index].maxConc = concentration.toString();
          parsedCount++;
        }
      }
    });
    
    if (parsedCount > 0) {
      // Refresh the Excel table display
      initializeExcelTable();
      updateStatus(`Successfully parsed ${parsedCount} cytokine entries from Excel data`, 'complete');
      // Auto-clear the paste area after successful parse
      pasteArea.value = '';
    } else {
      updateStatus('No valid data found. Please check format: CytokineName [Tab] Concentration', 'error');
    }
    
  } catch (error) {
    console.error('Error parsing Excel data:', error);
    updateStatus('Error parsing data. Please check format and try again.', 'error');
  }
}

function clearPasteArea() {
  const pasteArea = document.getElementById('excelPasteArea');
  pasteArea.value = '';
  updateStatus('Paste area cleared', 'complete');
}

// Enhanced paste detection with automatic parsing
function setupExcelPasteDetection() {
  const pasteArea = document.getElementById('excelPasteArea');
  if (pasteArea) {
    // Auto-parse when user pastes data (after a short delay)
    pasteArea.addEventListener('paste', (e) => {
      setTimeout(() => {
        const data = pasteArea.value.trim();
        if (data && (data.includes('\t') || data.includes('\n'))) {
          // Show auto-parse suggestion
          const suggestion = document.createElement('div');
          suggestion.style.cssText = 'margin-top: 5px; padding: 5px 8px; background: #e3f2fd; border: 1px solid #2196f3; border-radius: 3px; font-size: 11px; color: #1976d2;';
          suggestion.innerHTML = '💡 Detected Excel data! <button onclick="parseExcelData()" style="margin-left: 8px; padding: 2px 6px; font-size: 10px;" class="btn btn-primary btn-xs">Parse Now</button>';
          
          // Remove any existing suggestions
          const existing = pasteArea.parentNode.querySelector('.auto-parse-suggestion');
          if (existing) existing.remove();
          
          suggestion.className = 'auto-parse-suggestion';
          pasteArea.parentNode.appendChild(suggestion);
          
          // Auto-remove suggestion after 10 seconds
          setTimeout(() => {
            if (suggestion.parentNode) suggestion.remove();
          }, 10000);
        }
      }, 100);
    });
  }
}

// Initialize Application
function initApp() {
  console.log('🚀 Starting application initialization...');

  // Check if plate elements exist
  const plateContainer = document.querySelector('.plate-container');
  const plateElement = document.getElementById('plate');
  console.log('🔍 Plate container found:', !!plateContainer);
  console.log('🔍 Plate element found:', !!plateElement);

  // Initialize plot registry system
  initializePlotRegistry();

  initializePlateData();
  setupEventListeners();
  populateSelects();
  
  // Setup cytokine modal listeners for dilution parameter changes
  setTimeout(() => {
    const dilutionFactorInput = document.getElementById('setupDilutionFactor');
    const numDilutionsInput = document.getElementById('setupNumDilutions');
    
    if (dilutionFactorInput) {
      dilutionFactorInput.addEventListener('change', updateAllConcentrationPreviews);
    }
    if (numDilutionsInput) {
      numDilutionsInput.addEventListener('change', () => {
        generateCytokineSetupTable(); // Regenerate table with new number of dilutions
      });
    }
  }, 100);

  // Initialize the plate first
  renderPlate();

  updateStandardInputsForCytokine(); // Load initial standard concentrations
  applyDefaultMSDLayout(); // Apply the default MSD layout on startup

  // Initialize drag selection after plate is rendered
  setTimeout(() => {
    initializeDragSelection();
  }, 100);

  // Initialize concentration tools UI
  showConcentrationParams('serial'); // Show serial dilution params by default
  
  // Load real MSD data by default
  loadDefaultMSDData();
  
  updateStatus('Application initialized with real MSD data. Ready to analyze!', 'ready');
  console.log('✅ Application initialization complete');

  // Initialize template list
  updateTemplateList();

  // Test well interactions after a short delay
  setTimeout(() => {
    testWellInteractions();
  }, 500);
}

function testWellInteractions() {
  console.log('🧪 Testing well interactions...');

  // Test if wells exist and have event listeners
  const wells = document.querySelectorAll('.well');
  console.log(`Found ${wells.length} wells`);

  if (wells.length > 0) {
    const firstWell = wells[0];
    console.log('First well element:', firstWell);
    console.log('First well dataset:', firstWell.dataset);

    // Check if click event listener is attached
    const clickListeners = firstWell.onclick || firstWell.getEventListeners?.('click');
    console.log('Click listeners:', clickListeners);

    console.log('✅ Well interactions test complete');
  } else {
    console.error('❌ No wells found!');
  }
}

function initializePlateData() {
  plateData = {};
  wellRoles = {};
  wellCompounds = {};
  wellConcentrations = {}; // COMPOUND concentrations (experimental design)
  wellDilutions = {};
  wellNotes = {}; // Well notes for additional information
  standardConcentrationsByCytokine = {};
  
  // Initialize standard concentrations for all cytokines (only if we have cytokines)
  if (CYTOKINES.length > 0) {
  CYTOKINES.forEach((cytokine, index) => {
      if (STANDARD_CONCENTRATIONS[cytokine]) {
    standardConcentrationsByCytokine[index] = [...STANDARD_CONCENTRATIONS[cytokine]];
      }
    });
  }
  
  // Initialize ACTUAL concentrations (calculated from signals) for each cytokine
  calculatedConcentrations = {};
  for (let cytokineIndex = 0; cytokineIndex < CYTOKINES.length; cytokineIndex++) {
    calculatedConcentrations[cytokineIndex] = {};
  }
  
  // Initialize the nested structure for all wells
  for (let row of ROWS) {
    plateData[row] = {};
    wellRoles[row] = {};
    wellCompounds[row] = {};
    wellConcentrations[row] = {}; // COMPOUND concentrations
    wellDilutions[row] = {};
    wellNotes[row] = {};
    
    // Initialize calculated concentrations for each cytokine
    for (let cytokineIndex = 0; cytokineIndex < CYTOKINES.length; cytokineIndex++) {
      calculatedConcentrations[cytokineIndex][row] = {};
    }
    
    for (let col of COLS) {
      plateData[row][col] = Array(10).fill(null);
      wellRoles[row][col] = null;
      wellCompounds[row][col] = null;
      wellConcentrations[row][col] = null; // COMPOUND concentration
      wellDilutions[row][col] = null;
      wellNotes[row][col] = null;
      
      // Initialize calculated concentrations for each cytokine
      for (let cytokineIndex = 0; cytokineIndex < CYTOKINES.length; cytokineIndex++) {
        calculatedConcentrations[cytokineIndex][row][col] = null;
      }
    }
  }
}

function populateSelects() {
  populateCytokineSelect();
  populateAnalytePreset();
}

function populateCytokineSelect() {
  const cytokineSelect = document.getElementById('cytokineSelect');
  cytokineSelect.innerHTML = '';
  
  if (CYTOKINES.length === 0) {
    const option = document.createElement('option');
    option.value = -1;
    option.textContent = 'No cytokines configured - Use Setup Cytokines';
    option.disabled = true;
    cytokineSelect.appendChild(option);
    return;
  }
  
  CYTOKINES.forEach((cytokine, index) => {
    const option = document.createElement('option');
    option.value = index;
    option.textContent = `${cytokine} (Spot ${index + 1})`;
    cytokineSelect.appendChild(option);
  });
}

function populateResultsCytokineSelect() {
  const resultsSelect = document.getElementById('resultsCytokineSelect');
  if (!resultsSelect) return;
  
  resultsSelect.innerHTML = '';
  
  if (CYTOKINES.length === 0) {
    const option = document.createElement('option');
    option.value = -1;
    option.textContent = 'No cytokines configured';
    option.disabled = true;
    resultsSelect.appendChild(option);
    return;
  }
  
  CYTOKINES.forEach((cytokine, index) => {
    const option = document.createElement('option');
    option.value = index;
    option.textContent = cytokine;
    resultsSelect.appendChild(option);
  });
}

function populateAnalytePreset() {
  const analyteSelect = document.getElementById('analytePreset');
  if (!analyteSelect) return;
  
  analyteSelect.innerHTML = '';
  
  if (CYTOKINES.length === 0) {
    const option = document.createElement('option');
    option.value = '';
    option.textContent = 'No cytokines configured';
    option.disabled = true;
    analyteSelect.appendChild(option);
    return;
  }
  
  CYTOKINES.forEach((cytokine, index) => {
    const option = document.createElement('option');
    option.value = cytokine;
    option.textContent = cytokine;
    analyteSelect.appendChild(option);
  });
}

// Toggle card collapse/expand functionality
function toggleCard(headerElement) {
  const cardContent = headerElement.nextElementSibling;
  const collapseIcon = headerElement.querySelector('.collapse-icon');
  
  if (cardContent && collapseIcon) {
    cardContent.classList.toggle('collapsed');
    collapseIcon.classList.toggle('collapsed');
  }
}

