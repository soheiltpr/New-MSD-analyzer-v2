  <div class="context-menu-header" style="padding: 8px 16px; background: #f8f9fa; font-weight: bold; font-size: 12px; border-bottom: 1px solid #e2e8f0;">
    <span id="contextWellId">Well A1</span>
  </div>
  
  <!-- Essential actions only -->
  <div class="context-menu-item" data-action="set-standard">📏 Set Type: Standard</div>
  <div class="context-menu-item" data-action="set-unknown">❓ Set Type: Unknown</div>
  <div class="context-menu-item" data-action="set-control">🎛️ Set Type: Control</div>
