// Remove a section
function removeSection(sectionId) {
  console.log('🗑️ Removing section:', sectionId);
  
  const section = document.getElementById(sectionId);
  if (section) {
    section.remove();
  }
  
  // Remove from array
  layoutSections = layoutSections.filter(s => s.id !== sectionId);
  
  // Show empty message if no sections
  if (layoutSections.length === 0) {
    const emptyMessage = document.getElementById('emptyMessage');
    if (emptyMessage) {
      emptyMessage.style.display = 'block';
    }
  }
  
  console.log('✅ Section removed');
}

// Move section up or down
function moveSection(sectionId, direction) {
  const index = layoutSections.findIndex(s => s.id === sectionId);
  if (index === -1) return;
  
  const newIndex = direction === 'up' ? index - 1 : index + 1;
  if (newIndex < 0 || newIndex >= layoutSections.length) return;
  
  // Swap in array
  [layoutSections[index], layoutSections[newIndex]] = [layoutSections[newIndex], layoutSections[index]];
  
  // Re-render
  renderLayout();
}

// Render the layout
function renderLayout() {
  const previewArea = document.getElementById('layoutPreviewArea');
  if (!previewArea) return;
  
  // Clear and re-add all sections in order
  const sections = previewArea.querySelectorAll('.layout-section');
  sections.forEach(s => s.remove());
  
  layoutSections.forEach(section => {
    previewArea.appendChild(section.element);
  });
}

// Clear all sections
function clearAllSections() {
  if (!confirm('Remove all sections from layout?')) return;
  
  console.log('🗑️ Clearing all sections');
  
  const previewArea = document.getElementById('layoutPreviewArea');
  if (previewArea) {
    const sections = previewArea.querySelectorAll('.layout-section');
    sections.forEach(s => s.remove());
  }
  
  layoutSections = [];
  
  const emptyMessage = document.getElementById('emptyMessage');
  if (emptyMessage) {
    emptyMessage.style.display = 'block';
  }
  
  console.log('✅ All sections cleared');
}

// Save layout
function saveLayout() {
  const layoutData = layoutSections.map(s => ({
    id: s.id,
    type: s.type
  }));
  
  const dataStr = JSON.stringify(layoutData, null, 2);
  const dataBlob = new Blob([dataStr], { type: 'application/json' });
  const url = URL.createObjectURL(dataBlob);
  const link = document.createElement('a');
  link.href = url;
  link.download = 'layout_config.json';
  link.click();
  URL.revokeObjectURL(url);
  
  alert('Layout configuration saved!');
}

