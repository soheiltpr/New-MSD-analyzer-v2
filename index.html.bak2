  <div class="card">
    <div class="card-header" onclick="toggleCard(this)">
      <h2>📊 Analysis</h2>
      <span class="collapse-icon collapsed">▼</span>
    </div>
    <div class="card-content collapsed">
    
    <div class="form-row cols-2">
      <div>
        <label>Curve Model</label>
        <select id="curveModel">
          <option value="4pl">4-Parameter Logistic</option>
          <option value="5pl">5-Parameter Logistic</option>
          <option value="linear">Linear</option>
          <option value="polynomial">Polynomial</option>
        </select>
      </div>
      <div>
        <label>Weighting</label>
        <select id="weighting">
          <option value="none">None</option>
          <option value="1/y">1/Y</option>
          <option value="1/y2">1/Y²</option>
        </select>
      </div>
    </div>
    
    <div class="form-group">
      <label>Dilution Factor</label>
      <input type="number" id="dilutionFactor" value="1" min="1">
    </div>
    
    <div class="form-group">
      <label>Analysis Method</label>
      <select id="analysisMethod">
        <option value="fit4pl">4PL Curve Fit (Recommended)</option>
        <option value="interp">Log-Log Interpolation</option>
      </select>
      <small style="color: #666; font-size: 11px;">4PL fits sigmoidal curve; Interpolation is parameter-free</small>
    </div>
    
    <div class="quick-actions">
      <button class="btn btn-primary" id="runAnalysis">🔬 Analyze</button>
      <button class="btn btn-msd" id="runMSDAnalysis">🧪 MSD 4PL</button>
      <button class="btn btn-success" id="generateReport">📋 Report</button>
      <button class="btn btn-warning" id="runAllCytokines">🧪 Analyze All Cytokines</button>
      <button class="btn btn-secondary" id="validateStandards">✅ Validate Standards</button>
      <button class="btn btn-info" id="runAutoAnalysis">⚡ Auto Analysis & Plot</button>
      <button class="btn btn-danger" id="diagnoseAnalysis">🔬 Diagnose Calculation</button>
      <button class="btn btn-template" id="templateManagerBtn">💾 Template Manager</button>
    </div>
    
    <div class="quick-actions">
      <button class="btn btn-success" id="exportCSV">📊 Export CSV</button>
      <button class="btn btn-info" id="downloadPNG">📈 Download Chart</button>
      <button class="btn btn-warning" id="exportJSON">💾 Export JSON</button>
    </div>
    
    <!-- Progress Bar for Sequential Analysis -->
    <div id="analysisProgress" class="progress-container" style="display: none;">
      <div class="progress-header">
        <h4>🔄 Analyzing Cytokines</h4>
        <span id="progressText">Starting analysis...</span>
      </div>
      <div class="progress-bar">
        <div id="progressFill" class="progress-fill"></div>
      </div>
      <div class="progress-details">
        <span id="currentCytokine">Preparing...</span>
        <span id="progressCount">0 / 0</span>
      </div>
    </div>
    
    <div class="form-group">
      <h3>Quality Control</h3>
      <div class="form-row cols-2">
        <div>
          <label>Min R² Threshold</label>
          <input type="number" id="minR2" value="0.95" step="0.01" min="0" max="1">
        </div>
        <div>
          <label>CV% Threshold</label>
          <input type="number" id="maxCV" value="20" step="1" min="0" max="100">
        </div>
        </div>
      </div>
    </div>
  </div>

