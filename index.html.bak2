// Automatic Analysis and Plotting
function runAutomaticAnalysisAndPlotting() {
  try {
    updateStatus('Running automatic analysis for all cytokines...', 'processing');
    
    // Run analysis for all cytokines
    const results = {};
    const failedCytokines = [];
    
    for (let cytokineIndex = 0; cytokineIndex < CYTOKINES.length; cytokineIndex++) {
      try {
        currentCytokine = cytokineIndex;
        const standards = collectStandardData(cytokineIndex);
        
        if (standards.length < 3) {
          failedCytokines.push(`${CYTOKINES[cytokineIndex]} (insufficient standards: ${standards.length})`);
          continue;
        }
        
        const method = document.getElementById('analysisMethod').value || 'fit4pl';
        let predictor, curveQuality = {};
        
        if (method === 'fit4pl') {
          const standardPairs = standards.map(s => [s.concentration, s.signal]);
          predictor = Predictor.fromFit4PL(standardPairs);
          
          const signals = standards.map(s => s.signal);
          const predicted = standards.map(s => predictor.model.f(s.concentration));
          curveQuality.r2 = AnalysisEngine.calculateR2(signals, predicted).toFixed(4);
          curveQuality.method = '4PL Curve Fit';
        } else {
          const interpPairs = standards.map(s => [s.signal, s.concentration]);
          predictor = Predictor.fromInterpPairs(interpPairs);
          curveQuality.method = 'Log-Log Interpolation';
          curveQuality.r2 = 'N/A';
        }
        
        // Calculate unknown concentrations and collect rows for results
        const unknowns = calculateUnknownConcentrationsForCytokine(predictor, cytokineIndex, standards);
        
        results[cytokineIndex] = {
          cytokine: CYTOKINES[cytokineIndex],
          standards: standards.length,
          r2: curveQuality.r2,
          method: curveQuality.method,
          predictor: predictor,
          standardData: standards,
          unknowns: unknowns,
          cytokineIndex
        };
        
      } catch (error) {
        failedCytokines.push(`${CYTOKINES[cytokineIndex]} (${error.message})`);
      }
    }
    
    // Store global results (map by cytokine index)
    analysisResults = results; // { [index]: { cytokine, standards, r2, method, predictor, standardData, unknowns, cytokineIndex } }
    populateResultsCytokineSelect(results);
    const firstIdx = parseInt(Object.keys(results)[0] || currentCytokine);
    try { displayAnalysisResultsFor(firstIdx); } catch (e) { console.warn('Display init failed', e); }
    
    // Removed automatic charts creation per user request
    
    // Update status
    const successCount = Object.keys(results).length;
    let statusMessage = `Automatic analysis complete: ${successCount}/${CYTOKINES.length} cytokines analyzed`;
    if (failedCytokines.length > 0) {
      statusMessage += ` (${failedCytokines.length} failed)`;
    }
    
    updateStatus(statusMessage, 'complete');
    console.log('Automatic analysis results:', results);
    
  } catch (error) {
    updateStatus(`Automatic analysis failed: ${error.message}`, 'error');
    console.error('Automatic analysis error:', error);
  }
}

function calculateUnknownConcentrationsForCytokine(predictor, cytokineIndex, standards) {
  // Calculate concentrations for unknowns using this cytokine's predictor
  // Note: For our default layout, unknowns have expected concentrations set
  // We'll calculate and compare but preserve expected values for accuracy assessment
  
  // QC bounds from standards: min and max signal and concentration
  const stdSignals = (standards || []).map(s => s.signal).filter(v => Number.isFinite(v));
  const stdConcs = (standards || []).map(s => s.concentration).filter(v => Number.isFinite(v));
  const minStdSignal = stdSignals.length ? Math.min(...stdSignals) : null;
  const maxStdSignal = stdSignals.length ? Math.max(...stdSignals) : null;
  const minStdConc = stdConcs.length ? Math.min(...stdConcs) : null;
  const maxStdConc = stdConcs.length ? Math.max(...stdConcs) : null;

  const unknowns = [];
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row][col] === 'unknown') {
        const signal = getWellSignal(row, col, cytokineIndex);
        
        if (signal !== null && signal !== undefined) {
          try {
            const dilutionFactor = wellDilutions[row][col] || 1.0;
            const result = predictor.predict(signal, dilutionFactor);
            const finalConc = result.concentration;
            
            // Store ACTUAL concentration (pg/mL) in calculatedConcentrations without touching design concentrations
            if (!calculatedConcentrations[cytokineIndex]) {
              calculatedConcentrations[cytokineIndex] = {};
            }
            if (!calculatedConcentrations[cytokineIndex][row]) {
              calculatedConcentrations[cytokineIndex][row] = {};
            }
            calculatedConcentrations[cytokineIndex][row][col] = finalConc;

            // QC sanity checks vs standards (10% rule guidance)
            if (minStdSignal !== null && maxStdSignal !== null && minStdConc !== null && maxStdConc !== null) {
              if (signal < 0.9 * minStdSignal && finalConc > 1.1 * minStdConc) {
                console.warn(`QC: ${row}${col} signal ${signal} << minStd ${minStdSignal}, but conc ${finalConc} >> minStdConc ${minStdConc}`);
              }
              if (signal > 1.1 * maxStdSignal && finalConc < 0.9 * maxStdConc) {
                console.warn(`QC: ${row}${col} signal ${signal} >> maxStd ${maxStdSignal}, but conc ${finalConc} << maxStdConc ${maxStdConc}`);
              }
            }

            unknowns.push({ well: `${row}${col}`, signal, actualConcentration: finalConc, compound: wellCompounds[row][col] || 'Unknown' });
          } catch (e) {
            console.warn(`Failed to calculate concentration for ${row}${col}, ${CYTOKINES[cytokineIndex]}: ${e.message}`);
          }
        }
      }
    }
  }
  return unknowns;
}

