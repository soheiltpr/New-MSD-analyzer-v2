  	       172  	       167  	       472  	      1230  	      4438  	     16898  	     67645  	    260769  	    870606  	       252  	       315  	       283	
  	       186  	       126  	       257  	       612  	      1850  	      7109  	     30087  	    134401  	    600164  	     11001  	     10369  	      8749	
  	       139  	       120  	       648  	      2039  	      8153  	     29476  	    115140  	    364214  	    902107  	       181  	       216  	       227	
  	       159  	       178  	       499  	      1189  	      4625  	     20053  	    110921  	    437231  	    927463  	     31454  	     38170  	     28667	
  	       337  	       240  	       491  	      1191  	      4579  	     17121  	     71792  	    272065  	   1008205  	     51517  	     49577  	     47555	`;

  // Use the existing parseRawData logic but with this data
  document.getElementById('rawData').value = realMSDData;
  
  // Parse the data
  try {
    // Find the data section
    const dataStart = realMSDData.indexOf('==========Data');
    if (dataStart === -1) {
      throw new Error('Data section not found');
    }

    // Find the end of data section
    let dataEnd = realMSDData.indexOf('==========Processing');
    if (dataEnd === -1) dataEnd = realMSDData.indexOf('==========Statistics');
    if (dataEnd === -1) dataEnd = realMSDData.length;

    const dataSection = realMSDData.slice(dataStart, dataEnd);
    const lines = dataSection.split('\\n');
    
    // Initialize plate data
    for (let row of ROWS) {
      for (let col of COLS) {
        plateData[row][col] = Array(10).fill(null);
      }
    }

    let foundHeader = false;
    let dataLines = [];
    
    for (let line of lines) {
      line = line.trim();
      if (!line) continue;
      
      if (line.includes('1         	2         	3         ')) {
        foundHeader = true;
        continue;
      }
      
      if (foundHeader && line.match(/^[A-H]\\s/)) {
        dataLines.push(line);
      } else if (foundHeader && line.match(/^\\s+\\d/)) {
        dataLines.push(line);
      }
    }

    // Parse the data lines
    let currentRow = '';
    let cytokineIndex = 0;
    let dataCount = 0;
    
    for (let line of dataLines) {
      if (line.match(/^[A-H]\\s/)) {
        // This is a row header line
        currentRow = line.charAt(0);
        cytokineIndex = 0;
        
        // Parse the data values in this line
        const values = line.split(/\\s+/).slice(1); // Skip the row letter
        for (let i = 0; i < values.length && i < 12; i++) {
          const value = parseInt(values[i]);
          if (!isNaN(value)) {
            plateData[currentRow][i + 1][cytokineIndex] = value;
            dataCount++;
          }
        }
      } else if (line.match(/^\\s+\\d/) && currentRow) {
        // This is a continuation line with more cytokine data
        cytokineIndex++;
        if (cytokineIndex < 10) {
          const values = line.trim().split(/\\s+/);
          for (let i = 0; i < values.length && i < 12; i++) {
            const value = parseInt(values[i]);
            if (!isNaN(value)) {
              plateData[currentRow][i + 1][cytokineIndex] = value;
              dataCount++;
            }
          }
        }
      }
    }
    
    console.log(`✅ Real MSD data loaded: ${dataCount} data points`);
    
    // Apply default layout and render
    applyDefaultMSDLayout();
    renderPlate();
    
    updateStatus(`Real MSD data loaded successfully (${dataCount} data points)`, 'complete');
    
  } catch (error) {
    console.error('Error loading real MSD data:', error);
    updateStatus('Error loading real MSD data, falling back to demo data', 'warning');
    generateDemoData();
  }
}

function clearAllWells() {
  for (let row of ROWS) {
    for (let col of COLS) {
      wellRoles[row][col] = null;
      wellCompounds[row][col] = null;
      wellConcentrations[row][col] = null;
      wellDilutions[row][col] = 1.0;
    }
  }
}

// NEW: Clear wells but preserve compound concentrations
function clearWellsPreserveConcentrations() {
  console.log('🔄 Clearing wells while preserving compound concentrations...');
  
  // Store current compound concentrations
  const preservedConcentrations = {};
  for (let row of ROWS) {
    preservedConcentrations[row] = {};
    for (let col of COLS) {
      if (wellConcentrations[row][col] !== null) {
        preservedConcentrations[row][col] = wellConcentrations[row][col];
        console.log(`  💾 Preserving ${row}${col}: ${wellConcentrations[row][col]}`);
      }
    }
  }
  
  // Clear all wells
  clearAllWells();
  
  // Restore preserved concentrations
  for (let row of ROWS) {
    for (let col of COLS) {
      if (preservedConcentrations[row][col] !== undefined) {
        wellConcentrations[row][col] = preservedConcentrations[row][col];
        console.log(`  🔄 Restored ${row}${col}: ${wellConcentrations[row][col]}`);
      }
    }
  }
  
  console.log('✅ Wells cleared, compound concentrations preserved');
}

function clearAllWellsAndRender() {
  clearAllWells();
  renderPlate();
  updateStatus('All wells cleared', 'complete');
}

function updateStandardInputsForCytokine() {
  // Update the standard concentration input fields to show current cytokine values
  const concentrations = standardConcentrationsByCytokine[currentCytokine] || STANDARD_CONCENTRATIONS[CYTOKINES[currentCytokine]];
  
  for (let i = 0; i < 8; i++) {
    const input = document.getElementById(`std${i + 1}`);
    if (input) {
      input.value = concentrations[i];
    }
  }
  
  
  // Update the current cytokine label
  const cytokineLabel = document.getElementById('currentCytokineLabel');
  if (cytokineLabel) {
    cytokineLabel.textContent = CYTOKINES[currentCytokine];
  }
  
  // Update the analyte preset selector to match current cytokine
  const presetSelect = document.getElementById('analytePreset');
  if (presetSelect) {
    presetSelect.value = CYTOKINES[currentCytokine];
  }
  
  // Update existing standard wells with new concentrations
  updateExistingStandardsConcentrations();
}

function updateStandardConcentrations() {
  // Save the current input values to the cytokine-specific storage
  const concentrations = [];
  for (let i = 1; i <= 8; i++) {
    const value = parseFloat(document.getElementById(`std${i}`).value);
    concentrations.push(isNaN(value) ? 0 : value);
  }
  
  // Store the concentrations for the current cytokine
  standardConcentrationsByCytokine[currentCytokine] = concentrations;
  
  // Update existing standard wells with new concentrations
  updateExistingStandardsConcentrations();
  
  renderPlate();
  updateStatus(`Standard concentrations updated for ${CYTOKINES[currentCytokine]}`, 'complete');
}

function updateExistingStandardsConcentrations() {
  // Update all existing standards with current cytokine concentrations
  const concentrations = standardConcentrationsByCytokine[currentCytokine];
  if (!concentrations) return;
  
  console.log(`🔄 Updating existing standards with concentrations:`, concentrations);
  
  // Collect all standard wells and sort them
  const standardWells = [];
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row][col] === 'standard') {
        standardWells.push({ row, col, compound: wellCompounds[row][col] });
      }
    }
  }
  
  // Sort standards by their position (top to bottom, left to right)
  standardWells.sort((a, b) => {
    const rowA = ROWS.indexOf(a.row);
    const rowB = ROWS.indexOf(b.row);
    if (rowA !== rowB) return rowA - rowB;
    return COLS.indexOf(a.col) - COLS.indexOf(b.col);
  });
  
  // Update concentrations for each standard well
  // Extract standard numbers from compound names and map to concentrations
  standardWells.forEach((well) => {
    const compound = wellCompounds[well.row][well.col];
    let stdNumber = 1;
    
    // Extract standard number from compound name (std1, std2, etc.)
    if (compound && compound.startsWith('std')) {
      const match = compound.match(/std(\d+)/);
      if (match) {
        stdNumber = parseInt(match[1]);
      }
    }
    
    // Map standard number to concentration index
    // std1 = index 0 (highest), std8 = index 7 (lowest)
    const concentrationIndex = stdNumber - 1;
    const concentration = concentrations[concentrationIndex] || 0;
    
    wellConcentrations[well.row][well.col] = concentration;
    wellCompounds[well.row][well.col] = `std${stdNumber}`;
    
    console.log(`✅ Updated standard ${stdNumber} at ${well.row}${well.col}: ${wellCompounds[well.row][well.col]} = ${concentration} pg/mL (index ${concentrationIndex})`);
  });
  
  // Count replicates for logging
  const replicateCounts = {};
  standardWells.forEach((well) => {
    const compound = wellCompounds[well.row][well.col];
    if (compound && compound.startsWith('std')) {
      const match = compound.match(/std(\d+)/);
      if (match) {
        const stdNumber = parseInt(match[1]);
        replicateCounts[stdNumber] = (replicateCounts[stdNumber] || 0) + 1;
      }
    }
  });
  
  // Log replicate counts
  Object.keys(replicateCounts).forEach(stdNumber => {
    if (replicateCounts[stdNumber] > 1) {
      console.log(`📊 Updated ${replicateCounts[stdNumber]} replicates for std${stdNumber}`);
    }
  });
  
  // Re-render the plate to show updated concentrations
  renderPlate();
}

function loadAnalytePreset() {
  if (CYTOKINES.length === 0) {
    updateStatus('No cytokines configured. Please setup cytokines first.', 'error');
    return;
  }
  
  const analyte = document.getElementById('analytePreset').value;
  const concentrations = STANDARD_CONCENTRATIONS[analyte];
  
  if (concentrations && CYTOKINES.includes(analyte)) {
    // Update the input fields
    for (let i = 0; i < 8; i++) {
      const input = document.getElementById(`std${i + 1}`);
      if (input) {
        input.value = concentrations[i];
      }
    }
    
    // Store the concentrations for the current cytokine
    if (standardConcentrationsByCytokine[currentCytokine]) {
    standardConcentrationsByCytokine[currentCytokine] = [...concentrations];
    }
    
    // Update existing standard wells
    updateExistingStandardsConcentrations();
    renderPlate();
    
    updateStatus(`Loaded ${analyte} preset concentrations for ${CYTOKINES[currentCytokine]}`, 'complete');
  } else {
    updateStatus('Preset not found for ' + analyte + '. Make sure cytokines are configured properly.', 'error');
  }
}

// Quick Standard Assignment Functions
function assignStandardsToSelected() {
  if (selectedWells.size === 0) {
    updateStatus('No wells selected for standard assignment', 'error');
    return;
  }

  const direction = document.getElementById('standardDirection').value;
  const concentrationOrder = document.getElementById('concentrationOrder').value;
  const standardConcentrations = standardConcentrationsByCytokine[currentCytokine] || STANDARD_CONCENTRATIONS[CYTOKINES[currentCytokine]];
  
  // Convert selected wells to array and sort based on direction
  const wellsArray = Array.from(selectedWells);
  const sortedWells = sortWellsByDirection(wellsArray, direction);
  
  // Get concentration order
  const concentrations = concentrationOrder === 'highToLow' ? 
    [...standardConcentrations] : 
    [...standardConcentrations].reverse();
  
  // Assign standards
  sortedWells.forEach((wellId, index) => {
    if (index < 8) { // Only assign up to 8 standards
      const row = wellId[0];
      const col = parseInt(wellId.slice(1));
      const stdNum = concentrationOrder === 'highToLow' ? index + 1 : 8 - index;
      
      wellRoles[row][col] = 'standard';
      wellCompounds[row][col] = `Std ${stdNum}`;
      wellConcentrations[row][col] = concentrations[index];
      wellDilutions[row][col] = 1.0;
    }
  });
  
  renderPlate();
  updateStatus(`Assigned ${Math.min(sortedWells.length, 8)} standards in ${direction} order`, 'complete');
}

function sortWellsByDirection(wellsArray, direction) {
  return wellsArray.sort((a, b) => {
    const rowA = a[0], colA = parseInt(a.slice(1));
    const rowB = b[0], colB = parseInt(b.slice(1));
    const rowIndexA = ROWS.indexOf(rowA);
    const rowIndexB = ROWS.indexOf(rowB);
    
    switch (direction) {
      case 'leftToRight':
        return rowIndexA === rowIndexB ? colA - colB : rowIndexA - rowIndexB;
      case 'rightToLeft':
        return rowIndexA === rowIndexB ? colB - colA : rowIndexA - rowIndexB;
      case 'topToBottom':
        return colA === colB ? rowIndexA - rowIndexB : colA - colB;
      case 'bottomToTop':
        return colA === colB ? rowIndexB - rowIndexA : colA - colB;
      default:
        return 0;
    }
  });
}

// New Standard Assignment System (from starting point)
function assignStandardsFromStart() {
  const startWellInput = document.getElementById('standardStartWell');
  const startWell = startWellInput.value.trim().toUpperCase();
  
  if (!startWell) {
    updateStatus('Please select a starting well first', 'error');
    return;
  }
  
  // Validate well format (e.g., A2, H9)
  if (!startWell.match(/^[A-H]\d{1,2}$/)) {
    updateStatus('Invalid well format. Use format like A2, H9', 'error');
    return;
  }
  
  const startRow = startWell[0];
  const startCol = parseInt(startWell.slice(1));
  
  // Validate well exists on plate
  if (!ROWS.includes(startRow) || startCol < 1 || startCol > 12) {
    updateStatus('Well is outside plate boundaries', 'error');
    return;
  }
  
  const direction = document.getElementById('standardDirection').value;
  const count = parseInt(document.getElementById('standardCount').value);
  const concentrationOrder = document.getElementById('concentrationOrder').value;
  
  // Generate well sequence from starting point
  const wellSequence = generateWellSequence(startRow, startCol, direction, count);
  
  if (wellSequence.length === 0) {
    updateStatus('Cannot create sequence - wells go outside plate boundaries', 'error');
    return;
  }
  
  // Get standard concentrations
  const standardConcentrations = standardConcentrationsByCytokine[currentCytokine] || STANDARD_CONCENTRATIONS[CYTOKINES[currentCytokine]];
  const concentrations = concentrationOrder === 'highToLow' ? 
    [...standardConcentrations] : 
    [...standardConcentrations].reverse();
  
  // Clear existing assignments for these wells
  wellSequence.forEach(([row, col]) => {
    wellRoles[row][col] = 'empty';
    wellCompounds[row][col] = '';
    wellConcentrations[row][col] = 0;
    wellDilutions[row][col] = 1.0;
  });
  
  // Assign standards to the sequence
  wellSequence.forEach(([row, col], index) => {
    if (index < concentrations.length) {
      const stdNum = concentrationOrder === 'highToLow' ? index + 1 : concentrations.length - index;
      
      wellRoles[row][col] = 'standard';
      wellCompounds[row][col] = `Std ${stdNum}`;
      wellConcentrations[row][col] = concentrations[index];
      wellDilutions[row][col] = 1.0;
    }
  });
  
  renderPlate();
  updateStatus(`Assigned ${Math.min(wellSequence.length, concentrations.length)} standards starting from ${startWell} going ${direction}`, 'complete');
}

function generateWellSequence(startRow, startCol, direction, count) {
  const sequence = [];
  let currentRow = startRow;
  let currentCol = startCol;
  
  for (let i = 0; i < count; i++) {
    // Check if current position is valid
    if (!ROWS.includes(currentRow) || currentCol < 1 || currentCol > 12) {
      break; // Stop if we go outside plate boundaries
    }
    
    sequence.push([currentRow, currentCol]);
    
    // Move to next position based on direction
    switch (direction) {
      case 'right':
        currentCol++;
        break;
      case 'left':
        currentCol--;
        break;
      case 'down':
        const currentRowIndex = ROWS.indexOf(currentRow);
        if (currentRowIndex < ROWS.length - 1) {
          currentRow = ROWS[currentRowIndex + 1];
        } else {
          currentRow = null; // Will break the loop
        }
        break;
      case 'up':
        const currentRowIndexUp = ROWS.indexOf(currentRow);
        if (currentRowIndexUp > 0) {
          currentRow = ROWS[currentRowIndexUp - 1];
        } else {
          currentRow = null; // Will break the loop
        }
        break;
    }
  }
  
  return sequence;
}

function clearStandardStart() {
  document.getElementById('standardStartWell').value = '';
  updateStatus('Cleared starting well selection', 'info');
}

// Range parsing functions
function parseRowRange(input) {
  const rows = [];
  
  if (input.includes('-')) {
    // Range format like "B-D"
    const parts = input.split('-');
    if (parts.length === 2) {
      const startRow = parts[0].trim();
      const endRow = parts[1].trim();
      
      if (ROWS.includes(startRow) && ROWS.includes(endRow)) {
        const startIndex = ROWS.indexOf(startRow);
        const endIndex = ROWS.indexOf(endRow);
        
        const minIndex = Math.min(startIndex, endIndex);
        const maxIndex = Math.max(startIndex, endIndex);
        
        for (let i = minIndex; i <= maxIndex; i++) {
          rows.push(ROWS[i]);
        }
      }
    }
  } else {
    // Single row format like "B"
    if (ROWS.includes(input)) {
      rows.push(input);
    }
  }
  
  return rows;
}

function parseColumnRange(input) {
  const columns = [];
  
  if (input.includes('-')) {
    // Range format like "2-4"
    const parts = input.split('-');
    if (parts.length === 2) {
      const startCol = parseInt(parts[0].trim());
      const endCol = parseInt(parts[1].trim());
      
      if (startCol >= 1 && startCol <= 12 && endCol >= 1 && endCol <= 12) {
        const minCol = Math.min(startCol, endCol);
        const maxCol = Math.max(startCol, endCol);
        
        for (let i = minCol; i <= maxCol; i++) {
          columns.push(i);
        }
      }
    }
  } else {
    // Single column format like "3"
    const col = parseInt(input);
    if (col >= 1 && col <= 12) {
      columns.push(col);
    }
  }
  
  return columns;
}

function duplicateStandards() {
  // Find all current standards on the plate
  const currentStandards = [];
  
  for (let row of ROWS) {
    for (let col = 1; col <= 12; col++) {
      if (wellRoles[row][col] === 'standard') {
        currentStandards.push({
          row: row,
          col: col,
          compound: wellCompounds[row][col],
          concentration: wellConcentrations[row][col],
          dilution: wellDilutions[row][col]
        });
      }
    }
  }
  
  if (currentStandards.length === 0) {
    updateStatus('No standards found on plate to duplicate', 'error');
    return;
  }
  
  // Analyze the pattern of current standards
  const standardPattern = analyzeStandardPattern(currentStandards);
  
  if (!standardPattern.isSequential) {
    updateStatus('Standards are not in a continuous sequence. Please arrange standards in a row or column first.', 'error');
    return;
  }
  
  // Ask user for duplicate location based on pattern
  if (standardPattern.direction === 'horizontal') {
    // Standards are in a row, ask for duplicate row(s)
    const duplicateRows = prompt(`Standards are in row ${standardPattern.row} (columns ${standardPattern.startCol}-${standardPattern.endCol}).\nWhich row(s) should contain the duplicates?\n\nExamples:\n- Single row: B\n- Multiple rows: B-D (creates duplicates in rows B, C, D)`, 
      standardPattern.row === 'A' ? 'B' : 'A');
    
    if (!duplicateRows) {
      updateStatus('No row selection provided', 'error');
      return;
    }
    
    const rowsToUse = parseRowRange(duplicateRows.trim().toUpperCase());
    if (rowsToUse.length === 0) {
      updateStatus('Invalid row selection. Use format like: B or B-D', 'error');
      return;
    }
    
    rowsToUse.forEach(row => {
      duplicateStandardsInRow(currentStandards, row, standardPattern);
    });
    
  } else if (standardPattern.direction === 'vertical') {
    // Standards are in a column, ask for duplicate column(s)
    const duplicateCols = prompt(`Standards are in column ${standardPattern.col} (rows ${standardPattern.startRow}-${standardPattern.endRow}).\nWhich column(s) should contain the duplicates?\n\nExamples:\n- Single column: 3\n- Multiple columns: 2-4 (creates duplicates in columns 2, 3, 4)`, 
      standardPattern.col === 1 ? '2' : String(standardPattern.col - 1));
    
    if (!duplicateCols) {
      updateStatus('No column selection provided', 'error');
      return;
    }
    
    const colsToUse = parseColumnRange(duplicateCols.trim());
    if (colsToUse.length === 0) {
      updateStatus('Invalid column selection. Use format like: 3 or 2-4', 'error');
      return;
    }
    
    colsToUse.forEach(col => {
      duplicateStandardsInColumn(currentStandards, col, standardPattern);
    });
  }
}

function analyzeStandardPattern(standards) {
  if (standards.length < 2) {
    return { isSequential: false };
  }
  
  // Sort standards by position
  standards.sort((a, b) => {
    const rowDiff = ROWS.indexOf(a.row) - ROWS.indexOf(b.row);
    return rowDiff !== 0 ? rowDiff : a.col - b.col;
  });
  
  // Check if all standards are in the same row (horizontal pattern)
  const firstRow = standards[0].row;
  const allSameRow = standards.every(std => std.row === firstRow);
  
  if (allSameRow) {
    // Check if columns are sequential
    const columns = standards.map(std => std.col).sort((a, b) => a - b);
    const isSequential = columns.every((col, index) => 
      index === 0 || col === columns[index - 1] + 1
    );
    
    if (isSequential) {
      return {
        isSequential: true,
        direction: 'horizontal',
        row: firstRow,
        startCol: Math.min(...columns),
        endCol: Math.max(...columns),
        standards: standards
      };
    }
  }
  
  // Check if all standards are in the same column (vertical pattern)
  const firstCol = standards[0].col;
  const allSameCol = standards.every(std => std.col === firstCol);
  
  if (allSameCol) {
    // Check if rows are sequential
    const rowIndices = standards.map(std => ROWS.indexOf(std.row)).sort((a, b) => a - b);
    const isSequential = rowIndices.every((rowIdx, index) => 
      index === 0 || rowIdx === rowIndices[index - 1] + 1
    );
    
    if (isSequential) {
      const rows = standards.map(std => std.row);
      return {
        isSequential: true,
        direction: 'vertical',
        col: firstCol,
        startRow: ROWS[Math.min(...rowIndices)],
        endRow: ROWS[Math.max(...rowIndices)],
        standards: standards
      };
    }
  }
  
  return { isSequential: false };
}

function duplicateStandardsInRow(originalStandards, duplicateRow, pattern) {
  // Clear any existing assignments in the duplicate row for the same columns
  for (let col = pattern.startCol; col <= pattern.endCol; col++) {
    wellRoles[duplicateRow][col] = 'empty';
    wellCompounds[duplicateRow][col] = '';
    wellConcentrations[duplicateRow][col] = 0;
    wellDilutions[duplicateRow][col] = 1.0;
  }
  
  // Duplicate each standard to the new row
  originalStandards.forEach(standard => {
    wellRoles[duplicateRow][standard.col] = 'standard';
    wellCompounds[duplicateRow][standard.col] = standard.compound;
    wellConcentrations[duplicateRow][standard.col] = standard.concentration;
    wellDilutions[duplicateRow][standard.col] = standard.dilution;
  });
  
  renderPlate();
  updateStatus(`Duplicated ${originalStandards.length} standards from row ${pattern.row} to row ${duplicateRow}`, 'complete');
}

function duplicateStandardsInColumn(originalStandards, duplicateCol, pattern) {
  // Clear any existing assignments in the duplicate column for the same rows
  const rowIndices = originalStandards.map(std => ROWS.indexOf(std.row));
  const startRowIdx = Math.min(...rowIndices);
  const endRowIdx = Math.max(...rowIndices);
  
  for (let rowIdx = startRowIdx; rowIdx <= endRowIdx; rowIdx++) {
    const row = ROWS[rowIdx];
    wellRoles[row][duplicateCol] = 'empty';
    wellCompounds[row][duplicateCol] = '';
    wellConcentrations[row][duplicateCol] = 0;
    wellDilutions[row][duplicateCol] = 1.0;
  }
  
  // Duplicate each standard to the new column
  originalStandards.forEach(standard => {
    wellRoles[standard.row][duplicateCol] = 'standard';
    wellCompounds[standard.row][duplicateCol] = standard.compound;
    wellConcentrations[standard.row][duplicateCol] = standard.concentration;
    wellDilutions[standard.row][duplicateCol] = standard.dilution;
  });
  
  renderPlate();
  updateStatus(`Duplicated ${originalStandards.length} standards from column ${pattern.col} to column ${duplicateCol}`, 'complete');
}

// Compound Concentration Assignment Functions
function assignCompoundFromStart() {
  const startWellInput = document.getElementById('compoundStartWell');
  const startWell = startWellInput.value.trim().toUpperCase();
  
  if (!startWell) {
    updateStatus('Please select a starting well first', 'error');
    return;
  }
  
  // Validate well format
  if (!startWell.match(/^[A-H]\d{1,2}$/)) {
    updateStatus('Invalid well format. Use format like B2, C3', 'error');
    return;
  }
  
  const startRow = startWell[0];
  const startCol = parseInt(startWell.slice(1));
  
  // Validate well exists on plate
  if (!ROWS.includes(startRow) || startCol < 1 || startCol > 12) {
    updateStatus('Well is outside plate boundaries', 'error');
    return;
  }
  
  const direction = document.getElementById('compoundDirection').value;
  const dilutions = parseInt(document.getElementById('compoundDilutions').value);
  const maxConcentration = parseFloat(document.getElementById('maxConcentration').value);
  const dilutionFactor = parseFloat(document.getElementById('compoundDilutionFactor').value);
  const compoundName = document.getElementById('compoundName').value.trim() || 'Compound';
  
  // Generate well sequence from starting point
  const wellSequence = generateWellSequence(startRow, startCol, direction, dilutions);
  
  if (wellSequence.length === 0) {
    updateStatus('Cannot create sequence - wells go outside plate boundaries', 'error');
    return;
  }
  
  // Generate serial dilution concentrations
  const concentrations = generateSerialDilutionConcentrations(maxConcentration, dilutionFactor, dilutions);
  
  // Clear existing assignments for these wells and set as unknowns with compound concentrations
  wellSequence.forEach(([row, col], index) => {
    if (index < concentrations.length) {
      wellRoles[row][col] = 'unknown';
      wellCompounds[row][col] = compoundName;
      wellConcentrations[row][col] = concentrations[index];
      wellDilutions[row][col] = 1.0;
    }
  });
  
  renderPlate();
  updateStatus(`Assigned ${Math.min(wellSequence.length, concentrations.length)} compound concentrations for "${compoundName}" starting from ${startWell} going ${direction}`, 'complete');
}

function generateSerialDilutionConcentrations(maxConc, dilutionFactor, count) {
  const concentrations = [];
  let currentConc = maxConc;
  
  for (let i = 0; i < count; i++) {
    concentrations.push(currentConc);
    currentConc = currentConc / dilutionFactor;
  }
  
  return concentrations;
}

function extendCompoundSeries() {
  // Find all current compound wells with the same compound name
  const compoundName = document.getElementById('compoundName').value.trim() || 'Compound';
  const currentCompounds = [];
  
  for (let row of ROWS) {
    for (let col = 1; col <= 12; col++) {
      if (wellRoles[row][col] === 'unknown' && wellCompounds[row][col] === compoundName) {
        currentCompounds.push({
          row: row,
          col: col,
          compound: wellCompounds[row][col],
          concentration: wellConcentrations[row][col],
          dilution: wellDilutions[row][col]
        });
      }
    }
  }
  
  if (currentCompounds.length === 0) {
    updateStatus(`No compound wells found for "${compoundName}" to extend`, 'error');
    return;
  }
  
  // Analyze the pattern of current compounds
  const compoundPattern = analyzeCompoundPattern(currentCompounds);
  
  if (!compoundPattern.isSequential) {
    updateStatus('Compound wells are not in a continuous sequence. Please arrange compound concentrations in a row or column first.', 'error');
    return;
  }
  
  // Ask user for extension location based on pattern
  if (compoundPattern.direction === 'horizontal') {
    // Compounds are in a row, ask for parallel row(s)
    const parallelRows = prompt(`Compound "${compoundName}" is in row ${compoundPattern.row} (columns ${compoundPattern.startCol}-${compoundPattern.endCol}).\nWhich row(s) should contain the parallel series (replicates)?\n\nExamples:\n- Single row: C\n- Multiple rows: C-E (creates replicates in rows C, D, E)`, 
      compoundPattern.row === 'A' ? 'B' : String.fromCharCode(compoundPattern.row.charCodeAt(0) + 1));
    
    if (!parallelRows) {
      updateStatus('No row selection provided', 'error');
      return;
    }
    
    const rowsToUse = parseRowRange(parallelRows.trim().toUpperCase());
    if (rowsToUse.length === 0) {
      updateStatus('Invalid row selection. Use format like: C or C-E', 'error');
      return;
    }
    
    rowsToUse.forEach(row => {
      extendCompoundsInRow(currentCompounds, row, compoundPattern);
    });
    
  } else if (compoundPattern.direction === 'vertical') {
    // Compounds are in a column, ask for parallel column(s)
    const parallelCols = prompt(`Compound "${compoundName}" is in column ${compoundPattern.col} (rows ${compoundPattern.startRow}-${compoundPattern.endRow}).\nWhich column(s) should contain the parallel series (replicates)?\n\nExamples:\n- Single column: 4\n- Multiple columns: 3-5 (creates replicates in columns 3, 4, 5)`, 
      String(compoundPattern.col + 1));
    
    if (!parallelCols) {
      updateStatus('No column selection provided', 'error');
      return;
    }
    
    const colsToUse = parseColumnRange(parallelCols.trim());
    if (colsToUse.length === 0) {
      updateStatus('Invalid column selection. Use format like: 4 or 3-5', 'error');
      return;
    }
    
    colsToUse.forEach(col => {
      extendCompoundsInColumn(currentCompounds, col, compoundPattern);
    });
  }
}

function analyzeCompoundPattern(compounds) {
  if (compounds.length < 2) {
    return { isSequential: false };
  }
  
  // Sort compounds by position
  compounds.sort((a, b) => {
    const rowDiff = ROWS.indexOf(a.row) - ROWS.indexOf(b.row);
    return rowDiff !== 0 ? rowDiff : a.col - b.col;
  });
  
  // Check if all compounds are in the same row (horizontal pattern)
  const firstRow = compounds[0].row;
  const allSameRow = compounds.every(comp => comp.row === firstRow);
  
  if (allSameRow) {
    // Check if columns are sequential
    const columns = compounds.map(comp => comp.col).sort((a, b) => a - b);
    const isSequential = columns.every((col, index) => 
      index === 0 || col === columns[index - 1] + 1
    );
    
    if (isSequential) {
      return {
        isSequential: true,
        direction: 'horizontal',
        row: firstRow,
        startCol: Math.min(...columns),
        endCol: Math.max(...columns),
        compounds: compounds
      };
    }
  }
  
  // Check if all compounds are in the same column (vertical pattern)
  const firstCol = compounds[0].col;
  const allSameCol = compounds.every(comp => comp.col === firstCol);
  
  if (allSameCol) {
    // Check if rows are sequential
    const rowIndices = compounds.map(comp => ROWS.indexOf(comp.row)).sort((a, b) => a - b);
    const isSequential = rowIndices.every((rowIdx, index) => 
      index === 0 || rowIdx === rowIndices[index - 1] + 1
    );
    
    if (isSequential) {
      const rows = compounds.map(comp => comp.row);
      return {
        isSequential: true,
        direction: 'vertical',
        col: firstCol,
        startRow: ROWS[Math.min(...rowIndices)],
        endRow: ROWS[Math.max(...rowIndices)],
        compounds: compounds
      };
    }
  }
  
  return { isSequential: false };
}

function extendCompoundsInRow(originalCompounds, parallelRow, pattern) {
  // Clear any existing assignments in the parallel row for the same columns
  for (let col = pattern.startCol; col <= pattern.endCol; col++) {
    wellRoles[parallelRow][col] = 'empty';
    wellCompounds[parallelRow][col] = '';
    wellConcentrations[parallelRow][col] = 0;
    wellDilutions[parallelRow][col] = 1.0;
  }
  
  // Duplicate each compound to the new row
  originalCompounds.forEach(compound => {
    wellRoles[parallelRow][compound.col] = 'unknown';
    wellCompounds[parallelRow][compound.col] = compound.compound;
    wellConcentrations[parallelRow][compound.col] = compound.concentration;
    wellDilutions[parallelRow][compound.col] = compound.dilution;
  });
  
  renderPlate();
  updateStatus(`Extended ${originalCompounds.length} compound concentrations from row ${pattern.row} to row ${parallelRow}`, 'complete');
}

function extendCompoundsInColumn(originalCompounds, parallelCol, pattern) {
  // Clear any existing assignments in the parallel column for the same rows
  const rowIndices = originalCompounds.map(comp => ROWS.indexOf(comp.row));
  const startRowIdx = Math.min(...rowIndices);
  const endRowIdx = Math.max(...rowIndices);
  
  for (let rowIdx = startRowIdx; rowIdx <= endRowIdx; rowIdx++) {
    const row = ROWS[rowIdx];
    wellRoles[row][parallelCol] = 'empty';
    wellCompounds[row][parallelCol] = '';
    wellConcentrations[row][parallelCol] = 0;
    wellDilutions[row][parallelCol] = 1.0;
  }
  
  // Duplicate each compound to the new column
  originalCompounds.forEach(compound => {
    wellRoles[compound.row][parallelCol] = 'unknown';
    wellCompounds[compound.row][parallelCol] = compound.compound;
    wellConcentrations[compound.row][parallelCol] = compound.concentration;
    wellDilutions[compound.row][parallelCol] = compound.dilution;
  });
  
  renderPlate();
  updateStatus(`Extended ${originalCompounds.length} compound concentrations from column ${pattern.col} to column ${parallelCol}`, 'complete');
}

function clearCompoundStart() {
  document.getElementById('compoundStartWell').value = '';
  updateStatus('Cleared compound starting well selection', 'info');
}

function assignDuplicateRow() {
  if (selectedWells.size === 0) {
    updateStatus('No wells selected for duplication', 'error');
    return;
  }
  
  // Find the most common row in selection
  const rowCounts = {};
  selectedWells.forEach(wellId => {
    const row = wellId[0];
    rowCounts[row] = (rowCounts[row] || 0) + 1;
  });
  
  const sourceRow = Object.keys(rowCounts).reduce((a, b) => rowCounts[a] > rowCounts[b] ? a : b);
  const targetRow = sourceRow === 'A' ? 'H' : 'A'; // Default A<->H pairing
  
  // Duplicate the row
  selectedWells.forEach(wellId => {
    if (wellId[0] === sourceRow) {
      const col = parseInt(wellId.slice(1));
      wellRoles[targetRow][col] = wellRoles[sourceRow][col];
      wellCompounds[targetRow][col] = wellCompounds[sourceRow][col];
      wellConcentrations[targetRow][col] = wellConcentrations[sourceRow][col];
      wellDilutions[targetRow][col] = wellDilutions[sourceRow][col];
    }
  });
  
  renderPlate();
  updateStatus(`Duplicated row ${sourceRow} to row ${targetRow}`, 'complete');
}

function assignDuplicateColumn() {
  if (selectedWells.size === 0) {
    updateStatus('No wells selected for duplication', 'error');
    return;
  }
  
  // Get unique columns from selection
  const columns = [...new Set(Array.from(selectedWells).map(wellId => parseInt(wellId.slice(1))))];
  if (columns.length < 2) {
    updateStatus('Select wells from at least 2 columns for duplication', 'error');
    return;
  }
  
  const sourceCol = Math.min(...columns);
  const targetCol = Math.max(...columns);
  
  // Duplicate the column
  for (let row of ROWS) {
    if (selectedWells.has(`${row}${sourceCol}`) || selectedWells.has(`${row}${targetCol}`)) {
      wellRoles[row][targetCol] = wellRoles[row][sourceCol];
      wellCompounds[row][targetCol] = wellCompounds[row][sourceCol];
      wellConcentrations[row][targetCol] = wellConcentrations[row][sourceCol];
      wellDilutions[row][targetCol] = wellDilutions[row][sourceCol];
    }
  }
  
  renderPlate();
  updateStatus(`Duplicated column ${sourceCol} to column ${targetCol}`, 'complete');
}

// Quick Preset Layouts
function applyPresetLayout(presetType) {
  clearAllWells();
  
  switch (presetType) {
    case 'A_H_Standards':
      applyDefaultMSDLayout(); // This is already A&H standards
      break;
      
    case 'Column_Standards':
      applyColumnStandardsLayout();
      break;
      
    case 'Row_Standards':
      applyRowStandardsLayout();
      break;
      
    case 'Custom_Layout':
      showCustomLayoutDialog();
      break;
  }
}

function applyColumnStandardsLayout() {
  const standardConcentrations = standardConcentrationsByCytokine[currentCytokine] || STANDARD_CONCENTRATIONS[CYTOKINES[currentCytokine]];
  
  // Standards in column 1 (top to bottom, high to low)
  for (let i = 0; i < 8; i++) {
    const row = ROWS[i];
    wellRoles[row][1] = 'standard';
    wellCompounds[row][1] = `Std ${i + 1}`;
    wellConcentrations[row][1] = standardConcentrations[i];
    wellDilutions[row][1] = 1.0;
  }
  
  renderPlate();
  updateStatus('Applied column standards layout (A1-H1)', 'complete');
}

function applyRowStandardsLayout() {
  const standardConcentrations = standardConcentrationsByCytokine[currentCytokine] || STANDARD_CONCENTRATIONS[CYTOKINES[currentCytokine]];
  
  // Standards in row A (left to right, high to low)
  for (let i = 0; i < 8; i++) {
    const col = i + 1;
    wellRoles['A'][col] = 'standard';
    wellCompounds['A'][col] = `Std ${i + 1}`;
    wellConcentrations['A'][col] = standardConcentrations[i];
    wellDilutions['A'][col] = 1.0;
  }
  
  renderPlate();
  updateStatus('Applied row standards layout (A1-A8)', 'complete');
}

function showCustomLayoutDialog() {
  // For now, just show a message - could be expanded to a full dialog
  updateStatus('Custom layout builder - coming soon! Use quick assignment tools for now.', 'info');
}

// Smart Selection Tools
function selectRow(rowLetter) {
  clearSelection();
  for (let col of COLS) {
    selectWell(rowLetter, col);
  }
  updateSelectionDisplay();
  updateStatus(`Selected row ${rowLetter} (${COLS.length} wells)`, 'complete');
}

function selectColumns2to9() {
  clearSelection();
  for (let col = 2; col <= 9; col++) {
    for (let row of ROWS) {
      selectWell(row, col);
    }
  }
  updateSelectionDisplay();
  updateStatus('Selected columns 2-9 (64 wells)', 'complete');
}

function selectAllStandards() {
  clearSelection();
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row][col] === 'standard') {
        selectWell(row, col);
      }
    }
  }
  updateSelectionDisplay();
  updateStatus(`Selected all standards (${selectedWells.size} wells)`, 'complete');
}

function selectAllUnknowns() {
  clearSelection();
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row][col] === 'unknown') {
        selectWell(row, col);
      }
    }
  }
  updateSelectionDisplay();
  updateStatus(`Selected all unknowns (${selectedWells.size} wells)`, 'complete');
}

function invertSelection() {
  const currentSelection = new Set(selectedWells);
  clearSelection();
  
  for (let row of ROWS) {
    for (let col of COLS) {
      const wellId = `${row}${col}`;
      if (!currentSelection.has(wellId)) {
        selectWell(row, col);
      }
    }
  }
  
  updateSelectionDisplay();
  updateStatus(`Inverted selection (${selectedWells.size} wells)`, 'complete');
}

// Essential Selection Functions
function selectWell(row, col) {
  const wellId = `${row}${col}`;
  selectedWells.add(wellId);
  const wellElement = document.querySelector(`[data-row="${row}"][data-col="${col}"]`);
  if (wellElement) {
    wellElement.classList.add('selected');
    // Force a reflow to ensure immediate visual update
    wellElement.offsetHeight;
  }
  
  // Auto-populate starting well fields if only one well is selected
  if (selectedWells.size === 1) {
    updateStartingWellFields(wellId);
  }
}

function updateStartingWellFields(wellId) {
  // Update standard starting well field
  const standardStartWell = document.getElementById('standardStartWell');
  if (standardStartWell) {
    standardStartWell.value = wellId;
  }
  
  // Update compound starting well field
  const compoundStartWell = document.getElementById('compoundStartWell');
  if (compoundStartWell) {
    compoundStartWell.value = wellId;
  }
}

function clearSelection() {
  // Use more efficient method to clear all selected wells
  document.querySelectorAll('.well.selected').forEach(el => {
    el.classList.remove('selected');
  });
  selectedWells.clear();
  
  // Clear starting well fields when no wells are selected
  const standardStartWell = document.getElementById('standardStartWell');
  const compoundStartWell = document.getElementById('compoundStartWell');
  if (standardStartWell) standardStartWell.value = '';
  if (compoundStartWell) compoundStartWell.value = '';
}

function updateSelectionDisplay() {
  // Update any selection display elements if they exist
  const selectionInfo = document.getElementById('selectionInfo');
  if (selectionInfo) {
    if (selectedWells.size === 0) {
      selectionInfo.style.display = 'none';
    } else {
      selectionInfo.style.display = 'block';
      selectionInfo.innerHTML = `<strong>${selectedWells.size}</strong> wells selected`;
      
      // Add well IDs for small selections
      if (selectedWells.size <= 8) {
        const wellIds = Array.from(selectedWells).sort().join(', ');
        selectionInfo.innerHTML += `<br><small style="opacity: 0.8;">${wellIds}</small>`;
      }
    }
  }
  
  // Auto-populate starting well fields when wells are selected
  updateStartingWellFields();
}

function updateStartingWellFields() {
  const standardStartWell = document.getElementById('standardStartWell');
  const compoundStartWell = document.getElementById('compoundStartWell');
  
  if (selectedWells.size === 0) {
    // Clear fields when no wells are selected
    if (standardStartWell) standardStartWell.value = '';
    if (compoundStartWell) compoundStartWell.value = '';
  } else if (selectedWells.size === 1) {
    // Single well selected - use it as starting well
    const selectedWell = Array.from(selectedWells)[0];
    if (standardStartWell) standardStartWell.value = selectedWell;
    if (compoundStartWell) compoundStartWell.value = selectedWell;
  } else {
    // Multiple wells selected - use the first one alphabetically as starting well
    const sortedWells = Array.from(selectedWells).sort();
    const firstWell = sortedWells[0];
    if (standardStartWell) standardStartWell.value = firstWell;
    if (compoundStartWell) compoundStartWell.value = firstWell;
  }
}

// ENHANCED Row/Column Concentration Functions
function generateConcentrationValues(pattern, params) {
  console.log('🧮 Generating concentration values:', pattern, params);
  
  switch (pattern) {
    case 'serial':
      return generateSerialDilution(params.start, params.factor, params.steps);
    case 'linear':
      return generateLinearProgression(params.start, params.end, params.steps);
    case 'logarithmic':
      return generateLogarithmicScale(params.min, params.max, params.steps);
    case 'custom':
      return parseCustomValues(params.values);
    case 'same':
      return Array(params.count || 1).fill(params.value);
    default:
      return [];
  }
}

function generateSerialDilution(start, factor, steps) {
  const values = [];
  for (let i = 0; i < steps; i++) {
    values.push(start / Math.pow(factor, i));
  }
  return values;
}

function generateLinearProgression(start, end, steps) {
  const values = [];
  const increment = (end - start) / (steps - 1);
  for (let i = 0; i < steps; i++) {
    values.push(start + (increment * i));
  }
  return values;
}

function generateLogarithmicScale(min, max, steps) {
  const values = [];
  const logMin = Math.log10(min);
  const logMax = Math.log10(max);
  const logIncrement = (logMax - logMin) / (steps - 1);
  
  for (let i = 0; i < steps; i++) {
    const logValue = logMin + (logIncrement * i);
    values.push(Math.pow(10, logValue));
  }
  return values;
}

function parseCustomValues(valuesString) {
  try {
    return valuesString.split(',').map(v => parseFloat(v.trim())).filter(v => !isNaN(v));
  } catch (error) {
    console.error('Error parsing custom values:', error);
    return [];
  }
}








// Enhanced Context Menu Functions
function handleContextMenuAction(event) {
  const action = event.target.dataset.action;
  if (!action || !contextMenuWell) {
    console.log('❌ Context menu action failed:', { action, contextMenuWell });
    return;
  }

  const row = contextMenuWell.row;
  const col = contextMenuWell.col;

  console.log(`🎯 Executing context menu action: ${action} on ${row}${col}`);
  
  // Hide context menu
  document.getElementById('contextMenu').style.display = 'none';

  switch (action) {
    case 'set-standard':
    case 'set-unknown':
    case 'set-control':
      const roleMap = {
        'set-standard': 'standard',
        'set-unknown': 'unknown',
        'set-control': 'control'
      };
      setWellRole(row, col, roleMap[action]);
      break;
    case 'set-empty':
      setWellRole(row, col, null);
      break;
      
    case 'serial-dilution-right':
    case 'serial-dilution-down':
    case 'serial-dilution-left':
    case 'serial-dilution-up':
      const direction = action.split('-')[2];
      // Temporarily select the well and start serial dilution
      clearSelection();
      selectWell(row, col);
      updateSelectionDisplay();
      document.getElementById('serialDirection').value = direction;
      document.getElementById('serialStartConc').focus();
      updateStatus(`Starting serial dilution from ${row}${col} going ${direction}`, 'info');
      break;
      
    case 'assign-compound-series':
      promptAssignCompoundSeries(row, col);
      break;
    case 'set-compound-name':
      promptSetCompoundName(row, col);
      break;
      
    case 'select-row':
      selectRow(row);
      break;
      
    case 'select-column':
      selectColumn(col);
      break;
      
    case 'select-neighbors':
      selectNeighbors(row, col);
      break;
      
    case 'copy-well':
      copyWellProperties(row, col);
      break;
      
    case 'paste-well':
      pasteWellProperties(row, col);
      break;
      
    case 'duplicate-to-selection':
      duplicateWellToSelection(row, col);
      break;
      
      
    case 'clear-well':
      clearWellData(row, col);
      break;

    // Assay Designer quick actions
    case 'designer-assign-compounds':
      applyCompoundDesigner();
      break;
    case 'designer-assign-standards':
      assignStandardsToSelected();
      break;
    case 'designer-set-blanks':
      setSelectedAsRole('blank');
      break;
    case 'designer-set-negative':
      setSelectedAsRole('control', 'Negative');
      break;
    case 'designer-set-positive':
      setSelectedAsRole('control', 'Positive');
      break;

    default:
      console.log(`⚠️ Unknown context menu action: ${action}`);
  }

  // Re-render plate after any action
  renderPlate();
}


function setWellConcentration(row, col, concentration) {
  wellConcentrations[row][col] = concentration;
  renderPlate();
  updateStatus(`Set ${row}${col} concentration to ${concentration} pg/mL`, 'complete');
}

function promptCustomConcentration(row, col) {
  const current = wellConcentrations[row][col] || '';
  const newConc = prompt(`Enter concentration for well ${row}${col} (pg/mL):`, current);
  if (newConc !== null && !isNaN(parseFloat(newConc))) {
    setWellConcentration(row, col, parseFloat(newConc));
  }
}

function promptSetCompoundName(row, col) {
  const current = wellCompounds[row][col] || '';
  const name = prompt(`Compound name for ${row}${col}:`, current);
  if (name !== null) {
    // Assign color to compound
    getCompoundColor(name);
    
    if (selectedWells.size > 0) {
      for (let wid of selectedWells) {
        const r = wid[0];
        const c = parseInt(wid.slice(1));
        wellCompounds[r][c] = name;
      }
      updateStatus(`Set compound name '${name}' on ${selectedWells.size} wells`, 'complete');
    } else {
      wellCompounds[row][col] = name;
      updateStatus(`Set compound name '${name}' on ${row}${col}`, 'complete');
    }
    renderPlate();
  }
}

function promptAssignCompoundSeries(row, col) {
  // Use selection if present; otherwise start from clicked well
  const targets = selectedWells.size ? Array.from(selectedWells) : [`${row}${col}`];
  const dir = prompt('Direction (rightToLeft,leftToRight,topToBottom,bottomToTop):', 'rightToLeft') || 'rightToLeft';
  const name = prompt('Compound name:', 'Compound A') || 'Compound A';
  const start = parseFloat(prompt('Start concentration:', '1000')) || 1000;
  const dil = parseFloat(prompt('Dilution factor:', '10')) || 10;
  const steps = parseInt(prompt('Number of doses:', '6')) || 6;
  const reps = parseInt(prompt('Replicates per dose (1-3):', '2')) || 2;
  
  // Assign color to compound
  getCompoundColor(name);
  
  const sorted = sortWellsByDirection(targets, dir);
  const doses = Array.from({length: steps}, (_,i)=> start / Math.pow(dil, i));
  let idx = 0;
  outer: for (let d of doses) {
    for (let r = 0; r < reps; r++) {
      if (idx >= sorted.length) break outer;
      const wid = sorted[idx++];
      const R = wid[0];
      const C = parseInt(wid.slice(1));
      wellRoles[R][C] = 'unknown';
      wellCompounds[R][C] = name;
      wellConcentrations[R][C] = d;
      wellDilutions[R][C] = 1.0;
    }
  }
  renderPlate();
  updateStatus(`Assigned series '${name}' (${steps}×, reps ${reps})`, 'complete');
}

function startSerialDilutionFromContext(row, col, direction) {
  // Auto-fill serial dilution form and select the well
  clearSelection();
  selectWell(row, col);
  
  document.getElementById('serialDirection').value = direction;
  document.getElementById('serialStartConc').focus();
  
  updateStatus(`Starting serial dilution from ${row}${col} going ${direction}`, 'info');
}

function selectColumn(col) {
  clearSelection();
  for (let row of ROWS) {
    selectWell(row, col);
  }
  updateSelectionDisplay();
  updateStatus(`Selected column ${col}`, 'complete');
}

function selectNeighbors(centerRow, centerCol) {
  clearSelection();
  const centerRowIdx = ROWS.indexOf(centerRow);
  
  for (let rowOffset = -1; rowOffset <= 1; rowOffset++) {
    for (let colOffset = -1; colOffset <= 1; colOffset++) {
      const newRowIdx = centerRowIdx + rowOffset;
      const newCol = centerCol + colOffset;
      
      if (newRowIdx >= 0 && newRowIdx < ROWS.length && newCol >= 1 && newCol <= 12) {
        selectWell(ROWS[newRowIdx], newCol);
      }
    }
  }
  
  updateSelectionDisplay();
  updateStatus(`Selected 3x3 area around ${centerRow}${centerCol}`, 'complete');
}



function copyWellProperties(row, col) {
  copiedWellData = {
    role: wellRoles[row][col],
    compound: wellCompounds[row][col],
    concentration: wellConcentrations[row][col],
    dilution: wellDilutions[row][col]
  };
  updateStatus(`Copied properties from ${row}${col}`, 'complete');
}

function pasteWellProperties(row, col) {
  if (!copiedWellData) {
    updateStatus('No well properties copied', 'error');
    return;
  }
  
  wellRoles[row][col] = copiedWellData.role;
  wellCompounds[row][col] = copiedWellData.compound;
  wellConcentrations[row][col] = copiedWellData.concentration;
  wellDilutions[row][col] = copiedWellData.dilution;
  
  renderPlate();
  updateStatus(`Pasted properties to ${row}${col}`, 'complete');
}

function duplicateWellToSelection(row, col) {
  if (selectedWells.size === 0) {
    updateStatus('No wells selected for duplication', 'error');
    return;
  }
  
  const sourceData = {
    role: wellRoles[row][col],
    compound: wellCompounds[row][col],
    concentration: wellConcentrations[row][col],
    dilution: wellDilutions[row][col]
  };
  
  selectedWells.forEach(wellId => {
    const targetRow = wellId[0];
    const targetCol = parseInt(wellId.slice(1));
    
    wellRoles[targetRow][targetCol] = sourceData.role;
    wellCompounds[targetRow][targetCol] = sourceData.compound;
    wellConcentrations[targetRow][targetCol] = sourceData.concentration;
    wellDilutions[targetRow][targetCol] = sourceData.dilution;
  });
  
  renderPlate();
  updateStatus(`Duplicated ${row}${col} to ${selectedWells.size} wells`, 'complete');
}

function viewWellData(row, col) {
  const signals = (plateData[row] && plateData[row][col]) ? plateData[row][col] : Array(10).fill(null);
  let dataText = `Well ${row}${col} - All Signals:\n`;
  
  signals.forEach((signal, index) => {
    dataText += `${CYTOKINES[index]}: ${signal !== null ? signal.toFixed(0) : 'No data'}\n`;
  });
  
  alert(dataText);
}

function plotWellData(row, col) {
  updateStatus(`Plotting well ${row}${col} - feature coming soon!`, 'info');
}

function clearWellData(row, col) {
  wellRoles[row][col] = null;
  wellCompounds[row][col] = null;
  wellConcentrations[row][col] = null;
  wellDilutions[row][col] = 1.0;
  
  renderPlate();
  updateStatus(`Cleared well ${row}${col}`, 'complete');
}

// Advanced MSD Analyzer Functions

// Multi-Cytokine Analysis
function runAllCytokinesAnalysis() {
  updateStatus('Running analysis for all cytokines...', 'processing');
  
  try {
    const results = {};
    const failedCytokines = [];
    
    for (let i = 0; i < CYTOKINES.length; i++) {
      try {
        currentCytokine = i;
        const standards = collectStandardData(i);
        
        if (standards.length < 3) {
          failedCytokines.push(`${CYTOKINES[i]} (insufficient standards: ${standards.length})`);
          continue;
        }
        
        const method = document.getElementById('analysisMethod').value || 'fit4pl';
        let predictor, curveQuality = {};
        
        if (method === 'fit4pl') {
          const standardPairs = standards.map(s => [s.concentration, s.signal]);
          predictor = Predictor.fromFit4PL(standardPairs);
          
          const signals = standards.map(s => s.signal);
          const predicted = standards.map(s => predictor.model.f(s.concentration));
          curveQuality.r2 = AnalysisEngine.calculateR2(signals, predicted).toFixed(4);
          curveQuality.method = '4PL Curve Fit';
        } else {
          const interpPairs = standards.map(s => [s.signal, s.concentration]);
          predictor = Predictor.fromInterpPairs(interpPairs);
          curveQuality.method = 'Log-Log Interpolation';
          curveQuality.r2 = 'N/A';
        }
        
        results[i] = {
          cytokine: CYTOKINES[i],
          standards: standards.length,
          r2: curveQuality.r2,
          method: curveQuality.method,
          predictor: predictor
        };
        
      } catch (error) {
        failedCytokines.push(`${CYTOKINES[i]} (${error.message})`);
      }
    }
    
    // Display summary
    let summary = `Analysis completed for ${Object.keys(results).length}/${CYTOKINES.length} cytokines\n\n`;
    
    Object.values(results).forEach(result => {
      summary += `${result.cytokine}: R² = ${result.r2}, Standards = ${result.standards}\n`;
    });
    
    if (failedCytokines.length > 0) {
      summary += `\nFailed: ${failedCytokines.join(', ')}`;
    }
    
    alert(summary);
    updateStatus(`Multi-cytokine analysis complete: ${Object.keys(results).length} successful`, 'complete');
    
  } catch (error) {
    updateStatus(`Multi-cytokine analysis failed: ${error.message}`, 'error');
  }
}

// Standards Validation
function validateStandards() {
  updateStatus('Validating standards...', 'processing');
  
  try {
    const minR2 = parseFloat(document.getElementById('minR2').value) || 0.95;
    const maxCV = parseFloat(document.getElementById('maxCV').value) || 20;
    
    const validation = {};
    let totalPassed = 0;
    
    for (let i = 0; i < CYTOKINES.length; i++) {
      const tempCurrent = currentCytokine;
      currentCytokine = i;
      
      const standards = collectStandardData(i);
      
      if (standards.length < 3) {
        validation[CYTOKINES[i]] = {
          status: 'FAIL',
          reason: `Insufficient standards (${standards.length}/8)`,
          r2: 'N/A',
          cv: 'N/A'
        };
        continue;
      }
      
      try {
        // Calculate R²
        const standardPairs = standards.map(s => [s.concentration, s.signal]);
        const predictor = Predictor.fromFit4PL(standardPairs);
        const signals = standards.map(s => s.signal);
        const predicted = standards.map(s => predictor.model.f(s.concentration));
        const r2 = AnalysisEngine.calculateR2(signals, predicted);
        
        // Calculate CV% for duplicates (if any)
        const cv = calculateStandardCV(standards);
        
        const passedR2 = r2 >= minR2;
        const passedCV = cv <= maxCV;
        
        validation[CYTOKINES[i]] = {
          status: (passedR2 && passedCV) ? 'PASS' : 'FAIL',
          reason: (!passedR2 ? `R² too low (${r2.toFixed(4)})` : '') + 
                  (!passedCV ? ` CV% too high (${cv.toFixed(1)}%)` : ''),
          r2: r2.toFixed(4),
          cv: cv.toFixed(1) + '%'
        };
        
        if (passedR2 && passedCV) totalPassed++;
        
      } catch (error) {
        validation[CYTOKINES[i]] = {
          status: 'ERROR',
          reason: error.message,
          r2: 'Error',
          cv: 'Error'
        };
      }
      
      currentCytokine = tempCurrent;
    }
    
    // Display validation results
    let report = `Standards Validation Report\n`;
    report += `Criteria: R² ≥ ${minR2}, CV% ≤ ${maxCV}%\n`;
    report += `Passed: ${totalPassed}/${CYTOKINES.length} cytokines\n\n`;
    
    Object.entries(validation).forEach(([cytokine, result]) => {
      report += `${cytokine}: ${result.status} (R²=${result.r2}, CV=${result.cv})\n`;
      if (result.status !== 'PASS') {
        report += `  → ${result.reason}\n`;
      }
    });
    
    alert(report);
    updateStatus(`Standards validation complete: ${totalPassed}/${CYTOKINES.length} passed`, 'complete');
    
  } catch (error) {
    updateStatus(`Standards validation failed: ${error.message}`, 'error');
  }
}

function calculateStandardCV(standards) {
  // Group standards by concentration to find duplicates
  const groups = {};
  standards.forEach(std => {
    const conc = std.concentration;
    if (!groups[conc]) groups[conc] = [];
    groups[conc].push(std.signal);
  });
  
  let totalCV = 0;
  let groupCount = 0;
  
  Object.values(groups).forEach(signals => {
    if (signals.length > 1) {
      const mean = signals.reduce((a, b) => a + b) / signals.length;
      const variance = signals.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / (signals.length - 1);
      const cv = Math.sqrt(variance) / mean * 100;
      totalCV += cv;
      groupCount++;
    }
  });
  
  return groupCount > 0 ? totalCV / groupCount : 0;
}

// Statistical Analysis
function calculateStatistics() {
  updateStatus('Calculating statistics...', 'processing');
  
  try {
    const stats = {
      standards: {},
      unknowns: {},
      controls: {}
    };
    
    // Collect data by role
    for (let row of ROWS) {
      for (let col of COLS) {
        const role = wellRoles[row][col];
        const signal = getWellSignal(row, col, currentCytokine);
        const conc = wellConcentrations[row][col];
        
        if (signal !== null && role) {
          if (!stats[role]) stats[role] = [];
          stats[role].push({ well: `${row}${col}`, signal, conc });
        }
      }
    }
    
    // Calculate statistics for each group
    let report = `Statistical Analysis - ${CYTOKINES[currentCytokine]}\n\n`;
    
    Object.entries(stats).forEach(([role, data]) => {
      if (data.length === 0) return;
      
      const signals = data.map(d => d.signal);
      const mean = signals.reduce((a, b) => a + b) / signals.length;
      const variance = signals.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / (signals.length - 1);
      const std = Math.sqrt(variance);
      const cv = (std / mean) * 100;
      const min = Math.min(...signals);
      const max = Math.max(...signals);
      
      report += `${role.toUpperCase()} (n=${data.length}):\n`;
      report += `  Mean: ${mean.toFixed(0)} ± ${std.toFixed(0)}\n`;
      report += `  CV%: ${cv.toFixed(1)}%\n`;
      report += `  Range: ${min.toFixed(0)} - ${max.toFixed(0)}\n\n`;
    });
    
    alert(report);
    updateStatus('Statistics calculated successfully', 'complete');
    
  } catch (error) {
    updateStatus(`Statistics calculation failed: ${error.message}`, 'error');
  }
}

// Placeholder functions for advanced features
function detectOutliers() {
  try {
    if (!plateData || Object.keys(plateData).length === 0) {
      updateStatus('No data available for outlier detection', 'error');
      return;
    }

    const outliers = [];
    const cytokine = CYTOKINES[currentCytokine];
    
    // Collect all values for current cytokine
    const allValues = [];
    for (let row of ROWS) {
      for (let col of COLS) {
        const signal = getWellSignal(row, col, currentCytokine);
        if (signal !== null) {
          allValues.push({
            well: `${row}${col}`,
            value: signal,
            role: wellRoles[row][col] || 'unknown'
          });
        }
      }
    }

    if (allValues.length < 3) {
      updateStatus('Insufficient data for outlier detection', 'warning');
      return;
    }

    // Calculate Q1, Q3, and IQR
    const sortedValues = allValues.map(item => item.value).sort((a, b) => a - b);
    const q1Index = Math.floor(sortedValues.length * 0.25);
    const q3Index = Math.floor(sortedValues.length * 0.75);
    const q1 = sortedValues[q1Index];
    const q3 = sortedValues[q3Index];
    const iqr = q3 - q1;
    const lowerBound = q1 - 1.5 * iqr;
    const upperBound = q3 + 1.5 * iqr;

    // Find outliers
    allValues.forEach(item => {
      if (item.value < lowerBound || item.value > upperBound) {
        outliers.push({
          well: item.well,
          value: item.value,
          role: item.role,
          type: item.value < lowerBound ? 'low' : 'high'
        });
      }
    });

    if (outliers.length === 0) {
      updateStatus(`No outliers detected for ${cytokine}`, 'success');
    } else {
      const outlierList = outliers.map(o => `${o.well} (${o.value.toFixed(2)}, ${o.type})`).join(', ');
      updateStatus(`Found ${outliers.length} outliers for ${cytokine}: ${outlierList}`, 'warning');
      
      // Highlight outliers on plate
      clearSelection();
      outliers.forEach(outlier => {
        const [row, col] = [outlier.well[0], parseInt(outlier.well.slice(1))];
        selectWell(row, col, true);
      });
    }
  } catch (error) {
    updateStatus(`Outlier detection failed: ${error.message}`, 'error');
  }
}

