}

function closeSelectionHelp() {
  const modal = document.getElementById('selectionHelpModal');
  if (modal) {
    modal.remove();
  }
}

// Hide context menu when clicking elsewhere
document.addEventListener('click', (event) => {
  if (!event.target.closest('.context-menu')) {
    document.getElementById('contextMenu').style.display = 'none';
  }
});

// Smooth Well Selection System
let isMouseDown = false;
// isDragging already declared above in Excel-like selection system
let dragStartWell = null;
let dragStartPos = null;
let lastHoveredWell = null;

function initializeDragSelection() {
  console.log('🚀 Initializing drag selection system...');
  const plateElement = document.getElementById('plate');

  if (!plateElement) {
    console.error('❌ Plate element not found!');
    return;
  }
  
  // Mouse down on well
  plateElement.addEventListener('mousedown', (event) => {
    if (!event.target.classList.contains('well')) return;
    
    event.preventDefault();
    isMouseDown = true;
    isDragging = false;
    dragStartWell = {
      row: event.target.dataset.row,
      col: parseInt(event.target.dataset.col),
      element: event.target
    };
    
    dragStartPos = {
      x: event.pageX,
      y: event.pageY
    };

    // Don't handle click selection immediately - wait to see if it's a drag
    console.log('🖱️ Mouse down on well:', dragStartWell.row + dragStartWell.col);
  });
  
  // Mouse move - handle drag marquee
  document.addEventListener('mousemove', (event) => {
    if (!isMouseDown || !dragStartPos) return;

    const dx = Math.abs(event.pageX - dragStartPos.x);
    const dy = Math.abs(event.pageY - dragStartPos.y);

    if (!isDragging && (dx > 5 || dy > 5)) {
      // Start dragging - clear previous selection if not multi-select
      isDragging = true;
      console.log('🔄 Starting drag selection');
      
      if (!event.ctrlKey && !event.metaKey && !event.shiftKey) {
        clearSelection();
      }
    }

    if (isDragging) {
      const currentPos = {
        x: event.pageX,
        y: event.pageY
      };

      // Update lasso visual
      const left = Math.min(dragStartPos.x, currentPos.x);
      const top = Math.min(dragStartPos.y, currentPos.y);
      const width = Math.abs(currentPos.x - dragStartPos.x);
      const height = Math.abs(currentPos.y - dragStartPos.y);

      const lassoElement = document.getElementById('lasso');
      lassoElement.style.display = 'block';
      lassoElement.style.left = left + 'px';
      lassoElement.style.top = top + 'px';
      lassoElement.style.width = width + 'px';
      lassoElement.style.height = height + 'px';

      // Select wells within lasso
      if (!event.ctrlKey && !event.metaKey && !event.shiftKey) {
      clearSelection();
      }
      
      const wells = document.querySelectorAll('.well');
      wells.forEach(well => {
        const wellRect = well.getBoundingClientRect();
        const wellCenterX = wellRect.left + wellRect.width / 2;
        const wellCenterY = wellRect.top + wellRect.height / 2;

        if (wellCenterX >= left && wellCenterX <= left + width &&
            wellCenterY >= top && wellCenterY <= top + height) {
          const row = well.dataset.row;
          const col = parseInt(well.dataset.col);
          
          // Add drag highlight class for visual feedback
          well.classList.add('drag-highlight');
          
          if (event.ctrlKey || event.metaKey) {
            // Toggle selection during drag
            toggleWellSelection(row, col);
          } else {
        selectWell(row, col);
          }
        } else {
          // Remove drag highlight from wells outside selection
          well.classList.remove('drag-highlight');
        }
      });
        updateSelectionDisplay();
    }
  });
  
  // Mouse up - finalize selection
  document.addEventListener('mouseup', (event) => {
    if (!isMouseDown) return;
    
    // Hide lasso
    const lassoElement = document.getElementById('lasso');
    lassoElement.style.display = 'none';
    
    // Remove all drag highlights
    document.querySelectorAll('.well.drag-highlight').forEach(well => {
      well.classList.remove('drag-highlight');
    });
    
    // If it wasn't a drag, handle as a click
    if (!isDragging && dragStartWell) {
      console.log('🖱️ Handling as click (not drag)');
      
      if (event.ctrlKey || event.metaKey) {
        // Ctrl+Click: toggle selection
        toggleWellSelection(dragStartWell.row, dragStartWell.col);
      } else if (event.shiftKey && selectedWells.size > 0) {
        // Shift+Click: range selection
        selectWellRange(dragStartWell.row, dragStartWell.col);
      } else {
        // Normal click: single selection
        clearSelection();
        selectWell(dragStartWell.row, dragStartWell.col);
      }
      updateSelectionDisplay();
    }
    
    // Reset state
    isMouseDown = false;
    isDragging = false;
    dragStartWell = null;
    dragStartPos = null;
  });
  
  
  // Prevent context menu during drag
  plateElement.addEventListener('contextmenu', (event) => {
    if (isDragging) {
      event.preventDefault();
      return false;
    }
  });
}

function parseRawData() {
  const rawData = document.getElementById('rawData').value.trim();
  if (!rawData) {
    updateStatus('No data to parse', 'error');
    return;
  }

  try {
    // Find the data section
    const dataStart = rawData.indexOf('==========Data');
    if (dataStart === -1) {
      throw new Error('Data section not found');
    }

    // Find the end of data section
    let dataEnd = rawData.indexOf('==========Processing');
    if (dataEnd === -1) dataEnd = rawData.indexOf('==========Statistics');
    if (dataEnd === -1) dataEnd = rawData.length;

    const dataSection = rawData.slice(dataStart, dataEnd);
    const lines = dataSection.split('\n');
    
    // Initialize plate data
    for (let row of ROWS) {
      for (let col of COLS) {
        plateData[row][col] = Array(10).fill(null);
      }
    }

    let foundHeader = false;
    let dataLines = [];
    
    // First, collect all data lines
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i].trim();
      
      // Skip empty lines and separator lines
      if (!line || line.startsWith('==========')) continue;
      
      // Find column header line (contains numbers 1-12)
      if (!foundHeader && line.includes('1') && line.includes('12')) {
        foundHeader = true;
        continue;
      }
      
      if (!foundHeader) continue;

      // Check if this line starts with a row letter (A, B, C, etc.) or is just data
      const rowMatch = line.match(/^([A-H])\s+(.+)$/);
      if (rowMatch) {
        // Line starts with row letter - extract data part
        dataLines.push({
          rowLetter: rowMatch[1],
          data: rowMatch[2]
        });
      } else if (/^\s*\d/.test(line)) {
        // Line starts with numbers (continuation data)
        dataLines.push({
          rowLetter: null,
          data: line
        });
      }
    }

    // Now parse the data lines in blocks of 10 per row
    let lineIndex = 0;
    for (let rowIdx = 0; rowIdx < ROWS.length && lineIndex < dataLines.length; rowIdx++) {
      const rowLetter = ROWS[rowIdx];
      
      // Process 10 spots for this row
      for (let spot = 0; spot < 10 && lineIndex < dataLines.length; spot++) {
        const lineData = dataLines[lineIndex];
        
        // Parse the values from this line
        const values = lineData.data.split(/\s+/).map(v => parseFloat(v)).filter(v => !isNaN(v));
        
        if (values.length >= 12) {
          for (let col = 0; col < 12; col++) {
            if (values[col] !== undefined) {
              plateData[rowLetter][col + 1][spot] = values[col];
            }
          }
        }
        
        lineIndex++;
      }
    }
    
    // Verify we got data and log some sample values for debugging
    let dataCount = 0;
    for (let row of ROWS) {
      for (let col of COLS) {
        for (let spot = 0; spot < 10; spot++) {
          if (plateData[row][col][spot] !== null) {
            dataCount++;
          }
        }
      }
    }
    
    // Log some specific values to verify correct parsing
    console.log('Sample parsed values:');
    console.log('A12 spot 1:', plateData['A'][12][0]); // Should be 23692
    console.log('A12 spot 2:', plateData['A'][12][1]); // Should be 119108
    console.log('A10 spot 1:', plateData['A'][10][0]); // Should be 20602
    console.log('B12 spot 1:', plateData['B'][12][0]); // Should be 151
    
    if (dataCount === 0) {
      throw new Error('No data was parsed. Please check the file format.');
    }
    
    renderPlate();
    updateStatus(`Data parsed successfully (${dataCount} data points) - Applying default layout...`, 'processing');
    console.log(`Parsed ${dataCount} data points from MSD file`);
    
    // Apply default layout first, then run automatic analysis
    setTimeout(() => {
      // Apply the default MSD layout
      applyDefaultMSDLayout();
      updateStatus('Default layout applied - Running automatic analysis...', 'processing');
      
      // Then run automatic analysis and plotting
      setTimeout(() => {
        runAutomaticAnalysisAndPlotting();
      }, 300);
    }, 200); // Small delay to ensure UI updates
    
  } catch (error) {
    updateStatus('Error parsing data: ' + error.message, 'error');
    console.error('Parsing error:', error);
  }
}

function handleFileUpload(e) {
  const file = e.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(event) {
    document.getElementById('rawData').value = event.target.result;
    parseRawData();
  };
  reader.readAsText(file);
}

// Excel Import/Export Functions
function handleExcelImport(e) {
  const file = e.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(event) {
    try {
      const data = new Uint8Array(event.target.result);
      const workbook = XLSX.read(data, { type: 'array' });
      
      // Import cytokines first
      if (workbook.Sheets['Cytokines']) {
        importCytokines(workbook.Sheets['Cytokines']);
      }
      
      // Find all plates in all sheets
      let platesFound = [];
      for (let sheetName of workbook.SheetNames) {
        const sheet = workbook.Sheets[sheetName];
        const plates = findPlates(sheet);
        platesFound = platesFound.concat(plates.map(p => ({ ...p, sheetName })));
      }
      
      if (platesFound.length === 0) {
        updateStatus('No "Plate" labels found in Excel file', 'error');
    return;
  }

      // Import the first plate (or let user choose if multiple)
      if (platesFound.length === 1) {
        const plateInfo = platesFound[0];
        const sheet = workbook.Sheets[plateInfo.sheetName];
        importPlateFromSheet(sheet, plateInfo);
        updateStatus(`Imported plate: ${plateInfo.plateName}`, 'complete');
      } else {
        // Multiple plates found - import the first one and show info
        const plateInfo = platesFound[0];
        const sheet = workbook.Sheets[plateInfo.sheetName];
        importPlateFromSheet(sheet, plateInfo);
        updateStatus(`Imported plate: ${plateInfo.plateName} (${platesFound.length} plates found)`, 'complete');
  }

  renderPlate();
      
    } catch (error) {
      console.error('Excel import error:', error);
      updateStatus('Error importing Excel file: ' + error.message, 'error');
    }
  };
  reader.readAsArrayBuffer(file);
}

// Utility functions for Excel parsing (following Plate Interpreter rules exactly)
const isStr = v => typeof v === "string" && v.trim().length > 0;
const isNum = v => v != null && v !== "" && !isNaN(+String(v).trim());

function rcToA1(r, c) { // 1-based
  let s = "";
  while (c > 0) {
    let m = (c - 1) % 26;
    s = String.fromCharCode(65 + m) + s;
    c = Math.floor((c - 1) / 26);
  }
  return s + r;
}

function getCell(ws, r, c) {
  const a = rcToA1(r, c);
  return ws[a]?.v ?? null;
}

function startsWithLetter(s) {
  return /^[A-Za-z]/.test(s);
}

function firstNumberPrefix(s) {
  const m = s.match(/^\s*([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)/);
  return m ? parseFloat(m[1]) : null;
}

// In-well override parser (exact Plate Interpreter logic):
// - starts with letter => name only; if "name/123" then 123 is conc
// - starts with number => number is conc; trailing letters are compound name
function parseIncellStrict(raw) {
  if (!isStr(raw)) return { conc: null, name: null };
  const s = raw.trim();
  
  if (startsWithLetter(s)) {
    if (s.includes("/")) {
      const [left, ...rest] = s.split("/");
      const right = rest.join("/").trim();
      if (isNum(right)) return { conc: +right, name: left.trim() };
      if (isNum(left)) return { conc: +left, name: right || null };
    }
    return { conc: null, name: s };
  }
  
  const n = firstNumberPrefix(s);
  if (n != null) {
    const tail = s.slice(String(n).length).replace(/^[\s:|,;-]+/, "").trim();
    const name = /[A-Za-z]/.test(tail) ? tail : null;
    return { conc: n, name };
  }
  
  return { conc: null, name: s };
}

// Headers from exact merged spans (no forward-fill)
function buildHeaders(ws, topLeftR, topLeftC) {
  const topR = topLeftR - 1, leftC = topLeftC - 1;
  const top = Array(12).fill(null), left = Array(8).fill(null);
  const merges = ws["!merges"] || [];

  // top merged spans
  merges.forEach(m => {
    const sr = m.s.r + 1, er = m.e.r + 1, sc = m.s.c + 1, ec = m.e.c + 1;
    if (sr === er && sr === topR) {
      for (let j = 0; j < 12; j++) {
        const col = topLeftC + j;
        if (sc <= col && col <= ec) {
          const v = getCell(ws, topR, sc);
          if (isStr(v) || isNum(v)) top[j] = v;
        }
      }
    }
  });
  
  // top singles
  for (let j = 0; j < 12; j++) {
    if (top[j] == null) {
      const v = getCell(ws, topR, topLeftC + j);
      if (isStr(v) || isNum(v)) top[j] = v;
    }
  }
  
  // left merged spans
  merges.forEach(m => {
    const sr = m.s.r + 1, er = m.e.r + 1, sc = m.s.c + 1, ec = m.e.c + 1;
    if (sc === ec && sc === leftC) {
      for (let i = 0; i < 8; i++) {
        const row = topLeftR + i;
        if (sr <= row && row <= er) {
          const v = getCell(ws, sr, leftC);
          if (isStr(v) || isNum(v)) left[i] = v;
        }
      }
    }
  });
  
  // left singles
  for (let i = 0; i < 8; i++) {
    if (left[i] == null) {
      const v = getCell(ws, topLeftR + i, leftC);
      if (isStr(v) || isNum(v)) left[i] = v;
    }
  }

  const topNum = top.filter(isNum).length;
  const leftNum = left.filter(isNum).length;
  return { top, left, columnsAreConcs: topNum > leftNum };
}

// Find all plates: any cell starting with "Plate" (case-insensitive)
function findPlates(ws) {
  const plates = [];
  const ref = XLSX.utils.decode_range(ws["!ref"]);
  for (let R = ref.s.r; R <= ref.e.r; R++) {
    for (let C = ref.s.c; C <= ref.e.c; C++) {
      const addr = XLSX.utils.encode_cell({ r: R, c: C });
      const v = ws[addr]?.v;
      if (isStr(v) && /^plate\b/i.test(v.trim())) {
        const plateName = String(v).trim();
        plates.push({ plateName, anchorR: R + 2, anchorC: C + 2 });
      }
    }
  }
  return plates;
}

function importCytokines(sheet) {
  const data = XLSX.utils.sheet_to_json(sheet, { header: 1 });
  const cytokines = [];
  const concentrations = [];
  const dilutionFactors = [];
  
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] && data[i][1]) {
      cytokines.push(data[i][0]);
      concentrations.push(parseFloat(data[i][1]) || 0);
      dilutionFactors.push(parseFloat(data[i][2]) || 4); // Default to 4 if not provided
    }
  }
  
  if (cytokines.length > 0) {
    CYTOKINES = cytokines;
    STANDARD_CONCENTRATIONS = {};
    DILUTION_FACTORS = {};
    cytokines.forEach((cytokine, index) => {
      const maxConc = concentrations[index];
      const dilutionFactor = dilutionFactors[index];
      const numDilutions = 8; // Default number of dilutions
      STANDARD_CONCENTRATIONS[cytokine] = calculateStandardConcentrations(maxConc, dilutionFactor, numDilutions);
      DILUTION_FACTORS[cytokine] = dilutionFactor;
    });
    
    // Populate excelData for the cytokine setup modal
    excelData = [];
    cytokines.forEach((cytokine, index) => {
      excelData[index] = {
        spot: index + 1,
        cytokine: cytokine,
        maxConc: concentrations[index].toString(),
        dilutionFactor: dilutionFactors[index].toString(),
        standards: STANDARD_CONCENTRATIONS[cytokine].join(', ')
      };
    });
    
    // Update the UI to reflect the loaded cytokines
    populateCytokineSelect();
    populateResultsCytokineSelect();
    updateStatus(`Imported ${cytokines.length} cytokines: ${cytokines.join(', ')}`, 'complete');
    console.log('Imported cytokines:', cytokines);
    console.log('Standard concentrations:', STANDARD_CONCENTRATIONS);
    console.log('Dilution factors:', DILUTION_FACTORS);
  } else {
    updateStatus('No valid cytokines found in Excel file', 'error');
  }
}

// Interpret a plate (exact Plate Interpreter logic)
function interpretPlate(ws, plateName, anchorR, anchorC) {
  const { top, left, columnsAreConcs } = buildHeaders(ws, anchorR, anchorC);
  const wells = [];

  for (let i = 0; i < 8; i++) {
    for (let j = 0; j < 12; j++) {
      const r = anchorR + i, c = anchorC + j;
      let name = null, conc = null;

      if (columnsAreConcs) {
        if (isNum(top[j])) conc = +top[j];
        if (isStr(left[i])) name = String(left[i]).trim();
      } else {
        if (isStr(top[j])) name = String(top[j]).trim();
        if (isNum(left[i])) conc = +left[i];
      }

      const raw = getCell(ws, r, c);
      if (isStr(raw)) {
        const { conc: oc, name: on } = parseIncellStrict(raw);
        if (oc != null) conc = oc;
        if (on != null) name = on;
      } else if (isNum(raw)) {
        conc = +raw;
      }

      if (name && name.trim().toLowerCase() === "com/con") continue; // exclude
      const low = (name || "").trim().toLowerCase();
      
      // Enhanced standard recognition - extract standard number
      let stdNumber = null;
      let isStd = false;
      
      if (low === "std" || low === "standard") {
        isStd = true;
        stdNumber = 1; // Default to std1 if no number specified
      } else if (low.startsWith("std ") || /^std\d+$/i.test(low)) {
        isStd = true;
        const match = low.match(/std\s*(\d+)/i);
        stdNumber = match ? parseInt(match[1]) : 1;
      } else if (low.startsWith("standard ") || /^standard\d+$/i.test(low)) {
        isStd = true;
        const match = low.match(/standard\s*(\d+)/i);
        stdNumber = match ? parseInt(match[1]) : 1;
      }
      
      const isCtrl = low === "control" || low === "ctrl" || low.startsWith("ctrl ");

      const keep = (name && conc != null) || isStd || isCtrl;
      if (keep) {
        const wellData = { row: i, col: j, name, conc, kind: isCtrl ? "control" : (isStd ? "standard" : "assay") };
        if (isStd && stdNumber) {
          wellData.stdNumber = stdNumber;
        }
        wells.push(wellData);
      }
    }
  }

  // Merged controls on H row (replicate across span)
  const merges = ws["!merges"] || [];
  const hR = anchorR + 7;
  merges.forEach(m => {
    const sr = m.s.r + 1, er = m.e.r + 1, sc = m.s.c + 1, ec = m.e.c + 1;
    if (sr === er && sr === hR) {
      const label = getCell(ws, sr, sc);
      if (isStr(label)) {
        for (let col = anchorC; col < anchorC + 12; col++) {
          if (sc <= col && col <= ec) {
            const j = col - anchorC;
            const hit = wells.find(w => w.row === 7 && w.col === j);
            if (hit) {
              hit.name = String(label).trim();
              hit.kind = "control";
              if (hit.conc === undefined) hit.conc = null;
            } else {
              wells.push({ row: 7, col: j, name: String(label).trim(), conc: null, kind: "control" });
            }
          }
        }
      }
    }
  });

  return { plateName, wells };
}

function importPlateFromSheet(ws, plateInfo) {
  // Initialize plate data structure
  initializePlateData();
  
  // Interpret the plate using exact Plate Interpreter logic
  const interpreted = interpretPlate(ws, plateInfo.plateName, plateInfo.anchorR, plateInfo.anchorC);
  
  // Convert to our internal format
  console.log('📥 Importing plate data...');
  console.log('Interpreted wells:', interpreted.wells.length);
  
  // Separate wells by type
  const standards = interpreted.wells.filter(well => well.kind === "standard");
  const controls = interpreted.wells.filter(well => well.kind === "control");
  const compounds = interpreted.wells.filter(well => well.kind === "assay");
  
  console.log(`Found ${standards.length} standards, ${controls.length} controls, ${compounds.length} compounds`);
  
  // Process standards with proper concentration calculation
  if (standards.length > 0 && CYTOKINES.length > 0) {
    const currentCytokineName = CYTOKINES[currentCytokine] || CYTOKINES[0];
    const maxConc = STANDARD_CONCENTRATIONS[currentCytokineName] ? STANDARD_CONCENTRATIONS[currentCytokineName][0] : 2000;
    const dilutionFactor = DILUTION_FACTORS[currentCytokineName] || 4;
    
    console.log(`📊 Processing standards for ${currentCytokineName}:`, standards);
    
    // Group standards by their number and handle duplicates
    const standardsByNumber = {};
    standards.forEach(standard => {
      const stdNum = standard.stdNumber || 1;
      if (!standardsByNumber[stdNum]) {
        standardsByNumber[stdNum] = [];
      }
      standardsByNumber[stdNum].push(standard);
    });
    
    console.log(`📊 Standards grouped by number:`, standardsByNumber);
    
    // Get unique standard numbers and sort them
    const uniqueStdNumbers = Object.keys(standardsByNumber).map(Number).sort((a, b) => a - b);
    const numDilutions = uniqueStdNumbers.length;
    const standardConcentrations = calculateStandardConcentrations(maxConc, dilutionFactor, numDilutions);
    
    console.log(`📊 Unique standard numbers: ${uniqueStdNumbers}, Concentrations:`, standardConcentrations);
    
    // Process each standard number
    // Map standard numbers to concentration indices
    // std1 = highest concentration (index 0), std8 = lowest concentration (index 7)
    const stdNumberToIndex = {};
    uniqueStdNumbers.forEach((stdNum, index) => {
      stdNumberToIndex[stdNum] = index;
    });
    
    uniqueStdNumbers.forEach((stdNum) => {
      const concentrationIndex = stdNumberToIndex[stdNum];
      const concentration = standardConcentrations[concentrationIndex] || 0;
      const standardsWithThisNumber = standardsByNumber[stdNum];
      
      // Import ALL replicates of this standard number
      standardsWithThisNumber.forEach((standard, replicateIndex) => {
        const row = ROWS[standard.row];
        const col = COLS[standard.col];
        
        wellRoles[row][col] = 'standard';
        wellCompounds[row][col] = `std${stdNum}`;
        wellConcentrations[row][col] = concentration;
        
        const replicateLabel = standardsWithThisNumber.length > 1 ? ` (replicate ${replicateIndex + 1})` : '';
        console.log(`✅ Standard ${stdNum} at ${row}${col}: ${wellCompounds[row][col]} = ${concentration} pg/mL (index ${concentrationIndex})${replicateLabel}`);
      });
      
      // Log replicate count
      if (standardsWithThisNumber.length > 1) {
        console.log(`📊 Imported ${standardsWithThisNumber.length} replicates for std${stdNum}`);
      }
    });
  }
  
  // Process controls
  controls.forEach(control => {
    const row = ROWS[control.row];
    const col = COLS[control.col];
    
    wellRoles[row][col] = 'control';
    wellCompounds[row][col] = control.name || 'control';
    wellConcentrations[row][col] = control.conc || 0;
    
    console.log(`✅ Control at ${row}${col}: ${wellCompounds[row][col]} (${wellConcentrations[row][col]})`);
  });
  
  // Process compounds
  compounds.forEach(compound => {
    const row = ROWS[compound.row];
    const col = COLS[compound.col];
    
    wellRoles[row][col] = 'unknown';
    wellCompounds[row][col] = compound.name || 'compound';
    wellConcentrations[row][col] = compound.conc || 0;
    
    // Assign color to compound
    getCompoundColor(compound.name);
    
    console.log(`✅ Compound at ${row}${col}: ${wellCompounds[row][col]} (${wellConcentrations[row][col]})`);
  });
  
  // Ensure all wells have proper default values
  for (let row of ROWS) {
    for (let col of COLS) {
      if (!wellRoles[row][col]) {
        wellRoles[row][col] = 'empty';
        wellCompounds[row][col] = null;
        wellConcentrations[row][col] = null;
      }
    }
  }
  
  // Update the plate display
  renderPlate();
  
  // Update status with detailed information
  const standardsCount = Object.keys(wellRoles).reduce((count, row) => {
    return count + Object.keys(wellRoles[row]).filter(col => wellRoles[row][col] === 'standard').length;
  }, 0);
  
  const controlsCount = Object.keys(wellRoles).reduce((count, row) => {
    return count + Object.keys(wellRoles[row]).filter(col => wellRoles[row][col] === 'control').length;
  }, 0);
  
  const compoundsCount = Object.keys(wellRoles).reduce((count, row) => {
    return count + Object.keys(wellRoles[row]).filter(col => wellRoles[row][col] === 'unknown').length;
  }, 0);
  
  updateStatus(`Excel import complete: ${standardsCount} standards, ${controlsCount} controls, ${compoundsCount} compounds`, 'complete');
  
  console.log('📊 Import complete. Standards imported:', standardsCount);
  console.log('📊 Controls imported:', controlsCount);
  console.log('📊 Compounds imported:', compoundsCount);
}

function buildHeaders(ws, topLeftR, topLeftC) {
  const topR = topLeftR - 1;
  const leftC = topLeftC - 1;

  const top = Array(12).fill(null);
  const left = Array(8).fill(null);

  const merges = ws["!merges"] || [];
  
  // Top merged spans
  merges.forEach(m => {
    if (m.s.r + 1 === topR && m.e.r + 1 === topR) {
      for (let j = 0; j < 12; j++) {
        const col = topLeftC + j;
        const within = (m.s.c + 1) <= col && col <= (m.e.c + 1);
        if (within) {
          const v = getCell(ws, topR, m.s.c + 1);
          if (isStr(v) || isNum(v)) top[j] = v;
        }
      }
    }
  });
  
  // Top singles
  for (let j = 0; j < 12; j++) {
    if (top[j] == null) {
      const v = getCell(ws, topR, topLeftC + j);
      if (isStr(v) || isNum(v)) top[j] = v;
    }
  }
  
  // Left merged spans
  merges.forEach(m => {
    if (m.s.c + 1 === leftC && m.e.c + 1 === leftC) {
      for (let i = 0; i < 8; i++) {
        const row = topLeftR + i;
        const within = (m.s.r + 1) <= row && row <= (m.e.r + 1);
        if (within) {
          const v = getCell(ws, m.s.r + 1, leftC);
          if (isStr(v) || isNum(v)) left[i] = v;
        }
      }
    }
  });
  
  // Left singles
  for (let i = 0; i < 8; i++) {
    if (left[i] == null) {
      const v = getCell(ws, topLeftR + i, leftC);
      if (isStr(v) || isNum(v)) left[i] = v;
    }
  }
  
  // Determine orientation: which edge is mostly numeric => concentrations
  const topNum = top.filter(isNum).length;
  const leftNum = left.filter(isNum).length;
  const columnsAreConcs = topNum > leftNum;
  
  return { top, left, columnsAreConcs };
}

function exportToExcel() {
  try {
    const workbook = XLSX.utils.book_new();
    
    // Export cytokines
    const cytokinesData = [
      ['Cytokine Name', 'Max Concentration (pg/mL)', 'Dilution Factor']
    ];
    CYTOKINES.forEach(cytokine => {
      const maxConc = STANDARD_CONCENTRATIONS[cytokine] ? STANDARD_CONCENTRATIONS[cytokine][0] : 0;
      const dilutionFactor = DILUTION_FACTORS[cytokine] || 4;
      cytokinesData.push([cytokine, maxConc, dilutionFactor]);
    });
    const cytokinesSheet = XLSX.utils.aoa_to_sheet(cytokinesData);
    XLSX.utils.book_append_sheet(workbook, cytokinesSheet, 'Cytokines');
    
    // Export current plate in Plate Interpreter format
    const plateData = createPlateInterpreterFormat();
    const plateSheet = XLSX.utils.aoa_to_sheet(plateData);
    XLSX.utils.book_append_sheet(workbook, plateSheet, 'Plate 1');
    
    // Download the file
    const fileName = `MSD_Configuration_${new Date().toISOString().split('T')[0]}.xlsx`;
    XLSX.writeFile(workbook, fileName);
    
    updateStatus('Configuration exported to Excel successfully', 'complete');
    
  } catch (error) {
    console.error('Excel export error:', error);
    updateStatus('Error exporting to Excel: ' + error.message, 'error');
  }
}

// Comprehensive export function for all analysis results
function exportAllResults() {
  try {
    console.log('📊 Starting comprehensive results export...');
    updateStatus('Preparing comprehensive results export...', 'processing');
    
    const workbook = XLSX.utils.book_new();
    
    // 1. Create plate information sheet
    createPlateInfoSheet(workbook);
    
    // 2. Create technical analysis sheet
    createTechnicalAnalysisSheet(workbook);
    
    // 3. Create individual cytokine sheets
    if (analysisResults && Object.keys(analysisResults).length > 0) {
      Object.keys(analysisResults).forEach(cytokineIndex => {
        const cytokineName = CYTOKINES[parseInt(cytokineIndex)];
        if (cytokineName) {
          createCytokineSheet(workbook, cytokineName, parseInt(cytokineIndex), analysisResults[cytokineIndex]);
        }
      });
    } else {
      // If no analysis results, create sheets for all configured cytokines
      CYTOKINES.forEach((cytokineName, index) => {
        createCytokineSheet(workbook, cytokineName, index, null);
      });
    }
    
    // Download the file
    const fileName = `MSD_Analysis_Results_${new Date().toISOString().split('T')[0]}.xlsx`;
    XLSX.writeFile(workbook, fileName);
    
    updateStatus('✅ Comprehensive results exported successfully!', 'complete');
    console.log('✅ Export completed successfully');
    
  } catch (error) {
    console.error('❌ Comprehensive export error:', error);
    updateStatus('Error exporting comprehensive results: ' + error.message, 'error');
  }
}

// Create plate information sheet
function createPlateInfoSheet(workbook) {
  console.log('📋 Creating plate information sheet...');
  
  const plateInfoData = [
    ['MSD Plate Information'],
    [''],
    ['Plate Details:'],
    ['Plate Name', 'MSD Analysis Plate'],
    ['Plate Format', '96-well (8x12)'],
    ['Analysis Date', new Date().toLocaleString()],
    [''],
    ['Cytokines Analyzed:'],
    ['Cytokine Name', 'Max Concentration (pg/mL)', 'Dilution Factor', 'Number of Standards']
  ];
  
  // Add cytokine information
  CYTOKINES.forEach(cytokine => {
    const maxConc = STANDARD_CONCENTRATIONS[cytokine] ? STANDARD_CONCENTRATIONS[cytokine][0] : 0;
    const dilutionFactor = DILUTION_FACTORS[cytokine] || 4;
    const numStandards = STANDARD_CONCENTRATIONS[cytokine] ? STANDARD_CONCENTRATIONS[cytokine].length : 0;
    plateInfoData.push([cytokine, maxConc, dilutionFactor, numStandards]);
  });
  
  plateInfoData.push(['']);
  plateInfoData.push(['Well Assignment Summary:']);
  plateInfoData.push(['Well Type', 'Count', 'Description']);
  
  // Count well types
  const wellCounts = { standard: 0, control: 0, unknown: 0, empty: 0 };
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row] && wellRoles[row][col]) {
        wellCounts[wellRoles[row][col]] = (wellCounts[wellRoles[row][col]] || 0) + 1;
      }
    }
  }
  
  plateInfoData.push(['Standards', wellCounts.standard, 'Calibration standards for curve fitting']);
  plateInfoData.push(['Controls', wellCounts.control, 'Positive/negative controls']);
  plateInfoData.push(['Unknowns', wellCounts.unknown, 'Test compounds/samples']);
  plateInfoData.push(['Empty', wellCounts.empty, 'Unassigned wells']);
  
  plateInfoData.push(['']);
  plateInfoData.push(['Raw Data Information:']);
  plateInfoData.push(['Data Source', plateData && Object.keys(plateData).length > 0 ? 'Imported' : 'Generated']);
  plateInfoData.push(['Total Wells with Data', plateData ? Object.keys(plateData).length : 0]);
  plateInfoData.push(['Analysis Method', document.getElementById('analysisMethod')?.value || 'fit4pl']);
  
  const plateInfoSheet = XLSX.utils.aoa_to_sheet(plateInfoData);
  XLSX.utils.book_append_sheet(workbook, plateInfoSheet, 'Plate Information');
}

// Create technical analysis sheet
function createTechnicalAnalysisSheet(workbook) {
  console.log('🔬 Creating technical analysis sheet...');
  
  const technicalData = [
    ['MSD Technical Analysis Parameters'],
    [''],
    ['Analysis Settings:'],
    ['Analysis Method', document.getElementById('analysisMethod')?.value || 'fit4pl'],
    ['Curve Fitting Algorithm', '4-Parameter Logistic (4PL)'],
    ['Interpolation Method', 'Log-Log Interpolation'],
    ['R² Threshold', '≥ 0.90'],
    [''],
    ['Statistical Parameters:'],
    ['Parameter', 'Description', 'Formula/Notes']
  ];
  
  // Add statistical parameter descriptions
  const statParams = [
    ['R² (R-squared)', 'Coefficient of determination', '1 - (SSres/SStot)'],
    ['EC50', 'Half-maximal effective concentration', 'Concentration at 50% response'],
    ['Hill Slope', 'Steepness of the curve', 'Slope parameter in 4PL model'],
    ['Top', 'Upper asymptote', 'Maximum response value'],
    ['Bottom', 'Lower asymptote', 'Minimum response value'],
    ['Standard Error', 'Uncertainty in mean', 'SD / √n'],
    ['95% CI', '95% Confidence Interval', 'Mean ± (1.96 × SE)']
  ];
  
  statParams.forEach(param => {
    technicalData.push(param);
  });
  
  technicalData.push(['']);
  technicalData.push(['Curve Fitting Details:']);
  technicalData.push(['Model', '4-Parameter Logistic (4PL)']);
  technicalData.push(['Equation', 'y = Bottom + (Top-Bottom)/(1+((x/EC50)^HillSlope))']);
  technicalData.push(['Convergence Criteria', 'Maximum iterations: 1000, Tolerance: 1e-6']);
  technicalData.push(['Weighting', 'None (unweighted regression)']);
  
  technicalData.push(['']);
  technicalData.push(['Quality Control:']);
  technicalData.push(['Minimum Standards', '3 points required']);
  technicalData.push(['R² Threshold', '≥ 0.90 for 4PL, fallback to interpolation if lower']);
  technicalData.push(['Outlier Detection', 'None (all points included)']);
  technicalData.push(['Dilution Series', 'Geometric progression (log scale)']);
  
  // Add analysis results summary if available
  if (analysisResults && Object.keys(analysisResults).length > 0) {
    technicalData.push(['']);
    technicalData.push(['Analysis Results Summary:']);
    technicalData.push(['Cytokine', 'Method Used', 'R² Value', 'Standards Count', 'Unknowns Count']);
    
    Object.keys(analysisResults).forEach(cytokineIndex => {
      const cytokineName = CYTOKINES[parseInt(cytokineIndex)];
      const result = analysisResults[cytokineIndex];
      if (result && result.curve) {
        technicalData.push([
          cytokineName,
          result.curve.method || '4PL Curve Fit',
          result.curve.rSquared || 'N/A',
          result.standards ? result.standards.length : 0,
          result.unknowns ? result.unknowns.length : 0
        ]);
      }
    });
  }
  
  const technicalSheet = XLSX.utils.aoa_to_sheet(technicalData);
  XLSX.utils.book_append_sheet(workbook, technicalSheet, 'Technical Analysis');
}

// Create individual cytokine sheet
function createCytokineSheet(workbook, cytokineName, cytokineIndex, analysisResult) {
  console.log(`📊 Creating sheet for ${cytokineName}...`);
  
  const cytokineData = [];
  
  // Header
  cytokineData.push([`${cytokineName} Analysis Results`]);
  cytokineData.push(['Generated:', new Date().toLocaleString()]);
  cytokineData.push(['']);
  
  // Raw data section
  cytokineData.push(['RAW DATA']);
  cytokineData.push(['Well', 'Role', 'Compound', 'Concentration (pg/mL)', 'Signal', 'Calculated Conc (pg/mL)']);
  
  // Add raw data for this cytokine
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row] && wellRoles[row][col]) {
        const wellId = `${row}${col}`;
        const role = wellRoles[row][col];
        const compound = wellCompounds[row][col] || '';
        const concentration = wellConcentrations[row][col] || '';
        const signal = plateData[wellId] ? plateData[wellId][cytokineIndex] : '';
        
        // Get calculated concentration from analysis results
        let calculatedConc = '';
        if (analysisResult && analysisResult.unknowns) {
          // Find this well in the unknowns results
          const unknownResult = analysisResult.unknowns.find(u => 
            u.well === wellId || (u.wellIds && u.wellIds.includes(wellId))
          );
          if (unknownResult) {
            calculatedConc = unknownResult.calculatedConcentration || '';
          }
        }
        
        // Also check the calculatedConcentrations array as fallback
        if (!calculatedConc && calculatedConcentrations[cytokineIndex] && 
            calculatedConcentrations[cytokineIndex][row] && 
            calculatedConcentrations[cytokineIndex][row][col]) {
          calculatedConc = calculatedConcentrations[cytokineIndex][row][col];
        }
        
        cytokineData.push([wellId, role, compound, concentration, signal, calculatedConc]);
      }
    }
  }
  
  cytokineData.push(['']);
  
  // Standard curve table
  if (analysisResult && analysisResult.standards) {
    cytokineData.push(['STANDARD CURVE TABLE']);
    cytokineData.push(['Standard', 'Concentration (pg/mL)', 'Signal', 'Log(Conc)', 'Log(Signal)', 'Residual']);
    
    analysisResult.standards.forEach((std, index) => {
      const conc = parseFloat(std.concentration) || 0;
      const signal = parseFloat(std.signal) || 0;
      const logConc = conc > 0 ? Math.log10(conc) : '';
      const logSignal = signal > 0 ? Math.log10(signal) : '';
      const residual = ''; // Could calculate if needed
      
      cytokineData.push([`Std ${index + 1}`, conc, signal, logConc, logSignal, residual]);
    });
    
    cytokineData.push(['']);
  }
  
  // Calculated parameters
  if (analysisResult && analysisResult.curve) {
    cytokineData.push(['CURVE FITTING PARAMETERS']);
    cytokineData.push(['Parameter', 'Value', 'Description']);
    cytokineData.push(['Method', analysisResult.curve.method || '4PL Curve Fit', 'Curve fitting method used']);
    cytokineData.push(['R²', analysisResult.curve.rSquared || 'N/A', 'Coefficient of determination']);
    cytokineData.push(['EC50', 'N/A', 'Half-maximal effective concentration']);
    cytokineData.push(['Hill Slope', 'N/A', 'Steepness of the curve']);
    cytokineData.push(['Top', 'N/A', 'Upper asymptote']);
    cytokineData.push(['Bottom', 'N/A', 'Lower asymptote']);
    cytokineData.push(['']);
  }
  
  // Unknowns analysis table
  if (analysisResult && analysisResult.unknowns) {
    cytokineData.push(['UNKNOWNS & DUPLICATES ANALYSIS']);
    cytokineData.push(['Well', 'Compound', 'Concentration (ng/mL)', 'Calculated Conc (pg/mL)', 'Signal', 'CV%', 'Notes']);
    
    analysisResult.unknowns.forEach(unknown => {
      const well = unknown.well || unknown.wellIds?.[0] || 'Unknown';
      const compound = unknown.compound || '';
      const conc = unknown.concentration || '';
      const calcConc = unknown.calculatedConcentration || '';
      const signal = unknown.signal || '';
      const cv = unknown.cv || '';
      const notes = unknown.notes || '';
      
      cytokineData.push([well, compound, conc, calcConc, signal, cv, notes]);
    });
    
    cytokineData.push(['']);
  }
  
  // Plot data (for standard curve)
  if (analysisResult && analysisResult.standards) {
    cytokineData.push(['STANDARD CURVE PLOT DATA']);
    cytokineData.push(['Concentration (pg/mL)', 'Signal', 'Log(Conc)', 'Log(Signal)']);
    
    analysisResult.standards.forEach(std => {
      const conc = parseFloat(std.concentration) || 0;
      const signal = parseFloat(std.signal) || 0;
      const logConc = conc > 0 ? Math.log10(conc) : '';
      const logSignal = signal > 0 ? Math.log10(signal) : '';
      
      cytokineData.push([conc, signal, logConc, logSignal]);
    });
  }
  
  const cytokineSheet = XLSX.utils.aoa_to_sheet(cytokineData);
  XLSX.utils.book_append_sheet(workbook, cytokineSheet, cytokineName.substring(0, 31)); // Excel sheet name limit
  
  // Add plot data sheets
  try {
    createPlotDataSheets(workbook, cytokineName, cytokineIndex, analysisResult);
  } catch (error) {
    console.warn(`Could not create plot data sheets for ${cytokineName}:`, error);
  }
}

// Capture standard curve plot as image
function captureStandardCurvePlot(cytokineName, cytokineIndex) {
  try {
    // Find the standard curve canvas
    const canvas = document.querySelector('#standardCurveCanvas');
    if (!canvas) {
      console.warn('Standard curve canvas not found');
      return null;
    }
    
    // Convert canvas to image data
    const imageData = canvas.toDataURL('image/png');
    
    // Create a simple sheet with the image reference
    const imageSheet = XLSX.utils.aoa_to_sheet([
      [`${cytokineName} Standard Curve Plot`],
      [''],
      ['Plot Image:', 'See attached image file'],
      ['Generated:', new Date().toLocaleString()],
      [''],
      ['Note: This plot shows the standard curve used for concentration calculations.']
    ]);
    
    return imageSheet;
  } catch (error) {
    console.error('Error capturing standard curve plot:', error);
    return null;
  }
}

