  runStatisticalAnalysis();
}

// Test function to manually trigger statistics
function testStatisticsTab() {
  console.log('🧪 Testing statistics tab...');
  
  // Find statistics tab button
  const statsButton = document.querySelector('[data-tab="statistics"]');
  if (statsButton) {
    console.log('Found statistics button, clicking...');
    statsButton.click();
  } else {
    console.error('Statistics button not found');
  }
}

// Make test function globally available
window.testStatisticsTab = testStatisticsTab;

// Export statistical results
function exportStatisticalResults() {
  console.log('📄 Exporting statistical results...');
  
  // Get current results from the container
  const container = document.getElementById('statisticalResultsContainer');
  if (!container) {
    alert('No results to export. Please run analysis first.');
    return;
  }
  
  // Create a simple text export
  const resultsText = container.innerText;
  const blob = new Blob([resultsText], { type: 'text/plain' });
  const url = URL.createObjectURL(blob);
  
  const a = document.createElement('a');
  a.href = url;
  a.download = `statistical_analysis_${new Date().toISOString().split('T')[0]}.txt`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  
  console.log('✅ Statistical results exported');
}

// ==================== INTERPRETATION FUNCTIONS ====================

// Generate ANOVA interpretation
function generateANOVAInterpretation(results, significanceLevel) {
  let interpretation = '';
  
  if (results.anovaResults.significant) {
    interpretation += `The ANOVA revealed significant differences between compounds (F = ${results.anovaResults.fStatistic.toFixed(3)}, p = ${results.anovaResults.pValue.toFixed(3)}). `;
    
    if (results.postHocResults && results.postHocResults.significantComparisons.length > 0) {
      interpretation += `Post-hoc analysis identified ${results.postHocResults.significantComparisons.length} significant pairwise differences. `;
    }
    
    if (results.effectSizes && results.effectSizes.etaSquared > 0.1) {
      interpretation += `The effect size (η² = ${results.effectSizes.etaSquared.toFixed(3)}) indicates a ${results.effectSizes.etaSquared > 0.14 ? 'large' : 'medium'} practical significance. `;
    }
  } else {
    interpretation += `The ANOVA did not reveal significant differences between compounds (F = ${results.anovaResults.fStatistic.toFixed(3)}, p = ${results.anovaResults.pValue.toFixed(3)}). `;
  }
  
  interpretation += `This suggests that ${results.anovaResults.significant ? 'compound selection significantly impacts the response variable' : 'compound selection does not significantly impact the response variable'}.`;
  
  return interpretation;
}

// Generate concentration effect interpretation
function generateConcentrationEffectInterpretation(results, significanceLevel) {
  let interpretation = '';
  
  if (results.anovaResults.significant) {
    interpretation += `Concentration has a significant effect on the response (F = ${results.anovaResults.fStatistic.toFixed(3)}, p = ${results.anovaResults.pValue.toFixed(3)}). `;
    
    if (results.doseResponse && results.doseResponse.rSquared > 0.5) {
      interpretation += `The dose-response relationship shows good fit (R² = ${results.doseResponse.rSquared.toFixed(3)}). `;
    }
  } else {
    interpretation += `Concentration does not have a significant effect on the response (F = ${results.anovaResults.fStatistic.toFixed(3)}, p = ${results.anovaResults.pValue.toFixed(3)}). `;
  }
  
  interpretation += `This indicates that ${results.anovaResults.significant ? 'concentration changes significantly affect the measured response' : 'concentration changes do not significantly affect the measured response'}.`;
  
  return interpretation;
}

// Generate interaction interpretation
function generateInteractionInterpretation(results, significanceLevel) {
  let interpretation = '';
  
  if (results.anovaResults.compoundEffect && results.anovaResults.concentrationEffect) {
    interpretation += `Both compound and concentration have significant main effects. `;
    
    if (results.anovaResults.interaction) {
      interpretation += `Additionally, there is a significant interaction between compound and concentration, indicating that the effect of concentration depends on which compound is being tested. `;
    } else {
      interpretation += `However, there is no significant interaction between compound and concentration, suggesting that concentration effects are consistent across compounds. `;
    }
  } else if (results.anovaResults.compoundEffect) {
    interpretation += `Only compound has a significant effect, with concentration effects being non-significant. `;
  } else if (results.anovaResults.concentrationEffect) {
    interpretation += `Only concentration has a significant effect, with compound effects being non-significant. `;
  } else {
    interpretation += `Neither compound nor concentration have significant effects on the response. `;
  }
  
  return interpretation;
}

// Generate dose-response interpretation
function generateDoseResponseInterpretation(results, significanceLevel) {
  let interpretation = '';
  
  const compounds = results.compounds;
  interpretation += `Dose-response analysis was performed for ${compounds.length} compound(s). `;
  
  compounds.forEach(compound => {
    const ec50 = results.ec50Values[compound];
    const rSquared = results.rSquared[compound];
    
    interpretation += `${compound} shows EC₅₀ = ${ec50.toFixed(2)} with R² = ${rSquared.toFixed(3)}. `;
  });
  
  interpretation += `These parameters indicate the concentration at which 50% of the maximum response is achieved and the quality of the dose-response fit.`;
  
  return interpretation;
}

// Generate correlation interpretation
function generateCorrelationInterpretation(results, significanceLevel) {
  let interpretation = '';
  const significantCorrelations = [];
  
  Object.keys(results.correlations).forEach(var1 => {
    Object.keys(results.correlations[var1]).forEach(var2 => {
      const corr = results.correlations[var1][var2];
      if (corr.significant) {
        significantCorrelations.push(`${var1} and ${var2} (r = ${corr.r.toFixed(3)})`);
      }
    });
  });
  
  if (significantCorrelations.length > 0) {
    interpretation += `Significant correlations were found between: ${significantCorrelations.join(', ')}. `;
    interpretation += `This suggests strong linear relationships between these variables.`;
  } else {
    interpretation += `No significant correlations were found between the measured variables. `;
    interpretation += `This suggests that the variables are largely independent of each other.`;
  }
  
  return interpretation;
}

// Generate regression interpretation
function generateRegressionInterpretation(results, significanceLevel) {
  let interpretation = '';
  const significantModels = [];
  
  Object.keys(results.models).forEach(compound => {
    const model = results.models[compound];
    if (model.rSquared > 0.5) {
      significantModels.push(`${compound} (R² = ${model.rSquared.toFixed(3)})`);
    }
  });
  
  if (significantModels.length > 0) {
    interpretation += `Strong linear relationships were found for: ${significantModels.join(', ')}. `;
    interpretation += `These models can be used to predict response values from concentration.`;
  } else {
    interpretation += `Weak linear relationships were found for all compounds. `;
    interpretation += `Non-linear models or other factors may be more appropriate for prediction.`;
  }
  
  return interpretation;
}

// Generate power interpretation
function generatePowerInterpretation(results, significanceLevel) {
  let interpretation = '';
  
  interpretation += `Statistical power analysis shows the probability of detecting true effects. `;
  interpretation += `For small effect sizes (0.1), larger sample sizes are needed for adequate power (>80%). `;
  interpretation += `For medium effect sizes (0.3), moderate sample sizes (20-30) provide good power. `;
  interpretation += `For large effect sizes (0.5+), even small sample sizes (10-20) provide adequate power. `;
  interpretation += `Consider increasing sample size if power is below 80% for your expected effect size.`;
  
  return interpretation;
}
</script>

<!-- Settings Modal -->
<div id="settingsModal" class="modal" style="display: none;">
  <div class="modal-content" style="width: 90%; max-width: 900px; max-height: 90vh; overflow-y: auto;">
    <div class="modal-header">
      <h2>⚙️ Settings</h2>
      <button class="modal-close" onclick="closeSettings()">&times;</button>
    </div>
    <div class="modal-body">
      <!-- Settings Ribbon Navigation -->
      <div class="settings-ribbon">
        <button class="ribbon-tab active" data-tab="display" onclick="switchSettingsTab('display')">🎨 Display</button>
        <button class="ribbon-tab" data-tab="analysis" onclick="switchSettingsTab('analysis')">📊 Analysis</button>
        <button class="ribbon-tab" data-tab="export" onclick="switchSettingsTab('export')">💾 Export</button>
        <button class="ribbon-tab" data-tab="ai" onclick="switchSettingsTab('ai')">🤖 AI</button>
        <button class="ribbon-tab" data-tab="advanced" onclick="switchSettingsTab('advanced')">🔧 Advanced</button>
      </div>
      
      <!-- Display Settings Tab -->
      <div id="displaySettings" class="settings-tab-content active">
        <h3>Display & Visualization Settings</h3>
        
        <div class="settings-section">
          <h4>📏 Scale Settings</h4>
          <div class="form-row cols-2">
            <div>
              <label>Min Scale</label>
              <input type="number" id="minScale" placeholder="Auto" step="any">
              <p class="help-text">Minimum value for color scale (leave empty for auto)</p>
            </div>
            <div>
              <label>Max Scale</label>
              <input type="number" id="maxScale" placeholder="Auto" step="any">
              <p class="help-text">Maximum value for color scale (leave empty for auto)</p>
            </div>
          </div>
          <button class="btn btn-secondary btn-sm" id="autoScale">🎯 Auto Scale</button>
        </div>
        
        <div class="settings-section">
          <h4>🎨 Visual Appearance</h4>
          <div class="form-row cols-2">
            <div>
              <label>Font Size</label>
              <input type="number" id="fontSize" value="12" min="8" max="20" step="1">
              <p class="help-text">Font size for well labels (8-20px)</p>
            </div>
            <div>
              <label>Color Palette</label>
              <select id="paletteSelect">
                <option value="redGreen">🔴🟢 Traffic Light (Red to Green)</option>
                <option value="redWhite">🔥 Heat Map (Red to White)</option>
                <option value="viridis">Viridis (Blue-Green-Yellow)</option>
                <option value="plasma">Plasma (Purple-Pink-Yellow)</option>
                <option value="cool">Cool (Blue-Cyan)</option>
                <option value="warm">Warm (Red-Orange-Yellow)</option>
              </select>
              <p class="help-text">Color scheme for signal visualization. Red-to-Green uses logarithmic scaling for wide ranges (e.g., 2M to 10)</p>
            </div>
          </div>
        </div>
        
        <div class="settings-section">
          <h4>🔍 Plate Display Options</h4>
          <div class="form-row cols-3">
            <div>
              <label>
                <input type="checkbox" id="showWellLabels" checked>
                Show Well Labels
              </label>
            </div>
            <div>
              <label>
                <input type="checkbox" id="showSignalValues" checked>
                Show Signal Values
              </label>
            </div>
            <div>
              <label>
                <input type="checkbox" id="showGradient" checked>
                Show Color Gradient
              </label>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Analysis Settings Tab -->
      <div id="analysisSettings" class="settings-tab-content">
        <h3>Analysis & Calculation Settings</h3>
        
        <div class="settings-section">
          <h4>📈 Curve Fitting</h4>
          <div class="form-row cols-2">
            <div>
              <label>Analysis Method</label>
              <select id="analysisMethod">
                <option value="fit4pl">4PL (Four Parameter Logistic)</option>
                <option value="linear">Linear Regression</option>
                <option value="polynomial">Polynomial Fit</option>
              </select>
            </div>
            <div>
              <label>Global Dilution Factor</label>
              <input type="number" id="dilutionFactor" value="1" min="0.1" step="0.1">
            </div>
          </div>
        </div>
        
        <div class="settings-section">
          <h4>🎯 Quality Control</h4>
          <div class="form-row cols-2">
            <div>
              <label>Minimum R² Threshold</label>
              <input type="number" id="minR2" value="0.95" min="0" max="1" step="0.01">
            </div>
            <div>
              <label>
                <input type="checkbox" id="excludeOutliers" checked>
                Exclude Statistical Outliers
              </label>
            </div>
          </div>
        </div>
        
        <div class="settings-section">
          <h4>📊 Standard Concentrations (pg/mL)</h4>
          <p style="font-size: 11px; color: #666; margin-bottom: 8px;">
            <strong>Current Cytokine:</strong> <span id="currentCytokineLabel">GM-CSF</span><br>
            Values automatically update when cytokine selection changes:
          </p>
          <div class="form-row cols-2">
            <div>
              <label>Std 1 (Highest)</label>
              <input type="number" id="std1" value="4620" step="0.1">
            </div>
            <div>
              <label>Std 2</label>
              <input type="number" id="std2" value="1155" step="0.1">
            </div>
            <div>
              <label>Std 3</label>
              <input type="number" id="std3" value="289" step="0.1">
            </div>
            <div>
              <label>Std 4</label>
              <input type="number" id="std4" value="72" step="0.1">
            </div>
            <div>
              <label>Std 5</label>
              <input type="number" id="std5" value="18" step="0.1">
            </div>
            <div>
              <label>Std 6</label>
              <input type="number" id="std6" value="5" step="0.1">
            </div>
            <div>
              <label>Std 7</label>
              <input type="number" id="std7" value="1" step="0.1">
            </div>
            <div>
              <label>Std 8 (Blank)</label>
              <input type="number" id="std8" value="0" step="0.1">
            </div>
          </div>
          <button class="btn btn-success btn-sm" id="updateStandardConcs">✅ Update Standard Concentrations</button>
          <p style="font-size: 10px; color: #e67e22; margin-top: 8px; font-style: italic;">
            💡 Each cytokine has its own standard curve. Switch cytokines to see different concentrations.
          </p>
        </div>
      </div>
      
      <!-- Export Settings Tab -->
      <div id="exportSettings" class="settings-tab-content">
        <h3>Export & Report Settings</h3>
        
        <div class="settings-section">
          <h4>📊 Default Export Options</h4>
          <div class="form-row cols-2">
            <div>
              <label>Default Decimal Places</label>
              <input type="number" id="defaultDecimals" value="3" min="0" max="6" step="1">
            </div>
            <div>
              <label>
                <input type="checkbox" id="includeMetadataDefault" checked>
                Include Metadata by Default
              </label>
            </div>
          </div>
        </div>
        
        <div class="settings-section">
          <h4>📁 File Naming</h4>
          <div class="form-group">
            <label>File Prefix</label>
            <input type="text" id="filePrefix" value="MSD" placeholder="MSD">
            <p class="help-text">Prefix for exported files</p>
          </div>
        </div>
      </div>
      
      <!-- AI Settings Tab -->
      <div id="aiSettings" class="settings-tab-content">
        <h3>AI Interpretation Settings</h3>
        
        <div class="settings-section">
          <h4>🔑 API Configuration</h4>
          <div class="form-group">
            <label>API Key</label>
            <input type="password" id="aiApiKey" placeholder="Enter your AI API key" style="font-family: monospace;" value="OPENAI_API_KEY_HERE">
            <small style="color: #666;">Your API key is stored locally and never shared</small>
          </div>
          
          <div class="form-group">
            <label>API URL</label>
            <input type="url" id="aiApiUrl" placeholder="https://api.openai.com/v1/chat/completions" style="font-family: monospace;" value="https://api.openai.com/v1/chat/completions">
            <small style="color: #666;">Full API endpoint URL for your AI service</small>
          </div>
          
          <div class="form-row cols-2">
            <div>
              <label>Model</label>
              <select id="aiModel">
                <option value="gpt-4o-mini" selected>GPT-4o Mini (recommended)</option>
                <option value="gpt-4o">GPT-4o</option>
                <option value="gpt-4-turbo">GPT-4 Turbo</option>
                <option value="gpt-4">GPT-4</option>
                <option value="gpt-3.5-turbo">GPT-3.5 Turbo</option>
                <option value="claude-3-sonnet">Claude 3 Sonnet</option>
                <option value="claude-3-opus">Claude 3 Opus</option>
                <option value="custom">Custom Model</option>
              </select>
            </div>
            <div>
              <label>Max Tokens</label>
              <input type="number" id="aiMaxTokens" value="2000" min="100" max="8000">
            </div>
          </div>
          
          <div class="form-group">
            <label>Temperature (0.0 - 1.0)</label>
            <input type="range" id="aiTemperature" min="0" max="1" step="0.1" value="0.7" oninput="updateAITemperature()">
            <span id="aiTemperatureValue">0.7</span>
            <small style="color: #666;">Lower values = more focused, Higher values = more creative</small>
          </div>
          
          <div class="quick-actions">
            <button class="btn btn-primary" onclick="saveAISettings()">💾 Save AI Settings</button>
            <button class="btn btn-secondary" onclick="testAIConnection()">🔍 Test Connection</button>
            <button class="btn btn-info" onclick="testAIDiagnosis()">🧪 Diagnose AI</button>
            <button class="btn btn-warning" onclick="clearAISettings()">🗑️ Clear Settings</button>
          </div>
        </div>
        
        <div class="settings-section">
          <h4>📋 Supported AI Services</h4>
          <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
            <h5>OpenAI</h5>
