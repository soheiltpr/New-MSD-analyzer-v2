function saveFastTemplate() {
  console.log('💾 Saving Fast Template...');
  
  try {
    const templateName = document.getElementById('fastTemplateName')?.value.trim();
    if (!templateName) {
      showNotification('Please enter a template name', 'warning', 3000);
      return;
    }
    
    // Get selected options
    const includePlateLayout = document.getElementById('includePlateLayout')?.checked;
    const includeAnalysisData = document.getElementById('includeAnalysisData')?.checked;
    const includeSettings = document.getElementById('includeSettings')?.checked;
    const includeCytokines = document.getElementById('includeCytokines')?.checked;
    
    console.log('Template options:', { includePlateLayout, includeAnalysisData, includeSettings, includeCytokines });
    
    // Determine template type
    let templateType = 'plate-layout';
    if (includePlateLayout && includeAnalysisData && includeSettings && includeCytokines) {
      templateType = 'complete';
    } else if (includeAnalysisData && !includePlateLayout && !includeSettings && !includeCytokines) {
      templateType = 'analysis-data';
    } else if (includeSettings && !includePlateLayout && !includeAnalysisData && !includeCytokines) {
      templateType = 'settings';
    }
    
    console.log('Template type determined:', templateType);
    
    // Collect template data
    const templateData = collectFastTemplateData(templateType, {
      includePlateLayout,
      includeAnalysisData,
      includeSettings,
      includeCytokines
    });
    
    console.log('Template data collected:', Object.keys(templateData));
    
    // Save to desktop folder
    saveTemplateToDesktop(templateData, templateName, templateType);
    
    // Clear form
    document.getElementById('fastTemplateName').value = '';
    document.getElementById('fastTemplateDescription').value = '';
    
    showNotification(`Template "${templateName}" saved successfully!`, 'success', 4000);
    refreshTemplateLibrary();
    
  } catch (error) {
    console.error('❌ Error saving template:', error);
    showNotification('Error saving template: ' + error.message, 'error', 5000);
  }
}

function collectFastTemplateData(type, options) {
  console.log('📊 Collecting template data...', { type, options });
  
  const data = {
    metadata: {
      name: document.getElementById('fastTemplateName')?.value || 'Untitled Template',
      description: document.getElementById('fastTemplateDescription')?.value || '',
      type: type,
      created: new Date().toISOString(),
      version: '2.0',
      options: options
    },
    plateLayout: {},
    analysisData: {},
    settings: {},
    cytokines: {}
  };
  
  // Include plate layout if requested
  if (options.includePlateLayout) {
    console.log('Including plate layout...');
    data.plateLayout = {
      wells: typeof wells !== 'undefined' ? { ...wells } : {},
      wellRoles: typeof wellRoles !== 'undefined' ? { ...wellRoles } : {},
      wellCompounds: typeof wellCompounds !== 'undefined' ? { ...wellCompounds } : {},
      wellConcentrations: typeof wellConcentrations !== 'undefined' ? { ...wellConcentrations } : {},
      wellDilutions: typeof wellDilutions !== 'undefined' ? { ...wellDilutions } : {},
      wellNotes: typeof wellNotes !== 'undefined' ? { ...wellNotes } : {},
      selectedWells: typeof selectedWells !== 'undefined' ? [...selectedWells] : []
    };
  }
  
  // Include analysis data if requested
  if (options.includeAnalysisData) {
    console.log('Including analysis data...');
    data.analysisData = {
      rawData: typeof plateData !== 'undefined' ? { ...plateData } : {},
      analysisResults: typeof analysisResults !== 'undefined' ? { ...analysisResults } : {},
      standardCurves: typeof standardCurves !== 'undefined' ? { ...standardCurves } : {},
      calculatedConcentrations: typeof calculatedConcentrations !== 'undefined' ? { ...calculatedConcentrations } : {}
    };
  }
  
  // Include settings if requested
  if (options.includeSettings) {
    console.log('Including settings...');
    data.settings = {
      curveModel: document.getElementById('curveModel')?.value || '',
      dilutionFactor: document.getElementById('dilutionFactor')?.value || '1',
      analysisMethod: document.getElementById('analysisMethod')?.value || 'fit4pl',
      currentCytokine: typeof currentCytokine !== 'undefined' ? currentCytokine : 0
    };
  }
  
  // Include cytokines if requested
  if (options.includeCytokines) {
    console.log('Including cytokines...');
    data.cytokines = {
      cytokines: typeof CYTOKINES !== 'undefined' ? [...CYTOKINES] : [],
      standardConcentrations: typeof STANDARD_CONCENTRATIONS !== 'undefined' ? { ...STANDARD_CONCENTRATIONS } : {},
      standardConcentrationsByCytokine: typeof standardConcentrationsByCytokine !== 'undefined' ? { ...standardConcentrationsByCytokine } : {}
    };
  }
  
  console.log('Template data structure:', Object.keys(data));
  return data;
}

function saveTemplateToDesktop(templateData, templateName, templateType) {
  console.log('💾 Saving template to desktop...', { templateName, templateType });
  
  try {
    const timestamp = new Date().toISOString().slice(0, 19).replace(/:/g, '-');
    const fileName = `${templateName}-${templateType}-${timestamp}.msd`;
    
    console.log('File name:', fileName);
    
    // Create downloadable file
    const blob = new Blob([JSON.stringify(templateData, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    
    const a = document.createElement('a');
    a.href = url;
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    console.log('✅ File download initiated');
    
    // Store template info in localStorage for library display
    const templateInfo = {
      name: templateName,
      type: templateType,
      created: new Date().toISOString(),
      fileName: fileName,
      size: JSON.stringify(templateData).length
    };
    
    const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
    templates.push(templateInfo);
    localStorage.setItem('msdTemplates', JSON.stringify(templates));
    
    console.log('✅ Template info stored in localStorage');
    
  } catch (error) {
    console.error('❌ Error in saveTemplateToDesktop:', error);
    throw error;
  }
}

function previewFastTemplate() {
  const templateName = document.getElementById('fastTemplateName')?.value;
  const description = document.getElementById('fastTemplateDescription')?.value;
  
  if (!templateName) {
    showNotification('Please enter a template name to preview', 'warning', 3000);
    return;
  }
  
  const includePlateLayout = document.getElementById('includePlateLayout')?.checked;
  const includeAnalysisData = document.getElementById('includeAnalysisData')?.checked;
  const includeSettings = document.getElementById('includeSettings')?.checked;
  const includeCytokines = document.getElementById('includeCytokines')?.checked;
  
  const preview = `Template Preview:
Name: ${templateName}
Description: ${description || 'No description'}
Type: ${includePlateLayout && includeAnalysisData && includeSettings && includeCytokines ? 'Complete' : 'Custom'}
Created: ${new Date().toLocaleString()}

Includes:
${includePlateLayout ? '✓ Plate Layout' : '✗ Plate Layout'}
${includeAnalysisData ? '✓ Analysis Data' : '✗ Analysis Data'}
${includeSettings ? '✓ Settings' : '✗ Settings'}
${includeCytokines ? '✓ Cytokines' : '✗ Cytokines'}`;
  
  alert(preview);
}

function refreshTemplateLibrary() {
  console.log('🔄 Refreshing template library...');
  const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const templateList = document.getElementById('templateLibraryList');
  
  console.log('Found templates:', templates.length);
  
  if (!templateList) {
    console.error('❌ Template library list element not found!');
    return;
  }
  
  if (templates.length === 0) {
    templateList.innerHTML = `
      <div style="text-align: center; padding: 40px; color: #6c757d;">
        <div style="font-size: 18px; margin-bottom: 8px;">📁 No Templates Found</div>
        <div style="font-size: 14px;">Create your first template above or check the Desktop/MSD-Templates folder</div>
      </div>
    `;
    return;
  }
  
  templateList.innerHTML = templates.map((template, index) => `
    <div class="template-item" style="display: flex; align-items: center; justify-content: space-between; padding: 15px; border-bottom: 1px solid #e9ecef; background: white;">
      <div style="flex: 1;">
        <div style="font-weight: 600; color: #495057; margin-bottom: 4px;">${template.name}</div>
        <div style="font-size: 12px; color: #6c757d;">${template.type} • ${new Date(template.created).toLocaleDateString()}</div>
      </div>
      <div style="display: flex; gap: 8px;">
        <button class="btn btn-sm btn-primary" onclick="loadFastTemplate(${index})" style="padding: 4px 8px;">
          📂 Load
        </button>
        <button class="btn btn-sm btn-warning" onclick="duplicateFastTemplate(${index})" style="padding: 4px 8px;">
          📋 Copy
        </button>
        <button class="btn btn-sm btn-danger" onclick="deleteFastTemplate(${index})" style="padding: 4px 8px;">
          🗑️ Delete
        </button>
      </div>
    </div>
  `).join('');
}

function loadFastTemplate(index) {
  console.log('📂 Loading Fast Template...', index);
  
  try {
    const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
    const template = templates[index];
    
    if (!template) {
      showNotification('Template not found', 'error', 3000);
      return;
    }
    
    console.log('Loading template:', template);
    
    // Load template data into the application
    if (template.data) {
      // Load plate layout
      if (template.data.plateLayout) {
        if (template.data.plateLayout.wells) {
          Object.assign(wells, template.data.plateLayout.wells);
        }
        if (template.data.plateLayout.wellRoles) {
          Object.assign(wellRoles, template.data.plateLayout.wellRoles);
        }
        if (template.data.plateLayout.wellCompounds) {
          Object.assign(wellCompounds, template.data.plateLayout.wellCompounds);
        }
        if (template.data.plateLayout.wellConcentrations) {
          Object.assign(wellConcentrations, template.data.plateLayout.wellConcentrations);
        }
        if (template.data.plateLayout.wellDilutions) {
          Object.assign(wellDilutions, template.data.plateLayout.wellDilutions);
        }
        if (template.data.plateLayout.wellNotes) {
          Object.assign(wellNotes, template.data.plateLayout.wellNotes);
        }
        if (template.data.plateLayout.selectedWells) {
          selectedWells.clear();
          template.data.plateLayout.selectedWells.forEach(well => selectedWells.add(well));
        }
      }
      
      // Load analysis data
      if (template.data.analysisData) {
        if (template.data.analysisData.rawData) {
          Object.assign(plateData, template.data.analysisData.rawData);
        }
        if (template.data.analysisData.analysisResults) {
          Object.assign(analysisResults, template.data.analysisData.analysisResults);
        }
        if (template.data.analysisData.standardCurves) {
          Object.assign(standardCurves, template.data.analysisData.standardCurves);
        }
        if (template.data.analysisData.calculatedConcentrations) {
          Object.assign(calculatedConcentrations, template.data.analysisData.calculatedConcentrations);
        }
      }
      
      // Load settings
      if (template.data.settings) {
        if (template.data.settings.curveModel) {
          const curveModelSelect = document.getElementById('curveModel');
          if (curveModelSelect) curveModelSelect.value = template.data.settings.curveModel;
        }
        if (template.data.settings.dilutionFactor) {
          const dilutionFactorInput = document.getElementById('dilutionFactor');
          if (dilutionFactorInput) dilutionFactorInput.value = template.data.settings.dilutionFactor;
        }
        if (template.data.settings.analysisMethod) {
          const analysisMethodSelect = document.getElementById('analysisMethod');
          if (analysisMethodSelect) analysisMethodSelect.value = template.data.settings.analysisMethod;
        }
        if (template.data.settings.currentCytokine !== undefined) {
          currentCytokine = template.data.settings.currentCytokine;
        }
      }
      
      // Load cytokines
      if (template.data.cytokines) {
        if (template.data.cytokines.cytokines) {
          CYTOKINES.length = 0;
          CYTOKINES.push(...template.data.cytokines.cytokines);
        }
        if (template.data.cytokines.standardConcentrations) {
          Object.assign(STANDARD_CONCENTRATIONS, template.data.cytokines.standardConcentrations);
        }
        if (template.data.cytokines.standardConcentrationsByCytokine) {
          Object.assign(standardConcentrationsByCytokine, template.data.cytokines.standardConcentrationsByCytokine);
        }
      }
      
      // Update UI
      renderPlate();
      populateCytokineSelect();
      updateStandardInputsForCytokine();
      
      showNotification(`Template "${template.name}" loaded successfully!`, 'success', 4000);
      
      // Close the modal
      closeFastTemplateManager();
      
    } else {
      showNotification('Template data not found', 'error', 3000);
    }
    
  } catch (error) {
    console.error('❌ Error loading template:', error);
    showNotification('Error loading template: ' + error.message, 'error', 5000);
  }
}

function duplicateFastTemplate(index) {
  const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const template = templates[index];
  
  const newTemplate = {
    ...template,
    name: `${template.name} (Copy)`,
    created: new Date().toISOString()
  };
  
  templates.push(newTemplate);
  localStorage.setItem('msdTemplates', JSON.stringify(templates));
  
  showNotification(`Template "${template.name}" duplicated`, 'success', 3000);
  refreshTemplateLibrary();
}

function deleteFastTemplate(index) {
  if (confirm('Delete this template from the library?')) {
    const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
    templates.splice(index, 1);
    localStorage.setItem('msdTemplates', JSON.stringify(templates));
    
    showNotification('Template deleted from library', 'success', 3000);
    refreshTemplateLibrary();
  }
}

function filterTemplateLibrary() {
  const filter = document.getElementById('templateFilter')?.value;
  console.log('🔍 Filtering templates by:', filter);
  
  const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const templateList = document.getElementById('templateLibraryList');
  
  if (!templateList) {
    console.error('❌ Template library list element not found!');
    return;
  }
  
  let filteredTemplates = templates;
  
  if (filter && filter !== 'all') {
    filteredTemplates = templates.filter(template => {
      switch (filter) {
        case 'plate-layout':
          return template.type === 'plate-layout' || template.type === 'complete';
        case 'analysis-data':
          return template.type === 'analysis-data' || template.type === 'complete';
        case 'settings':
          return template.type === 'settings' || template.type === 'complete';
        case 'complete':
          return template.type === 'complete';
        case 'recent':
          const oneWeekAgo = new Date();
          oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
          return new Date(template.created) > oneWeekAgo;
        case 'favorites':
          return template.favorite === true;
        default:
          return true;
      }
    });
  }
  
  console.log(`Filtered ${templates.length} templates to ${filteredTemplates.length} templates`);
  
  if (filteredTemplates.length === 0) {
    templateList.innerHTML = `
      <div style="text-align: center; padding: 40px; color: #6c757d;">
        <div style="font-size: 18px; margin-bottom: 8px;">📁 No Templates Found</div>
        <div style="font-size: 14px;">No templates match the selected filter</div>
      </div>
    `;
    return;
  }
  
  templateList.innerHTML = filteredTemplates.map((template, index) => {
    const originalIndex = templates.findIndex(t => t.name === template.name);
    return `
      <div class="template-item" style="display: flex; align-items: center; justify-content: space-between; padding: 15px; border-bottom: 1px solid #e9ecef; background: white;">
        <div style="flex: 1;">
          <div style="font-weight: 600; color: #495057; margin-bottom: 4px;">${template.name}</div>
          <div style="font-size: 12px; color: #6c757d;">${template.type} • ${new Date(template.created).toLocaleDateString()}</div>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn btn-sm btn-primary" onclick="loadFastTemplate(${originalIndex})" style="padding: 4px 8px;">
            📂 Load
          </button>
          <button class="btn btn-sm btn-warning" onclick="duplicateFastTemplate(${originalIndex})" style="padding: 4px 8px;">
            📋 Copy
          </button>
          <button class="btn btn-sm btn-danger" onclick="deleteFastTemplate(${originalIndex})" style="padding: 4px 8px;">
            🗑️ Delete
          </button>
        </div>
      </div>
    `;
  }).join('');
  
  showNotification(`Filtered to ${filteredTemplates.length} templates`, 'info', 2000);
}

