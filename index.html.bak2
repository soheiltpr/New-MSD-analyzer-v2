  document.getElementById('includeSignals').checked = true;
  document.getElementById('includeAnalysisResults').checked = true;
}

function closeTemplateManager() {
  document.getElementById('templateManagerModal').style.display = 'none';
  selectedTemplateIndex = null;
}

function saveTemplateToFile() {
  const name = document.getElementById('templateNameInput').value.trim();
  const description = document.getElementById('templateDescriptionInput').value.trim();
  const includeSignals = document.getElementById('includeSignals').checked;
  const includeAnalysisResults = document.getElementById('includeAnalysisResults').checked;
  
  if (!name) {
    updateStatus('Please enter a template name', 'error');
    return;
  }
  
  try {
    // Collect template data
    const templateData = {
      name,
      description,
      created: new Date().toISOString(),
      version: '1.0',
      includeSignals,
      includeAnalysisResults,
      
      // Plate layout data
      plateData: includeSignals ? plateData : {},
      wellRoles,
      wellCompounds,
      wellConcentrations,
      wellDilutions,
      wellNotes,
      
      // Cytokine configuration
      cytokines: CYTOKINES,
      standardConcentrations: STANDARD_CONCENTRATIONS,
      standardConcentrationsByCytokine,
      dilutionFactors: DILUTION_FACTORS,
      
      // Current state
      currentCytokine,
      
      // Analysis results (if requested)
      analysisResults: includeAnalysisResults ? analysisResults : {},
      
      // UI state
      selectedWells: Array.from(selectedWells || []),
      compoundColors
    };
    
    // Create downloadable file
    const jsonData = JSON.stringify(templateData, null, 2);
    const blob = new Blob([jsonData], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    
    // Create download link
    const a = document.createElement('a');
    a.href = url;
    a.download = `msd-template-${name.replace(/[^a-zA-Z0-9]/g, '-')}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    // Also save to localStorage for quick access
    const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
    templates.push(templateData);
    localStorage.setItem('msdTemplates', JSON.stringify(templates));
    
    updateStatus(`✅ Template "${name}" saved successfully`, 'complete');
    
    // Refresh template list
    refreshTemplateList();
    
    // Clear form
    document.getElementById('templateNameInput').value = '';
    document.getElementById('templateDescriptionInput').value = '';
    
  } catch (error) {
    console.error('Error saving template:', error);
    updateStatus(`❌ Error saving template: ${error.message}`, 'error');
  }
}

function refreshTemplateList() {
  const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const content = document.getElementById('templateListContent');
  
  if (templates.length === 0) {
    content.innerHTML = '<p class="no-templates">No templates found. Create your first template above!</p>';
    return;
  }
  
  content.innerHTML = '';
  
  templates.forEach((template, index) => {
    const item = document.createElement('div');
    item.className = 'template-item';
    item.dataset.index = index;
    
    const size = new Blob([JSON.stringify(template)]).size;
    const sizeKB = Math.round(size / 1024 * 100) / 100;
    
    item.innerHTML = `
      <div class="template-name">${template.name}</div>
      <div class="template-description">${template.description || 'No description'}</div>
      <div class="template-date">${new Date(template.created).toLocaleDateString()}</div>
      <div class="template-size">${sizeKB} KB</div>
      <div class="template-actions-cell">
        <button class="btn btn-xs btn-primary" onclick="loadTemplateFromList(${index})">Load</button>
        <button class="btn btn-xs btn-danger" onclick="deleteTemplateFromList(${index})">Delete</button>
      </div>
    `;
    
    item.addEventListener('click', (e) => {
      // Don't trigger if clicking on buttons
      if (e.target.tagName === 'BUTTON') return;
      
      // Update selection
      document.querySelectorAll('.template-item').forEach(i => i.classList.remove('selected'));
      item.classList.add('selected');
      selectedTemplateIndex = index;
    });
    
    content.appendChild(item);
  });
}

function loadTemplateFromList(index) {
  const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const template = templates[index];
  
  if (!template) {
    updateStatus('Template not found', 'error');
    return;
  }
  
  try {
    // Load template data
    if (template.wellRoles) wellRoles = template.wellRoles;
    if (template.wellCompounds) wellCompounds = template.wellCompounds;
    if (template.wellConcentrations) wellConcentrations = template.wellConcentrations;
    if (template.wellDilutions) wellDilutions = template.wellDilutions;
    if (template.wellNotes) wellNotes = template.wellNotes;
    if (template.plateData && template.includeSignals) plateData = template.plateData;
    
    // Load cytokine configuration
    if (template.cytokines) CYTOKINES = template.cytokines;
    if (template.standardConcentrations) STANDARD_CONCENTRATIONS = template.standardConcentrations;
    if (template.standardConcentrationsByCytokine) standardConcentrationsByCytokine = template.standardConcentrationsByCytokine;
    if (template.dilutionFactors) DILUTION_FACTORS = template.dilutionFactors;
    
    // Load current state
    if (typeof template.currentCytokine !== 'undefined') currentCytokine = template.currentCytokine;
    
    // Load analysis results
    if (template.analysisResults && template.includeAnalysisResults) {
      analysisResults = template.analysisResults;
    }
    
    // Load UI state
    if (template.selectedWells) selectedWells = new Set(template.selectedWells);
    if (template.compoundColors) compoundColors = template.compoundColors;
    
    // Update UI
    renderPlate();
    populateCytokineSelect();
    updateStandardInputsForCytokine();
    updateSelectionDisplay();
    
    updateStatus(`✅ Template "${template.name}" loaded successfully`, 'complete');
    
    // Close modal
    closeTemplateManager();
    
  } catch (error) {
    console.error('Error loading template:', error);
    updateStatus(`❌ Error loading template: ${error.message}`, 'error');
  }
}

function deleteTemplateFromList(index) {
  if (!confirm('Are you sure you want to delete this template?')) return;
  
  const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const template = templates[index];
  
  if (!template) {
    updateStatus('Template not found', 'error');
    return;
  }
  
  templates.splice(index, 1);
  localStorage.setItem('msdTemplates', JSON.stringify(templates));
  
  updateStatus(`Template "${template.name}" deleted`, 'complete');
  refreshTemplateList();
}

function loadSelectedTemplate() {
  if (selectedTemplateIndex === null) {
    updateStatus('Please select a template first', 'warning');
    return;
  }
  
  loadTemplateFromList(selectedTemplateIndex);
}

function deleteSelectedTemplate() {
  if (selectedTemplateIndex === null) {
    updateStatus('Please select a template first', 'warning');
    return;
  }
  
  deleteTemplateFromList(selectedTemplateIndex);
}

function renameSelectedTemplate() {
  if (selectedTemplateIndex === null) {
    updateStatus('Please select a template first', 'warning');
    return;
  }
  
  const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const template = templates[selectedTemplateIndex];
  
  if (!template) {
    updateStatus('Template not found', 'error');
    return;
  }
  
  const newName = prompt('Enter new template name:', template.name);
  if (newName && newName.trim()) {
    template.name = newName.trim();
    localStorage.setItem('msdTemplates', JSON.stringify(templates));
    updateStatus(`Template renamed to "${newName}"`, 'complete');
    refreshTemplateList();
  }
}

function exportSelectedTemplate() {
  if (selectedTemplateIndex === null) {
    updateStatus('Please select a template first', 'warning');
    return;
  }
  
  const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const template = templates[selectedTemplateIndex];
  
  if (!template) {
    updateStatus('Template not found', 'error');
    return;
  }
  
  try {
    const jsonData = JSON.stringify(template, null, 2);
    const blob = new Blob([jsonData], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    
    const a = document.createElement('a');
    a.href = url;
    a.download = `msd-template-${template.name.replace(/[^a-zA-Z0-9]/g, '-')}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    updateStatus(`Template "${template.name}" exported successfully`, 'complete');
  } catch (error) {
    console.error('Error exporting template:', error);
    updateStatus(`❌ Error exporting template: ${error.message}`, 'error');
  }
}

function importTemplateFromFile() {
  const fileInput = document.getElementById('importTemplateFile');
  const file = fileInput.files[0];
  
  if (!file) {
    updateStatus('Please select a file to import', 'warning');
    return;
  }
  
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const templateData = JSON.parse(e.target.result);
      
      // Validate template structure
      if (!templateData.name || !templateData.created) {
        throw new Error('Invalid template file format');
      }
      
      // Add to localStorage
      const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
      templates.push(templateData);
      localStorage.setItem('msdTemplates', JSON.stringify(templates));
      
      updateStatus(`Template "${templateData.name}" imported successfully`, 'complete');
      refreshTemplateList();
      
      // Clear file input
      fileInput.value = '';
      
    } catch (error) {
      console.error('Error importing template:', error);
      updateStatus(`❌ Error importing template: ${error.message}`, 'error');
    }
  };
  
  reader.readAsText(file);
}

function previewTemplate() {
  const name = document.getElementById('templateNameInput').value.trim();
  const description = document.getElementById('templateDescriptionInput').value.trim();
  const includeSignals = document.getElementById('includeSignals').checked;
  const includeAnalysisResults = document.getElementById('includeAnalysisResults').checked;
  
  if (!name) {
    updateStatus('Please enter a template name first', 'warning');
    return;
  }
  
  // Create preview data
  const previewData = {
    name,
    description,
    includeSignals,
    includeAnalysisResults,
    plateData: includeSignals ? Object.keys(plateData).length : 0,
    wellRoles: Object.keys(wellRoles).length,
    wellCompounds: Object.keys(wellCompounds).length,
    cytokines: CYTOKINES.length,
    analysisResults: includeAnalysisResults ? Object.keys(analysisResults).length : 0
  };
  
  const previewText = `
Template Preview:
- Name: ${previewData.name}
- Description: ${previewData.description}
- Include Signals: ${previewData.includeSignals ? 'Yes' : 'No'}
- Include Analysis Results: ${previewData.includeAnalysisResults ? 'Yes' : 'No'}
- Plate Data Rows: ${previewData.plateData}
- Well Roles Rows: ${previewData.wellRoles}
- Well Compounds Rows: ${previewData.wellCompounds}
- Cytokines: ${previewData.cytokines}
- Analysis Results: ${previewData.analysisResults}
  `;
  
  alert(previewText);
}

// MSD-style 4PL fitting & reporting
function msd_mean(arr){ return arr.reduce((a,b)=>a+b,0)/arr.length; }
function msd_clamp(v, lo, hi){ return Math.max(lo, Math.min(hi, v)); }
function msd_log10(v){ return Math.log(v)/Math.LN10; }

function msd_y4pl_logx(params, xlog){
  const {A, D, Clog, B} = params;
  const t = Math.pow(10, (xlog - Clog));
  return A + (D - A) / (1 + Math.pow(t, B));
}

function msd_backcalc4pl_logx(params, y){
  const {A, D, Clog, B} = params;
  const eps = 1e-9;
  const yy = msd_clamp(y, A+eps, D-eps);
  
  // Forward: y = A + (D-A) / (1 + (10^(xlog - Clog))^B)
  // Inverse: xlog = Clog + log10(((D-A)/(y-A) - 1)^(1/B))
  // Then x = 10^xlog
  
  const ratio = (D - A) / (yy - A);
  const term = ratio - 1;
  
  if (term <= 0) {
    console.warn('MSD backcalc: term <= 0, using small value', { y, yy, A, D, ratio, term });
    return 1e-6;
  }
  
  const xlog = Clog + msd_log10(Math.pow(term, 1.0/B));
  const x = Math.pow(10, xlog);
  
  // console.log(`MSD backcalc: y=${y}, yy=${yy}, ratio=${ratio}, term=${term}, xlog=${xlog}, x=${x}`);
  return x;
}

function msd_loss4pl(params, xlog, y, weights, hardBounds){
  const {A, D, Clog, B} = params;
  let pen = 0;
  if (A < hardBounds.Amin) pen += Math.pow(hardBounds.Amin - A, 2)*1e6;
  if (D < hardBounds.Dmin) pen += Math.pow(hardBounds.Dmin - D, 2)*1e6;
  if (D > hardBounds.Dmax) pen += Math.pow(D - hardBounds.Dmax, 2)*1e6;
  if (B < hardBounds.Bmin) pen += Math.pow(hardBounds.Bmin - B, 2)*1e6;
  if (B > hardBounds.Bmax) pen += Math.pow(B - hardBounds.Bmax, 2)*1e6;
  if (Clog < hardBounds.ClogMin) pen += Math.pow(hardBounds.ClogMin - Clog, 2)*1e6;
  if (Clog > hardBounds.ClogMax) pen += Math.pow(Clog - hardBounds.ClogMax, 2)*1e6;

  let sse = 0;
  for (let i=0;i<xlog.length;i++){
    const yhat = msd_y4pl_logx(params, xlog[i]);
    const r = y[i] - yhat;
    sse += weights[i]*r*r;
  }
  return sse + pen;
}

function msd_nelderMead(fn, start, step=1.0, maxIter=5000, tol=1e-9){
  const n = start.length;
  let simplex = [start.slice()];
  for (let i=0;i<n;i++){
    const p = start.slice();
    p[i] = p[i] + (Math.abs(start[i]) + 1)*0.05 + step*0.01;
    simplex.push(p);
  }
  function f(p){ return fn(p); }

  function centroid(pts, exclude){
    const c = new Array(n).fill(0);
    for (let i=0;i<pts.length;i++){
      if (i===exclude) continue;
      for (let j=0;j<n;j++) c[j] += pts[i][j];
    }
    for (let j=0;j<n;j++) c[j] /= (pts.length-1);
    return c;
  }

  let values = simplex.map(f);
  for (let iter=0; iter<maxIter; iter++){
    const idx = values.map((v,i)=>[v,i]).sort((a,b)=>a[0]-b[0]).map(x=>x[1]);
    simplex = idx.map(k=>simplex[k]);
    values  = idx.map(k=>values[k]);

    const fspan = Math.abs(values[values.length-1] - values[0]);
    let pspan = 0;
    for (let j=0;j<n;j++){
      const arr = simplex.map(s=>s[j]);
      const maxv = Math.max.apply(null, arr);
      const minv = Math.min.apply(null, arr);
      pspan = Math.max(pspan, Math.abs(maxv-minv));
    }
    if (fspan<tol && pspan<1e-7) break;

    const worst = simplex.length-1;
    const c = centroid(simplex, worst);
    const alpha = 1.0, gamma = 2.0, rho = 0.5, sigma = 0.5;
    const xr = c.map((ci, j)=> ci + alpha*(ci - simplex[worst][j]));
    const fr = f(xr);

    if (fr < values[0]){
      const xe = c.map((ci, j)=> ci + gamma*(xr[j] - ci));
      const fe = f(xe);
      if (fe < fr){ simplex[worst]=xe; values[worst]=fe; }
      else { simplex[worst]=xr; values[worst]=fr; }
    } else if (fr < values[worst-1]){
      simplex[worst]=xr; values[worst]=fr;
    } else {
      const xc = c.map((ci, j)=> ci + rho*(simplex[worst][j] - ci));
      const fc = f(xc);
      if (fc < values[worst]){ simplex[worst]=xc; values[worst]=fc; }
      else {
        for (let i=1;i<simplex.length;i++){
          simplex[i] = simplex[0].map((s0j, j)=> s0j + sigma*(simplex[i][j]-s0j));
          values[i]  = f(simplex[i]);
        }
      }
    }
  }
  const bestIdx = values.indexOf(Math.min.apply(null, values));
  return {params: simplex[bestIdx], fval: values[bestIdx]};
}

function msd_fit4PL(conc, signal, topStdMean){
  const xlog = conc.map(x => msd_log10(x));
  const y = signal.slice();
  const w = y.map(v => 1/Math.pow(Math.max(v,1),2));

  const A0 = Math.min.apply(null, y);
  const D0 = Math.max.apply(null, y);
  const B0 = 1.0;
  const C0 = Math.sqrt(conc[0] * conc[conc.length-1]);
  const start = [A0, D0, msd_log10(C0), B0];
  console.log('🔧 Initial parameters:', { A0, D0, B0, C0, Clog0: msd_log10(C0) });
  console.log('🔧 Start array:', start);

  const ClogMin = Math.min.apply(null, xlog) - 0.25;
  const ClogMax = Math.max.apply(null, xlog) + 0.25;
  const hard = {
    Amin: 0,
    Dmin: 0,
    Dmax: topStdMean * 2.0, // Increased from 1.2 to 2.0 to allow higher D values
    Bmin: 0.1,
    Bmax: 5.0,
    ClogMin, ClogMax
  };

  const fn = (pArr)=>{
    const p = {A:pArr[0], D:pArr[1], Clog:pArr[2], B:pArr[3]};
    return msd_loss4pl(p, xlog, y, w, hard);
  };

  const res = msd_nelderMead(fn, start, 1.0, 6000, 1e-10);
  const p = {A:res.params[0], D:res.params[1], Clog:res.params[2], B:res.params[3]};
  console.log('🔧 Raw MSD fit result:', res);
  console.log('🔧 Raw parameters before clamping:', p);
  p.A = Math.max(p.A, hard.Amin);
  p.D = msd_clamp(p.D, hard.Dmin, hard.Dmax);
  p.B = msd_clamp(p.B, hard.Bmin, hard.Bmax);
  p.Clog = msd_clamp(p.Clog, hard.ClogMin, hard.ClogMax);
  console.log('🔧 Final parameters after clamping:', p);
  console.log('🔧 Hard bounds:', hard);
  return p;
}

function msd_computeLOQ(params, conc, meanSignal, replicateSignals){
  const bc = meanSignal.map(y=> msd_backcalc4pl_logx(params, y));
  const biasPct = bc.map((xhat, i)=> 100*(xhat - conc[i]) / conc[i]);
  let ok = biasPct.map(b => Math.abs(b) <= 20);

  if (Array.isArray(replicateSignals) && replicateSignals.length === conc.length){
    ok = ok.map((good, i)=>{
      if (!good) return false;
      const reps = replicateSignals[i];
      if (!reps || reps.length<2) return good;
      const m = msd_mean(reps);
      const sd = Math.sqrt(msd_mean(reps.map(v=>Math.pow(v-m,2))));
      const cv = (sd / Math.max(m,1)) * 100;
      return cv <= 20;
    });
  }

  const idxGood = conc.map((c,i)=> ok[i] ? i : -1).filter(i=> i>=0);
  if (idxGood.length===0){
    return { LLOQ: NaN, ULOQ: NaN, yAtLLOQ: NaN, yAtULOQ: NaN };
  }
  const Lidx = idxGood[0];
  const Uidx = idxGood[idxGood.length-1];
  const LLOQ = conc[Lidx];
  const ULOQ = conc[Uidx];
  const yAtLLOQ = meanSignal[Lidx];
  const yAtULOQ = meanSignal[Uidx];
  return { LLOQ, ULOQ, yAtLLOQ, yAtULOQ };
}

function runMSDAnalysisForCytokine(cytokineIndex){
  try {
    console.log(`📊 MSD Analyzing cytokine ${cytokineIndex}: ${CYTOKINES[cytokineIndex]}`);
    
    // Collect standard data for this cytokine (same as existing)
    const standards = collectStandardData(cytokineIndex);
    const standardsHash = standards.standardsHash;
    console.log(`✅ MSD Standards collected for ${CYTOKINES[cytokineIndex]}:`, standards);
    
    if (standards.length < 3) {
      throw new Error(`Need at least 3 standards for MSD analysis, found ${standards.length}`);
    }
    
    // MSD 4PL fitting with log10(x) and 1/y² weighting
    const stds = standards
      .filter(s => Number.isFinite(s.concentration) && s.concentration > 0)
      .sort((a,b)=> a.concentration - b.concentration);

    const conc = stds.map(s => s.concentration);
    const reps = stds.map(s => (Array.isArray(s.rawSignals) && s.rawSignals.length>0) ? s.rawSignals : [s.signal]);
    const means = reps.map(arr => msd_mean(arr));
    const topStdMean = means[0];

    const params = msd_fit4PL(conc, means, topStdMean);
    console.log('🔧 MSD 4PL Parameters:', params);
    console.log('🔧 Concentrations:', conc);
    console.log('🔧 Mean signals:', means);
    
    const { LLOQ, ULOQ, yAtLLOQ, yAtULOQ } = msd_computeLOQ(params, conc, means, reps);
    console.log('🔧 LLOQ/ULOQ:', { LLOQ, ULOQ, yAtLLOQ, yAtULOQ });

    // Create MSD predictor that mimics existing predictor interface
    const msdPredictor = {
      mode: 'msd4pl',
      params: params,
      yAtLLOQ: yAtLLOQ,
      yAtULOQ: yAtULOQ,
      predict: function(signal, dilutionFactor = 1.0) {
        // MSD prediction with LLOQ/ULOQ checking
        if (isFinite(yAtULOQ) && signal > yAtULOQ) {
          return { 
            concentration: '>ULOQ — dilute & re-run', 
            undiluted: '>ULOQ — dilute & re-run',
            dilutionFactor: dilutionFactor,
            isExtrapolated: false,
            isAboveULOQ: true
          };
        }
        if (isFinite(yAtLLOQ) && signal < yAtLLOQ) {
          return { 
            concentration: '<LLOQ', 
            undiluted: '<LLOQ',
            dilutionFactor: dilutionFactor,
            isExtrapolated: false,
            isBelowLLOQ: true
          };
        }
        
        const undiluted = msd_backcalc4pl_logx(params, signal);
        const diluted = undiluted * Math.max(dilutionFactor, 1e-12);
        return { 
          concentration: diluted, 
          undiluted: undiluted,
          dilutionFactor: dilutionFactor,
          isExtrapolated: false,
          isAboveULOQ: false,
          isBelowLLOQ: false
        };
      },
      getR2: function() {
        // Calculate R² for MSD fit
        const xlog = conc.map(x => msd_log10(x));
        const y = means;
        const yhat = xlog.map(x => msd_y4pl_logx(params, x));
        const ssRes = y.reduce((sum, yi, i) => sum + Math.pow(yi - yhat[i], 2), 0);
        const ssTot = y.reduce((sum, yi) => sum + Math.pow(yi - msd_mean(y), 2), 0);
        return 1 - (ssRes / ssTot);
      }
    };

    // Calculate unknown concentrations using existing function but with MSD predictor
    const unknowns = calculateUnknownConcentrationsForMSD(msdPredictor, cytokineIndex, standards);
    
    return {
      success: true,
      data: {
        standards: standards || [],
        standardsHash: standardsHash,
        predictor: msdPredictor || null,
        unknowns: unknowns || [],
        cytokine: CYTOKINES[cytokineIndex] || 'Unknown',
        cytokineIndex: cytokineIndex,
        timestamp: new Date(),
        curve: {
          type: 'MSD 4PL (log-x, 1/y²)',
          rSquared: msdPredictor.getR2(),
          method: 'MSD 4PL (log-x, 1/y²)'
        },
        curveQuality: { 
          method: 'MSD 4PL (log-x, 1/y²)', 
          r2: msdPredictor.getR2().toFixed(4),
          LLOQ: LLOQ,
          ULOQ: ULOQ
        }
      }
    };
    
  } catch (error) {
    console.error(`❌ Error in MSD analysis for ${CYTOKINES[cytokineIndex]}:`, error);
    return {
      success: false,
      error: error.message
    };
  }
}

function calculateUnknownConcentrationsForMSD(predictor, cytokineIndex, standards) {
  const unknowns = [];
  
  // Get global dilution factor from analysis form
  const globalDilutionFactor = parseFloat(document.getElementById('dilutionFactor')?.value) || 1.0;
  
  console.log(`🧮 MSD Calculating concentrations for cytokine ${cytokineIndex}...`);
  console.log(`📊 Using global dilution factor: ${globalDilutionFactor}x`);
  
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row][col] === 'unknown' || wellRoles[row][col] === 'control') {
        const signal = getWellSignal(row, col, cytokineIndex);
        // Use global dilution factor for unknowns and controls, per-well factor as additional multiplier if set
        const perWellDilution = wellDilutions[row][col] || 1.0;
        const totalDilutionFactor = globalDilutionFactor * perWellDilution;
        
        if (signal !== null && signal > 0) {
          try {
            const result = predictor.predict(signal, totalDilutionFactor);
            
            // Store ACTUAL calculated concentration (pg/mL) - the real biological measurement
            if (!calculatedConcentrations[cytokineIndex]) {
              calculatedConcentrations[cytokineIndex] = {};
            }
            if (!calculatedConcentrations[cytokineIndex][row]) {
              calculatedConcentrations[cytokineIndex][row] = {};
            }
            // Store concentration as number or null for special cases
            calculatedConcentrations[cytokineIndex][row][col] = 
              (typeof result.concentration === 'number') ? result.concentration : null;
            
            // Determine range status for MSD analysis
            let rangeStatus = 'Within Range';
            if (result.isAboveULOQ) {
              rangeStatus = 'Above Range';
            } else if (result.isBelowLLOQ) {
              rangeStatus = 'Below Range';
            }
            
            unknowns.push({
              well: `${row}${col}`,
              signal,
              undiluted: result.undiluted,
              actualConcentration: result.concentration, // ACTUAL concentration (pg/mL)
              compoundConcentration: wellConcentrations[row][col], // COMPOUND concentration (experimental design)
              dilutionFactor: result.dilutionFactor,
              compound: wellCompounds[row][col] || 'Unknown',
              role: wellRoles[row][col],
              rangeStatus: rangeStatus,
              isAboveULOQ: result.isAboveULOQ || false,
              isBelowLLOQ: result.isBelowLLOQ || false,
              isExtrapolated: result.isExtrapolated || false
            });
            
            const status = result.isAboveULOQ ? '>ULOQ' : result.isBelowLLOQ ? '<LLOQ' : 'In Range';
            console.log(`  ✅ ${row}${col}: Signal=${signal} → Actual Conc=${result.concentration} (${status}) (dilution: ${globalDilutionFactor}x${perWellDilution > 1 ? ` × ${perWellDilution}` : ''})`);
          } catch (error) {
            console.warn(`Failed to calculate MSD concentration for well ${row}${col}:`, error);
            calculatedConcentrations[cytokineIndex][row][col] = null;
            unknowns.push({
              well: `${row}${col}`,
              signal,
              undiluted: 'Error',
              actualConcentration: 'Error',
              compoundConcentration: wellConcentrations[row][col],
              dilutionFactor: totalDilutionFactor,
              compound: wellCompounds[row][col] || 'Unknown',
              role: wellRoles[row][col],
              error: error.message
            });
          }
        }
      }
    }
  }
  
  console.log(`📊 MSD Calculated ${unknowns.length} concentrations for cytokine ${cytokineIndex}`);
  return unknowns;
}

function runMSDAnalysis() {
  console.log('=== MSD 4PL ANALYSIS START ===');
  console.log('Analyzing all cytokines with MSD 4PL method:', CYTOKINES);
  
  console.log('🧪 MSD 4PL Analysis button clicked! Starting sequential MSD analysis for all cytokines...');
  
  // Ensure we have plate data
  if (!plateData || Object.keys(plateData).length === 0) {
    updateStatus('No plate data - generating demo data first...', 'warning');
    generateDemoData();
  }
  
  // Check if we have standards
  console.log('🔍 Checking for standards...');
  console.log('CYTOKINES array:', CYTOKINES);
  console.log('wellRoles sample:', Object.keys(wellRoles).slice(0, 3).map(row => ({ [row]: wellRoles[row] })));
  
  // Debug: Check for standards manually
  let debugStandardCount = 0;
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row] && wellRoles[row][col] === 'standard') {
        debugStandardCount++;
        console.log(`Found standard at ${row}${col}:`, {
          role: wellRoles[row][col],
          compound: wellCompounds[row][col],
          concentration: wellConcentrations[row][col]
        });
      }
    }
  }
  console.log(`Debug: Found ${debugStandardCount} standards manually`);
  
  if (!hasStandards()) {
    updateStatus('ERROR: No standards found. Please assign standards to wells before analyzing.', 'error');
    console.log('Standards check failed');
    return;
  }

  // Start sequential cytokine analysis with progress bar (MSD version)
  runSequentialMSDCytokineAnalysis();
}

function runSequentialMSDCytokineAnalysis() {
  if (CYTOKINES.length === 0) {
    updateStatus('ERROR: No cytokines configured. Please setup cytokines first.', 'error');
    return;
  }

  console.log('🔄 Starting sequential MSD cytokine analysis with progress bar...');
  
  // Initialize analysis results if needed
  if (!analysisResults || typeof analysisResults !== 'object' || Array.isArray(analysisResults)) {
    analysisResults = {};
  }

  // Show progress bar and disable MSD analyze button
  const progressContainer = document.getElementById('analysisProgress');
  const msdAnalyzeBtn = document.getElementById('runMSDAnalysis');
  
  if (progressContainer) {
    progressContainer.style.display = 'block';
  }
  if (msdAnalyzeBtn) {
    msdAnalyzeBtn.disabled = true;
    msdAnalyzeBtn.textContent = 'MSD Analyzing...';
  }

  // Initialize progress
  updateProgress(0, 'Starting MSD 4PL analysis...', 'Preparing...');
  
  let currentIndex = 0;
  let successfulAnalyses = 0;
  let failedAnalyses = 0;

  // Process cytokines sequentially
  async function processNextMSDCytokine() {
    if (currentIndex >= CYTOKINES.length) {
      // All cytokines processed - show completion
      const totalProcessed = successfulAnalyses + failedAnalyses;
      updateProgress(100, 'MSD 4PL Analysis complete!', `Completed ${successfulAnalyses}/${totalProcessed} cytokines`);
      
      // Hide progress bar after a delay
      setTimeout(() => {
        if (progressContainer) {
          progressContainer.style.display = 'none';
        }
        if (msdAnalyzeBtn) {
          msdAnalyzeBtn.disabled = false;
          msdAnalyzeBtn.textContent = '🧪 MSD 4PL';
        }
      }, 2000);

      // Show final results
      if (successfulAnalyses > 0) {
        updateStatus(`✅ MSD 4PL Sequential analysis complete! ${successfulAnalyses} successful, ${failedAnalyses} failed`, 'complete');
        
        // Update UI with results
        populateResultsCytokineSelect(analysisResults);
        const resultsSelect = document.getElementById('resultsCytokineSelect');
        if (resultsSelect) {
          resultsSelect.value = String(currentCytokine);
        }
        displayAnalysisResultsFor(currentCytokine);
        
        // Show results section
        const resultsSection = document.getElementById('resultsSection');
        if (resultsSection) {
          resultsSection.style.display = 'block';
        }
      } else {
        updateStatus('❌ MSD 4PL Sequential analysis failed: No cytokines were successfully analyzed', 'error');
      }
      return;
    }

    const cytokineIndex = currentIndex;
    const cytokineName = CYTOKINES[cytokineIndex];
    const progress = Math.round(((currentIndex + 1) / CYTOKINES.length) * 100);

    console.log(`🔄 MSD Processing cytokine ${currentIndex + 1}/${CYTOKINES.length}: ${cytokineName}`);
    
    // Update progress bar
    updateProgress(progress, `MSD Analyzing ${cytokineName}...`, `${cytokineName} (${currentIndex + 1}/${CYTOKINES.length})`);

    try {
      // Step 1: Set current cytokine in dropdown
      currentCytokine = cytokineIndex;
      const mainSelect = document.getElementById('cytokineSelect');
      if (mainSelect) {
        mainSelect.value = String(cytokineIndex);
      }

      // Step 2: Update standards for this cytokine
      updateStandardInputsForCytokine();

      // Step 3: Run MSD analysis for this cytokine
      const result = await analyzeSingleMSDCytokineAsync(cytokineIndex);
      
      if (result.success) {
        // Store the result
        analysisResults[cytokineIndex] = result.data;
        successfulAnalyses++;
        console.log(`✅ Successfully analyzed ${cytokineName} with MSD 4PL`);
        
        // Step 4: Update the unknowns table for this cytokine
        if (result.data.unknowns && result.data.unknowns.length > 0) {
          console.log(`📊 Updated unknowns table for ${cytokineName} with ${result.data.unknowns.length} samples`);
        }
        
      } else {
        failedAnalyses++;
        console.error(`❌ Failed to analyze ${cytokineName}: ${result.error}`);
      }

    } catch (error) {
      failedAnalyses++;
      console.error(`❌ Error processing ${cytokineName}:`, error);
    }

    currentIndex++;
    
    // Process next cytokine after a small delay
    setTimeout(processNextMSDCytokine, 100);
  }

  // Start processing
  processNextMSDCytokine();
}

function analyzeSingleMSDCytokineAsync(cytokineIndex) {
  return new Promise((resolve) => {
    try {
      const result = runMSDAnalysisForCytokine(cytokineIndex);
      resolve(result);
    } catch (error) {
      resolve({ success: false, error: error.message });
    }
  });
}

// Test MSD back-calculation function
function testMSDBackCalculation() {
  console.log('🧪 Testing MSD back-calculation...');
  
  // Test parameters (reasonable values)
  const testParams = {
    A: 100,
    D: 10000,
    Clog: 2.5, // C = 10^2.5 ≈ 316
    B: 1.5
  };
  
  // Test signals
  const testSignals = [500, 1000, 2000, 5000];
  
  testSignals.forEach(signal => {
    try {
      const result = msd_backcalc4pl_logx(testParams, signal);
      console.log(`Signal ${signal} → Concentration ${result.toFixed(2)}`);
    } catch (e) {
      console.error(`Error with signal ${signal}:`, e);
    }
  });
}

function testMSDAnalysis() {
  console.log('🧪 Testing MSD analysis with sample data...');
  
