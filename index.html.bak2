        </div>
      </div>
    `;
  });
  
  html += `</div>`;
  return html;
}

function generateCorrelationDisplay(results) {
  let html = `<div style="background: white; border: 1px solid #e5e7eb; border-radius: 6px; padding: 16px;">
    <h4 style="margin: 0 0 12px 0; color: #374151; font-size: 14px; font-weight: 600;">Correlations</h4>`;
  
  Object.keys(results.correlations).forEach(var1 => {
    Object.keys(results.correlations[var1]).forEach(var2 => {
      const corr = results.correlations[var1][var2];
      html += `
        <div style="margin-bottom: 4px; font-size: 12px; color: #6b7280;">
          <strong>${var1} vs ${var2}:</strong> r = ${corr.r.toFixed(3)} 
          ${corr.significant ? '(significant)' : '(not significant)'}
        </div>
      `;
    });
  });
  
  html += `</div>`;
  return html;
}

function generateRegressionDisplay(results) {
  let html = `<div style="background: white; border: 1px solid #e5e7eb; border-radius: 6px; padding: 16px;">
    <h4 style="margin: 0 0 12px 0; color: #374151; font-size: 14px; font-weight: 600;">Regression Models</h4>`;
  
  Object.keys(results.models).forEach(compound => {
    const model = results.models[compound];
    html += `
      <div style="margin-bottom: 8px; padding: 8px; background: #f9fafb; border-radius: 4px;">
        <div style="font-weight: 600; color: #374151; font-size: 12px;">${compound}</div>
        <div style="font-size: 11px; color: #6b7280; margin-top: 4px;">
          Slope: ${model.slope.toFixed(3)} | 
          Intercept: ${model.intercept.toFixed(3)} | 
          R²: ${model.rSquared.toFixed(3)}
        </div>
      </div>
    `;
  });
  
  html += `</div>`;
  return html;
}

function generatePowerDisplay(results) {
  let html = `<div style="background: white; border: 1px solid #e5e7eb; border-radius: 6px; padding: 16px;">
    <h4 style="margin: 0 0 12px 0; color: #374151; font-size: 14px; font-weight: 600;">Statistical Power</h4>
    <div style="font-size: 12px; color: #6b7280;">
      <div style="margin-bottom: 8px;"><strong>Effect Size vs Sample Size:</strong></div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(80px, 1fr)); gap: 4px; font-size: 11px;">
        <div style="font-weight: 600;">Effect Size</div>
        <div style="font-weight: 600;">n=10</div>
        <div style="font-weight: 600;">n=20</div>
        <div style="font-weight: 600;">n=30</div>
        <div style="font-weight: 600;">n=50</div>
        <div style="font-weight: 600;">n=100</div>
  `;
  
  Object.keys(results.powerResults).forEach(effectSize => {
    html += `<div style="font-weight: 600;">${effectSize}</div>`;
    Object.keys(results.powerResults[effectSize]).forEach(n => {
      const power = results.powerResults[effectSize][n];
      html += `<div style="color: ${power > 0.8 ? '#059669' : power > 0.5 ? '#d97706' : '#dc2626'};">
        ${(power * 100).toFixed(0)}%
      </div>`;
    });
  });
  
  html += `</div></div></div>`;
  return html;
}

// Display statistical error
function displayStatisticalError(message) {
  const container = document.getElementById('statisticalResultsContainer');
  if (!container) return;
  
  container.innerHTML = `
    <div style="text-align: center; padding: 40px; color: #dc2626;">
      <div style="font-size: 48px; margin-bottom: 16px;">⚠️</div>
      <h3 style="margin: 0 0 8px 0; color: #dc2626; font-size: 18px;">Analysis Error</h3>
      <p style="margin: 0; font-size: 14px;">${message}</p>
    </div>
  `;
}

