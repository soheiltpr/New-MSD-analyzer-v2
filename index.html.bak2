function exportAIConversation() {
  const chatContainer = document.getElementById('aiChatContainer');
  const messages = chatContainer.querySelectorAll('.ai-message');
  
  let exportText = 'MSD Plate Analysis - AI Conversation Export\n';
  exportText += '=' .repeat(50) + '\n\n';
  exportText += `Exported: ${new Date().toLocaleString()}\n\n`;
  
  messages.forEach((message, index) => {
    const isUser = message.classList.contains('ai-user');
    const isSystem = message.classList.contains('ai-system');
    const isAssistant = message.classList.contains('ai-assistant');
    
    let role = 'Unknown';
    if (isUser) role = 'User';
    else if (isSystem) role = 'System';
    else if (isAssistant) role = 'AI Assistant';
    
    const content = message.querySelector('.ai-content');
    if (content) {
      exportText += `[${role}]: ${content.textContent.trim()}\n\n`;
    }
  });
  
  downloadFile(exportText, 'ai-conversation-export.txt', 'text/plain');
  showNotification('Conversation exported', 'success', 2000);
}

function voiceInput() {
  if ('webkitSpeechRecognition' in window) {
    const recognition = new webkitSpeechRecognition();
    recognition.continuous = false;
    recognition.interimResults = false;
    recognition.lang = 'en-US';
    
    recognition.onstart = function() {
      showNotification('Listening... Speak your question', 'info', 3000);
    };
    
    recognition.onresult = function(event) {
      const transcript = event.results[0][0].transcript;
      document.getElementById('aiChatInput').value = transcript;
      showNotification('Voice input captured', 'success', 2000);
    };
    
    recognition.onerror = function(event) {
      showNotification('Voice input error: ' + event.error, 'error', 3000);
    };
    
    recognition.start();
  } else {
    showNotification('Voice input not supported in this browser', 'warning', 3000);
  }
}

