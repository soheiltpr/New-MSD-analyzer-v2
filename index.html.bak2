function resetUnknownsTable() {
  unknownsTableState.filteredData = [...unknownsTableState.data];
  unknownsTableState.sortColumn = -1;
  unknownsTableState.sortDirection = 'asc';
  
  // Reset filters
  document.getElementById('unknownsSearch').value = '';
  document.getElementById('compoundFilter').value = '';
  document.getElementById('rangeFilter').value = '';
  document.getElementById('concMinFilter').value = '';
  document.getElementById('concMaxFilter').value = '';
  
  renderUnknownsTable();
  updateSortIndicators();
  updateStatus('Table reset to default view', 'complete');
}

function toggleReplicateView() {
  const checkbox = document.getElementById('showReplicateSummary');
  const showReplicateSummary = checkbox ? checkbox.checked : false;
  
  console.log('Toggling replicate view:', showReplicateSummary);
  
  if (showReplicateSummary) {
    // Switch to replicate summary view
    createReplicateSummaryView();
  } else {
    // Switch back to detailed view
    renderUnknownsTable();
  }
  
  updateStatus(showReplicateSummary ? 'Switched to replicate summary view' : 'Switched to detailed view', 'info');
}

function toggle5PercentAdjustment() {
  const checkbox = document.getElementById('add5PercentAdjustment');
  if (checkbox) {
    // Refresh the table to apply/remove the 5% adjustment
    if (unknownsTableState.showReplicateSummary) {
      createReplicateSummaryView();
    } else {
      renderUnknownsTable();
    }
    
    // Update status message
    if (checkbox.checked) {
      updateStatus('Applied +5% MSD adjustment to concentrations above range', 'info');
    } else {
      updateStatus('Removed +5% MSD adjustment from concentrations above range', 'info');
    }
  }
}

function createReplicateSummaryView() {
  const tbody = document.getElementById('unknownsTableBody');
  if (!tbody) return;
  
  const { filteredData } = unknownsTableState;
  
  // Check if 5% adjustment is enabled
  const adjustmentCheckbox = document.getElementById('add5PercentAdjustment');
  const applyAdjustment = adjustmentCheckbox && adjustmentCheckbox.checked;
  
  // Group data by compound and design concentration
  const replicateGroups = {};
  
  filteredData.forEach(row => {
    const key = `${row.compound}_${row.designConcentration}`;
    if (!replicateGroups[key]) {
      replicateGroups[key] = [];
    }
    replicateGroups[key].push(row);
  });
  
  // Create summary rows
  const summaryRows = Object.keys(replicateGroups).map(key => {
    const group = replicateGroups[key];
    const isReplicateGroup = group.length > 1;
    
    if (isReplicateGroup) {
      // Create summary for replicate group
      const signals = group.map(r => parseFloat(r.signal)).filter(s => !isNaN(s));
      const concentrations = group.map(r => parseFloat(r.actualConcentration)).filter(c => !isNaN(c));
      const dilutions = group.map(r => parseFloat(r.dilutionFactor)).filter(d => !isNaN(d));
      const rangeStatuses = group.map(r => r.rangeStatus);
      
      const meanSignal = signals.length > 0 ? (signals.reduce((a, b) => a + b, 0) / signals.length).toFixed(2) : 'N/A';
      const meanConcentration = concentrations.length > 0 ? (concentrations.reduce((a, b) => a + b, 0) / concentrations.length).toFixed(2) : 'N/A';
      
      // Check if all dilutions are the same
      const allSameDilution = dilutions.every(d => d === dilutions[0]);
      const dilutionFactor = allSameDilution ? dilutions[0] : 'Mixed';
      
      // Determine combined range status
      let combinedRangeStatus = '';
      const uniqueRanges = [...new Set(rangeStatuses.filter(r => r))];
      if (uniqueRanges.length === 1) {
        combinedRangeStatus = uniqueRanges[0];
      } else {
        combinedRangeStatus = uniqueRanges.join(', ');
      }
      
      // Calculate CV% for replicates
      let cvPercent = '';
      if (concentrations.length > 1) {
        const mean = parseFloat(meanConcentration);
        const variance = concentrations.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / concentrations.length;
        const stdDev = Math.sqrt(variance);
        cvPercent = mean > 0 ? ((stdDev / mean) * 100).toFixed(1) : 'N/A';
      }
      
      // Create well range display (e.g., "A2-A4")
      const wells = group.map(r => r.well).sort();
      const wellDisplay = wells.length > 1 ? `${wells[0]}-${wells[wells.length - 1]}` : wells[0];
      
      return {
        well: wellDisplay,
        compound: group[0].compound,
        signal: meanSignal,
        actualConcentration: meanConcentration,
        designConcentration: group[0].designConcentration,
        dilutionFactor: dilutionFactor,
        meanReplicates: meanConcentration,
        stdDev: concentrations.length > 1 ? (Math.sqrt(concentrations.reduce((sum, val) => sum + Math.pow(val - parseFloat(meanConcentration), 2), 0) / concentrations.length)).toFixed(2) : '',
        cvPercent: cvPercent,
        rangeStatus: combinedRangeStatus,
        recovery: group[0].recovery,
        isReplicateGroup: true,
        isFirstInGroup: true,
        groupKey: key,
        originalData: group
      };
    } else {
      // Single sample - return as is
      return group[0];
    }
  });
  
  // Render summary rows
  tbody.innerHTML = summaryRows.map((row, index) => {
    const rowClass = row.isReplicateGroup ? 'duplicate-row' : '';
    const firstInGroupClass = row.isFirstInGroup ? 'first-in-group' : '';
    
    return `
      <tr class="${rowClass} ${firstInGroupClass}" data-index="${index}">
        <td>${row.well}</td>
        <td>${row.compound}</td>
        <td>${row.signal}</td>
        <td>${getOriginalConcentration(row.well, applyAdjustment)}</td>
        <td>${getModifiedConcentration(row.well, applyAdjustment)}</td>
        <td>${row.designConcentration}</td>
        <td>${row.dilutionFactor}</td>
        <td>${getAdjustedConcentration(row.meanReplicates, applyAdjustment, row.rangeStatus, row.isAboveULOQ)}</td>
        <td>${row.stdDev}</td>
        <td>${row.cvPercent}</td>
        <td><span class="range-badge range-${row.rangeStatus.toLowerCase().replace(' ', '-')}">${row.rangeStatus}</span></td>
        <td>${row.recovery}</td>
        <td>
          <button class="btn-tiny" onclick="highlightOnPlot('${row.well}')" title="Highlight on plot">📍</button>
          <button class="btn-tiny" onclick="showSampleDetails('${row.well}')" title="Show sample details">ℹ️</button>
          <button class="btn-tiny" onclick="exportSampleData('${row.well}')" title="Export sample data">📤</button>
          <button class="btn-tiny" onclick="recalculateSample('${row.well}')" title="Recalculate concentration">🔄</button>
        </td>
      </tr>
    `;
  }).join('');
  
  updateRowCount();
}

