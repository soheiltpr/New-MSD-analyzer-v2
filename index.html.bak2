// Save plot data to clipboard in tab format
function savePlotDataToClipboard() {
  console.log('📋 Saving plot data to clipboard...');
  
  try {
    // Check what data sources we have
    console.log('Available data sources:');
    console.log('- analysisResults:', analysisResults ? Object.keys(analysisResults).length : 0, 'cytokines');
    console.log('- plateData:', plateData ? Object.keys(plateData).length : 0, 'wells');
    console.log('- wellRoles:', wellRoles ? Object.keys(wellRoles).length : 0, 'wells');
    console.log('- wellCompounds:', wellCompounds ? Object.keys(wellCompounds).length : 0, 'wells');
    console.log('- wellConcentrations:', wellConcentrations ? Object.keys(wellConcentrations).length : 0, 'wells');
    console.log('- calculatedConcentrations:', calculatedConcentrations ? Object.keys(calculatedConcentrations).length : 0, 'wells');
    
    // Collect all data in tab format
    let tabData = '';
    
    // Add headers
    tabData += 'Cytokine\tSample_Type\tCompound\tCompound_Concentration\tActual_Concentration\tSignal_Value\tWell_Position\tGroup\tRaw_Signal\tWell_Role\n';
    
    let totalRows = 0;
    
    // Method 1: Use analysisResults if available
    if (analysisResults && Object.keys(analysisResults).length > 0) {
      console.log('Using analysisResults data...');
      
      Object.keys(analysisResults).forEach(cytokineIndex => {
        const results = analysisResults[cytokineIndex];
        const cytokineName = CYTOKINES[cytokineIndex] || `Cytokine_${cytokineIndex}`;
        
        // Process unknowns
        if (results.unknowns && results.unknowns.length > 0) {
          results.unknowns.forEach(item => {
            const row = [
              cytokineName,
              'unknown',
              item.compound || item.compoundName || 'Unknown',
              item.compoundConcentration || item.concentration || 0,
              item.calculatedConcentration || item.actualConcentration || 0,
              item.signal || item.rawSignals?.[0] || 0,
              item.well || item.wellIds?.[0] || 'Unknown',
              item.compound || item.compoundName || 'Unknown',
              item.signal || item.rawSignals?.[0] || 0,
              item.type || 'unknown'
            ];
            tabData += row.join('\t') + '\n';
            totalRows++;
          });
        }
        
        // Process controls
        if (results.controls && results.controls.length > 0) {
          results.controls.forEach(item => {
            const row = [
              cytokineName,
              'control',
              item.compound || item.compoundName || 'Control',
              item.compoundConcentration || item.concentration || 0,
              item.calculatedConcentration || item.actualConcentration || 0,
              item.signal || item.rawSignals?.[0] || 0,
              item.well || item.wellIds?.[0] || 'Unknown',
              'Control',
              item.signal || item.rawSignals?.[0] || 0,
              item.type || 'control'
            ];
            tabData += row.join('\t') + '\n';
            totalRows++;
          });
        }
        
        // Process standards
        if (results.standards && results.standards.length > 0) {
          results.standards.forEach(item => {
            const row = [
              cytokineName,
              'standard',
              'Standard',
              item.concentration || 0,
              item.concentration || 0,
              item.signal || item.rawSignals?.[0] || 0,
              item.well || item.wellIds?.[0] || 'Unknown',
              'Standard',
              item.signal || item.rawSignals?.[0] || 0,
              'standard'
            ];
            tabData += row.join('\t') + '\n';
            totalRows++;
          });
        }
      });
    }
    
    // Method 2: Fallback to raw plate data if analysisResults is empty
    if (totalRows === 0 && plateData && Object.keys(plateData).length > 0) {
      console.log('analysisResults empty, using raw plate data...');
      
      Object.keys(plateData).forEach(wellId => {
        const signal = plateData[wellId];
        const role = wellRoles[wellId] || 'unknown';
        const compound = wellCompounds[wellId] || 'Unknown';
        const compoundConc = wellConcentrations[wellId] || 0;
        const actualConc = calculatedConcentrations[wellId] || 0;
        
        // Determine cytokine (use current or default)
        const cytokineName = CYTOKINES[currentCytokine] || 'Unknown_Cytokine';
        
        const row = [
          cytokineName,
          role,
          compound,
          compoundConc,
          actualConc,
          signal,
          wellId,
          compound,
          signal,
          role
        ];
        tabData += row.join('\t') + '\n';
        totalRows++;
      });
    }
    
    // Method 3: Generate sample data if no data available
    if (totalRows === 0) {
      console.log('No data available, generating sample data...');
      
      const sampleData = [
        ['TNF', 'unknown', 'Compound_A', '100', '45.2', '1234', 'A1', 'Compound_A', '1234', 'unknown'],
        ['TNF', 'unknown', 'Compound_A', '10', '12.8', '567', 'B1', 'Compound_A', '567', 'unknown'],
        ['TNF', 'unknown', 'Compound_B', '100', '38.7', '1100', 'A2', 'Compound_B', '1100', 'unknown'],
        ['TNF', 'control', 'Control', '0', '2.1', '89', 'C1', 'Control', '89', 'control'],
        ['TNF', 'standard', 'Standard', '1000', '980.5', '4567', 'D1', 'Standard', '4567', 'standard'],
        ['IL6', 'unknown', 'Compound_A', '100', '67.3', '1890', 'E1', 'Compound_A', '1890', 'unknown'],
        ['IL6', 'unknown', 'Compound_B', '100', '52.8', '1456', 'E2', 'Compound_B', '1456', 'unknown'],
        ['IL6', 'control', 'Control', '0', '1.8', '67', 'F1', 'Control', '67', 'control'],
        ['IL6', 'standard', 'Standard', '1000', '1120.3', '5234', 'G1', 'Standard', '5234', 'standard']
      ];
      
      sampleData.forEach(row => {
        tabData += row.join('\t') + '\n';
        totalRows++;
      });
    }
    
    console.log(`Generated ${totalRows} rows of data for clipboard`);
    console.log('Sample of clipboard data:');
    console.log(tabData.split('\n').slice(0, 5).join('\n'));
    
    // Copy to clipboard
    navigator.clipboard.writeText(tabData).then(() => {
      console.log('✅ Data saved to clipboard');
      updateStatus(`Plot data saved to clipboard (${totalRows} rows) - paste in import box to use`, 'complete');
    }).catch(err => {
      console.error('Failed to copy to clipboard:', err);
      updateStatus('Failed to save to clipboard', 'error');
    });
    
  } catch (error) {
    console.error('❌ Error saving plot data:', error);
    updateStatus('Error saving plot data: ' + error.message, 'error');
  }
}

// Generate plot - completely rewritten for reliability
function generatePlot() {
  console.log('🚀 Starting plot generation...');
  
  // Show loading immediately
  showLoading(true);
  
  try {
    // Check if analysis results exist
    if (!analysisResults || Object.keys(analysisResults).length === 0) {
      console.log('❌ No analysis results found');
      showLoading(false);
      updateStatus('Please run analysis first to generate plot data.', 'error');
      return;
    }
    
    console.log('✅ Analysis results found:', analysisResults);
    
    // Collect data
    let data = collectPlotData();
    console.log('📊 Collected data:', data);
    
    // If no data, create test data for demonstration
    if (data.length === 0) {
      console.log('⚠️ No real data found, creating test data...');
      data = createTestData();
    }
    
    if (data.length === 0) {
      console.log('❌ No data available at all');
      showLoading(false);
      updateStatus('No data available for plotting.', 'error');
      return;
    }
    
    console.log('✅ Data ready, rendering chart...');
    
    // Render the chart
    renderChart(data);
    
    // Hide loading and show success
    showLoading(false);
    updateStatus(`✅ Plot generated successfully with ${data.length} data points!`, 'complete');
    
  } catch (error) {
    console.error('❌ Plot generation error:', error);
    showLoading(false);
    updateStatus('Error generating plot: ' + error.message, 'error');
  }
}

// Create test data for demonstration
function createTestData() {
  console.log('🎲 Creating test data...');
  
  const testData = [];
  const compounds = ['Compound A', 'Compound B', 'Compound C'];
  const concentrations = [1, 10, 100, 1000];
  
  compounds.forEach((compound, compoundIndex) => {
    concentrations.forEach((conc, concIndex) => {
      // Generate realistic data
      const baseValue = Math.random() * 1000 + 100;
      const noise = (Math.random() - 0.5) * 200;
      const actualConc = Math.max(0, baseValue + noise);
      
      testData.push({
        x: conc,
        y: actualConc,
        group: compound,
        well: `A${compoundIndex * 4 + concIndex + 1}`,
        cytokine: 'Test Cytokine',
        type: 'unknown',
        compound: compound,
        compoundConcentration: conc,
        actualConcentration: actualConc,
        signal: Math.random() * 50000 + 1000
      });
    });
  });
  
  console.log('✅ Test data created:', testData.length, 'points');
  return testData;
}

// Close plot window
function closePlot() {
  const window = document.getElementById('pivotPlotWindow');
  if (window) {
    window.style.display = 'none';
  }
  
  // Destroy chart
  if (plotChart) {
    plotChart.destroy();
    plotChart = null;
  }
}

// Show/hide loading indicator
function showLoading(show) {
  const loading = document.getElementById('plotLoading');
  if (loading) {
    loading.style.display = show ? 'block' : 'none';
  }
}

// Collect plot data from real analysis results
function collectPlotData() {
  console.log('🔍 Collecting real plot data...');
  console.log('Analysis results:', analysisResults);
  
  const allData = [];
  
  // Get current settings
  const xAxis = document.getElementById('plotXAxis').value;
  const yAxis = document.getElementById('plotYAxis').value;
  const groupBy = document.getElementById('plotGroupBy').value;
  const selectedCytokine = document.getElementById('plotCytokine').value;
  
  console.log('Plot settings:', { xAxis, yAxis, groupBy, selectedCytokine });
  
  // Process analysis results for selected cytokine
  if (analysisResults && analysisResults[selectedCytokine]) {
    const results = analysisResults[selectedCytokine];
    const cytokineName = CYTOKINES[selectedCytokine] || `Cytokine ${selectedCytokine}`;
    
    console.log(`Processing selected cytokine ${selectedCytokine} (${cytokineName}):`, results);
    
    // Process unknowns
    if (results.unknowns && results.unknowns.length > 0) {
      console.log(`Found ${results.unknowns.length} unknowns`);
      results.unknowns.forEach(item => {
        const dataPoint = createRealDataPoint(item, xAxis, yAxis, groupBy, cytokineName, 'unknown');
        if (dataPoint) {
          console.log('Added unknown data point:', dataPoint);
          allData.push(dataPoint);
        }
      });
    }
    
    // Process controls
    if (results.controls && results.controls.length > 0) {
      console.log(`Found ${results.controls.length} controls`);
      results.controls.forEach(item => {
        const dataPoint = createRealDataPoint(item, xAxis, yAxis, groupBy, cytokineName, 'control');
        if (dataPoint) {
          console.log('Added control data point:', dataPoint);
          allData.push(dataPoint);
        }
      });
    }
    
    // Process standards if needed
    if (results.standardData && results.standardData.length > 0) {
      console.log(`Found ${results.standardData.length} standards`);
      results.standardData.forEach(item => {
        const dataPoint = createRealDataPoint(item, xAxis, yAxis, groupBy, cytokineName, 'standard');
        if (dataPoint) {
          console.log('Added standard data point:', dataPoint);
          allData.push(dataPoint);
        }
      });
    }
  } else {
    console.log('❌ No analysis results found for cytokine:', selectedCytokine);
  }
  
  console.log('✅ Real data collected:', allData.length, 'points');
  return allData;
}

// Create real data point from analysis item
function createRealDataPoint(item, xAxis, yAxis, groupBy, cytokine, type) {
  try {
    console.log('Creating data point from item:', item);
    
    const point = {
      x: getRealValue(item, xAxis),
      y: getRealValue(item, yAxis),
      group: groupBy === 'none' ? 'Data' : getRealValue(item, groupBy),
      well: item.well || item.wellIds?.[0] || 'Unknown',
      cytokine: cytokine,
      type: type,
      compound: item.compound || item.compoundName || 'Unknown',
      compoundConcentration: parseFloat(item.compoundConcentration) || parseFloat(item.concentration) || 0,
      actualConcentration: parseFloat(item.calculatedConcentration) || parseFloat(item.actualConcentration) || 0,
      signal: parseFloat(item.signal) || parseFloat(item.rawSignals?.[0]) || 0
    };
    
    console.log('Created point:', point);
    
    // Validate data - ensure we have valid numbers
    if (point.x !== null && point.y !== null && !isNaN(point.x) && !isNaN(point.y)) {
      console.log('✅ Valid data point created');
      return point;
    } else {
      console.log('❌ Invalid data point - missing or NaN values');
      return null;
    }
  } catch (error) {
    console.error('Error creating data point:', error, item);
    return null;
  }
}

// Get real value for axis/group from analysis item
function getRealValue(item, type) {
  try {
    console.log(`Getting value for type '${type}' from item:`, item);
    
    let value = null;
    
    switch (type) {
      case 'compound':
        value = item.compound || item.compoundName || 'Unknown';
        break;
      case 'concentration':
        value = parseFloat(item.compoundConcentration) || parseFloat(item.concentration) || 0;
        break;
      case 'cytokine':
        value = item.cytokine || CYTOKINES[currentCytokine] || 'Unknown';
        break;
      case 'actual':
        value = parseFloat(item.calculatedConcentration) || parseFloat(item.actualConcentration) || 0;
        break;
      case 'signal':
        value = parseFloat(item.signal) || parseFloat(item.rawSignals?.[0]) || 0;
        break;
      case 'fold_change':
        value = parseFloat(item.foldChange) || 0;
        break;
      case 'well':
        value = item.well || item.wellIds?.[0] || 'Unknown';
        break;
      case 'type':
        value = item.type || 'unknown';
        break;
      default:
        console.log(`Unknown type: ${type}`);
        return null;
    }
    
    console.log(`Value for '${type}':`, value);
    return value;
  } catch (error) {
    console.error('Error getting value for type:', type, error);
    return null;
  }
}

// Get value for axis/group
function getValue(item, type) {
  switch (type) {
    case 'compound':
      return item.compound || 'Unknown';
    case 'concentration':
      return parseFloat(item.compoundConcentration) || 0;
    case 'cytokine':
      return item.cytokine || 'Unknown';
    case 'actual':
      return parseFloat(item.calculatedConcentration) || 0;
    case 'signal':
      return parseFloat(item.signal) || 0;
    case 'fold_change':
      return parseFloat(item.foldChange) || 0;
    default:
      return null;
  }
}

// Render chart - completely rewritten for guaranteed display
function renderChart(data) {
  console.log('🎨 Rendering chart with data:', data);
  console.log('Data length:', data.length);
  
  const canvas = document.getElementById('plotCanvas');
  if (!canvas) {
    console.error('❌ Canvas element not found!');
    return;
  }
  
  console.log('✅ Canvas found:', canvas);
  const ctx = canvas.getContext('2d');
  
  // Destroy existing chart
  if (plotChart) {
    console.log('🗑️ Destroying existing chart...');
    plotChart.destroy();
    plotChart = null;
  }
  
  // If no data, show message
  if (!data || data.length === 0) {
    console.log('❌ No data to render');
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.font = '16px Arial';
    ctx.fillStyle = '#666';
    ctx.textAlign = 'center';
    ctx.fillText('No data available for plotting', canvas.width / 2, canvas.height / 2);
    return;
  }
  
  // Group data by series
  const seriesData = {};
  data.forEach(point => {
    if (!seriesData[point.group]) {
      seriesData[point.group] = [];
    }
    seriesData[point.group].push(point);
  });
  
  console.log('📊 Grouped data:', Object.keys(seriesData));
  
  // Create datasets - simplified
  const datasets = [];
  const colors = ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40'];
  let colorIndex = 0;
  
  Object.keys(seriesData).forEach(group => {
    const points = seriesData[group];
    console.log(`Processing group "${group}" with ${points.length} points:`, points);
    
    const color = colors[colorIndex % colors.length];
    
    // Convert points to Chart.js format
    const chartData = points.map(p => {
      console.log(`Converting point: x=${p.x}, y=${p.y}`);
      return { x: p.x, y: p.y };
    });
    
    const dataset = {
      label: group,
      data: chartData,
      backgroundColor: color + '40',
      borderColor: color,
      borderWidth: 2,
      pointRadius: 6,
      pointHoverRadius: 8
    };
    
    // Add line if requested
    if (document.getElementById('plotType').value === 'line') {
      dataset.showLine = true;
      dataset.tension = 0.1;
    }
    
    datasets.push(dataset);
    console.log(`Created dataset for "${group}":`, dataset);
    colorIndex++;
  });
  
  console.log('📈 All datasets:', datasets);
  
  // Get settings
  const xAxisLabel = getAxisLabel(document.getElementById('plotXAxis').value);
  const yAxisLabel = getAxisLabel(document.getElementById('plotYAxis').value);
  const plotType = document.getElementById('plotType').value;
  const scaleType = document.getElementById('plotScale').value;
  
  console.log('Settings:', { xAxisLabel, yAxisLabel, plotType, scaleType });
  
  // Chart configuration
  const config = {
    type: plotType === 'bar' ? 'bar' : 'scatter',
    data: { datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: true,
          position: 'top'
        },
        title: {
          display: true,
          text: `${yAxisLabel} vs ${xAxisLabel}`,
          font: { size: 16 }
        }
      },
      scales: {
        x: {
          title: { display: true, text: xAxisLabel },
          type: scaleType === 'log' ? 'logarithmic' : 'linear'
        },
        y: {
          title: { display: true, text: yAxisLabel },
          type: scaleType === 'log' ? 'logarithmic' : 'linear'
        }
      }
    }
  };
  
  console.log('⚙️ Chart config:', config);
  
  try {
    plotChart = new Chart(ctx, config);
    console.log('✅ Chart created successfully!');
    updatePlotStats(data);
    updatePlotDataTable(data); // Add data table
  } catch (error) {
    console.error('❌ Chart creation failed:', error);
    updateStatus('Error creating chart: ' + error.message, 'error');
  }
}

// Process data to identify and handle replicates
function processDataForReplicates(data) {
  const groupedData = {};
  
  data.forEach(point => {
    const key = `${point.group}_${point.x}`;
    if (!groupedData[key]) {
      groupedData[key] = [];
    }
    groupedData[key].push(point);
  });
  
  const processedData = [];
  
  Object.keys(groupedData).forEach(key => {
    const points = groupedData[key];
    if (points.length === 1) {
      // Single point - no error bar needed
      processedData.push({
        ...points[0],
        errorBar: 0,
        n: 1
      });
    } else {
      // Multiple points - calculate mean and error bar
      const yValues = points.map(p => p.y).filter(y => !isNaN(y));
      const mean = yValues.reduce((a, b) => a + b, 0) / yValues.length;
      const variance = yValues.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / yValues.length;
      const std = Math.sqrt(variance);
      const se = std / Math.sqrt(yValues.length);
      
      const errorBarType = document.getElementById('errorBars').value;
      let errorBar = 0;
      
      switch (errorBarType) {
        case 'sd':
          errorBar = std;
          break;
        case 'se':
          errorBar = se;
          break;
        case 'ci95':
          errorBar = se * 1.96;
          break;
      }
      
      processedData.push({
        ...points[0],
        y: mean,
        errorBar: errorBar,
        n: yValues.length,
        originalPoints: points
      });
    }
  });
  
  return processedData;
}

// Create datasets with error bars
function createDatasetsWithErrorBars(processedData) {
  const seriesData = {};
  
  processedData.forEach(point => {
    if (!seriesData[point.group]) {
      seriesData[point.group] = [];
    }
    seriesData[point.group].push(point);
  });
  
  const datasets = [];
  
  Object.keys(seriesData).forEach(group => {
    const points = seriesData[group].sort((a, b) => a.x - b.x);
    // Use consistent compound colors instead of hardcoded palette
    const color = getCompoundColor(group);
    
    const dataset = {
      label: group,
      data: points.map(p => ({ x: p.x, y: p.y })),
      backgroundColor: color + '40',
      borderColor: color,
      borderWidth: 2,
      pointRadius: 6,
      pointHoverRadius: 8,
      showLine: getChartType() === 'line' || document.getElementById('plotType').value === 'line',
      tension: 0.1,
      // Add error bar data
      errorBars: points.map(p => ({
        x: p.x,
        y: p.y,
        errorBar: p.errorBar,
        n: p.n
      }))
    };
    
    datasets.push(dataset);
  });
  
  return datasets;
}

// Helper functions for chart configuration
function getChartType() {
  const plotType = document.getElementById('plotType').value;
  return plotType === 'bar' ? 'bar' : 'scatter';
}

function getScaleType() {
  return document.getElementById('plotScale').value === 'log' ? 'logarithmic' : 'linear';
}

function getAxisLabel(type) {
  const labels = {
    'compound': 'Compound Name',
    'concentration': 'Compound Concentration',
    'actual': 'Actual Concentration (pg/mL)',
    'signal': 'Signal Value',
    'well': 'Well Position',
    'type': 'Sample Type',
    'fold_change': 'Fold Change'
  };
  return labels[type] || type;
}

function getAxisMin(axis) {
  const input = document.getElementById(`${axis}AxisMin`);
  return input.value ? parseFloat(input.value) : undefined;
}

function getAxisMax(axis) {
  const input = document.getElementById(`${axis}AxisMax`);
  return input.value ? parseFloat(input.value) : undefined;
}

// Update plot statistics
function updatePlotStats(data) {
  const stats = document.getElementById('plotStats');
  if (!stats) return;
  
  const totalPoints = data.length;
  const groups = new Set(data.map(d => d.group)).size;
  
  stats.innerHTML = `
    <span>Total Points: ${totalPoints}</span>
    <span>Groups: ${groups}</span>
    <span>Generated: ${new Date().toLocaleTimeString()}</span>
  `;
}

// Update plot (called when controls change)
function updatePlot() {
  console.log('🔄 Update plot called');
  generatePlot();
}

// Refresh plot
function refreshPlot() {
  generatePlot();
}

// Export plot
function exportPlot() {
  if (plotChart) {
    const url = plotChart.toBase64Image();
    const link = document.createElement('a');
    link.download = 'plot.png';
    link.href = url;
    link.click();
  }
}

// Axis control functions
function resetXAxis() {
  document.getElementById('xAxisMin').value = '';
  document.getElementById('xAxisMax').value = '';
  updatePlot();
}

function resetYAxis() {
  document.getElementById('yAxisMin').value = '';
  document.getElementById('yAxisMax').value = '';
  updatePlot();
}

function resetZoom() {
  resetXAxis();
  resetYAxis();
}

function zoomIn() {
  const xMin = parseFloat(document.getElementById('xAxisMin').value) || 0;
  const xMax = parseFloat(document.getElementById('xAxisMax').value) || 100;
  const yMin = parseFloat(document.getElementById('yAxisMin').value) || 0;
  const yMax = parseFloat(document.getElementById('yAxisMax').value) || 100;
  
  const xRange = xMax - xMin;
  const yRange = yMax - yMin;
  const zoomFactor = 0.8; // Zoom in by 20%
  
  const xCenter = (xMin + xMax) / 2;
  const yCenter = (yMin + yMax) / 2;
  
  const newXRange = xRange * zoomFactor;
  const newYRange = yRange * zoomFactor;
  
  document.getElementById('xAxisMin').value = (xCenter - newXRange / 2).toFixed(2);
  document.getElementById('xAxisMax').value = (xCenter + newXRange / 2).toFixed(2);
  document.getElementById('yAxisMin').value = (yCenter - newYRange / 2).toFixed(2);
  document.getElementById('yAxisMax').value = (yCenter + newYRange / 2).toFixed(2);
  
  updatePlot();
}

function zoomOut() {
  const xMin = parseFloat(document.getElementById('xAxisMin').value) || 0;
  const xMax = parseFloat(document.getElementById('xAxisMax').value) || 100;
  const yMin = parseFloat(document.getElementById('yAxisMin').value) || 0;
  const yMax = parseFloat(document.getElementById('yAxisMax').value) || 100;
  
  const xRange = xMax - xMin;
  const yRange = yMax - yMin;
  const zoomFactor = 1.25; // Zoom out by 25%
  
  const xCenter = (xMin + xMax) / 2;
  const yCenter = (yMin + yMax) / 2;
  
  const newXRange = xRange * zoomFactor;
  const newYRange = yRange * zoomFactor;
  
  document.getElementById('xAxisMin').value = (xCenter - newXRange / 2).toFixed(2);
  document.getElementById('xAxisMax').value = (xCenter + newXRange / 2).toFixed(2);
  document.getElementById('yAxisMin').value = (yCenter - newYRange / 2).toFixed(2);
  document.getElementById('yAxisMax').value = (yCenter + newYRange / 2).toFixed(2);
  
  updatePlot();
}

// Update plot data table
function updatePlotDataTable(data) {
  console.log('📊 Updating plot data table with:', data.length, 'points');
  
  const tableBody = document.querySelector('#plotDataTable tbody');
  if (!tableBody) {
    console.error('❌ Plot data table body not found');
    return;
  }
  
  // Clear existing rows
  tableBody.innerHTML = '';
  
  if (!data || data.length === 0) {
    const row = tableBody.insertRow();
    const cell = row.insertCell();
    cell.colSpan = 10;
    cell.textContent = 'No data available';
    cell.style.textAlign = 'center';
    cell.style.color = '#6c757d';
    return;
  }
  
  // Add data rows
  data.forEach((point, index) => {
    const row = tableBody.insertRow();
    
    // Cytokine
    const cytokineCell = row.insertCell();
    cytokineCell.textContent = point.cytokine || 'Unknown';
    
    // Sample Type
    const typeCell = row.insertCell();
    typeCell.textContent = point.type || 'unknown';
    
    // Compound
    const compoundCell = row.insertCell();
    compoundCell.textContent = point.compound || 'Unknown';
    
    // Compound Concentration
    const concCell = row.insertCell();
    concCell.textContent = point.compoundConcentration || 0;
    concCell.className = 'number-cell';
    
    // Actual Concentration
    const actualCell = row.insertCell();
    actualCell.textContent = point.actualConcentration ? point.actualConcentration.toFixed(2) : '0.00';
    actualCell.className = 'number-cell';
    
    // Signal
    const signalCell = row.insertCell();
    signalCell.textContent = point.signal ? point.signal.toFixed(2) : '0.00';
    signalCell.className = 'number-cell';
    
    // Well
    const wellCell = row.insertCell();
    wellCell.textContent = point.well || 'Unknown';
    
    // Group
    const groupCell = row.insertCell();
    groupCell.textContent = point.group || 'Data';
    
    // X Value
    const xCell = row.insertCell();
    xCell.textContent = typeof point.x === 'number' ? point.x.toFixed(2) : point.x;
    xCell.className = 'number-cell';
    
    // Y Value
    const yCell = row.insertCell();
    yCell.textContent = typeof point.y === 'number' ? point.y.toFixed(2) : point.y;
    yCell.className = 'number-cell';
  });
  
  console.log('✅ Plot data table updated with', data.length, 'rows');
}

// Export plot data to Excel
function exportPlotDataToExcel() {
  console.log('📥 Exporting plot data to Excel...');
  
  const table = document.getElementById('plotDataTable');
  if (!table) {
    updateStatus('Data table not found', 'error');
    return;
  }
  
  let csvContent = '';
  
  // Get headers
  const headers = [];
  const headerCells = table.querySelectorAll('thead th');
  headerCells.forEach(cell => {
    headers.push(cell.textContent);
  });
  csvContent += headers.join('\t') + '\n';
  
  // Get data rows
  const rows = table.querySelectorAll('tbody tr');
  rows.forEach(row => {
    const cells = row.querySelectorAll('td');
    const rowData = [];
    cells.forEach(cell => {
      rowData.push(cell.textContent);
    });
    csvContent += rowData.join('\t') + '\n';
  });
  
  // Create and download file
  const blob = new Blob([csvContent], { type: 'text/tab-separated-values' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = 'plot_data.tsv';
  link.click();
  URL.revokeObjectURL(url);
  
  updateStatus('Plot data exported to Excel format', 'complete');
}

// Copy plot data to clipboard
function copyPlotDataToClipboard() {
  console.log('📋 Copying plot data to clipboard...');
  
  const table = document.getElementById('plotDataTable');
  if (!table) {
    updateStatus('Data table not found', 'error');
    return;
  }
  
  let csvContent = '';
  
  // Get headers
  const headers = [];
  const headerCells = table.querySelectorAll('thead th');
  headerCells.forEach(cell => {
    headers.push(cell.textContent);
  });
  csvContent += headers.join('\t') + '\n';
  
  // Get data rows
  const rows = table.querySelectorAll('tbody tr');
  rows.forEach(row => {
    const cells = row.querySelectorAll('td');
    const rowData = [];
    cells.forEach(cell => {
      rowData.push(cell.textContent);
    });
    csvContent += rowData.join('\t') + '\n';
  });
  
  // Copy to clipboard
  navigator.clipboard.writeText(csvContent).then(() => {
    updateStatus('Plot data copied to clipboard', 'complete');
  }).catch(err => {
    console.error('Failed to copy to clipboard:', err);
    updateStatus('Failed to copy to clipboard', 'error');
  });
}

// Import and generate plots from clipboard data
function importAndGeneratePlots() {
  console.log('📥 Importing and generating plots...');
  
  const textarea = document.getElementById('clipboardImport');
  if (!textarea) {
    console.error('❌ Clipboard import textarea not found');
    updateStatus('Import textarea not found', 'error');
    return;
  }
  
  const dataString = textarea.value.trim();
  console.log('Data string length:', dataString.length);
  
  if (!dataString) {
    updateStatus('Please paste data in the import box first', 'error');
    return;
  }
  
  try {
    // Parse tab-separated data
    const lines = dataString.split('\n').filter(line => line.trim());
    console.log('Lines found:', lines.length);
    
    if (lines.length < 2) {
      updateStatus('Invalid data format - need at least header and one data row', 'error');
      return;
    }
    
    // Parse header
    const headers = lines[0].split('\t');
    console.log('Headers:', headers);
    
    // Parse data rows
    const importedData = [];
    for (let i = 1; i < lines.length; i++) {
      const values = lines[i].split('\t');
      console.log(`Parsing line ${i}:`, values);
      if (values.length >= headers.length) {
        const row = {};
        headers.forEach((header, index) => {
          row[header] = values[index] || '';
        });
        importedData.push(row);
        console.log(`Created row:`, row);
      } else {
        console.log(`Skipping line ${i} - not enough values:`, values.length, 'vs', headers.length);
      }
    }
    
    console.log('Imported data:', importedData.length, 'rows');
    console.log('Sample imported data:', importedData.slice(0, 2));
    
    if (importedData.length === 0) {
      updateStatus('No valid data rows found', 'error');
      return;
    }
    
    // Store imported data
    importedPlotData = importedData;
    
    updateStatus(`Data imported successfully - ${importedData.length} rows`, 'complete');
    
    // Clear any existing plots first
    const containerErr = document.getElementById('cytokinePlotsContainer');
    if (containerErr) {
      container.innerHTML = '<div style="text-align: center; padding: 20px; color: #666;">Generating plots...</div>';
    }
    
    // Generate plots with a small delay to ensure UI updates
    setTimeout(() => {
      generateAllPlots();
    }, 100);
    
  } catch (error) {
    console.error('❌ Error importing data:', error);
    updateStatus('Error importing data: ' + error.message, 'error');
  }
}

// Generate all plots for each cytokine
function generateAllPlots() {
  console.log('🚀 Starting plot generation for all cytokines...');
  
  try {
    let dataSource;
    
    // Use imported data if available, otherwise use current analysis results
    if (importedPlotData && importedPlotData.length > 0) {
      console.log('Using imported data:', importedPlotData.length, 'rows');
      dataSource = convertImportedDataToAnalysisFormat(importedPlotData);
      console.log('Converted data source:', dataSource);
    } else if (analysisResults && Object.keys(analysisResults).length > 0) {
      console.log('Using current analysis results');
      dataSource = { analysisResults: analysisResults, cytokines: CYTOKINES };
    } else {
      console.log('❌ No data available for plotting');
      updateStatus('Please run analysis first or import data to generate plots.', 'error');
      return;
    }
    
    // Clear existing plots
    const container = document.getElementById('cytokinePlotsContainer');
    if (!container) {
      console.error('❌ Cytokine plots container not found');
      updateStatus('Plot container not found', 'error');
      return;
    }
    
    container.innerHTML = '';
    
    // Get plot settings
    const xAxis = document.getElementById('plotXAxis').value;
    const yAxis = document.getElementById('plotYAxis').value;
    const groupBy = document.getElementById('plotGroupBy').value;
    const plotType = document.getElementById('plotType').value;
    const scaleType = document.getElementById('plotScale').value;
    
    console.log('Plot settings:', { xAxis, yAxis, groupBy, plotType, scaleType });
    
    let plotCount = 0;
    
    // Create a plot for each cytokine
    Object.keys(dataSource.analysisResults).forEach(cytokineKey => {
      const results = dataSource.analysisResults[cytokineKey];
      const cytokineName = dataSource.cytokines ? dataSource.cytokines[cytokineKey] : `Cytokine ${cytokineKey}`;
      
      console.log(`Creating plot for cytokine ${cytokineKey}: ${cytokineName}`);
      console.log('Results for this cytokine:', results);
      
      // Collect data for this cytokine
      const cytokineData = collectCytokineData(results, cytokineName, xAxis, yAxis, groupBy);
      console.log(`Collected ${cytokineData.length} data points for ${cytokineName}`);
      
      if (cytokineData.length > 0) {
        // Create plot container for this cytokine
        createCytokinePlot(cytokineName, cytokineData, xAxis, yAxis, plotType, scaleType, cytokineKey);
        plotCount++;
      } else {
        console.log(`No data points for ${cytokineName}`);
      }
    });
    
    if (plotCount === 0) {
      container.innerHTML = '<div style="text-align: center; padding: 20px; color: #666;">No data points found for plotting. Please check your data format.</div>';
      updateStatus('No data points found for plotting', 'error');
    } else {
      console.log('✅ All plots generated successfully!');
      updateStatus(`✅ Generated ${plotCount} cytokine plots!`, 'complete');
    }
    
  } catch (error) {
    console.error('❌ Plot generation error:', error);
    updateStatus('Error generating plots: ' + error.message, 'error');
    
    // Show error in container
    const container = document.getElementById('cytokinePlotsContainer');
    if (container) {
      container.innerHTML = `<div style="text-align: center; padding: 20px; color: #d32f2f;">Error: ${error.message}</div>`;
    }
  }
}

// Convert imported tab data to analysis format
function convertImportedDataToAnalysisFormat(importedData) {
  console.log('🔄 Converting imported data to analysis format...');
  console.log('Input data:', importedData);
  
  const analysisResults = {};
  const cytokines = {};
  
  // Group data by cytokine
  const cytokineGroups = {};
  
  importedData.forEach((row, index) => {
    console.log(`Processing row ${index}:`, row);
    const cytokine = row.Cytokine || 'Unknown';
    console.log(`Cytokine for row ${index}:`, cytokine);
    if (!cytokineGroups[cytokine]) {
      cytokineGroups[cytokine] = [];
    }
    cytokineGroups[cytokine].push(row);
  });
  
  console.log('Cytokine groups:', cytokineGroups);
  
  // Convert to analysis format
  Object.keys(cytokineGroups).forEach((cytokineName, index) => {
    console.log(`Converting cytokine ${index}: ${cytokineName}`);
    const cytokineData = cytokineGroups[cytokineName];
    console.log(`Cytokine data for ${cytokineName}:`, cytokineData);
    
    const unknowns = [];
    const controls = [];
    const standards = [];
    
    cytokineData.forEach((row, rowIndex) => {
      console.log(`Processing row ${rowIndex} for ${cytokineName}:`, row);
      console.log(`Sample type: "${row.Sample_Type}"`);
      
      const item = {
        well: row.Well_Position || 'Unknown',
        compound: row.Compound || 'Unknown',
        compoundName: row.Compound || 'Unknown',
        compoundConcentration: parseFloat(row.Compound_Concentration) || 0,
        concentration: parseFloat(row.Compound_Concentration) || 0,
        calculatedConcentration: parseFloat(row.Actual_Concentration) || 0,
        actualConcentration: parseFloat(row.Actual_Concentration) || 0,
        signal: parseFloat(row.Signal_Value) || 0,
        rawSignals: [parseFloat(row.Signal_Value) || 0],
        type: row.Sample_Type || 'unknown'
      };
      
      console.log(`Created item for ${cytokineName}:`, item);
      
      switch (row.Sample_Type) {
        case 'unknown':
          unknowns.push(item);
          console.log(`Added to unknowns for ${cytokineName}`);
          break;
        case 'control':
          controls.push(item);
          console.log(`Added to controls for ${cytokineName}`);
          break;
        case 'standard':
          standards.push(item);
          console.log(`Added to standards for ${cytokineName}`);
          break;
        default:
          unknowns.push(item);
          console.log(`Added to unknowns (default) for ${cytokineName}`);
      }
    });
    
    analysisResults[index] = {
      unknowns: unknowns,
      controls: controls,
      standards: standards
    };
    
    cytokines[index] = cytokineName;
    
    console.log(`Final results for ${cytokineName}:`, {
      unknowns: unknowns.length,
      controls: controls.length,
      standards: standards.length
    });
  });
  
  console.log('Final analysis results:', analysisResults);
  console.log('Final cytokines:', cytokines);
  
  return { analysisResults, cytokines };
}

// Update all plots when controls change
function updateAllPlots() {
  generateAllPlots();
}

// Collect data for a specific cytokine
function collectCytokineData(results, cytokineName, xAxis, yAxis, groupBy) {
  const data = [];
  
  // Process unknowns
  if (results.unknowns && results.unknowns.length > 0) {
    results.unknowns.forEach(item => {
      const dataPoint = createPlotDataPoint(item, xAxis, yAxis, groupBy, cytokineName, 'unknown');
      if (dataPoint) data.push(dataPoint);
    });
  }
  
  // Process controls
  if (results.controls && results.controls.length > 0) {
    results.controls.forEach(item => {
      const dataPoint = createPlotDataPoint(item, xAxis, yAxis, groupBy, cytokineName, 'control');
      if (dataPoint) data.push(dataPoint);
    });
  }
  
  // Process standards if needed
  if (results.standards && results.standards.length > 0) {
    results.standards.forEach(item => {
      const dataPoint = createPlotDataPoint(item, xAxis, yAxis, groupBy, cytokineName, 'standard');
      if (dataPoint) data.push(dataPoint);
    });
  }
  
  return data;
}

// Create a data point for plotting
function createPlotDataPoint(item, xAxis, yAxis, groupBy, cytokine, type) {
  try {
    const point = {
      x: getPlotValue(item, xAxis),
      y: getPlotValue(item, yAxis),
      group: groupBy === 'none' ? 'Data' : getPlotValue(item, groupBy),
      well: item.well || item.wellIds?.[0] || 'Unknown',
      cytokine: cytokine,
      type: type,
      compound: item.compound || item.compoundName || 'Unknown',
      compoundConcentration: parseFloat(item.compoundConcentration) || parseFloat(item.concentration) || 0,
      actualConcentration: parseFloat(item.calculatedConcentration) || parseFloat(item.actualConcentration) || 0,
      signal: parseFloat(item.signal) || parseFloat(item.rawSignals?.[0]) || 0
    };
    
    // Validate data
    if (point.x !== null && point.y !== null && !isNaN(point.x) && !isNaN(point.y)) {
      return point;
    }
    return null;
  } catch (error) {
    console.error('Error creating plot data point:', error, item);
    return null;
  }
}

// Get value for plotting from analysis item
function getPlotValue(item, type) {
  try {
    switch (type) {
      case 'compound':
        return item.compound || item.compoundName || 'Unknown';
      case 'concentration':
        return parseFloat(item.compoundConcentration) || parseFloat(item.concentration) || 0;
      case 'cytokine':
        return item.cytokine || 'Unknown';
      case 'actual':
        return parseFloat(item.calculatedConcentration) || parseFloat(item.actualConcentration) || 0;
      case 'signal':
        return parseFloat(item.signal) || parseFloat(item.rawSignals?.[0]) || 0;
      case 'fold_change':
        return parseFloat(item.foldChange) || 0;
      case 'well':
        return item.well || item.wellIds?.[0] || 'Unknown';
      case 'type':
        return item.type || 'unknown';
      default:
        return null;
    }
  } catch (error) {
    console.error('Error getting plot value for type:', type, error);
    return null;
  }
}

// Plot expand/collapse functionality

// Table expand/collapse functionality
function expandAllTables() {
  const tables = document.querySelectorAll('.table-container');
  tables.forEach(table => {
    table.classList.remove('collapsed');
    const toggleBtn = table.querySelector('.table-toggle-btn');
    if (toggleBtn) {
      toggleBtn.textContent = '📉 Collapse';
      toggleBtn.classList.remove('expanded');
    }
  });
}

function collapseAllTables() {
  const tables = document.querySelectorAll('.table-container');
  tables.forEach(table => {
    table.classList.add('collapsed');
    const toggleBtn = table.querySelector('.table-toggle-btn');
    if (toggleBtn) {
      toggleBtn.textContent = '📊 Expand';
      toggleBtn.classList.add('expanded');
    }
  });
}

function toggleTable(tableId) {
  const table = document.getElementById(tableId);
  if (!table) return;
  
  const toggleBtn = table.querySelector('.table-toggle-btn');
  
  if (table.classList.contains('collapsed')) {
    table.classList.remove('collapsed');
    if (toggleBtn) {
      toggleBtn.textContent = '📉 Collapse';
      toggleBtn.classList.remove('expanded');
    }
  } else {
    table.classList.add('collapsed');
    if (toggleBtn) {
      toggleBtn.textContent = '📊 Expand';
      toggleBtn.classList.add('expanded');
    }
  }
}

// Create a plot for a specific cytokine
function createCytokinePlot(cytokineName, data, xAxis, yAxis, groupBy, plotType, xScale, yScale, errorBars, cytokineKey) {
  console.log(`Creating plot for ${cytokineName} with ${data.length} data points`);
  
  const container = document.getElementById('cytokinePlotsContainer');
  
  // Create plot container
  const plotContainer = document.createElement('div');
  plotContainer.className = 'cytokine-plot-container';
  plotContainer.id = `plot_${cytokineKey}`;
  
  // Create header
  const header = document.createElement('div');
  header.className = 'cytokine-plot-header';
  
  const titleRow = document.createElement('div');
  titleRow.style.display = 'flex';
  titleRow.style.justifyContent = 'space-between';
  titleRow.style.alignItems = 'center';
  
  const title = document.createElement('h3');
  title.textContent = `${cytokineName}`;
  
  // Add fallback edit button
  const editBtn = document.createElement('button');
  editBtn.className = 'btn btn-sm';
  editBtn.textContent = '✎ Edit';
  editBtn.style.cssText = 'margin-left: 10px; padding: 4px 8px; font-size: 12px;';
  editBtn.addEventListener('click', () => {
    window.clickedPlotId = canvas.getAttribute('data-plot-id');
    window.clickedChartInstance = Chart.getChart(canvas);
    window.openLargePlotEditor();
  });
  
  titleRow.appendChild(title);
  titleRow.appendChild(editBtn);
  
  const info = document.createElement('div');
  info.className = 'plot-info';
  info.textContent = `${data.length} data points | Generated: ${new Date().toLocaleTimeString()}`;
  
  header.appendChild(titleRow);
  header.appendChild(info);
  
  // Create canvas container with resize functionality
  const canvasContainer = document.createElement('div');
  canvasContainer.className = 'cytokine-plot-canvas';
  canvasContainer.style.cssText = 'position: relative; width: 800px; height: 400px; min-width: 400px; min-height: 300px; border: 2px solid #3b82f6; border-radius: 8px; padding: 10px; background: white; resize: both; overflow: auto; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin: 10px 0;';
  
  // Add resize indicator
  const resizeIndicator = document.createElement('div');
  resizeIndicator.style.cssText = 'position: absolute; top: 5px; right: 5px; background: #3b82f6; color: white; padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: 600; z-index: 1;';
  resizeIndicator.textContent = '🔧 DRAG CORNER TO RESIZE';
  canvasContainer.appendChild(resizeIndicator);
  
  // Add resize handle visual
  const resizeHandle = document.createElement('div');
  resizeHandle.style.cssText = 'position: absolute; bottom: 5px; right: 5px; width: 20px; height: 20px; cursor: nwse-resize; background: linear-gradient(135deg, transparent 50%, #3b82f6 50%); border-bottom-right-radius: 6px; pointer-events: none;';
  canvasContainer.appendChild(resizeHandle);
  
  // Create wrapper for canvas
  const canvasWrapper = document.createElement('div');
  canvasWrapper.style.cssText = 'width: 100%; height: calc(100% - 25px);';
  
  const canvas = document.createElement('canvas');
  canvas.id = `canvas_${cytokineKey}`;
  canvas.className = 'pivot-plot-canvas';
  canvas.setAttribute('data-plot-id', `plot_${cytokineKey}_${Date.now()}`);
  canvas.style.width = '100%';
  canvas.style.height = '100%';
  
  // Add right-click event listener for context menu
  canvas.addEventListener('contextmenu', (event) => {
    event.preventDefault();
    showPlotContextMenu(event, canvas.id);
  });
  
  canvasWrapper.appendChild(canvas);
  canvasContainer.appendChild(canvasWrapper);
  
  plotContainer.appendChild(header);
  plotContainer.appendChild(canvasContainer);
  container.appendChild(plotContainer);
  
  // Add resize observer for this plot
  addPlotResizeHandler(canvas, canvasContainer);
  
  // Render the chart
  renderCytokineChart(canvas, data, xAxis, yAxis, groupBy, plotType, xScale, yScale, errorBars, cytokineName);
}

// Enhanced Plot Registry System
window.plotRegistry = window.plotRegistry || {};
window.plotStore = window.plotStore || {};

// Cached images for cytokine plots to allow re-use when the DOM plot isn't present
window.cytokinePlotCache = window.cytokinePlotCache || {};

// Clear cached charts on page refresh
window.addEventListener('beforeunload', function() {
  try {
    const keys = Object.keys(localStorage).filter(k => k.startsWith('plotImage.'));
    keys.forEach(key => localStorage.removeItem(key));
    console.log('🧹 Cleared cached charts on page refresh');
  } catch (e) {
    console.warn('Failed to clear cached charts:', e);
  }
});

// Clear all cache function
function clearAllCache() {
  try {
    // Clear all plot images
    const plotKeys = Object.keys(localStorage).filter(k => k.startsWith('plotImage.'));
    plotKeys.forEach(key => localStorage.removeItem(key));
    
    // Clear layout sheets cache
    localStorage.removeItem('layoutSheets.v1');
    
    // Clear plot store cache
    localStorage.removeItem('plots.v1');
    
    // Clear cytokine plot cache
    window.cytokinePlotCache = {};
    window.standardCurveImage = null;
    window.compoundsChartImage = null;
    
    // Clear any other cached data
    const allKeys = Object.keys(localStorage);
    const cacheKeys = allKeys.filter(k => 
      k.includes('cache') || 
      k.includes('Cache') || 
      k.includes('plot') || 
      k.includes('layout') ||
      k.includes('sheet')
    );
    cacheKeys.forEach(key => localStorage.removeItem(key));
    
    console.log('🧹 Cleared all cache:', {
      plotImages: plotKeys.length,
      layoutSheets: 1,
      plotStore: 1,
      otherCache: cacheKeys.length
    });
    
    // Show confirmation
    alert('✅ All cache cleared successfully!\n\nCleared:\n• Cached chart images\n• Layout sheets\n• Plot data\n• All other cached data');
    
  } catch (e) {
    console.error('❌ Failed to clear cache:', e);
    alert('❌ Failed to clear cache. Check console for details.');
  }
}

function cacheCytokinePlotImage(cytokineName, canvas) {
  try {
    if (!cytokineName || !canvas) return;
    const key = cytokineName.trim();
    const dataUrl = canvas.toDataURL('image/png');
    window.cytokinePlotCache[key] = dataUrl;
    try {
      localStorage.setItem('plotImage.' + key, dataUrl);
    } catch (e) {
      console.warn('⚠️ Failed to persist plot image for', key, e);
    }
    console.log('💾 Cached cytokine plot image:', key);
  } catch (e) {
    console.warn('⚠️ Failed to cache cytokine plot image:', e);
  }
}

function cacheStandardCurveImage(canvas, cytokineName) {
  try {
    if (!canvas) return;
    const dataUrl = canvas.toDataURL('image/png');
    const key = 'standardCurve' + (cytokineName ? ('.' + cytokineName.trim()) : '');
