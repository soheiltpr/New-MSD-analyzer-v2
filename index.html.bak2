// Show what's currently in the clipboard
function showClipboardContent() {
  console.log('📋 Reading clipboard content...');
  
  navigator.clipboard.readText().then(clipboardText => {
    console.log('📋 Clipboard content:');
    console.log('Length:', clipboardText.length, 'characters');
    console.log('First 500 characters:');
    console.log(clipboardText.substring(0, 500));
    
    if (clipboardText.length > 500) {
      console.log('... (truncated)');
    }
    
    // Show in alert for user to see
    const preview = clipboardText.length > 200 ? 
      clipboardText.substring(0, 200) + '...' : 
      clipboardText;
    
    alert(`Clipboard Content (${clipboardText.length} chars):\n\n${preview}`);
    
    // Also put it in the textarea
    const textarea = document.getElementById('clipboardImport');
    if (textarea) {
      textarea.value = clipboardText;
      updateStatus(`Clipboard content loaded (${clipboardText.length} chars)`, 'complete');
    }
    
  }).catch(err => {
    console.error('❌ Failed to read clipboard:', err);
    updateStatus('Failed to read clipboard - may need permission', 'error');
    alert('Failed to read clipboard. Please ensure the browser has clipboard access permission.');
  });
}

// Sync plot controls with export controls
function syncPlotControlsWithExport() {
  const exportRows = document.getElementById('pivotRows').value;
  const exportColumns = document.getElementById('pivotColumns').value;
  const exportValues = document.getElementById('pivotValues').value;
  const exportScale = document.getElementById('pivotScale').value;
  const exportIncludeStandards = document.getElementById('pivotIncludeStandards').value;

  // Set plot controls to match export settings
  document.getElementById('plotXAxis').value = exportRows;
  document.getElementById('plotYAxis').value = exportValues;
  document.getElementById('plotSeriesGroup').value = exportColumns;
  document.getElementById('plotScale').value = exportScale;
  document.getElementById('plotIncludeStandards').value = exportIncludeStandards;
}

// Update pivot plot
function updatePivotPlot() {
  console.log('🔄 Updating pivot plot...');
  
  // Get plot parameters
  const xAxis = document.getElementById('plotXAxis').value;
  const yAxis = document.getElementById('plotYAxis').value;
  const seriesGroup = document.getElementById('plotSeriesGroup').value;
  const plotType = document.getElementById('plotType').value;
  const includeStandards = document.getElementById('plotIncludeStandards').value === 'yes';
  
  // Get styling options
  const pointSize = parseInt(document.getElementById('pointSize').value);
  const lineWidth = parseInt(document.getElementById('lineWidth').value);
  const showErrorBars = document.getElementById('errorBarType').value !== 'none';
  const showLegend = document.getElementById('showLegend').checked;
  const showGrid = document.getElementById('showGrid').checked;
  const showAxisLabels = document.getElementById('showAxisLabels').checked;
  const showTicks = document.getElementById('showTicks').checked;
  const backgroundColor = document.getElementById('backgroundColor').value;
  
  // Get axis configuration
  const xAxisMin = document.getElementById('xAxisMin').value;
  const xAxisMax = document.getElementById('xAxisMax').value;
  const xAxisScale = document.getElementById('xAxisScale').value;
  const yAxisMin = document.getElementById('yAxisMin').value;
  const yAxisMax = document.getElementById('yAxisMax').value;
  const yAxisScale = document.getElementById('yAxisScale').value;
  
  // Get transformations
  const xTransform = document.getElementById('xTransform').value;
  const yTransform = document.getElementById('yTransform').value;
  const showTrendLines = document.getElementById('showTrendLines').checked;

  console.log('Plot parameters:', { xAxis, yAxis, seriesGroup, plotType, xAxisScale, yAxisScale });

  // Collect data points (similar to export function)
  pivotPlotData = collectPlotData(xAxis, yAxis, seriesGroup, includeStandards);
  
  if (pivotPlotData.length === 0) {
    updateStatus('No data available for plotting.', 'error');
    return;
  }

  // Apply transformations
  if (xTransform !== 'none' || yTransform !== 'none') {
    pivotPlotData = applyDataTransformations(pivotPlotData, xTransform, yTransform);
  }
  
  // Apply scale transformations for axes
  if (xAxisScale !== 'linear') {
    pivotPlotData = applyScaleTransformation(pivotPlotData, 'x', xAxisScale);
  }
  if (yAxisScale !== 'linear') {
    pivotPlotData = applyScaleTransformation(pivotPlotData, 'y', yAxisScale);
  }

  // Generate chart with all options
  generatePivotChart(pivotPlotData, xAxis, yAxis, seriesGroup, plotType, {
    xAxisMin, xAxisMax, xAxisScale,
    yAxisMin, yAxisMax, yAxisScale,
    pointSize, lineWidth, showErrorBars, showLegend,
    showGrid, showAxisLabels, showTicks, backgroundColor,
    showTrendLines
  });
  
  // Update series toggles
  updateSeriesToggles(pivotPlotData);
  
  // Update plot info
  updatePlotInfo(pivotPlotData, xAxis, yAxis, seriesGroup);
}

// Collect data for plotting
function collectPlotData(xAxis, yAxis, seriesGroup, includeStandards) {
  const dataPoints = [];
  
  // Determine which cytokines to include
  const cytokinesToProcess = [currentCytokine]; // Start with current cytokine only

  cytokinesToProcess.forEach(cytokineIndex => {
    const cytokine = CYTOKINES[cytokineIndex];
    if (!cytokine) return;

    // Get analysis results for this cytokine
    const results = analysisResults && analysisResults[cytokineIndex];
    
    // Process standards if included
    if (includeStandards && results && results.standardData) {
      results.standardData.forEach(std => {
        const wellIds = std.wellIds || [std.well];
        const signals = std.rawSignals || [std.signal];
        
        wellIds.forEach((wellId, idx) => {
          const signal = signals[idx] || std.signal;
          const dataPoint = createPlotDataPoint(wellId, cytokine, 'Standard', std.concentration, std.concentration, signal, xAxis, yAxis, seriesGroup);
          if (dataPoint) dataPoints.push(dataPoint);
        });
      });
    }

    // Process unknowns and controls
    if (results && results.unknowns) {
      results.unknowns.forEach(unk => {
        const { row, col } = parseWellId(unk.well);
        const signal = (row && col) ? getWellSignal(row, col, cytokineIndex) : unk.signal;
        const actualConc = unk.actualConcentration || unk.concentration;
        const compoundConc = (row && col && wellConcentrations[row] && typeof wellConcentrations[row][col] !== 'undefined') ? wellConcentrations[row][col] : '';
        const compoundName = unk.compound || 'Unknown';
        
        const dataPoint = createPlotDataPoint(unk.well, cytokine, compoundName, compoundConc, actualConc, signal, xAxis, yAxis, seriesGroup);
        if (dataPoint) dataPoints.push(dataPoint);
      });
    }
  });

  return dataPoints;
}

// Create data point for plotting
function createPlotDataPoint(well, cytokine, compound, compoundConc, actualConc, signal, xAxis, yAxis, seriesGroup) {
  try {
    const dataPoint = {
      well: well,
      cytokine: cytokine,
      compound: compound,
      compoundConc: compoundConc,
      actualConc: actualConc,
      signal: signal
    };

    // Get X, Y, and series values
    const xValue = getPlotDimensionValue(dataPoint, xAxis);
    const yValue = getPlotDimensionValue(dataPoint, yAxis);
    const seriesValue = getPlotDimensionValue(dataPoint, seriesGroup);

    if (xValue === null || yValue === null || seriesValue === null) {
      return null;
    }

    return {
      x: xValue,
      y: yValue,
      series: seriesValue,
      well: well,
      cytokine: cytokine,
      compound: compound,
      originalData: dataPoint
    };
  } catch (error) {
    console.warn('Error creating plot data point for well', well, error);
    return null;
  }
}

// Get dimension value for plotting
function getPlotDimensionValue(dataPoint, dimension) {
  switch (dimension) {
    case 'cytokine':
      return dataPoint.cytokine;
    case 'compound':
      return dataPoint.compound || 'Unknown';
    case 'concentration':
      return dataPoint.compoundConc || '';
    case 'well':
      return dataPoint.well;
    case 'signal':
      return dataPoint.signal;
    case 'actual':
      return dataPoint.actualConc;
    case 'actual_mean':
      return calculateMeanActualConcentration(dataPoint, [dataPoint]);
    case 'fold_change':
      return calculateFoldChange(dataPoint, [dataPoint]);
    case 'none':
      return 'All Data';
    default:
      return null;
  }
}

// Apply data transformations
function applyDataTransformations(dataPoints, xTransform, yTransform) {
  const transformedData = [...dataPoints];
  
  // Get all values for normalization/standardization
  const xValues = transformedData.map(dp => parseFloat(dp.x)).filter(v => !isNaN(v));
  const yValues = transformedData.map(dp => parseFloat(dp.y)).filter(v => !isNaN(v));
  
  // Calculate statistics for transformations
  const xStats = calculateStats(xValues);
  const yStats = calculateStats(yValues);
  
  transformedData.forEach(dp => {
    // Transform X values
    if (xTransform !== 'none') {
      dp.x = applyTransformation(dp.x, xTransform, xStats);
    }
    
    // Transform Y values
    if (yTransform !== 'none') {
      dp.y = applyTransformation(dp.y, yTransform, yStats);
    }
  });
  
  return transformedData;
}

// Calculate statistics for transformations
function calculateStats(values) {
  const validValues = values.filter(v => !isNaN(v) && isFinite(v));
  if (validValues.length === 0) return { mean: 0, std: 1, min: 0, max: 1 };
  
  const mean = validValues.reduce((a, b) => a + b, 0) / validValues.length;
  const variance = validValues.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / validValues.length;
  const std = Math.sqrt(variance);
  const min = Math.min(...validValues);
  const max = Math.max(...validValues);
  
  return { mean, std, min, max };
}

// Apply individual transformation
function applyTransformation(value, transform, stats) {
  const numValue = parseFloat(value);
  if (isNaN(numValue) || !isFinite(numValue)) return value;
  
  switch (transform) {
    case 'normalize':
      return (numValue - stats.min) / (stats.max - stats.min);
    case 'standardize':
      return (numValue - stats.mean) / stats.std;
    case 'log10':
      return numValue > 0 ? Math.log10(numValue) : value;
    case 'ln':
      return numValue > 0 ? Math.log(numValue) : value;
    default:
      return numValue;
  }
}

// Apply scale transformations for axes
function applyScaleTransformation(dataPoints, axis, scaleType) {
  const transformedData = [...dataPoints];
  
  transformedData.forEach(dp => {
    const value = axis === 'x' ? dp.x : dp.y;
    const numValue = parseFloat(value);
    
    if (isNaN(numValue) || !isFinite(numValue)) return;
    
    let transformedValue;
    switch (scaleType) {
      case 'sqrt':
        transformedValue = numValue >= 0 ? Math.sqrt(numValue) : value;
        break;
      case 'pow2':
        transformedValue = Math.pow(numValue, 2);
        break;
      case 'pow10':
        transformedValue = Math.pow(numValue, 10);
        break;
      default:
        transformedValue = numValue;
    }
    
    if (axis === 'x') {
      dp.x = transformedValue;
    } else {
      dp.y = transformedValue;
    }
  });
  
  return transformedData;
}

// Update series toggles
function updateSeriesToggles(dataPoints) {
  const container = document.getElementById('seriesToggleContainer');
  const seriesGroup = document.getElementById('plotSeriesGroup').value;
  
  // Clear container
  container.innerHTML = '';
  
  // If no grouping, don't show series toggles
  if (seriesGroup === 'none') {
    return;
  }
  
  const seriesNames = [...new Set(dataPoints.map(dp => dp.series))];
  const colors = [
    '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', 
    '#FF9F40', '#FF6384', '#C9CBCF', '#4BC0C0', '#FF6384'
  ];
  
  seriesNames.forEach((seriesName, index) => {
    const color = colors[index % colors.length];
    const toggleItem = document.createElement('div');
    toggleItem.className = 'series-toggle-item active';
    toggleItem.dataset.series = seriesName;
    
    toggleItem.innerHTML = `
      <div class="series-toggle-color" style="background-color: ${color}"></div>
      <span class="series-toggle-label">${seriesName}</span>
    `;
    
    toggleItem.addEventListener('click', () => {
      toggleItem.classList.toggle('active');
      updatePivotPlot(); // Re-render with updated series visibility
    });
    
    container.appendChild(toggleItem);
  });
}

// Get visible series
function getVisibleSeries() {
  const toggles = document.querySelectorAll('.series-toggle-item');
  const visibleSeries = [];
  
  toggles.forEach(toggle => {
    if (toggle.classList.contains('active')) {
      visibleSeries.push(toggle.dataset.series);
    }
  });
  
  return visibleSeries;
}

// Generate Chart.js chart with enhanced options
function generatePivotChart(dataPoints, xAxis, yAxis, seriesGroup, plotType, options) {
  const ctx = document.getElementById('pivotPlotCanvas').getContext('2d');
  
  // Destroy existing chart
  if (pivotPlotChart) {
    pivotPlotChart.destroy();
  }

  // Get visible series
  const visibleSeries = getVisibleSeries();
  
  // Group data by series and calculate error bars for replicates
  const seriesData = {};
  dataPoints.forEach(dp => {
    if (!seriesData[dp.series]) {
      seriesData[dp.series] = [];
    }
    seriesData[dp.series].push(dp);
  });

  // Create datasets for each visible series
  const datasets = [];
  const colors = [
    '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', 
    '#FF9F40', '#FF6384', '#C9CBCF', '#4BC0C0', '#FF6384'
  ];

  Object.keys(seriesData).forEach((seriesName, index) => {
    // Skip if series is not visible
    if (!visibleSeries.includes(seriesName)) return;
    
    const seriesPoints = seriesData[seriesName];
    const color = colors[index % colors.length];
    
    // Group by X value to calculate error bars for replicates
    const groupedData = {};
    seriesPoints.forEach(dp => {
      const xKey = String(dp.x);
      if (!groupedData[xKey]) {
        groupedData[xKey] = [];
      }
      groupedData[xKey].push(dp);
    });

    // Calculate mean and error bars for each X value
    const processedData = [];
    Object.keys(groupedData).forEach(xKey => {
      const points = groupedData[xKey];
      const xValue = parseFloat(xKey);
      const yValues = points.map(p => parseFloat(p.y)).filter(v => !isNaN(v));
      
      if (yValues.length === 0) return;
      
      const mean = yValues.reduce((a, b) => a + b, 0) / yValues.length;
      const variance = yValues.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / yValues.length;
      const std = Math.sqrt(variance);
      const se = std / Math.sqrt(yValues.length);
      
      let errorBar = 0;
      const errorBarType = document.getElementById('errorBarType').value;
      switch (errorBarType) {
        case 'sd':
          errorBar = std;
          break;
        case 'se':
          errorBar = se;
          break;
        case 'ci95':
          errorBar = se * 1.96; // 95% CI
          break;
        default:
          errorBar = 0;
      }
      
      processedData.push({
        x: xValue,
        y: mean,
        errorBar: errorBar,
        n: yValues.length
      });
    });
    
    // Sort points by X value
    processedData.sort((a, b) => a.x - b.x);

    const dataset = {
      label: seriesName,
      data: processedData.map(dp => ({ x: dp.x, y: dp.y })),
      backgroundColor: color + '20',
      borderColor: color,
      borderWidth: options.lineWidth,
      pointRadius: options.pointSize,
      pointHoverRadius: options.pointSize + 2,
      tension: plotType === 'line' ? 0.1 : 0,
      fill: plotType === 'area',
      showLine: plotType === 'line' || plotType === 'area',
      // Add error bar data
      errorBars: processedData.map(dp => ({
        x: dp.x,
        y: dp.y,
        errorBar: dp.errorBar,
        n: dp.n
      }))
    };

    datasets.push(dataset);
  });

  // Get background color
  let bgColor = 'white';
  if (options.backgroundColor === 'transparent') {
    bgColor = 'transparent';
  } else if (options.backgroundColor === 'light') {
    bgColor = '#f8f9fa';
  }

  // Chart configuration
  const config = {
    type: plotType === 'bar' ? 'bar' : 'scatter',
    data: { datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      backgroundColor: bgColor,
      plugins: {
        legend: {
          display: options.showLegend,
          position: 'top',
          labels: {
            usePointStyle: true,
            padding: 20,
            font: { size: 12 }
          }
        },
        title: {
          display: true,
          text: `${yAxis} vs ${xAxis}`,
          font: { size: 16, weight: 'bold' }
        },
        tooltip: {
          displayColors: false,
          callbacks: {
            title: () => '',
            label: (context) => `${xAxis}: ${context.parsed.x} | ${yAxis}: ${context.parsed.y}`
          }
        }
      },
      scales: {
        x: {
          title: { display: options.showAxisLabels, text: xAxis },
          type: getScaleType(options.xAxisScale),
          min: options.xAxisMin || undefined,
          max: options.xAxisMax || undefined,
          grid: { display: options.showGrid },
          ticks: { display: options.showTicks }
        },
        y: {
          title: { display: options.showAxisLabels, text: yAxis },
          type: getScaleType(options.yAxisScale),
          min: options.yAxisMin || undefined,
          max: options.yAxisMax || undefined,
          grid: { display: options.showGrid },
          ticks: { display: options.showTicks }
        }
      },
      interaction: {
        intersect: false,
        mode: 'point'
      }
    }
  };

  // Add error bar plugin if needed
  if (options.showErrorBars && datasets.some(ds => ds.errorBars)) {
    config.plugins = config.plugins || {};
    config.plugins.errorBars = {
      id: 'errorBars',
      afterDatasetsDraw: (chart) => {
        const ctx = chart.ctx;
        const datasets = chart.data.datasets;
        
        datasets.forEach((dataset, datasetIndex) => {
          if (!dataset.errorBars) return;
          
          const meta = chart.getDatasetMeta(datasetIndex);
          if (meta.hidden) return;
          
          ctx.save();
          ctx.strokeStyle = dataset.borderColor;
          ctx.lineWidth = 1;
          
          dataset.errorBars.forEach((errorBar, pointIndex) => {
            const point = meta.data[pointIndex];
            if (!point) return;
            
            const x = point.x;
            const y = point.y;
            const error = errorBar.errorBar;
            
            if (error > 0) {
              // Draw vertical error bar
              ctx.beginPath();
              ctx.moveTo(x, y - error);
              ctx.lineTo(x, y + error);
              ctx.stroke();
              
              // Draw horizontal caps
              const capLength = 4;
              ctx.beginPath();
              ctx.moveTo(x - capLength, y - error);
              ctx.lineTo(x + capLength, y - error);
              ctx.moveTo(x - capLength, y + error);
              ctx.lineTo(x + capLength, y + error);
              ctx.stroke();
            }
          });
          
          ctx.restore();
        });
      }
    };
  }

  // Create chart
  pivotPlotChart = new Chart(ctx, config);

  // Register this plot with a unique ID
  const plotId = generatePlotUUID();
  const canvas = document.getElementById('pivotPlotCanvas');
  canvas.setAttribute('data-plot-id', plotId);
  
  const metadata = {
    title: config.options.plugins.title.text || 'Pivot Analysis',
    xAxis: xAxis,
    yAxis: yAxis,
    seriesGroup: seriesGroup,
    plotType: plotType,
    canvasId: 'pivotPlotCanvas'
  };
  
  registerPlot(plotId, pivotPlotChart, metadata);
  console.log('📊 Registered pivot plot with ID:', plotId);

  // Expose latest pivot plot data/meta for external consumers (e.g., Plot Editor)
  try {
    window.pivotPlotChart = pivotPlotChart;
    window.pivotPlotSourceData = Array.isArray(dataPoints) ? dataPoints : [];
    window.pivotPlotMeta = { xAxis, yAxis, seriesGroup, plotType };
  } catch (e) {
    console.warn('Unable to expose pivot plot data/meta:', e);
  }

  // Attach Cmd/Ctrl + double-click handler to open large plot editor
  try {
    const canvas = document.getElementById('pivotPlotCanvas');
    if (canvas) {
      canvas.removeEventListener('dblclick', handlePivotPlotModifierDblClick);
      canvas.addEventListener('dblclick', handlePivotPlotModifierDblClick);
      
      // Add context menu listener for right-click
      canvas.removeEventListener('contextmenu', handlePivotPlotContextMenu);
      canvas.addEventListener('contextmenu', handlePivotPlotContextMenu);
    }
  } catch (e) {
    console.warn('Modifier double-click handler not attached:', e);
  }
}

function handlePivotPlotModifierDblClick(event) {
  // Require Command (macOS) or Control (Windows/Linux) key during double-click
  if (event.metaKey || event.ctrlKey) {
    event.preventDefault();
    openLargePivotPlotEditor();
  }
}

function handlePivotPlotContextMenu(event) {
  event.preventDefault();
  
  // Store reference to the clicked canvas
  const canvas = event.target;
  window.clickedPivotPlotCanvas = canvas;
  
  // Get or generate a unique plot ID for this canvas
  let plotId = canvas.getAttribute('data-plot-id');
  if (!plotId) {
    plotId = generatePlotUUID();
    canvas.setAttribute('data-plot-id', plotId);
    console.log('🆔 Generated new plot ID:', plotId);
  }
  
  // Try to find the Chart.js instance for this canvas
  const chartId = canvas.id;
  let clickedChart = null;
  
  // Check if this is the main pivot plot canvas
  if (chartId === 'pivotPlotCanvas' && window.pivotPlotChart) {
    clickedChart = window.pivotPlotChart;
    console.log('📊 Found main pivot plot chart');
  }
  // Check for other chart instances
  else if (Chart.getChart && Chart.getChart(canvas)) {
    clickedChart = Chart.getChart(canvas);
    console.log('📊 Found chart instance for canvas:', chartId);
  }
  
  // Store the chart reference and plot ID
  window.clickedPivotPlotChart = clickedChart;
  window.clickedPlotId = plotId;
  
  // Register this plot in the registry if not already registered
  if (clickedChart && !getPlotById(plotId)) {
    const metadata = {
      title: clickedChart.options?.plugins?.title?.text || 'Plot',
      xAxis: clickedChart.options?.scales?.x?.title?.text || 'X-Axis',
      yAxis: clickedChart.options?.scales?.y?.title?.text || 'Y-Axis',
      canvasId: chartId
    };
    registerPlot(plotId, clickedChart, metadata);
    console.log('📊 Registered plot in registry:', plotId);
  }
  
  console.log('🎯 Right-clicked on plot ID:', plotId, 'Chart found:', !!clickedChart);
  console.log('📊 Plot registry has', Object.keys(window.plotRegistry).length, 'plots');
  
  // QA logging for plot selection
  if (clickedChart) {
    console.log('✅ Chart instance found:', clickedChart.id || 'unknown');
    console.log('📊 Chart data points:', clickedChart.data?.datasets?.length || 0);
  } else {
    console.warn('⚠️ No chart instance found for canvas:', chartId);
  }
  
  const menu = document.getElementById('plotContextMenu');
  menu.style.display = 'block';
  menu.style.left = event.pageX + 'px';
  menu.style.top = event.pageY + 'px';
  
  // Add click outside to close
  setTimeout(() => {
    document.addEventListener('click', hidePivotPlotContextMenu);
  }, 100);
}

function hidePivotPlotContextMenu() {
  const menu = document.getElementById('plotContextMenu');
  menu.style.display = 'none';
  document.removeEventListener('click', hidePivotPlotContextMenu);
}

function openLargePivotPlotEditor(plotId = null, chartInstance = null) {
  try {
    // Hide the context menu first
    hidePivotPlotContextMenu();
    
    // Use provided parameters or fall back to global state
    const currentPlotId = plotId || window.clickedPlotId;
    const currentChart = chartInstance || window.clickedPivotPlotChart;
    
    if (!currentPlotId) {
      showNotification('Right-click a plot and choose Large Plot Editor', 'warning', 4000);
      return;
    }
    
    if (!currentChart) {
      showNotification('No chart data available for editing', 'error', 4000);
      return;
    }
    
    console.log('🎯 Opening Large Plot Editor for plot ID:', currentPlotId);
    
    // Create or show the large plot editor modal
    let modal = document.getElementById('largePlotEditorModal');
    if (!modal) {
      modal = createLargePlotEditorModal();
    }
    
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden'; // Prevent background scrolling
    
    // Initialize the large plot with the specific plot data
    initializeLargePlot();
    
    showNotification('Large Plot Editor opened', 'success', 3000);
  } catch (e) {
    console.error('Error opening large pivot plot editor:', e);
    showNotification('Failed to open Large Plot Editor: ' + e.message, 'error', 5000);
  }
}

