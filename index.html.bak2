        <div class="form-row">
          <div class="form-group">
            <label>
              <input type="checkbox" id="includeSignals" checked> Include Signal Data
            </label>
            <small style="display: block; color: #666; margin-top: 4px;">
              Check to save signal values, uncheck to save only layout and settings
            </small>
          </div>
          <div class="form-group">
            <label>
              <input type="checkbox" id="includeAnalysisResults" checked> Include Analysis Results
            </label>
            <small style="display: block; color: #666; margin-top: 4px;">
              Check to save calculated concentrations and analysis data
            </small>
          </div>
        </div>
        
        <div class="template-actions">
          <button class="btn btn-success" id="saveTemplateToFile">💾 Save Template</button>
          <button class="btn btn-secondary" id="previewTemplate">👁️ Preview</button>
        </div>
      </div>
      
      <!-- Template List Section -->
      <div class="template-section">
        <h3>📂 Saved Templates</h3>
        <div class="template-list-container">
          <div id="templateListDisplay" class="template-list">
            <div class="template-list-header">
              <span>Template Name</span>
              <span>Description</span>
              <span>Created</span>
              <span>Size</span>
              <span>Actions</span>
            </div>
            <div id="templateListContent" class="template-list-content">
              <p class="no-templates">No templates found. Create your first template above!</p>
            </div>
          </div>
        </div>
        
        <div class="template-actions">
          <button class="btn btn-primary" id="loadSelectedTemplate">📂 Load Selected</button>
          <button class="btn btn-warning" id="renameSelectedTemplate">✏️ Rename</button>
          <button class="btn btn-danger" id="deleteSelectedTemplate">🗑️ Delete</button>
          <button class="btn btn-info" id="refreshTemplateList">🔄 Refresh</button>
        </div>
      </div>
      
      <!-- File Operations Section -->
      <div class="template-section">
        <h3>📁 File Operations</h3>
        <div class="form-row">
          <div class="form-group">
            <label>Import Template from File:</label>
            <input type="file" id="importTemplateFile" accept=".json" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
          </div>
          <div class="form-group">
            <label>Export Selected Template:</label>
            <button class="btn btn-success" id="exportSelectedTemplate" style="width: 100%;">📤 Export to File</button>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</div>

<!-- Well Editor Modal -->
<div id="wellEditorModal" class="modal" style="display: none;">
  <div class="modal-content" style="width: 500px; max-width: 90vw;">
    <div class="modal-header">
      <h3>🔧 Edit Well Properties</h3>
      <button class="modal-close" onclick="closeWellEditor()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="well-info-header">
        <h4 id="wellEditorWellId">A1</h4>
        <div class="well-coordinates">Well Coordinates</div>
      </div>
      
      <form class="well-editor-form" id="wellEditorForm">
        <div class="form-row">
          <div class="form-group">
            <label for="wellEditorRole">Role:</label>
            <select id="wellEditorRole" class="form-control">
              <option value="">None</option>
              <option value="standard">Standard</option>
              <option value="unknown">Unknown</option>
              <option value="control">Control</option>
              <option value="blank">Blank</option>
            </select>
          </div>
          
          <div class="form-group">
            <label for="wellEditorCompound">Compound Name:</label>
            <input type="text" id="wellEditorCompound" class="form-control" placeholder="Enter compound name">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="wellEditorConcentration">Concentration (pg/mL):</label>
            <input type="number" id="wellEditorConcentration" class="form-control" placeholder="Enter concentration" step="0.01">
          </div>
          
          <div class="form-group">
            <label for="wellEditorDilution">Dilution Factor:</label>
            <input type="number" id="wellEditorDilution" class="form-control" placeholder="Enter dilution factor" step="0.1" value="1.0">
          </div>
        </div>

        <div class="form-row single">
          <div class="form-group">
            <label for="wellEditorNotes">Notes:</label>
            <textarea id="wellEditorNotes" class="form-control" rows="3" placeholder="Add any notes about this well"></textarea>
          </div>
        </div>
      </form>
      
      <div class="well-editor-actions">
        <button type="button" class="btn-cancel" onclick="closeWellEditor()">Cancel</button>
        <button type="button" class="btn-save" onclick="saveWellChanges()">Save Changes</button>
      </div>
    </div>
  </div>
</div>

<!-- Cytokine Setup Modal -->
<div id="cytokineSetupModal" class="modal" style="display: none;">
  <div class="modal-content" style="width: 90%; max-width: 800px; max-height: 90vh; overflow-y: auto;">
    <div class="modal-header">
      <h2>🧬 Cytokine & Concentration Setup</h2>
      <span class="modal-close" onclick="closeCytokineSetup()">&times;</span>
    </div>
    
    <div class="modal-body">
      <div style="margin-bottom: 20px;">
        <h3>Dilution Parameters</h3>
        <div class="form-row cols-2">
          <div>
            <label>Dilution Factor</label>
            <input type="number" id="setupDilutionFactor" value="4" min="2" max="10" step="0.5">
            <p style="font-size: 11px; color: #666;">Each dilution step (e.g., 4x means each step is 4x lower)</p>
          </div>
          <div>
            <label>Number of Dilutions</label>
            <input type="number" id="setupNumDilutions" value="8" min="3" max="12" step="1">
            <p style="font-size: 11px; color: #666;">Total number of standard concentrations</p>
          </div>
        </div>
      </div>
      
      <div style="margin-bottom: 20px;">
        <h3>Cytokine Configuration</h3>
        <p style="font-size: 12px; color: #666; margin-bottom: 15px;">
          Configure cytokine names and maximum concentrations for each spot. Standard concentrations will be auto-calculated based on dilution parameters.
        </p>
        
        <div class="excel-paste-section" style="background: #f8f9fa; border: 1px solid #ddd; border-radius: 4px; padding: 15px; margin-bottom: 15px;">
          <h4 style="margin: 0 0 10px 0; font-size: 14px;">📋 Paste from Excel</h4>
          <p style="font-size: 11px; color: #666; margin-bottom: 10px;">
            Copy data from Excel (Cytokine Name → Max Concentration) and paste below. Each row should contain cytokine name and concentration separated by tab.
          </p>
          <textarea id="excelPasteArea" 
                    placeholder="Paste Excel data here...&#10;Example:&#10;GM-CSF	4620&#10;IFN-γ	16050&#10;IL-1β	2220&#10;IL-2	945"
                    style="width: 100%; height: 80px; font-family: monospace; font-size: 12px; border: 1px solid #ccc; border-radius: 4px; padding: 8px; resize: vertical;"></textarea>
          <div class="quick-actions" style="margin-top: 8px;">
            <button class="btn btn-primary btn-sm" onclick="parseExcelData()">📊 Parse & Fill Table</button>
            <button class="btn btn-secondary btn-sm" onclick="clearPasteArea()">🗑️ Clear</button>
          </div>
        </div>
        
        <div class="excel-table-container" style="border: 1px solid #ddd; border-radius: 4px; overflow: hidden;">
          <table id="excelCytokineTable" class="excel-table" style="width: 100%; border-collapse: collapse;">
            <thead style="background: #f0f8ff;">
              <tr>
                <th class="excel-header">Spot #</th>
                <th class="excel-header">Cytokine Name</th>
                <th class="excel-header">Max Concentration (pg/mL)</th>
                <th class="excel-header">Dilution Factor</th>
                <th class="excel-header">Standard Concentrations (calculated)</th>
              </tr>
            </thead>
            <tbody id="excelTableBody">
              <!-- Excel-like rows will be generated by JavaScript -->
            </tbody>
          </table>
        </div>
      </div>
      
      <div class="quick-actions">
        <button class="btn btn-secondary" onclick="loadDefaultCytokines()">📋 Load Defaults</button>
        <button class="btn btn-warning" onclick="clearAllCytokines()">🗑️ Clear All</button>
        <button class="btn btn-success" onclick="applyCytokineSetup()">✅ Apply Configuration</button>
        <button class="btn btn-secondary" onclick="closeCytokineSetup()">❌ Cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- Scrollable Plot Window -->
<div id="pivotPlotWindow" class="scrollable-plot-window" style="display: none;">
  <div class="plot-header">
    <h2>📈 Data Visualization</h2>
    <div class="plot-actions">
      <button class="btn-icon" onclick="refreshPlot()" title="Refresh">🔄</button>
      <button class="btn-icon" onclick="exportPlotData()" title="Export Data">💾</button>
      <button class="btn-icon close-btn" onclick="closePlot()" title="Close">✕</button>
    </div>
  </div>
  
  <div class="plot-content">
    <div class="plot-controls-panel">
      <div class="control-group">
        <label>Cytokine</label>
        <select id="plotCytokine" onchange="updatePlot()">
          <!-- Options will be populated dynamically -->
        </select>
      </div>
      
      <div class="control-group">
        <label>X-Axis</label>
        <select id="plotXAxis" onchange="updatePlot()">
          <option value="compound">Compound Name</option>
          <option value="concentration">Compound Concentration</option>
          <option value="actual">Actual Concentration (pg/mL)</option>
          <option value="signal">Signal Value</option>
          <option value="well">Well Position</option>
          <option value="type">Sample Type</option>
        </select>
      </div>
      
      <div class="control-group">
        <label>Y-Axis</label>
        <select id="plotYAxis" onchange="updatePlot()">
          <option value="actual">Actual Concentration (pg/mL)</option>
          <option value="signal">Signal Value</option>
          <option value="fold_change">Fold Change</option>
          <option value="concentration">Compound Concentration</option>
        </select>
      </div>
      
      <div class="control-group">
        <label>Group By</label>
        <select id="plotGroupBy" onchange="updatePlot()">
          <option value="compound">Compound Name</option>
          <option value="type">Sample Type</option>
          <option value="cytokine">Cytokine</option>
          <option value="well">Well Position</option>
          <option value="none">No Grouping</option>
        </select>
      </div>
      
      <div class="control-group">
        <label>Plot Type</label>
        <select id="plotType" onchange="updatePlot()">
          <option value="scatter">Scatter Plot</option>
          <option value="line">Line Plot</option>
          <option value="bar">Bar Chart</option>
          <option value="area">Area Chart</option>
          <option value="box">Box Plot</option>
          <option value="violin">Violin Plot</option>
          <option value="heatmap">Heatmap</option>
          <option value="radar">Radar Chart</option>
          <option value="bubble">Bubble Chart</option>
          <option value="doughnut">Doughnut Chart</option>
        </select>
      </div>
      
      <div class="control-group">
        <label>Scale</label>
        <select id="plotScale" onchange="updatePlot()">
          <option value="linear">Linear</option>
          <option value="log">Logarithmic</option>
        </select>
      </div>
      
      <div class="control-group">
        <button class="btn-primary" onclick="updatePlot()">Update Plot</button>
      </div>
    </div>
    
    <div class="plot-container">
      <div id="plotLoading" class="loading" style="display: none;">
        <div class="spinner"></div>
        <p>Generating plot...</p>
      </div>
      <canvas id="plotCanvas" width="1000" height="600"></canvas>
    </div>
    
    <div class="plot-info">
      <div id="plotStats"></div>
    </div>
    
    <div class="data-section">
      <div class="data-section-header">
        <h3>📊 Plot Data</h3>
        <div class="data-actions">
          <button class="btn-secondary" onclick="exportPlotDataToExcel()">Export to Excel</button>
          <button class="btn-secondary" onclick="copyPlotDataToClipboard()">Copy Data</button>
        </div>
      </div>
      
      <div class="data-table-container">
        <table id="plotDataTable" class="plot-data-table">
          <thead>
            <tr>
              <th>Cytokine</th>
              <th>Sample Type</th>
              <th>Compound</th>
              <th>Compound Concentration</th>
              <th>Actual Concentration (pg/mL)</th>
              <th>Signal Value</th>
              <th>Well</th>
              <th>Group</th>
              <th>X Value</th>
              <th>Y Value</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- AI Interpretation Modal -->
<div id="aiInterpretModal" class="modal" style="display: none;">
  <div class="modal-content" style="width: 95%; max-width: 1400px; max-height: 95vh; overflow: hidden;">
    <div class="modal-header" style="padding: 15px 20px; border-bottom: 1px solid var(--gray-200); display: flex; align-items: center; justify-content: space-between;">
      <div style="display: flex; align-items: center; gap: 15px;">
        <h2 style="margin: 0;">🤖 AI Data Interpretation Assistant</h2>
        <div class="ai-status-badge" id="aiStatusBadge" style="padding: 4px 8px; border-radius: 12px; font-size: 12px; font-weight: 500;">Ready</div>
      </div>
      <div style="display: flex; align-items: center; gap: 10px;">
        <button class="btn btn-sm btn-secondary" onclick="toggleAIMode()" id="aiModeToggle">💬 Chat Mode</button>
        <button class="btn btn-sm btn-info" onclick="exportAIConversation()">💾 Export Chat</button>
        <button class="modal-close" onclick="closeAIInterpret()">&times;</button>
      </div>
    </div>
    
    <div class="modal-body" style="padding: 0; height: calc(95vh - 60px); overflow: hidden;">
      <div style="display: flex; height: 100%;">
        <!-- Left Panel: Enhanced Controls -->
        <div style="width: 350px; border-right: 1px solid var(--gray-200); padding: 20px; overflow-y: auto; background: var(--gray-50);">
          <!-- AI Mode Selector -->
          <div class="ai-mode-selector" style="margin-bottom: 20px;">
            <h3 style="margin: 0 0 10px; font-size: 16px;">🎯 AI Assistant Mode</h3>
            <div class="ai-mode-tabs" style="display: flex; background: white; border-radius: 8px; padding: 4px; border: 1px solid var(--gray-200);">
              <button class="ai-mode-tab active" data-mode="chat" onclick="switchAIMode('chat')" style="flex: 1; padding: 8px; border: none; background: var(--primary); color: white; border-radius: 4px; font-size: 12px;">💬 Chat</button>
              <button class="ai-mode-tab" data-mode="analysis" onclick="switchAIMode('analysis')" style="flex: 1; padding: 8px; border: none; background: transparent; color: var(--gray-600); border-radius: 4px; font-size: 12px;">📈 Analysis</button>
              <button class="ai-mode-tab" data-mode="report" onclick="switchAIMode('report')" style="flex: 1; padding: 8px; border: none; background: transparent; color: var(--gray-600); border-radius: 4px; font-size: 12px;">📄 Report</button>
            </div>
          </div>
          
          <!-- Data Summary -->
          <div class="ai-data-summary" style="margin-bottom: 20px;">
            <h3 style="margin: 0 0 10px; font-size: 16px;">📊 Analysis Data</h3>
            <div id="aiDataSummary" style="background: white; padding: 15px; border-radius: 8px; border: 1px solid var(--gray-200); font-size: 13px;">
              <p style="color: var(--gray-600); font-style: italic; margin: 0;">No analysis data available. Please run analysis first.</p>
            </div>
          </div>
          
          <!-- Quick Actions -->
          <div class="ai-quick-actions" style="margin-bottom: 20px;">
            <h3 style="margin: 0 0 10px; font-size: 16px;">⚡ Quick Actions</h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <button class="btn btn-sm btn-outline-primary" onclick="askAIQuestion('Create a summary table of all cytokines')" style="font-size: 11px; padding: 6px 8px;">📊 Table</button>
              <button class="btn btn-sm btn-outline-primary" onclick="askAIQuestion('Generate a comparison chart')" style="font-size: 11px; padding: 6px 8px;">📈 Chart</button>
              <button class="btn btn-sm btn-outline-primary" onclick="askAIQuestion('Analyze data quality issues')" style="font-size: 11px; padding: 6px 8px;">🔍 Quality</button>
              <button class="btn btn-sm btn-outline-primary" onclick="askAIQuestion('Statistical analysis summary')" style="font-size: 11px; padding: 6px 8px;">📊 Stats</button>
              <button class="btn btn-sm btn-outline-primary" onclick="askAIQuestion('Export comprehensive report')" style="font-size: 11px; padding: 6px 8px;">📄 Report</button>
              <button class="btn btn-sm btn-outline-primary" onclick="askAIQuestion('Troubleshoot my assay')" style="font-size: 11px; padding: 6px 8px;">🔧 Debug</button>
            </div>
          </div>
          
          <!-- Analysis Focus -->
          <div class="ai-focus-panel" id="aiFocusPanel" style="margin-bottom: 20px;">
            <h3 style="margin: 0 0 10px; font-size: 16px;">🎯 Analysis Focus</h3>
            <div class="form-group" style="margin-bottom: 12px;">
              <select id="aiFocusArea" style="width: 100%; padding: 8px; border: 1px solid var(--gray-300); border-radius: 6px; font-size: 13px;">
                <option value="overall">Overall Data Quality & Trends</option>
                <option value="standards">Standard Curve Analysis</option>
                <option value="samples">Sample Concentration Results</option>
                <option value="quality">Data Quality Issues</option>
                <option value="comparison">Cytokine Comparison</option>
                <option value="statistical">Statistical Analysis</option>
                <option value="biological">Biological Interpretation</option>
                <option value="troubleshooting">Troubleshooting</option>
                <option value="custom">Custom Analysis</option>
              </select>
            </div>
            
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 13px; font-weight: 500; margin-bottom: 4px; display: block;">Context (Optional)</label>
              <textarea id="aiContext" placeholder="Describe your experiment, expected results, or specific concerns..." 
                        style="width: 100%; height: 60px; resize: vertical; padding: 8px; border: 1px solid var(--gray-300); border-radius: 6px; font-size: 12px;"></textarea>
            </div>
            
            <button class="btn btn-primary" id="generateAIInterpretation" style="width: 100%; padding: 10px;">
              🚀 Generate Analysis
            </button>
          </div>
          
          <!-- AI Settings Panel -->
          <div class="ai-settings-panel" style="margin-bottom: 20px;">
            <h3 style="margin: 0 0 10px; font-size: 16px;">⚙️ AI Settings</h3>
            <div style="background: white; padding: 12px; border-radius: 8px; border: 1px solid var(--gray-200);">
              <div class="form-group" style="margin-bottom: 10px;">
                <label style="font-size: 12px; font-weight: 500; margin-bottom: 4px; display: block;">Response Style</label>
                <select id="aiResponseStyle" style="width: 100%; padding: 6px; border: 1px solid var(--gray-300); border-radius: 4px; font-size: 12px;">
                  <option value="detailed">Detailed & Technical</option>
                  <option value="concise">Concise & Clear</option>
                  <option value="visual">Visual & Interactive</option>
                  <option value="educational">Educational & Explanatory</option>
                </select>
              </div>
              
              <div class="form-group" style="margin-bottom: 10px;">
                <label style="font-size: 12px; font-weight: 500; margin-bottom: 4px; display: block;">Output Format</label>
                <div style="display: flex; gap: 4px;">
                  <label style="font-size: 11px; display: flex; align-items: center; gap: 4px;">
                    <input type="checkbox" id="aiIncludeTables" checked style="margin: 0;"> Tables
                  </label>
                  <label style="font-size: 11px; display: flex; align-items: center; gap: 4px;">
                    <input type="checkbox" id="aiIncludeCharts" checked style="margin: 0;"> Charts
                  </label>
                  <label style="font-size: 11px; display: flex; align-items: center; gap: 4px;">
                    <input type="checkbox" id="aiIncludeExports" checked style="margin: 0;"> Exports
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Right Panel: Enhanced AI Interface -->
        <div style="flex: 1; display: flex; flex-direction: column; padding: 20px; background: white;">
          <!-- AI Chat Header -->
          <div class="ai-chat-header" style="margin-bottom: 15px; padding-bottom: 10px; border-bottom: 1px solid var(--gray-200);">
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <h3 style="margin: 0; font-size: 18px; display: flex; align-items: center; gap: 8px;">
                💬 <span id="aiChatTitle">AI Assistant</span>
              </h3>
              <div style="display: flex; gap: 8px;">
                <button class="btn btn-sm btn-outline-secondary" onclick="clearAIChat()" title="Clear Chat">🗺️</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="toggleAIHelp()" title="Show Help">❓</button>
              </div>
            </div>
          </div>
          
          <!-- AI Chat Container -->
          <div id="aiChatContainer" style="flex: 1; border: 1px solid var(--gray-200); border-radius: 8px; overflow-y: auto; padding: 15px; background: var(--gray-50); margin-bottom: 15px; min-height: 400px;">
            <div class="ai-message ai-system">
              <div class="ai-avatar">🤖</div>
              <div class="ai-content">
                <h4>Welcome to AI Data Interpretation!</h4>
                <p>I'm your advanced AI assistant for MSD plate analysis. I can help you:</p>
                <ul>
                  <li><strong>Analyze data quality</strong> and identify issues</li>
                  <li><strong>Create interactive tables</strong> and charts</li>
                  <li><strong>Generate reports</strong> and export files</li>
                  <li><strong>Provide biological interpretations</strong> of your results</li>
                  <li><strong>Troubleshoot</strong> experimental problems</li>
                </ul>
                <p><em>Use the quick actions on the left, or type your questions below!</em></p>
              </div>
            </div>
          </div>
          
          <!-- Enhanced Input Area -->
          <div class="ai-input-area" style="background: var(--gray-50); padding: 15px; border-radius: 8px; border: 1px solid var(--gray-200);">
            <!-- Suggested Prompts -->
            <div id="aiSuggestedPrompts" style="margin-bottom: 10px;">
              <div style="font-size: 12px; font-weight: 500; margin-bottom: 6px; color: var(--gray-600);">Suggested prompts:</div>
              <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                <button class="ai-suggestion-btn" onclick="askAIQuestion('Analyze my data quality and create a summary table')" style="padding: 4px 8px; font-size: 11px; border: 1px solid var(--gray-300); background: white; border-radius: 12px; cursor: pointer;">Data Quality Summary</button>
                <button class="ai-suggestion-btn" onclick="askAIQuestion('Create a comparison chart of all cytokines')" style="padding: 4px 8px; font-size: 11px; border: 1px solid var(--gray-300); background: white; border-radius: 12px; cursor: pointer;">Cytokine Comparison</button>
                <button class="ai-suggestion-btn" onclick="askAIQuestion('What biological insights can you provide?')" style="padding: 4px 8px; font-size: 11px; border: 1px solid var(--gray-300); background: white; border-radius: 12px; cursor: pointer;">Biological Insights</button>
                <button class="ai-suggestion-btn" onclick="askAIQuestion('Generate a comprehensive analysis report')" style="padding: 4px 8px; font-size: 11px; border: 1px solid var(--gray-300); background: white; border-radius: 12px; cursor: pointer;">Full Report</button>
              </div>
            </div>
            
            <!-- Input Controls -->
            <div style="display: flex; gap: 10px; align-items: flex-end;">
              <div style="flex: 1;">
                <textarea id="aiChatInput" placeholder="Ask me anything about your MSD analysis data...\n\nExamples:\n• 'Create a table showing R² values for each cytokine'\n• 'What quality issues do you see?'\n• 'Generate a comparison chart'" 
                         style="width: 100%; height: 80px; padding: 10px; border: 1px solid var(--gray-300); border-radius: 6px; resize: vertical; font-family: inherit; font-size: 14px;"></textarea>
              </div>
              <div style="display: flex; flex-direction: column; gap: 6px;">
                <button class="btn btn-primary" id="sendAIQuestion" style="padding: 10px 16px; white-space: nowrap;">Send</button>
                <button class="btn btn-sm btn-secondary" onclick="voiceInput()" title="Voice Input" style="padding: 6px 8px;">🎤</button>
              </div>
            </div>
            
            <!-- Input Options -->
            <div style="margin-top: 8px; display: flex; align-items: center; gap: 12px; font-size: 12px;">
              <label style="display: flex; align-items: center; gap: 4px; color: var(--gray-600);">
                <input type="checkbox" id="aiAutoScroll" checked style="margin: 0;"> Auto-scroll
              </label>
              <label style="display: flex; align-items: center; gap: 4px; color: var(--gray-600);">
                <input type="checkbox" id="aiShowThinking" style="margin: 0;"> Show AI thinking
              </label>
              <span style="color: var(--gray-400); margin-left: auto;">Press Ctrl+Enter to send</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Fast Template Manager Modal -->
<div id="fastTemplateModal" class="modal" style="display: none;">
  <div class="modal-content" style="width: 95%; max-width: 1400px; max-height: 95vh; overflow-y: auto;">
    <div class="modal-header">
      <h2>💾 Fast Template Manager</h2>
      <button class="modal-close" onclick="closeFastTemplateManager()">&times;</button>
    </div>
    <div class="modal-body">
      
      <!-- Template Creation Section -->
      <div class="template-creation-section" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); padding: 20px; border-radius: 12px; margin-bottom: 20px;">
        <h3 style="margin: 0 0 15px; color: #495057;">🎯 Create New Template</h3>
        
        <div class="form-row cols-2" style="margin-bottom: 15px;">
          <div>
            <label style="font-weight: 600; color: #495057;">Template Name</label>
            <input type="text" id="fastTemplateName" placeholder="e.g., Standard 96-Well Layout" maxlength="50" style="width: 100%; padding: 10px; border: 2px solid #dee2e6; border-radius: 8px; font-size: 14px;">
          </div>
          <div>
            <label style="font-weight: 600; color: #495057;">Description</label>
            <input type="text" id="fastTemplateDescription" placeholder="Brief description..." maxlength="100" style="width: 100%; padding: 10px; border: 2px solid #dee2e6; border-radius: 8px; font-size: 14px;">
          </div>
        </div>
        
        <!-- Template Options -->
        <div class="template-options" style="margin-bottom: 20px;">
          <h4 style="margin: 0 0 10px; color: #495057; font-size: 16px;">📋 What to Include:</h4>
          <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;">
            <label style="display: flex; align-items: center; gap: 8px; padding: 10px; background: white; border-radius: 8px; border: 2px solid #e9ecef; cursor: pointer; transition: all 0.2s;">
              <input type="checkbox" id="includePlateLayout" checked style="width: 18px; height: 18px;">
              <span style="font-weight: 500;">🗺️ Plate Layout</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; padding: 10px; background: white; border-radius: 8px; border: 2px solid #e9ecef; cursor: pointer; transition: all 0.2s;">
              <input type="checkbox" id="includeAnalysisData" style="width: 18px; height: 18px;">
              <span style="font-weight: 500;">📊 Analysis Data</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; padding: 10px; background: white; border-radius: 8px; border: 2px solid #e9ecef; cursor: pointer; transition: all 0.2s;">
              <input type="checkbox" id="includeSettings" style="width: 18px; height: 18px;">
              <span style="font-weight: 500;">⚙️ Settings</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; padding: 10px; background: white; border-radius: 8px; border: 2px solid #e9ecef; cursor: pointer; transition: all 0.2s;">
              <input type="checkbox" id="includeCytokines" checked style="width: 18px; height: 18px;">
              <span style="font-weight: 500;">🧪 Cytokines</span>
            </label>
          </div>
        </div>
        
        <div class="quick-actions" style="display: flex; gap: 10px;">
          <button class="btn btn-success" onclick="saveFastTemplate()" style="flex: 1; padding: 12px; font-size: 16px; font-weight: 600;">
            💾 Save Template
          </button>
          <button class="btn btn-secondary" onclick="previewFastTemplate()" style="flex: 1; padding: 12px; font-size: 16px; font-weight: 600;">
            👁️ Preview
          </button>
          <button class="btn btn-info" onclick="testFastTemplateButtons()" style="padding: 12px; font-size: 16px; font-weight: 600;">
            🔧 Test
          </button>
        </div>
      </div>
      
      <!-- Template Library Section -->
      <div class="template-library-section">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px;">
          <h3 style="margin: 0; color: #495057;">📚 Template Library</h3>
          <div style="display: flex; gap: 8px;">
            <button class="btn btn-outline-primary btn-sm" onclick="refreshTemplateLibrary()" style="padding: 6px 12px;">
              🔄 Refresh
            </button>
            <button class="btn btn-outline-info btn-sm" onclick="openTemplateFolder()" style="padding: 6px 12px;">
              📁 Open Folder
            </button>
            <button class="btn btn-outline-success btn-sm" onclick="addSampleTemplates()" style="padding: 6px 12px;">
              📊 Add Samples
            </button>
          </div>
        </div>
        
        <!-- Template Filter -->
        <div style="margin-bottom: 15px;">
          <select id="templateFilter" onchange="filterTemplateLibrary()" style="width: 100%; padding: 10px; border: 2px solid #dee2e6; border-radius: 8px; font-size: 14px;">
            <option value="all">All Templates</option>
            <option value="plate-layout">Plate Layouts</option>
            <option value="analysis-data">Analysis Data</option>
            <option value="settings">Settings</option>
            <option value="complete">Complete Templates</option>
            <option value="recent">Recent</option>
          </select>
        </div>
        
        <!-- Template List -->
        <div id="templateLibraryList" style="max-height: 400px; overflow-y: auto; border: 2px solid #e9ecef; border-radius: 12px; background: white;">
          <div style="text-align: center; padding: 40px; color: #6c757d;">
            <div style="font-size: 18px; margin-bottom: 8px;">📁 No Templates Found</div>
            <div style="font-size: 14px;">Create your first template above or check the Desktop/MSD-Templates folder</div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</div>

