// Initialize the large plot
function initializeLargePlot() {
  try {
    console.log('🎨 Initializing large plot editor...');
    
    // Get the current plot ID from the global state
    const currentPlotId = window.clickedPlotId;
    if (!currentPlotId) {
      console.error('❌ No plot ID found for large plot editor');
      showNotification('No plot selected for editing', 'error', 4000);
      return;
    }
    
    console.log('🎯 Loading plot with ID:', currentPlotId);
    
    // Get plot data from registry
    const plotInfo = getPlotById(currentPlotId);
    const plotStore = getPlotStore(currentPlotId);
    
    if (!plotInfo) {
      console.error('❌ Plot not found in registry:', currentPlotId);
      showNotification('Plot not found in registry', 'error', 4000);
      return;
    }
    
    if (!plotStore) {
      console.error('❌ Plot store not found for:', currentPlotId);
      showNotification('Plot store not found', 'error', 4000);
      return;
    }
    
    console.log('✅ Found plot data:', plotInfo.metadata);
    console.log('📊 Plot store data:', plotStore);
    
    // QA logging for editor opening
    console.log('🎯 Editor opening for plot ID:', currentPlotId);
    console.log('📊 Plot info exists:', !!plotInfo);
    console.log('📊 Plot store exists:', !!plotStore);
    console.log('📊 Chart instance exists:', !!plotInfo.chart);
    
    // Initialize the editor with the correct plot data
    initializeLargePlotEditor(currentPlotId, plotInfo, plotStore);
    
  } catch (e) {
    console.error('Error initializing large plot:', e);
    showNotification('Error initializing large plot: ' + e.message, 'error', 5000);
  }
}

function initializeLargePlotEditor(plotId, plotInfo, plotStore) {
  console.log('🎨 Initializing large plot editor for plot:', plotId);
  
  // Update the modal header with plot information (target the correct h2 element)
  const modalTitle = document.querySelector('#largePlotEditorModal h2');
  if (modalTitle) {
    modalTitle.textContent = `📊 Large Plot Editor — ${plotStore.style.title || plotInfo.metadata.title || 'Untitled Plot'}`;
  }
  
  // Add plot ID display for debugging
  const plotIdDisplay = document.querySelector('#largePlotEditorModal .plot-id-display');
  if (plotIdDisplay) {
    plotIdDisplay.textContent = `Plot ID: ${plotId}`;
  }
  
  // Initialize form controls with current plot style
  initializeEditorControls(plotStore.style);
  
  // Create the preview chart (ensure canvas exists first)
  const canvas = document.getElementById('largePlotCanvas');
  if (!canvas) {
    console.error('❌ Large plot canvas not found');
    showNotification('Plot canvas not found', 'error', 4000);
    return;
  }
  
  createLargePlotPreview(plotInfo.chart, plotStore);
  
  console.log('✅ Large plot editor initialized successfully');
}

function initializeEditorControls(style) {
  // Update all form controls with current style values using largePlot* IDs
  const controls = {
    'largePlotTitle': style.title || '',
    'largePlotBgColor': style.background || '#ffffff',
    'largePlotBgColorText': style.background || '#ffffff',
    'largePlotShowGrid': style.showGrid || false,
    'largePlotShowLegend': style.showLegend || false,
    'largePlotPointSize': style.pointSize || 8,
    'largePlotLineWidth': style.lineWidth || 2,
    'largePlotXLabel': style.xAxisLabel || '',
    'largePlotYLabel': style.yAxisLabel || '',
    'largePlotXScale': style.xScale || 'linear',
    'largePlotYScale': style.yScale || 'linear',
    'largePlotLegendPosition': style.legendPosition || 'top'
  };
  
  // Apply values to form controls
  Object.entries(controls).forEach(([id, value]) => {
    const element = document.getElementById(id);
    if (element) {
      if (element.type === 'checkbox') {
        element.checked = value;
      } else {
        element.value = value;
      }
    }
  });
  
  // Update slider displays
  const pointSizeSlider = document.getElementById('largePlotPointSize');
  const lineWidthSlider = document.getElementById('largePlotLineWidth');
  
  if (pointSizeSlider) {
    document.getElementById('largePlotPointSizeValue').textContent = pointSizeSlider.value;
  }
  if (lineWidthSlider) {
    document.getElementById('largePlotLineWidthValue').textContent = lineWidthSlider.value;
  }
  
  console.log('🎛️ Editor controls initialized with current style');
}

function createLargePlotPreview(originalChart, plotStore) {
  const canvas = document.getElementById('largePlotCanvas');
  if (!canvas) {
    console.error('❌ Large plot canvas not found');
    showNotification('Plot canvas not found', 'error', 4000);
    return;
  }
  
  // Check if Chart.js is loaded
  if (typeof Chart === 'undefined') {
    console.error('❌ Chart.js not loaded');
    showNotification('Chart library not loaded', 'error', 4000);
    return;
  }
  
  // Destroy existing chart if any
  if (window.largePlotChart) {
    window.largePlotChart.destroy();
    window.largePlotChart = null;
  }
  
  try {
    // Deep clone the original chart data to avoid mutations
    const clonedData = JSON.parse(JSON.stringify(originalChart.data));
    
    // Create new chart with current style
    const ctx = canvas.getContext('2d');
    const config = buildChartConfigFromStyle(clonedData, plotStore.style);
    
    window.largePlotChart = new Chart(ctx, config);
    
    console.log('📊 Large plot preview created with', clonedData.datasets?.length || 0, 'datasets');
    
    // QA logging for preview creation
    if (clonedData.datasets && clonedData.datasets.length > 0) {
      console.log('📊 First dataset points:', clonedData.datasets[0].data?.length || 0);
      console.log('📊 Dataset labels:', clonedData.datasets.map(d => d.label));
    }
  } catch (error) {
    console.error('❌ Error creating large plot preview:', error);
    showNotification('Error creating plot preview: ' + error.message, 'error', 4000);
  }
}

function buildChartConfigFromStyle(data, style) {
  return {
    type: 'scatter',
    data: data,
    options: {
      responsive: true,
      maintainAspectRatio: false,
      backgroundColor: style.background || '#ffffff',
      plugins: {
        title: {
          display: true,
          text: style.title || 'Plot',
          font: {
            size: style.fontSizes?.title || 16
          }
        },
        legend: {
          display: style.showLegend || false,
          position: style.legendPosition || 'top',
          labels: {
            font: {
              size: style.fontSizes?.legend || 12
            }
          }
        }
      },
      scales: {
        x: {
          type: style.xScale === 'logarithmic' ? 'logarithmic' : 'linear',
          title: {
            display: true,
            text: style.xAxisLabel || 'X-Axis',
            font: {
              size: style.fontSizes?.axes || 12
            }
          },
          grid: {
            display: style.showGrid || false,
            color: style.gridSettings?.color || '#e9ecef'
          },
          ticks: {
            font: {
              size: style.fontSizes?.ticks || 10
            }
          }
        },
        y: {
          type: style.yScale === 'logarithmic' ? 'logarithmic' : 'linear',
          title: {
            display: true,
            text: style.yAxisLabel || 'Y-Axis',
            font: {
              size: style.fontSizes?.axes || 12
            }
          },
          grid: {
            display: style.showGrid || false,
            color: style.gridSettings?.color || '#e9ecef'
          },
          ticks: {
            font: {
              size: style.fontSizes?.ticks || 10
            }
          }
        }
      }
    }
  };
}

// Update form controls with the plot data
function updateFormControlsWithPlotData(meta) {
  try {
    if (meta.title) {
      const titleInput = document.getElementById('largePlotTitle');
      if (titleInput) titleInput.value = meta.title;
    }
    
    if (meta.xAxis) {
      const xLabelInput = document.getElementById('largePlotXLabel');
      if (xLabelInput) xLabelInput.value = meta.xAxis;
    }
    
    if (meta.yAxis) {
      const yLabelInput = document.getElementById('largePlotYLabel');
      if (yLabelInput) yLabelInput.value = meta.yAxis;
    }
    
    console.log('✅ Form controls updated with plot data');
  } catch (e) {
    console.warn('⚠️ Could not update form controls:', e);
  }
}

// Generate sample pivot data if no real data is available
function generateSamplePivotData() {
  const sampleData = [];
  const compounds = ['Compound A', 'Compound B', 'Compound C'];
  const concentrations = [0.1, 1, 10, 100, 1000];
  
  compounds.forEach(compound => {
    concentrations.forEach(conc => {
      // Generate realistic signal values with some noise
      const baseSignal = Math.log10(conc + 0.1) * 2 + Math.random() * 0.5;
      sampleData.push({
        x: conc,
        y: baseSignal,
        series: compound
      });
    });
  });
  
  return sampleData;
}

// Create the large plot
function createLargePlot(data, meta) {
  const canvas = document.getElementById('largePlotCanvas');
  if (!canvas) {
    console.error('❌ Large plot canvas not found');
    return;
  }
  
  console.log('🎨 Creating large plot with data:', data.length, 'points');
  console.log('📊 Data sample:', data.slice(0, 3));
  
  const ctx = canvas.getContext('2d');
  
  // Destroy existing chart
  if (window.largePlotChart) {
    window.largePlotChart.destroy();
  }
  
  // Group data by series
  const seriesData = {};
  data.forEach(dp => {
    const seriesName = dp.series || 'Default Series';
    if (!seriesData[seriesName]) {
      seriesData[seriesName] = [];
    }
    seriesData[seriesName].push(dp);
  });
  
  console.log('📈 Series found:', Object.keys(seriesData));
  
  // Create datasets
  const datasets = [];
  const colors = [
    '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', 
    '#FF9F40', '#FF6384', '#C9CBCF', '#4BC0C0', '#FF6384'
  ];
  
  Object.keys(seriesData).forEach((seriesName, index) => {
    const seriesPoints = seriesData[seriesName];
    const color = colors[index % colors.length];
    
    console.log(`📊 Creating dataset for ${seriesName}:`, seriesPoints.length, 'points');
    
    datasets.push({
      label: seriesName,
      data: seriesPoints.map(dp => ({ x: dp.x, y: dp.y })),
      backgroundColor: color + '20',
      borderColor: color,
      borderWidth: 2,
      pointRadius: 8,
      pointHoverRadius: 10,
      tension: 0.1
    });
  });
  
  console.log('📊 Total datasets created:', datasets.length);
  
  // Chart configuration
  const config = {
    type: 'scatter',
    data: { datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      backgroundColor: '#ffffff',
      plugins: {
        title: {
          display: true,
          text: meta.title || 'Pivot Analysis',
          font: { size: 20, weight: 'bold' }
        },
        legend: {
          display: true,
          position: 'top',
          labels: {
            usePointStyle: true,
            padding: 20,
            font: { size: 14 }
          }
        }
      },
      scales: {
        x: {
          title: { 
            display: true, 
            text: meta.xAxis || 'Concentration' 
          },
          grid: { display: true }
        },
        y: {
          title: { 
            display: true, 
            text: meta.yAxis || 'Signal' 
          },
          grid: { display: true }
        }
      }
    }
  };
  
  try {
    window.largePlotChart = new Chart(ctx, config);
    console.log('✅ Large plot chart created successfully');
  } catch (error) {
    console.error('❌ Error creating large plot chart:', error);
    showNotification('Error creating plot: ' + error.message, 'error', 5000);
  }
}

// Update the large plot
function updateLargePlot() {
  if (!window.largePlotChart) return;
  
  // Get current settings
  const title = document.getElementById('largePlotTitle')?.value || 'Pivot Analysis';
  const backgroundColor = document.getElementById('largePlotBgColor')?.value || '#ffffff';
  const showGrid = document.getElementById('largePlotShowGrid')?.checked || false;
  const showLegend = document.getElementById('largePlotShowLegend')?.checked || false;
  const xLabel = document.getElementById('largePlotXLabel')?.value || 'Concentration';
  const yLabel = document.getElementById('largePlotYLabel')?.value || 'Signal';
  const pointSize = parseInt(document.getElementById('largePlotPointSize')?.value) || 8;
  const lineWidth = parseInt(document.getElementById('largePlotLineWidth')?.value) || 2;
  const xScale = document.getElementById('largePlotXScale')?.value || 'linear';
  const yScale = document.getElementById('largePlotYScale')?.value || 'linear';
  const legendPosition = document.getElementById('largePlotLegendPosition')?.value || 'top';
  
  // Update slider values
  document.getElementById('largePlotPointSizeValue').textContent = pointSize;
  document.getElementById('largePlotLineWidthValue').textContent = lineWidth;
  
  // Update chart options
  window.largePlotChart.options.plugins.title.text = title;
  window.largePlotChart.options.plugins.legend.display = showLegend;
  window.largePlotChart.options.plugins.legend.position = legendPosition;
  window.largePlotChart.options.scales.x.title.text = xLabel;
  window.largePlotChart.options.scales.y.title.text = yLabel;
  window.largePlotChart.options.scales.x.grid.display = showGrid;
  window.largePlotChart.options.scales.y.grid.display = showGrid;
  window.largePlotChart.options.scales.x.type = xScale === 'logarithmic' ? 'logarithmic' : 'linear';
  window.largePlotChart.options.scales.y.type = yScale === 'logarithmic' ? 'logarithmic' : 'linear';
  window.largePlotChart.options.backgroundColor = backgroundColor;
  
  // Update datasets
  window.largePlotChart.data.datasets.forEach(dataset => {
    dataset.pointRadius = pointSize;
    dataset.pointHoverRadius = pointSize + 2;
    dataset.borderWidth = lineWidth;
  });
  
  window.largePlotChart.update();
}

// Export large plot
function exportLargePlot(format) {
  if (!window.largePlotChart) {
    showNotification('No plot to export', 'error', 3000);
    return;
  }
  
  const canvas = window.largePlotChart.canvas;
  const filename = `pivot-plot-${new Date().toISOString().slice(0, 10)}`;
  
  switch (format) {
    case 'png':
      const pngLink = document.createElement('a');
      pngLink.download = `${filename}.png`;
      pngLink.href = canvas.toDataURL('image/png');
      pngLink.click();
      showNotification('Plot exported as PNG', 'success', 3000);
      break;
      
    case 'svg':
      // For SVG, we'd need additional library
      showNotification('SVG export requires additional library', 'info', 3000);
      break;
      
    case 'pdf':
      // For PDF, we'd need additional library
      showNotification('PDF export requires additional library', 'info', 3000);
      break;
      
    case 'csv':
      // Export data as CSV
      exportLargePlotDataAsCSV();
      break;
  }
}

// Export large plot data as CSV
function exportLargePlotDataAsCSV() {
  if (!window.largePlotChart) return;
  
  const data = window.largePlotChart.data;
  let csvContent = 'Series,X-Value,Y-Value\n';
  
  data.datasets.forEach(dataset => {
    dataset.data.forEach(point => {
      csvContent += `${dataset.label},${point.x},${point.y}\n`;
    });
  });
  
  const blob = new Blob([csvContent], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = `pivot-plot-data-${new Date().toISOString().slice(0, 10)}.csv`;
  link.click();
  URL.revokeObjectURL(url);
  
  showNotification('Plot data exported as CSV', 'success', 3000);
}

// Generate a UUID for plot identification
function generatePlotUUID() {
  return 'plot_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
}

// Store plot references with unique IDs
window.plotRegistry = window.plotRegistry || {};

// Register a plot with its unique ID
function registerPlot(plotId, chartInstance, metadata = {}) {
  window.plotRegistry[plotId] = {
    chart: chartInstance,
    metadata: metadata,
    timestamp: Date.now()
  };
  console.log('📊 Registered plot:', plotId, 'Total plots:', Object.keys(window.plotRegistry).length);
}

// Get plot by ID
function getPlotById(plotId) {
  return window.plotRegistry[plotId] || null;
}

// Clear plot registry (useful for cleanup)
function clearPlotRegistry() {
  Object.values(window.plotRegistry).forEach(plot => {
    if (plot.chart && typeof plot.chart.destroy === 'function') {
      plot.chart.destroy();
    }
  });
  window.plotRegistry = {};
  console.log('🧹 Cleared plot registry');
}

// Close the large plot editor
function closeLargePlotEditor() {
  const modal = document.getElementById('largePlotEditorModal');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = 'auto'; // Restore scrolling
  }
  
  // Destroy chart to free memory
  if (window.largePlotChart) {
    window.largePlotChart.destroy();
    window.largePlotChart = null;
  }
  
  // Clear the clicked plot data to prevent stale references
  window.clickedPivotPlotChart = null;
  window.clickedPivotPlotCanvas = null;
  window.clickedPlotId = null;
  
  console.log('🧹 Cleared clicked plot data');
}

// Get Chart.js scale type from our scale option
function getScaleType(scaleOption) {
  switch (scaleOption) {
    case 'log':
      return 'logarithmic';
    case 'sqrt':
      return 'linear'; // Chart.js doesn't have sqrt, we'll handle this in data transformation
    case 'pow2':
      return 'linear'; // Chart.js doesn't have pow2, we'll handle this in data transformation
    case 'pow10':
      return 'linear'; // Chart.js doesn't have pow10, we'll handle this in data transformation
    default:
      return 'linear';
  }
}

// Zoom functions
function zoomAxis(axis, direction) {
  const minInput = document.getElementById(axis + 'AxisMin');
  const maxInput = document.getElementById(axis + 'AxisMax');
  
  let min = parseFloat(minInput.value) || 0;
  let max = parseFloat(maxInput.value) || 100;
  
  const range = max - min;
  const zoomFactor = 0.2; // 20% zoom
  
  if (direction === 'in') {
    const center = (min + max) / 2;
    const newRange = range * (1 - zoomFactor);
    min = center - newRange / 2;
    max = center + newRange / 2;
  } else if (direction === 'out') {
    const center = (min + max) / 2;
    const newRange = range * (1 + zoomFactor);
    min = center - newRange / 2;
    max = center + newRange / 2;
  }
  
  minInput.value = min.toFixed(6);
  maxInput.value = max.toFixed(6);
  updatePivotPlot();
}

function resetZoom(axis) {
  const minInput = document.getElementById(axis + 'AxisMin');
  const maxInput = document.getElementById(axis + 'AxisMax');
  
  minInput.value = '';
  maxInput.value = '';
  updatePivotPlot();
}

// Update plot information
function updatePlotInfo(dataPoints, xAxis, yAxis, seriesGroup) {
  const infoDiv = document.getElementById('plotInfo');
  
  const totalPoints = dataPoints.length;
  const seriesCount = new Set(dataPoints.map(dp => dp.series)).size;
  const xValues = [...new Set(dataPoints.map(dp => dp.x))].length;
  const yValues = [...new Set(dataPoints.map(dp => dp.y))].length;
  
  infoDiv.innerHTML = `
    <div class="stat-item">
      <div class="stat-value">${totalPoints}</div>
      <div class="stat-label">Data Points</div>
    </div>
    <div class="stat-item">
      <div class="stat-value">${seriesCount}</div>
      <div class="stat-label">Series</div>
    </div>
    <div class="stat-item">
      <div class="stat-value">${xValues}</div>
      <div class="stat-label">X Values</div>
    </div>
    <div class="stat-item">
      <div class="stat-value">${yValues}</div>
      <div class="stat-label">Y Values</div>
    </div>
  `;
}

