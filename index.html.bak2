function applyDisplaySettings(settings) {
  // Apply font size
  const fontSize = parseInt(settings.fontSize) || 12;
  document.documentElement.style.setProperty('--well-font-size', fontSize + 'px');
  
  // Apply color palette
  if (settings.colorPalette) {
    // This would require implementing different color palettes in renderPlate()
    window.currentPalette = settings.colorPalette;
    renderPlate(); // Re-render with new palette
  }
  
  // Apply scale settings
  if (settings.minScale && settings.maxScale) {
    window.scaleSettings = {
      min: parseFloat(settings.minScale),
      max: parseFloat(settings.maxScale)
    };
    renderPlate(); // Re-render with new scale
  }
}

function applyExportDefaults(settings) {
  // Update export form defaults
  if (document.getElementById('exportDecimals')) {
    document.getElementById('exportDecimals').value = settings.defaultDecimals || 3;
  }
  if (document.getElementById('includeMetadata')) {
    document.getElementById('includeMetadata').value = settings.includeMetadataDefault ? 'yes' : 'no';
  }
}

