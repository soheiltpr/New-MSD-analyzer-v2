  initializeAIChat();
}

function showAIConfigurationPrompt() {
  const chatContainer = document.getElementById('aiChatContainer');
  chatContainer.innerHTML = `
    <div class="ai-message ai-system">
      <div class="ai-avatar">🤖</div>
      <div class="ai-content">
        <h4>AI Configuration Required</h4>
        <p>To use AI interpretation, you need to configure your AI API settings first.</p>
        <p><strong>Steps to get started:</strong></p>
        <ol>
          <li>Click the <strong>⚙️ Settings</strong> button in the header</li>
          <li>Go to the <strong>🤖 AI</strong> tab</li>
          <li>Enter your API key and URL</li>
          <li>Test the connection</li>
          <li>Save your settings</li>
        </ol>
        <p><strong>Supported services:</strong> OpenAI, Anthropic Claude, or any OpenAI-compatible API</p>
        <div style="margin-top: 15px;">
          <button class="btn btn-primary" onclick="openSettings(); switchSettingsTab('ai'); closeAIInterpret();">⚙️ Configure AI Settings</button>
        </div>
      </div>
    </div>
  `;
  
  // Disable the generate button
  const generateBtn = document.getElementById('generateAIInterpretation');
  if (generateBtn) {
    generateBtn.disabled = true;
    generateBtn.textContent = '⚠️ Configure AI First';
  }
}

function closeAIInterpret() {
  const modal = document.getElementById('aiInterpretModal');
  modal.style.display = 'none';
}

function updateAIDataSummary() {
  const summaryDiv = document.getElementById('aiDataSummary');
  
  if (!analysisResults || Object.keys(analysisResults).length === 0) {
    summaryDiv.innerHTML = '<p style="color: var(--gray-600); font-style: italic;">No analysis data available. Please run analysis first.</p>';
    return;
  }
  
  const cytokines = Object.keys(analysisResults);
  const totalCytokines = cytokines.length;
  let summaryHTML = `<h4 style="margin: 0 0 10px; color: var(--gray-800);">Analysis Summary</h4>`;
  summaryHTML += `<p style="margin: 5px 0; font-size: 14px;"><strong>Cytokines Analyzed:</strong> ${totalCytokines}</p>`;
  
  cytokines.forEach(cytokineIndex => {
    const result = analysisResults[cytokineIndex];
    if (result && result.standards && result.samples) {
      const standardCount = result.standards.length;
      const sampleCount = result.samples.length;
      const rSquared = result.rSquared ? result.rSquared.toFixed(3) : 'N/A';
      
      summaryHTML += `<div style="background: white; padding: 10px; border-radius: 6px; margin: 8px 0; border-left: 3px solid var(--primary);">`;
      summaryHTML += `<strong>${CYTOKINES[cytokineIndex] || `Cytokine ${parseInt(cytokineIndex) + 1}`}</strong><br>`;
      summaryHTML += `<small style="color: var(--gray-600);">Standards: ${standardCount} | Samples: ${sampleCount} | R²: ${rSquared}</small>`;
      summaryHTML += `</div>`;
    }
  });
  
  summaryDiv.innerHTML = summaryHTML;
}

function initializeAIChat() {
  const chatContainer = document.getElementById('aiChatContainer');
  const chatInput = document.getElementById('aiChatInput');
  const sendBtn = document.getElementById('sendAIQuestion');
  const generateBtn = document.getElementById('generateAIInterpretation');
  
  // Clear existing chat except system message
  const systemMessage = chatContainer.querySelector('.ai-system');
  chatContainer.innerHTML = '';
  if (systemMessage) {
    chatContainer.appendChild(systemMessage);
  }
  
  // Add event listeners
  sendBtn.addEventListener('click', sendAIQuestion);
  generateBtn.addEventListener('click', generateAIInterpretation);
  
  chatInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      if (e.ctrlKey || e.metaKey) {
        // Ctrl+Enter or Cmd+Enter: Send message
        e.preventDefault();
        sendAIQuestion();
      } else if (!e.shiftKey) {
        // Enter without Shift: Send message (for regular input)
        // For textarea, Enter without Shift adds new line, Ctrl+Enter sends
        if (chatInput.tagName.toLowerCase() === 'input') {
          e.preventDefault();
          sendAIQuestion();
        }
      }
    }
  });
  
  // Auto-resize textarea
  if (chatInput.tagName.toLowerCase() === 'textarea') {
    chatInput.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = Math.min(this.scrollHeight, 120) + 'px';
    });
  }
  
  // Auto-scroll option
  const autoScrollCheckbox = document.getElementById('aiAutoScroll');
  if (autoScrollCheckbox) {
    autoScrollCheckbox.addEventListener('change', function() {
      localStorage.setItem('aiAutoScroll', this.checked);
    });
    
    // Load saved preference
    const savedAutoScroll = localStorage.getItem('aiAutoScroll');
    if (savedAutoScroll !== null) {
      autoScrollCheckbox.checked = savedAutoScroll === 'true';
    }
  }
}

async function sendAIQuestion() {
  const input = document.getElementById('aiChatInput');
  const question = input.value.trim();
  
  if (!question) return;
  
  // Add user message
  addAIMessage('user', question);
  input.value = '';
  
  // Show typing indicator
  showAITyping();
  
  try {
    const response = await generateAIResponse(question);
    hideAITyping();
    addAIMessage('assistant', response);
  } catch (error) {
    hideAITyping();
    addAIMessage('assistant', `Error: ${error.message}`);
  }
}

async function generateAIInterpretation() {
  const focusArea = document.getElementById('aiFocusArea').value;
  const context = document.getElementById('aiContext').value;
  
  if (!analysisResults || Object.keys(analysisResults).length === 0) {
    addAIMessage('assistant', 'Please run analysis first to generate data for interpretation.');
    return;
  }
  
  showAITyping();
  
  try {
    const interpretation = await generateComprehensiveInterpretation(focusArea, context);
    hideAITyping();
    addAIMessage('assistant', interpretation);
  } catch (error) {
    hideAITyping();
    addAIMessage('assistant', `Error: ${error.message}`);
  }
}

function addAIMessage(type, content, options = {}) {
  const chatContainer = document.getElementById('aiChatContainer');
  const messageDiv = document.createElement('div');
  messageDiv.className = `ai-message ai-${type}`;
  
  const avatar = type === 'user' ? '👤' : '🤖';
  
  // Process content for rich formatting
  const processedContent = processAIContent(content, options);
  
  messageDiv.innerHTML = `
    <div class="ai-avatar">${avatar}</div>
    <div class="ai-content">
      ${processedContent}
    </div>
  `;
  
  chatContainer.appendChild(messageDiv);
  
  // Auto-scroll if enabled
  const autoScroll = document.getElementById('aiAutoScroll')?.checked !== false;
  if (autoScroll) {
    chatContainer.scrollTop = chatContainer.scrollHeight;
  }
  
  // Update usage statistics
  if (type === 'user') {
    updateAIUsageStats('question');
  } else if (content.includes('ai-table-container')) {
    updateAIUsageStats('table');
  } else if (content.includes('ai-chart-container')) {
    updateAIUsageStats('chart');
  }
  
  // Initialize any interactive elements
  initializeInteractiveElements(messageDiv);
}

function processAIContent(content, options = {}) {
  // Check if content contains structured data markers
  if (content.includes('```table') || content.includes('[TABLE]')) {
    return processTableContent(content);
  }
  if (content.includes('```chart') || content.includes('[CHART]')) {
    return processChartContent(content);
  }
  if (content.includes('```download') || content.includes('[DOWNLOAD]')) {
    return processDownloadContent(content);
  }
  
  // Enhanced markdown-like processing
  let processed = content;
  
  // Convert markdown tables to HTML
  processed = convertMarkdownTables(processed);
  
  // Convert code blocks
  processed = processed.replace(/```([\s\S]*?)```/g, '<pre class="ai-code"><code>$1</code></pre>');
  
  // Convert bold text
  processed = processed.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
  
  // Convert italic text
  processed = processed.replace(/\*(.*?)\*/g, '<em>$1</em>');
  
  // Convert bullet points
  processed = processed.replace(/^[•\-\*] (.+)$/gm, '<li>$1</li>');
  processed = processed.replace(/((<li>.*<\/li>\s*)+)/g, '<ul>$1</ul>');
  
  // Convert numbered lists
  processed = processed.replace(/^\d+\. (.+)$/gm, '<li>$1</li>');
  
  // Convert headers
  processed = processed.replace(/^### (.+)$/gm, '<h4>$1</h4>');
  processed = processed.replace(/^## (.+)$/gm, '<h3>$1</h3>');
  processed = processed.replace(/^# (.+)$/gm, '<h2>$1</h2>');
  
  // Convert line breaks
  processed = processed.replace(/\n\n/g, '</p><p>');
  processed = '<p>' + processed + '</p>';
  
  return processed;
}

function convertMarkdownTables(content) {
  const tableRegex = /\|(.+)\|\s*\n\|([\s\S]*?)\n(?=\n|$)/g;
  
  return content.replace(tableRegex, (match, headerRow, dataRows) => {
    const headers = headerRow.split('|').map(h => h.trim()).filter(h => h);
    const rows = dataRows.split('\n').filter(row => row.trim() && !row.includes('---'));
    
    let html = '<div class="ai-table-container"><table class="ai-table">';
    
    // Add headers
    html += '<thead><tr>';
    headers.forEach(header => {
      html += `<th>${header}</th>`;
    });
    html += '</tr></thead>';
    
    // Add data rows
    html += '<tbody>';
    rows.forEach(row => {
      const cells = row.split('|').map(c => c.trim()).filter(c => c);
      html += '<tr>';
      cells.forEach(cell => {
        html += `<td>${cell}</td>`;
      });
      html += '</tr>';
    });
    html += '</tbody></table>';
    
    // Add action buttons
    html += `
      <div class="ai-table-actions">
        <button class="btn btn-sm btn-secondary" onclick="exportAITable(this)">📊 Export CSV</button>
        <button class="btn btn-sm btn-info" onclick="createChartFromTable(this)">📈 Create Chart</button>
        <button class="btn btn-sm btn-primary" onclick="copyAITable(this)">📋 Copy</button>
      </div>
    </div>`;
    
    return html;
  });
}

function processTableContent(content) {
  // Extract table data from AI response
  const tableMatch = content.match(/```table([\s\S]*?)```/) || content.match(/\[TABLE\]([\s\S]*?)\[\/TABLE\]/);
  if (!tableMatch) return content;
  
  try {
    const tableData = JSON.parse(tableMatch[1].trim());
    return createInteractiveTable(tableData, content.replace(tableMatch[0], ''));
  } catch (e) {
    return content;
  }
}

function processChartContent(content) {
  const chartMatch = content.match(/```chart([\s\S]*?)```/) || content.match(/\[CHART\]([\s\S]*?)\[\/CHART\]/);
  if (!chartMatch) return content;
  
  try {
    const chartData = JSON.parse(chartMatch[1].trim());
    return createInteractiveChart(chartData, content.replace(chartMatch[0], ''));
  } catch (e) {
    return content;
  }
}

function processDownloadContent(content) {
  const downloadMatch = content.match(/```download([\s\S]*?)```/) || content.match(/\[DOWNLOAD\]([\s\S]*?)\[\/DOWNLOAD\]/);
  if (!downloadMatch) return content;
  
  try {
    const downloadData = JSON.parse(downloadMatch[1].trim());
    return createDownloadButton(downloadData, content.replace(downloadMatch[0], ''));
  } catch (e) {
    return content;
  }
}

function showAITyping() {
  const chatContainer = document.getElementById('aiChatContainer');
  const typingDiv = document.createElement('div');
  typingDiv.className = 'ai-message ai-assistant';
  typingDiv.id = 'ai-typing-indicator';
  typingDiv.innerHTML = `
    <div class="ai-avatar">🤖</div>
    <div class="ai-content">
      <div class="ai-typing">
        <span></span><span></span><span></span>
        <span style="margin-left: 8px;">AI is thinking...</span>
      </div>
    </div>
  `;
  
  chatContainer.appendChild(typingDiv);
  chatContainer.scrollTop = chatContainer.scrollHeight;
}

function hideAITyping() {
  const typingIndicator = document.getElementById('ai-typing-indicator');
  if (typingIndicator) {
    typingIndicator.remove();
  }
}

async function generateAIResponse(question) {
  try {
    const analysisData = getFormattedAnalysisData();
    const prompt = createAIPrompt(question, analysisData);
    
    const response = await callAIAPI(prompt);
    return response;
  } catch (error) {
    console.error('AI API Error:', error);
    return `I apologize, but I'm having trouble connecting to the AI service. Error: ${error.message}. Please check your API configuration or try again later.`;
  }
}

async function generateComprehensiveInterpretation(focusArea, context) {
  try {
    const analysisData = getFormattedAnalysisData();
    const prompt = createComprehensiveAIPrompt(focusArea, context, analysisData);
    
    const response = await callAIAPI(prompt);
    return response;
  } catch (error) {
    console.error('AI API Error:', error);
    return `I apologize, but I'm having trouble connecting to the AI service. Error: ${error.message}. Please check your API configuration or try again later.`;
  }
}

// AI API Configuration and Functions
let AIConfig = {
  apiKey: 'OPENAI_API_KEY_HERE',
  apiUrl: 'https://api.openai.com/v1/chat/completions',
  model: 'gpt-4o-mini', // Default to widely available modern model
  maxTokens: 2000,
  temperature: 0.7
};

function getFormattedAnalysisData() {
  if (!analysisResults || Object.keys(analysisResults).length === 0) {
    return { message: 'No analysis data available' };
  }
  
  const formattedData = {
    timestamp: new Date().toISOString(),
    totalCytokines: Object.keys(analysisResults).length,
    cytokines: []
  };
  
  Object.keys(analysisResults).forEach(cytokineIndex => {
    const result = analysisResults[cytokineIndex];
    const cytokineName = CYTOKINES[cytokineIndex] || `Cytokine ${parseInt(cytokineIndex) + 1}`;
    
    const cytokineData = {
      name: cytokineName,
      index: cytokineIndex,
      rSquared: result.rSquared || null,
      standardCount: result.standards ? result.standards.length : 0,
      sampleCount: result.samples ? result.samples.length : 0,
      standards: result.standards ? result.standards.map(std => ({
        concentration: std.concentration,
        signal: std.signal,
        well: std.well
      })) : [],
      samples: result.samples ? result.samples.map(sample => ({
        concentration: sample.concentration,
        signal: sample.signal,
        well: sample.well,
        compound: sample.compound || 'Unknown'
      })) : []
    };
    
    formattedData.cytokines.push(cytokineData);
  });
  
  return formattedData;
}

function createAIPrompt(question, analysisData) {
  return `You are an expert bioanalytical scientist specializing in MSD (Meso Scale Discovery) plate assays and cytokine analysis. 

User Question: "${question}"

Analysis Data:
${JSON.stringify(analysisData, null, 2)}

Please provide a detailed, scientific response to the user's question based on their actual MSD plate analysis data. Focus on:
1. Data quality assessment
2. Biological significance of results
3. Statistical considerations
4. Experimental recommendations
5. Potential issues or concerns

Be specific about their data and provide actionable insights. Use scientific terminology appropriately but explain complex concepts clearly.

FORMATTING INSTRUCTIONS:
- Use **bold** for important terms
- Use *italics* for emphasis
- Create tables using markdown format when presenting data:
  | Header 1 | Header 2 | Header 3 |
  |----------|----------|----------|
  | Data 1   | Data 2   | Data 3   |
- Use bullet points with - or •
- Use ## for main sections, ### for subsections
- When the user specifically asks for tables, charts, or downloads, format your response accordingly`;
}

function createComprehensiveAIPrompt(focusArea, context, analysisData) {
  const focusDescriptions = {
    'overall': 'comprehensive overall data quality and trends analysis',
    'standards': 'detailed standard curve analysis and calibration assessment',
    'samples': 'sample concentration results and biological interpretation',
    'quality': 'data quality issues and validation assessment',
    'comparison': 'cytokine comparison and cross-cytokine analysis',
    'custom': 'custom analysis based on user context'
  };
  
  const focusDescription = focusDescriptions[focusArea] || 'comprehensive data analysis';
  
  return `You are an expert bioanalytical scientist specializing in MSD (Meso Scale Discovery) plate assays and cytokine analysis. 

Please provide a ${focusDescription} for the following MSD plate data:

Analysis Data:
${JSON.stringify(analysisData, null, 2)}

${context ? `Additional Context: ${context}` : ''}

Please provide a detailed scientific report including:
1. Executive summary of findings
2. Data quality assessment with specific metrics
3. Statistical analysis and significance
4. Biological interpretation of results
5. Experimental recommendations
6. Potential limitations or concerns
7. Next steps for validation or follow-up

Format your response as a professional scientific report with clear sections and actionable recommendations.

FORMATTING INSTRUCTIONS:
- Use **bold** for important terms and values
- Use *italics* for emphasis
- Create tables using markdown format for data presentation:
  | Cytokine | R² Value | Sample Count | Status |
  |----------|----------|--------------|--------|
  | GM-CSF   | 0.995    | 24           | Good   |
- Use ## for main sections, ### for subsections
- Use bullet points with - or •
- Present numerical data in organized tables when possible
- Include actionable recommendations in bullet format`;
}

async function callAIAPI(prompt) {
  if (!AIConfig.apiKey || !AIConfig.apiUrl) {
    throw new Error('AI API not configured. Please set up your API credentials in the settings.');
  }

  // Helper builders for different endpoints
  const buildChatCompletionsBody = () => ({
    model: AIConfig.model,
    messages: [
      {
        role: 'system',
        content:
          'You are an expert bioanalytical scientist specializing in MSD plate assays and cytokine analysis. Provide detailed, scientific responses based on the provided data.'
      },
      { role: 'user', content: prompt }
    ],
    max_tokens: AIConfig.maxTokens,
    temperature: AIConfig.temperature
  });

  // Responses API (fallback) – simplified payload
  const buildResponsesBody = () => ({
    model: AIConfig.model,
    input: prompt,
    // Some providers use max_output_tokens instead of max_tokens
    max_tokens: AIConfig.maxTokens,
    max_output_tokens: AIConfig.maxTokens,
    temperature: AIConfig.temperature
  });

  async function tryRequest(url, body) {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${AIConfig.apiKey}`
      },
      body: JSON.stringify(body)
    });

    if (!response.ok) {
      const errorText = await response.text().catch(() => '');
      throw new Error(`API request failed: ${response.status} ${response.statusText}${errorText ? ` - ${errorText}` : ''}`);
    }

    const data = await response.json();

    // Chat Completions style
    if (data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content) {
      return data.choices[0].message.content;
    }
    // Responses API style
    if (typeof data.output_text === 'string' && data.output_text.length > 0) {
      return data.output_text;
    }
    if (Array.isArray(data.output) && data.output.length > 0 && data.output[0].content && data.output[0].content[0] && data.output[0].content[0].text) {
      return data.output[0].content[0].text;
    }
    if (data.content) {
      return data.content;
    }
    throw new Error('Unexpected API response format');
  }

  // Try primary endpoint first
  try {
    const primaryUrl = AIConfig.apiUrl.trim();
    if (primaryUrl.endsWith('/responses')) {
      return await tryRequest(primaryUrl, buildResponsesBody());
    }
    // default to chat/completions format
    return await tryRequest(primaryUrl, buildChatCompletionsBody());
  } catch (e) {
    const msg = String(e.message || e);
    // If 404 or "not found", retry with the Responses API automatically
    if (msg.includes('404') || msg.toLowerCase().includes('not found')) {
      try {
        const fallbackUrl = 'https://api.openai.com/v1/responses';
        return await tryRequest(fallbackUrl, buildResponsesBody());
      } catch (e2) {
        throw e2;
      }
    }
    throw e;
  }
}

function configureAIAPI(apiKey, apiUrl, model = 'gpt-3.5-turbo') {
  AIConfig.apiKey = apiKey;
  AIConfig.apiUrl = apiUrl;
  AIConfig.model = model;
  
  // Save to localStorage
  localStorage.setItem('aiConfig', JSON.stringify(AIConfig));
  
  showNotification('AI API configured successfully!', 'success', 3000);
}

function loadAIConfig() {
  const saved = localStorage.getItem('aiConfig');
  if (saved) {
    AIConfig = { ...AIConfig, ...JSON.parse(saved) };
  }
}

// AI Settings Management Functions
function saveAISettings() {
  const apiKey = document.getElementById('aiApiKey').value.trim();
  const apiUrl = document.getElementById('aiApiUrl').value.trim();
  const model = document.getElementById('aiModel').value;
  const maxTokens = parseInt(document.getElementById('aiMaxTokens').value);
  const temperature = parseFloat(document.getElementById('aiTemperature').value);
  
  if (!apiKey || !apiUrl) {
    showNotification('Please enter both API Key and API URL', 'error', 3000);
    return;
  }
  
  configureAIAPI(apiKey, apiUrl, model);
  AIConfig.maxTokens = maxTokens;
  AIConfig.temperature = temperature;
  
  localStorage.setItem('aiConfig', JSON.stringify(AIConfig));
  showNotification('AI settings saved successfully!', 'success', 3000);
}

function testAIConnection() {
  const apiKey = document.getElementById('aiApiKey').value.trim();
  const apiUrl = document.getElementById('aiApiUrl').value.trim();
  
  if (!apiKey || !apiUrl) {
    showNotification('Please enter both API Key and API URL first', 'error', 3000);
    return;
  }
  
  showNotification('Testing AI connection...', 'info', 2000);
  
  // Test with a simple prompt
  const testPrompt = 'Hello, this is a test message. Please respond with "Connection successful!"';
  
  fetch(apiUrl, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${apiKey}`
    },
    body: JSON.stringify({
      model: document.getElementById('aiModel').value,
      messages: [
        { role: 'user', content: testPrompt }
      ],
      max_tokens: 50
    })
  })
  .then(response => {
    if (response.ok) {
      showNotification('✅ AI connection successful!', 'success', 3000);
    } else {
      showNotification(`❌ Connection failed: ${response.status}`, 'error', 5000);
    }
  })
  .catch(error => {
    showNotification(`❌ Connection error: ${error.message}`, 'error', 5000);
  });
}

// Simple test function to diagnose API issues end-to-end
async function testAIDiagnosis() {
  console.log('🧪 Starting AI Diagnosis...');
  try {
    const reply = await callAIAPI('Reply exactly with: TEST_OK');
    console.log('🧪 Diagnosis reply:', reply);
    if (reply && reply.toUpperCase().includes('TEST_OK')) {
      showNotification('✅ AI diagnosis successful', 'success', 3000);
    } else {
      showNotification('⚠️ AI responded but not as expected. Check console.', 'warning', 5000);
    }
  } catch (err) {
    console.error('🧪 Diagnosis error:', err);
    showNotification(`❌ AI diagnosis failed: ${err.message}`, 'error', 6000);
  }
}

// Enhanced AI Content Processing Functions
function createInteractiveTable(tableData, additionalContent = '') {
  const tableId = 'ai-table-' + Date.now();
  
  let html = additionalContent ? `<div>${processAIContent(additionalContent)}</div>` : '';
  
  html += `<div class="ai-table-container">
    <table class="ai-table" id="${tableId}">`;
  
  // Add headers
  if (tableData.headers) {
    html += '<thead><tr>';
    tableData.headers.forEach(header => {
      html += `<th>${header}</th>`;
    });
    html += '</tr></thead>';
  }
  
  // Add data rows
  html += '<tbody>';
  if (tableData.rows) {
    tableData.rows.forEach(row => {
      html += '<tr>';
      row.forEach(cell => {
        html += `<td>${cell}</td>`;
      });
      html += '</tr>';
    });
  }
  html += '</tbody></table>';
  
  // Add action buttons
  html += `
    <div class="ai-table-actions">
      <button class="btn btn-sm btn-secondary" onclick="exportAITable('${tableId}')">📊 Export CSV</button>
      <button class="btn btn-sm btn-info" onclick="createChartFromTable('${tableId}')">📈 Create Chart</button>
      <button class="btn btn-sm btn-primary" onclick="copyAITable('${tableId}')">📋 Copy</button>
      <button class="btn btn-sm btn-success" onclick="downloadTablePDF('${tableId}')">📄 PDF</button>
    </div>
  </div>`;
  
  return html;
}

function createInteractiveChart(chartData, additionalContent = '') {
  const chartId = 'ai-chart-' + Date.now();
  
  let html = additionalContent ? `<div>${processAIContent(additionalContent)}</div>` : '';
  
  html += `
    <div class="ai-chart-container">
      <canvas class="ai-chart-canvas" id="${chartId}" width="400" height="300"></canvas>
      <div class="ai-chart-actions">
        <button class="btn btn-sm btn-secondary" onclick="downloadChart('${chartId}')">📋 Download PNG</button>
        <button class="btn btn-sm btn-info" onclick="downloadChartData('${chartId}')">📊 Export Data</button>
      </div>
    </div>
  `;
  
  // Store chart data for later use
  setTimeout(() => {
    createChart(chartId, chartData);
  }, 100);
  
  return html;
}

function createDownloadButton(downloadData, additionalContent = '') {
  let html = additionalContent ? `<div>${processAIContent(additionalContent)}</div>` : '';
  
  html += `
    <div class="ai-download-container">
      <div class="ai-download-icon">📁</div>
      <div class="ai-download-info">
        <div class="ai-download-title">${downloadData.title || 'Download File'}</div>
        <div class="ai-download-desc">${downloadData.description || 'Generated file ready for download'}</div>
      </div>
      <button class="btn btn-primary" onclick="downloadAIFile('${JSON.stringify(downloadData).replace(/'/g, "&apos;")}')">⬇️ Download</button>
    </div>
  `;
  
  return html;
}

function initializeInteractiveElements(messageDiv) {
  // Initialize any charts in the message
  const charts = messageDiv.querySelectorAll('.ai-chart-canvas');
  charts.forEach(canvas => {
    const chartData = canvas.getAttribute('data-chart');
    if (chartData) {
      try {
        createChart(canvas.id, JSON.parse(chartData));
      } catch (e) {
        console.error('Failed to create chart:', e);
      }
    }
  });
}

// Table Export Functions
function exportAITable(tableId) {
  const table = document.getElementById(tableId);
  if (!table) return;
  
  let csv = '';
  const rows = table.querySelectorAll('tr');
  
  rows.forEach(row => {
    const cells = row.querySelectorAll('th, td');
    const rowData = Array.from(cells).map(cell => {
      let text = cell.textContent.trim();
      // Escape quotes and wrap in quotes if contains comma
      if (text.includes(',') || text.includes('"')) {
        text = '"' + text.replace(/"/g, '""') + '"';
      }
      return text;
    });
    csv += rowData.join(',') + '\n';
  });
  
  downloadFile(csv, 'ai-table-export.csv', 'text/csv');
  showNotification('Table exported as CSV', 'success', 2000);
}

function copyAITable(tableId) {
  const table = document.getElementById(tableId);
  if (!table) return;
  
  let text = '';
  const rows = table.querySelectorAll('tr');
  
  rows.forEach(row => {
    const cells = row.querySelectorAll('th, td');
    const rowData = Array.from(cells).map(cell => cell.textContent.trim());
    text += rowData.join('\t') + '\n';
  });
  
  navigator.clipboard.writeText(text).then(() => {
    showNotification('Table copied to clipboard', 'success', 2000);
  }).catch(() => {
    showNotification('Failed to copy table', 'error', 2000);
  });
}

function downloadTablePDF(tableId) {
  const table = document.getElementById(tableId);
  if (!table) return;
  
  // Simple PDF generation (you might want to use a library like jsPDF)
  const content = table.outerHTML;
  const printWindow = window.open('', '', 'height=600,width=800');
  printWindow.document.write(`
    <html><head><title>AI Table Export</title>
    <style>
      table { border-collapse: collapse; width: 100%; }
      th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
      th { background-color: #f2f2f2; }
    </style>
    </head><body>${content}</body></html>
  `);
  printWindow.document.close();
  printWindow.print();
}

// Chart Functions
function createChart(canvasId, chartData) {
  const canvas = document.getElementById(canvasId);
  if (!canvas || !window.Chart) return;
  
  const ctx = canvas.getContext('2d');
  
  new Chart(ctx, {
    type: chartData.type || 'bar',
    data: chartData.data,
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        title: {
          display: true,
          text: chartData.title || 'AI Generated Chart'
        }
      },
      ...chartData.options
    }
  });
}

function createChartFromTable(tableId) {
  const table = document.getElementById(tableId);
  if (!table) return;
  
  const headers = Array.from(table.querySelectorAll('th')).map(th => th.textContent.trim());
  const rows = Array.from(table.querySelectorAll('tbody tr')).map(row => 
    Array.from(row.querySelectorAll('td')).map(td => td.textContent.trim())
  );
  
  if (headers.length < 2 || rows.length === 0) {
    showNotification('Table needs at least 2 columns and 1 row to create a chart', 'warning', 3000);
    return;
  }
  
  // Create chart data
  const chartData = {
    type: 'bar',
    data: {
      labels: rows.map(row => row[0]),
      datasets: [{
        label: headers[1],
        data: rows.map(row => parseFloat(row[1]) || 0),
        backgroundColor: 'rgba(54, 162, 235, 0.2)',
        borderColor: 'rgba(54, 162, 235, 1)',
        borderWidth: 1
      }]
    },
    title: `Chart from ${headers.join(' vs ')}`
  };
  
  const chartHtml = createInteractiveChart(chartData, 'Chart generated from table data:');
  addAIMessage('assistant', chartHtml);
}

function downloadChart(canvasId) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  
  canvas.toBlob(blob => {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'ai-chart.png';
    a.click();
    URL.revokeObjectURL(url);
    showNotification('Chart downloaded as PNG', 'success', 2000);
  });
}

function downloadChartData(canvasId) {
  // This would export the underlying chart data
  showNotification('Chart data export not implemented yet', 'info', 2000);
}

// File Download Functions
function downloadAIFile(downloadDataStr) {
  try {
    const downloadData = JSON.parse(downloadDataStr.replace(/&apos;/g, "'"));
    
    if (downloadData.content && downloadData.filename) {
      downloadFile(downloadData.content, downloadData.filename, downloadData.mimeType || 'text/plain');
      showNotification(`Downloaded ${downloadData.filename}`, 'success', 2000);
    } else {
      showNotification('Invalid download data', 'error', 2000);
    }
  } catch (e) {
    showNotification('Failed to process download', 'error', 2000);
  }
}

function downloadFile(content, filename, mimeType) {
  const blob = new Blob([content], { type: mimeType });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  a.click();
  URL.revokeObjectURL(url);
}

// Enhanced AI Interface Functions
function askAIQuestion(question) {
  const chatInput = document.getElementById('aiChatInput');
  chatInput.value = question;
  sendAIQuestion();
}

function switchAIMode(mode) {
  // Update mode tabs
  document.querySelectorAll('.ai-mode-tab').forEach(tab => {
    tab.classList.remove('active');
    tab.style.background = 'transparent';
    tab.style.color = 'var(--gray-600)';
  });
  
  const activeTab = document.querySelector(`[data-mode="${mode}"]`);
  if (activeTab) {
    activeTab.classList.add('active');
    activeTab.style.background = 'var(--primary)';
    activeTab.style.color = 'white';
  }
  
  // Update chat title and behavior
  const chatTitle = document.getElementById('aiChatTitle');
  const focusPanel = document.getElementById('aiFocusPanel');
  
  switch (mode) {
    case 'chat':
      chatTitle.textContent = 'AI Assistant - Chat Mode';
      focusPanel.style.display = 'none';
      break;
    case 'analysis':
      chatTitle.textContent = 'AI Assistant - Analysis Mode';
      focusPanel.style.display = 'block';
      break;
    case 'report':
      chatTitle.textContent = 'AI Assistant - Report Mode';
      focusPanel.style.display = 'block';
      askAIQuestion('Generate a comprehensive analysis report with tables and charts');
      break;
  }
}

function toggleAIMode() {
  const currentMode = document.querySelector('.ai-mode-tab.active')?.dataset.mode || 'chat';
  const nextMode = currentMode === 'chat' ? 'analysis' : currentMode === 'analysis' ? 'report' : 'chat';
  switchAIMode(nextMode);
}

