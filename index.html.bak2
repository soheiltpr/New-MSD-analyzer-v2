// Enhanced Template Manager Functions
class TemplateFileManager {
  constructor() {
    this.templateStorageSettings = {
      defaultPath: '~/Documents/MSD-Templates/',
      customPath: null,
      autoBackup: true,
      compression: false
    };
    this.initializeStorage();
  }
  
  initializeStorage() {
    // Load storage settings from localStorage
    const savedSettings = localStorage.getItem('templateStorageSettings');
    if (savedSettings) {
      this.templateStorageSettings = { ...this.templateStorageSettings, ...JSON.parse(savedSettings) };
    }
    
    // Update UI with current path
    this.updateStoragePathDisplay();
  }
  
  updateStoragePathDisplay() {
    const pathElement = document.getElementById('templateStoragePath');
    if (pathElement) {
      const displayPath = this.templateStorageSettings.customPath || this.templateStorageSettings.defaultPath;
      pathElement.textContent = displayPath;
    }
  }
  
  async saveTemplateToFile(templateData, filename, type = 'complete') {
    try {
      const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
      const sanitizedFilename = filename.replace(/[^a-zA-Z0-9-_]/g, '-');
      const fullFilename = `${sanitizedFilename}-${type}-${timestamp}.msd`;
      
      const templateContent = {
        metadata: {
          name: filename,
          type: type,
          created: new Date().toISOString(),
          version: '2.0',
          software: 'MSD Plate Analyzer'
        },
        data: templateData
      };
      
      const jsonContent = JSON.stringify(templateContent, null, 2);
      const blob = new Blob([jsonContent], { type: 'application/json' });
      
      // Use File System Access API if available, otherwise fallback to download
      if ('showSaveFilePicker' in window) {
        const fileHandle = await window.showSaveFilePicker({
          suggestedName: fullFilename,
          types: [{
            description: 'MSD Template files',
            accept: { 'application/json': ['.msd'] }
          }]
        });
        
        const writable = await fileHandle.createWritable();
        await writable.write(blob);
        await writable.close();
        
        showNotification(`Template saved as ${fullFilename}`, 'success', 3000);
        return true;
      } else {
        // Fallback to download
        this.downloadTemplate(blob, fullFilename);
        return true;
      }
    } catch (error) {
      console.error('Failed to save template:', error);
      showNotification(`Failed to save template: ${error.message}`, 'error', 5000);
      return false;
    }
  }
  
  downloadTemplate(blob, filename) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
    showNotification(`Template downloaded as ${filename}`, 'success', 3000);
  }
  
  async loadTemplateFromFile() {
    try {
      if ('showOpenFilePicker' in window) {
        const [fileHandle] = await window.showOpenFilePicker({
          types: [{
            description: 'MSD Template files',
            accept: { 'application/json': ['.msd', '.json'] }
          }]
        });
        
        const file = await fileHandle.getFile();
        const content = await file.text();
        const templateData = JSON.parse(content);
        
        this.applyTemplate(templateData);
        showNotification(`Template loaded from ${file.name}`, 'success', 3000);
      } else {
        // Fallback to file input
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = '.msd,.json';
        input.onchange = (e) => {
          const file = e.target.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = (e) => {
              try {
                const templateData = JSON.parse(e.target.result);
                this.applyTemplate(templateData);
                showNotification(`Template loaded from ${file.name}`, 'success', 3000);
              } catch (error) {
                showNotification(`Failed to load template: ${error.message}`, 'error', 5000);
              }
            };
            reader.readAsText(file);
          }
        };
        input.click();
      }
    } catch (error) {
      if (error.name !== 'AbortError') {
        console.error('Failed to load template:', error);
        showNotification(`Failed to load template: ${error.message}`, 'error', 5000);
      }
    }
  }
  
  applyTemplate(templateData) {
    try {
      const data = templateData.data || templateData;
      
      if (data.plateLayout && data.plateLayout.wells) {
        // Apply plate layout
        Object.assign(wells, data.plateLayout.wells);
        renderPlate();
      }
      
      if (data.plateLayout && data.plateLayout.cytokines) {
        // Apply cytokine configuration
        CYTOKINES.length = 0;
        CYTOKINES.push(...data.plateLayout.cytokines);
        updateCytokineSelect();
      }
      
      if (data.settings) {
        // Apply settings
        this.applySettings(data.settings);
      }
      
      if (data.analysisData) {
        // Apply analysis data
        Object.assign(analysisResults, data.analysisData);
      }
      
      showNotification('Template applied successfully', 'success', 3000);
    } catch (error) {
      console.error('Failed to apply template:', error);
      showNotification(`Failed to apply template: ${error.message}`, 'error', 5000);
    }
  }
  
  applySettings(settings) {
    // Apply various settings based on the settings object
    if (settings.standardConcentrations && document.getElementById('stdConcs')) {
      document.getElementById('stdConcs').value = settings.standardConcentrations;
    }
    if (settings.cytokineSelect && document.getElementById('cytokineSelect')) {
      document.getElementById('cytokineSelect').value = settings.cytokineSelect;
    }
    // Add more settings as needed
  }
}

// Initialize file manager
const templateFileManager = new TemplateFileManager();

// Enhanced Template Functions
function quickSaveTemplate(type) {
  const templateName = generateAutoTemplateName(type);
  const templateData = collectTemplateData(type);
  
  templateFileManager.saveTemplateToFile(templateData, templateName, type);
  updateTemplateUsageStats(type);
}

function generateAutoTemplateName(type) {
  const now = new Date();
  const date = now.toISOString().split('T')[0];
  const time = now.toTimeString().split(' ')[0].replace(/:/g, '-');
  
  const typeNames = {
    'plate-map': 'PlateMap',
    'data': 'Data',
    'settings': 'Settings',
    'complete': 'Complete'
  };
  
  return `MSD-${typeNames[type] || 'Template'}-${date}-${time}`;
}

function collectTemplateData(type) {
  const data = {};
  
  switch (type) {
    case 'plate-map':
      data.plateLayout = {
        wells: { ...wells },
        cytokines: [...CYTOKINES],
        currentCytokine: currentCytokine
      };
      break;
      
    case 'data':
      data.analysisData = { ...analysisResults };
      data.plateData = {
        signals: extractSignalData(),
        concentrations: extractConcentrationData()
      };
      break;
      
    case 'settings':
      data.settings = {
        standardConcentrations: document.getElementById('stdConcs')?.value || '',
        cytokineSelect: document.getElementById('cytokineSelect')?.value || '',
        analysisSettings: extractAnalysisSettings(),
        uiSettings: extractUISettings()
      };
      break;
      
    case 'complete':
      data.plateLayout = {
        wells: { ...wells },
        cytokines: [...CYTOKINES],
        currentCytokine: currentCytokine
      };
      data.analysisData = { ...analysisResults };
      data.settings = {
        standardConcentrations: document.getElementById('stdConcs')?.value || '',
        cytokineSelect: document.getElementById('cytokineSelect')?.value || '',
        analysisSettings: extractAnalysisSettings(),
        uiSettings: extractUISettings()
      };
      break;
  }
  
  return data;
}

function extractSignalData() {
  const signals = {};
  for (const [wellKey, well] of Object.entries(wells)) {
    if (well.signal !== undefined) {
      signals[wellKey] = well.signal;
    }
  }
  return signals;
}

function extractConcentrationData() {
  const concentrations = {};
  for (const [wellKey, well] of Object.entries(wells)) {
    if (well.concentration !== undefined) {
      concentrations[wellKey] = well.concentration;
    }
  }
  return concentrations;
}

function extractAnalysisSettings() {
  return {
    curveType: document.getElementById('curveType')?.value || '4pl',
    // Add more analysis settings as needed
  };
}

function extractUISettings() {
  return {
    // Add UI settings that should be saved
    selectedWells: selectedWells ? [...selectedWells] : []
  };
}

function openTemplateFileDialog() {
  templateFileManager.loadTemplateFromFile();
}

function changeTemplateFolder() {
  const currentPath = templateFileManager.templateStorageSettings.customPath || templateFileManager.templateStorageSettings.defaultPath;
  const newPath = prompt('Enter new template storage path:', currentPath);
  if (newPath && newPath.trim()) {
    templateFileManager.templateStorageSettings.customPath = newPath.trim();
    localStorage.setItem('templateStorageSettings', JSON.stringify(templateFileManager.templateStorageSettings));
    templateFileManager.updateStoragePathDisplay();
    showNotification('Template storage path updated', 'success', 3000);
  }
}

function filterTemplates() {
  const filter = document.getElementById('templateFilter')?.value || 'all';
  refreshTemplateList(filter);
}

function refreshTemplateList(filter = 'all') {
  const templateList = document.getElementById('templateList');
  if (!templateList) return;
  
  // For now, show a message about file-based storage
  templateList.innerHTML = `
    <div style="text-align: center; padding: 15px; color: var(--gray-600);">
      <div style="font-size: 12px; margin-bottom: 8px; font-weight: 500;">📁 File-Based Templates</div>
      <div style="font-size: 10px; line-height: 1.4;">
        Templates are saved as files in your Documents folder.<br>
        Use "Load File" to browse and load saved templates.
      </div>
      <div style="margin-top: 8px; padding: 6px; background: var(--gray-100); border-radius: 4px; font-size: 9px;">
        Saved to: ${templateFileManager.templateStorageSettings.customPath || templateFileManager.templateStorageSettings.defaultPath}
      </div>
    </div>
  `;
}

function exportTemplatePackage() {
  const packageData = {
    metadata: {
      name: 'MSD Template Package',
      created: new Date().toISOString(),
      version: '2.0'
    },
    templates: {
      plateMap: collectTemplateData('plate-map'),
      data: collectTemplateData('data'),
      settings: collectTemplateData('settings')
    }
  };
  
  const filename = `MSD-Template-Package-${new Date().toISOString().split('T')[0]}.json`;
  const blob = new Blob([JSON.stringify(packageData, null, 2)], { type: 'application/json' });
  templateFileManager.downloadTemplate(blob, filename);
}

function importTemplatePackage() {
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = '.json';
  input.onchange = (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const packageData = JSON.parse(e.target.result);
          if (packageData.templates) {
            // Let user choose which templates to import
            showTemplatePackageImportDialog(packageData.templates);
          } else {
            showNotification('Invalid template package format', 'error', 3000);
          }
        } catch (error) {
          showNotification(`Failed to import package: ${error.message}`, 'error', 5000);
        }
      };
      reader.readAsText(file);
    }
  };
  input.click();
}

function showTemplatePackageImportDialog(templates) {
  const options = Object.keys(templates).map(key => `${key}: ${templates[key] ? 'Available' : 'Empty'}`).join('\n');
  const choice = prompt(`Template Package Contents:\n${options}\n\nEnter template type to import (plateMap, data, settings):`);
  
  if (choice && templates[choice]) {
    templateFileManager.applyTemplate({ data: templates[choice] });
  }
}

function openTemplateFolder() {
  // Show information about the template folder
  const path = templateFileManager.templateStorageSettings.customPath || templateFileManager.templateStorageSettings.defaultPath;
  const message = `Template storage location:\n${path}\n\nTemplates are saved as .msd files in this location.\nYou can organize them manually using your file manager.`;
  alert(message);
}

function cleanupTemplates() {
  if (confirm('This will help you organize your template files. Continue?')) {
    alert('Template cleanup features:\n\n1. Remove duplicate templates\n2. Organize by date\n3. Archive old templates\n4. Compress template files\n\nThese features will be implemented in a future update.');
  }
}

function updateTemplateUsageStats(type) {
  const stats = JSON.parse(localStorage.getItem('templateUsageStats') || '{}');
  stats[type] = (stats[type] || 0) + 1;
  stats.lastUsed = new Date().toISOString();
  localStorage.setItem('templateUsageStats', JSON.stringify(stats));
}

