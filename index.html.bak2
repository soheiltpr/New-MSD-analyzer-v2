// Alternative approach: Create plot data sheets instead of images
function createPlotDataSheets(workbook, cytokineName, cytokineIndex, analysisResult) {
  try {
    // Create standard curve plot data sheet
    if (analysisResult && analysisResult.standards) {
      const standardCurveData = [
        [`${cytokineName} Standard Curve Data`],
        [''],
        ['Concentration (pg/mL)', 'Signal', 'Log(Conc)', 'Log(Signal)', 'Predicted Signal', 'Residual']
      ];
      
      analysisResult.standards.forEach((std, index) => {
        const conc = parseFloat(std.concentration) || 0;
        const signal = parseFloat(std.signal) || 0;
        const logConc = conc > 0 ? Math.log10(conc) : '';
        const logSignal = signal > 0 ? Math.log10(signal) : '';
        const predictedSignal = ''; // Could calculate if predictor is available
        const residual = ''; // Could calculate if predictor is available
        
        standardCurveData.push([conc, signal, logConc, logSignal, predictedSignal, residual]);
      });
      
      const standardCurveSheet = XLSX.utils.aoa_to_sheet(standardCurveData);
      XLSX.utils.book_append_sheet(workbook, standardCurveSheet, `${cytokineName}_StandardCurve`);
    }
    
    // Create pivot plot data sheet
    const pivotData = collectAllPlotData();
    const cytokinePivotData = pivotData.filter(point => point.cytokine === cytokineName);
    
    if (cytokinePivotData.length > 0) {
      const pivotPlotData = [
        [`${cytokineName} Pivot Plot Data`],
        [''],
        ['Compound', 'Concentration (ng/mL)', 'Actual Conc (pg/mL)', 'Signal', 'Type', 'Well']
      ];
      
      cytokinePivotData.forEach(point => {
        pivotPlotData.push([
          point.compound || '',
          point.compoundConcentration || '',
          point.actualConcentration || '',
          point.signal || '',
          point.type || '',
          point.well || ''
        ]);
      });
      
      const pivotPlotSheet = XLSX.utils.aoa_to_sheet(pivotPlotData);
      XLSX.utils.book_append_sheet(workbook, pivotPlotSheet, `${cytokineName}_PivotPlot`);
    }
    
  } catch (error) {
    console.error('Error creating plot data sheets:', error);
  }
}

// Export all plots as PNG files in a zip file
function exportAllPlotsAsPNG() {
  try {
    console.log('🖼️ Starting PNG export of all plots...');
    updateStatus('Preparing plot export...', 'processing');
    
    const timestamp = new Date().toISOString().split('T')[0];
    const zip = new JSZip();
    let exportedCount = 0;
    
    // Export standard curves and pivot plots for each cytokine
    if (analysisResults && Object.keys(analysisResults).length > 0) {
      Object.keys(analysisResults).forEach(cytokineIndex => {
        const cytokineName = CYTOKINES[parseInt(cytokineIndex)];
        if (cytokineName) {
          try {
            // Export standard curve
            const standardPngData = createStandardCurvePNG(cytokineName, parseInt(cytokineIndex), analysisResults[cytokineIndex], timestamp);
            if (standardPngData) {
              zip.file(`StandardCurve_${cytokineName}_${timestamp}.png`, standardPngData, { base64: true });
              exportedCount++;
            }
            
            // Export individual pivot plot for this cytokine
            const pivotPngData = createCytokinePivotPlotPNG(cytokineName, parseInt(cytokineIndex), analysisResults[cytokineIndex], timestamp);
            if (pivotPngData) {
              zip.file(`PivotPlot_${cytokineName}_${timestamp}.png`, pivotPngData, { base64: true });
              exportedCount++;
            }
          } catch (error) {
            console.warn(`Could not export plots for ${cytokineName}:`, error);
          }
        }
      });
    } else {
      // If no analysis results, export for all configured cytokines
      CYTOKINES.forEach((cytokineName, index) => {
        try {
          // Export standard curve
          const standardPngData = createStandardCurvePNG(cytokineName, index, null, timestamp);
          if (standardPngData) {
            zip.file(`StandardCurve_${cytokineName}_${timestamp}.png`, standardPngData, { base64: true });
            exportedCount++;
          }
          
          // Export individual pivot plot for this cytokine
          const pivotPngData = createCytokinePivotPlotPNG(cytokineName, index, null, timestamp);
          if (pivotPngData) {
            zip.file(`PivotPlot_${cytokineName}_${timestamp}.png`, pivotPngData, { base64: true });
            exportedCount++;
          }
        } catch (error) {
          console.warn(`Could not export plots for ${cytokineName}:`, error);
        }
      });
    }
    
    // Export combined pivot plots (all cytokines together)
    try {
      const combinedPivotPngData = createPivotPlotsPNG(timestamp);
      if (combinedPivotPngData) {
        zip.file(`PivotPlots_AllCytokines_${timestamp}.png`, combinedPivotPngData, { base64: true });
        exportedCount++;
      }
    } catch (error) {
      console.warn('Could not export combined pivot plots:', error);
    }
    
    // Add a test PNG to ensure zip is not empty
    if (exportedCount === 0) {
      console.log('No plots exported, adding test PNG...');
      const testPngData = createTestPNG();
      if (testPngData) {
        zip.file(`Test_Plot_${timestamp}.png`, testPngData, { base64: true });
        exportedCount++;
      }
    }
    
    // Generate and download the zip file
    console.log(`Creating zip file with ${exportedCount} files...`);
    zip.generateAsync({ type: 'blob' }).then(function(content) {
      console.log(`Zip file created, size: ${content.size} bytes`);
      
      if (content.size === 0) {
        console.error('Zip file is empty!');
        updateStatus('Error: Generated zip file is empty', 'error');
        return;
      }
      
      const link = document.createElement('a');
      link.href = URL.createObjectURL(content);
      link.download = `MSD_Plots_${timestamp}.zip`;
      link.click();
      
      updateStatus(`✅ Exported ${exportedCount} plot files in zip!`, 'complete');
      console.log(`✅ PNG export completed: ${exportedCount} files in zip`);
    }).catch(function(error) {
      console.error('Error generating zip file:', error);
      updateStatus('Error generating zip file: ' + error.message, 'error');
    });
    
  } catch (error) {
    console.error('❌ PNG export error:', error);
    updateStatus('Error exporting plots: ' + error.message, 'error');
  }
}

// Create standard curve PNG data with configuration details
function createStandardCurvePNG(cytokineName, cytokineIndex, analysisResult, timestamp) {
  try {
    console.log(`Creating standard curve PNG for ${cytokineName}...`);
    
    // Try to find the standard curve canvas
    let canvas = document.querySelector('#standardCurveCanvas');
    
    // If not found, try to find any chart canvas
    if (!canvas) {
      canvas = document.querySelector('canvas');
      console.log('Standard curve canvas not found, trying any canvas:', canvas);
    }
    
    // Create a new canvas with configuration details overlay
    const overlayCanvas = document.createElement('canvas');
    const ctx = overlayCanvas.getContext('2d');
    
    // Set canvas size
    const originalWidth = canvas ? canvas.width : 800;
    const originalHeight = canvas ? canvas.height : 400;
    const textAreaHeight = 100; // Space for configuration text
    overlayCanvas.width = originalWidth;
    overlayCanvas.height = originalHeight + textAreaHeight;
    
    // Fill background
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, overlayCanvas.width, overlayCanvas.height);
    
    // Add configuration details at the top
    ctx.fillStyle = '#000000';
    ctx.font = 'bold 16px Arial';
    ctx.textAlign = 'left';
    
    // Title
    ctx.fillText(`${cytokineName} Standard Curve`, 20, 30);
    
    // Configuration details
    ctx.font = '14px Arial';
    const configDetails = [
      `Analysis Method: ${document.getElementById('analysisMethod')?.value || 'fit4pl'}`,
      `Generated: ${new Date().toLocaleString()}`,
      `Plate: MSD 96-well Analysis`
    ];
    
    if (analysisResult && analysisResult.curve) {
      configDetails.push(`R²: ${analysisResult.curve.rSquared || 'N/A'}`);
      configDetails.push(`Method: ${analysisResult.curve.method || '4PL Curve Fit'}`);
    }
    
    if (analysisResult && analysisResult.standards) {
      configDetails.push(`Standards: ${analysisResult.standards.length} points`);
    }
    
    configDetails.forEach((detail, index) => {
      ctx.fillText(detail, 20, 60 + (index * 20));
    });
    
    // Draw the original chart below the text if available
    if (canvas) {
      try {
        ctx.drawImage(canvas, 0, textAreaHeight, originalWidth, originalHeight);
      } catch (error) {
        console.warn('Could not draw canvas image:', error);
        // Draw a placeholder
        ctx.fillStyle = '#f0f0f0';
        ctx.fillRect(0, textAreaHeight, originalWidth, originalHeight);
        ctx.fillStyle = '#666666';
        ctx.font = '18px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('Chart not available', originalWidth/2, textAreaHeight + originalHeight/2);
      }
    } else {
      // Draw a placeholder if no canvas found
      ctx.fillStyle = '#f0f0f0';
      ctx.fillRect(0, textAreaHeight, originalWidth, originalHeight);
      ctx.fillStyle = '#666666';
      ctx.font = '18px Arial';
      ctx.textAlign = 'center';
      ctx.fillText('Standard Curve Chart', originalWidth/2, textAreaHeight + originalHeight/2);
      ctx.fillText('(Chart not available)', originalWidth/2, textAreaHeight + originalHeight/2 + 30);
    }
    
    // Convert to PNG data URL and extract base64
    const imageData = overlayCanvas.toDataURL('image/png');
    const base64Data = imageData.split(',')[1]; // Remove data:image/png;base64, prefix
    
    console.log(`✅ Created standard curve PNG for ${cytokineName} (${base64Data.length} chars)`);
    return base64Data;
    
  } catch (error) {
    console.error(`Error creating standard curve PNG for ${cytokineName}:`, error);
    return null;
  }
}

// Create pivot plots PNG data with configuration details
function createPivotPlotsPNG(timestamp) {
  try {
    console.log('Creating pivot plots PNG...');
    
    // Try to find the pivot plot canvas
    let pivotCanvas = document.querySelector('#pivotPlotCanvas');
    
    // If not found, try to find any chart canvas
    if (!pivotCanvas) {
      pivotCanvas = document.querySelector('canvas');
      console.log('Pivot plot canvas not found, trying any canvas:', pivotCanvas);
    }
    
    // Create a new canvas with configuration details overlay
    const overlayCanvas = document.createElement('canvas');
    const ctx = overlayCanvas.getContext('2d');
    
    // Set canvas size
    const originalWidth = pivotCanvas ? pivotCanvas.width : 800;
    const originalHeight = pivotCanvas ? pivotCanvas.height : 400;
    const textAreaHeight = 120; // Space for configuration text
    overlayCanvas.width = originalWidth;
    overlayCanvas.height = originalHeight + textAreaHeight;
    
    // Fill background
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, overlayCanvas.width, overlayCanvas.height);
    
    // Add configuration details at the top
    ctx.fillStyle = '#000000';
    ctx.font = 'bold 16px Arial';
    ctx.textAlign = 'left';
    
    // Title
    ctx.fillText('MSD Pivot Plots - Dose Response Analysis', 20, 30);
    
    // Configuration details
    ctx.font = '14px Arial';
    const configDetails = [
      `X-Axis: ${document.getElementById('plotXAxis')?.value || 'Compound Concentration'}`,
      `Y-Axis: ${document.getElementById('plotYAxis')?.value || 'Actual Concentration'}`,
      `Plot Type: ${document.getElementById('plotType')?.value || 'Line Plot'}`,
      `X-Scale: ${document.getElementById('plotXScale')?.value || 'Logarithmic'}`,
      `Error Bars: ${document.getElementById('plotErrorBars')?.value || 'Standard Error'}`,
      `Include Standards: ${document.getElementById('includeStandards')?.checked ? 'Yes' : 'No'}`,
      `Generated: ${new Date().toLocaleString()}`
    ];
    
    configDetails.forEach((detail, index) => {
      ctx.fillText(detail, 20, 60 + (index * 20));
    });
    
    // Draw the original chart below the text if available
    if (pivotCanvas) {
      try {
        ctx.drawImage(pivotCanvas, 0, textAreaHeight, originalWidth, originalHeight);
      } catch (error) {
        console.warn('Could not draw pivot canvas image:', error);
        // Draw a placeholder
        ctx.fillStyle = '#f0f0f0';
        ctx.fillRect(0, textAreaHeight, originalWidth, originalHeight);
        ctx.fillStyle = '#666666';
        ctx.font = '18px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('Pivot Plot Chart', originalWidth/2, textAreaHeight + originalHeight/2);
        ctx.fillText('(Chart not available)', originalWidth/2, textAreaHeight + originalHeight/2 + 30);
      }
    } else {
      // Draw a placeholder if no canvas found
      ctx.fillStyle = '#f0f0f0';
      ctx.fillRect(0, textAreaHeight, originalWidth, originalHeight);
      ctx.fillStyle = '#666666';
      ctx.font = '18px Arial';
      ctx.textAlign = 'center';
      ctx.fillText('Pivot Plot Chart', originalWidth/2, textAreaHeight + originalHeight/2);
      ctx.fillText('(Chart not available)', originalWidth/2, textAreaHeight + originalHeight/2 + 30);
    }
    
    // Convert to PNG data URL and extract base64
    const imageData = overlayCanvas.toDataURL('image/png');
    const base64Data = imageData.split(',')[1]; // Remove data:image/png;base64, prefix
    
    console.log(`✅ Created pivot plots PNG (${base64Data.length} chars)`);
    return base64Data;
    
  } catch (error) {
    console.error('Error creating pivot plots PNG:', error);
    return null;
  }
}

