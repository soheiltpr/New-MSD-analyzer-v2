    return null;
  }
}

function createPlateInterpreterFormat() {
  // Create a 10x14 grid (A1 is at B2, with headers)
  const data = Array(10).fill(null).map(() => Array(14).fill(''));
  
  // Add "Plate 1" label at A1
  data[0][0] = 'Plate 1';
  
  // Add column headers (1-12)
  for (let j = 0; j < 12; j++) {
    data[1][j + 2] = j + 1;
  }
  
  // Add row headers (A-H)
  for (let i = 0; i < 8; i++) {
    data[i + 2][1] = ROWS[i];
  }
  
  // Fill in the plate data following Plate Interpreter rules
  for (let i = 0; i < 8; i++) {
    for (let j = 0; j < 12; j++) {
      const row = ROWS[i];
      const col = COLS[j];
      const role = wellRoles[row][col];
      const compound = wellCompounds[row][col];
      const concentration = wellConcentrations[row][col];
      
      if (role) {
        let cellValue = '';
        
        if (role === 'standard') {
          // For standards, show "std" or "standard"
          cellValue = compound?.toLowerCase().includes('std') ? compound : 'std';
        } else if (role === 'control') {
          // For controls, show the control name
          cellValue = compound || 'control';
        } else if (role === 'unknown') {
          // For compounds, follow Plate Interpreter format
          if (concentration && concentration > 0) {
            cellValue = `${compound || 'Sample'}/${concentration}`;
          } else {
            cellValue = compound || 'Sample';
          }
        }
        
        data[i + 2][j + 2] = cellValue;
      }
    }
  }
  
  return data;
}

function downloadExcelTemplate() {
  try {
    const workbook = XLSX.utils.book_new();
    
    // Create cytokines sheet
    const cytokinesData = [
      ['Cytokine Name', 'Max Concentration (pg/mL)', 'Dilution Factor'],
      ['GM-CSF', '2000', '4'],
      ['IL-2', '1500', '4'],
      ['IL-4', '1000', '4']
    ];
    const cytokinesSheet = XLSX.utils.aoa_to_sheet(cytokinesData);
    XLSX.utils.book_append_sheet(workbook, cytokinesSheet, 'Cytokines');
    
    // Create Plate Interpreter format template
    const plateData = createTemplatePlateInterpreterFormat();
    const plateSheet = XLSX.utils.aoa_to_sheet(plateData);
    XLSX.utils.book_append_sheet(workbook, plateSheet, 'Plate 1');
    
    // Download the template
    XLSX.writeFile(workbook, 'MSD_Configuration_Template.xlsx');
    
    updateStatus('Excel template downloaded successfully', 'complete');
    
  } catch (error) {
    console.error('Template download error:', error);
    updateStatus('Error downloading template: ' + error.message, 'error');
  }
}

function createTemplatePlateInterpreterFormat() {
  // Create a 10x14 grid (A1 is at B2, with headers)
  const data = Array(10).fill(null).map(() => Array(14).fill(''));
  
  // Add "Plate 1" label at A1
  data[0][0] = 'Plate 1';
  
  // Add column headers (1-12)
  for (let j = 0; j < 12; j++) {
    data[1][j + 2] = j + 1;
  }
  
  // Add row headers (A-H)
  for (let i = 0; i < 8; i++) {
    data[i + 2][1] = ROWS[i];
  }
  
  // Add example data following Plate Interpreter rules
  // Standards in column 2 (A2-A9)
  for (let i = 0; i < 8; i++) {
    data[i + 2][2] = 'std';
  }
  
  // Sample compounds with concentrations
  data[2][3] = 'Compound A/1000';
  data[2][4] = 'Compound A/100';
  data[2][5] = 'Compound A/10';
  
  data[3][3] = 'Compound B/1000';
  data[3][4] = 'Compound B/100';
  data[3][5] = 'Compound B/10';
  
  data[4][3] = 'Compound C/1000';
  data[4][4] = 'Compound C/100';
  data[4][5] = 'Compound C/10';
  
  // Controls
  data[2][1] = 'control';  // A1
  data[9][1] = 'control';  // H1
  data[2][11] = 'control'; // A10
  data[9][11] = 'control'; // H10
  
  return data;
}

function showExcelFormat() {
  const formatInfo = `
📊 PLATE INTERPRETER EXCEL FORMAT:

📋 CYTOKINES Sheet:
- Column A: Cytokine Name (e.g., GM-CSF, IL-2)
- Column B: Max Concentration in pg/mL
- Column C: Dilution Factor (e.g., 4 for 4x dilution)

📋 PLATE SHEETS (Plate 1, Plate 2, etc.):
- Cell A1: "Plate 1" (or any name starting with "Plate")
- Row 2: Column numbers 1-12
- Column B: Row letters A-H
- Plate data starts at B2 (A1 well)

WELL FORMATS (exact Plate Interpreter rules):
• Standards: "std" or "standard"
• Compounds: "Compound Name/Concentration" (e.g., "Drug A/1000")
• Controls: "control", "ctrl", "ctrl Positive", etc.
• Numbers only: Treated as concentrations
• Text only: Treated as compound names
• Exclude: "com/con" (ignored)

PARSING RULES:
- Starts with letter → name only; if "name/123" then 123 is conc
- Starts with number → number is conc; trailing letters are compound name
- Merged cells on H row → replicate control label across span

EXAMPLES:
• std → Standard well
• Drug A/1000 → Compound "Drug A" with 1000 pg/mL
• control → Control well
• ctrl Positive → Control well labeled "Positive"
• 500 → Just concentration (500 pg/mL)
• 1000DrugB → Concentration 1000, compound "DrugB"

💡 TIPS:
- Download template for proper format
- Multiple plates supported (Plate 1, Plate 2, etc.)
- Headers auto-detected from merged cells
- Empty cells are ignored
- Import overwrites current configuration
  `;
  
  alert(formatInfo);
}

// Well Management

function selectRow(row, event = null) {
  console.log('📊 Selecting row:', row);
  
  // Check for modifier keys for multi-select
  const isMultiSelect = event && (event.ctrlKey || event.metaKey);
  
  if (!isMultiSelect) {
    selectedWells.clear();
  }

  for (let col of COLS) {
    selectedWells.add(`${row}${col}`);
  }

  renderPlate();
  updateSelectionDisplay();
  updateStatus(`Selected row ${row} (${COLS.length} wells)`, 'complete');
}

function selectColumn(col, event = null) {
  console.log('📊 Selecting column:', col);
  
  // Check for modifier keys for multi-select
  const isMultiSelect = event && (event.ctrlKey || event.metaKey);
  
  if (!isMultiSelect) {
    selectedWells.clear();
  }

  for (let row of ROWS) {
    selectedWells.add(`${row}${col}`);
  }

  renderPlate();
  updateSelectionDisplay();
  updateStatus(`Selected column ${col} (${ROWS.length} wells)`, 'complete');
}


// Analysis
function runAnalysis() {
  try {
    console.log('=== MSD ANALYSIS START ===');
    console.log('Analyzing all cytokines:', CYTOKINES);
    
    console.log('🔬 Analysis button clicked! Starting sequential MSD analysis for all cytokines...');
    
    // Ensure we have plate data
    if (!plateData || Object.keys(plateData).length === 0) {
      updateStatus('No plate data - generating demo data first...', 'warning');
      generateDemoData();
    }
    
    // Check if we have standards
    console.log('🔍 Checking for standards...');
    console.log('CYTOKINES array:', CYTOKINES);
    console.log('wellRoles sample:', Object.keys(wellRoles).slice(0, 3).map(row => ({ [row]: wellRoles[row] })));
    
    // Debug: Check for standards manually
    let debugStandardCount = 0;
    for (let row of ROWS) {
      for (let col of COLS) {
        if (wellRoles[row] && wellRoles[row][col] === 'standard') {
          debugStandardCount++;
          console.log(`Found standard at ${row}${col}:`, {
            role: wellRoles[row][col],
            compound: wellCompounds[row][col],
            concentration: wellConcentrations[row][col]
          });
        }
      }
    }
    console.log(`Debug: Found ${debugStandardCount} standards manually`);
    
    if (!hasStandards()) {
      updateStatus('ERROR: No standards found. Please assign standards to wells before analyzing.', 'error');
      console.log('Standards check failed');
      return;
    }

    // Start sequential cytokine analysis with progress bar
    runSequentialCytokineAnalysis();
  } finally {
    // ensure the mask flag is one-shot
    window.__useStdMask = false;
    window.__stdMaskPayload = null;
  }
}

function runAnalysisForAllCytokines() {
  if (CYTOKINES.length === 0) {
    updateStatus('ERROR: No cytokines configured. Please setup cytokines first.', 'error');
    return;
  }

  updateStatus(`Running MSD analysis for all ${CYTOKINES.length} cytokines...`, 'processing');
  
  // Initialize analysis results if needed
  if (!analysisResults || typeof analysisResults !== 'object' || Array.isArray(analysisResults)) {
    analysisResults = {};
  }

  let completedCount = 0;
  let totalCytokines = CYTOKINES.length;
  let successfulAnalyses = 0;
  let failedAnalyses = 0;

  // Process each cytokine
  CYTOKINES.forEach((cytokine, cytokineIndex) => {
    try {
      console.log(`🧪 Analyzing cytokine ${cytokineIndex + 1}/${totalCytokines}: ${cytokine}`);
      updateStatus(`Analyzing ${cytokine} (${cytokineIndex + 1}/${totalCytokines})...`, 'processing');
      
      const result = analyzeSingleCytokine(cytokineIndex);
      
      if (result.success) {
        analysisResults[cytokineIndex] = result.data;
        successfulAnalyses++;
        console.log(`✅ Successfully analyzed ${cytokine}`);
      } else {
        failedAnalyses++;
        console.error(`❌ Failed to analyze ${cytokine}: ${result.error}`);
      }
      
      completedCount++;
      
      // Update progress
      const progress = Math.round((completedCount / totalCytokines) * 100);
      updateStatus(`Progress: ${progress}% (${completedCount}/${totalCytokines}) - ${cytokine} completed`, 'processing');
      
    } catch (error) {
      failedAnalyses++;
      completedCount++;
      console.error(`❌ Error analyzing ${cytokine}:`, error);
    }
  });

  // Final status update
  if (successfulAnalyses > 0) {
    updateStatus(`✅ ANALYSIS COMPLETE! ${successfulAnalyses} successful, ${failedAnalyses} failed`, 'complete');
    
    // Update UI
    populateResultsCytokineSelect(analysisResults);
    // Keep the user's current selection visible after analysis
    const resultsSelect = document.getElementById('resultsCytokineSelect');
    if (resultsSelect) {
      resultsSelect.value = String(currentCytokine);
    }
    displayAnalysisResultsFor(currentCytokine);
    
    // Show results section
    const resultsSection = document.getElementById('resultsSection');
    if (resultsSection) {
      resultsSection.style.display = 'block';
    }
  } else {
    updateStatus('❌ ANALYSIS FAILED: No cytokines were successfully analyzed', 'error');
  }
}

function runSequentialCytokineAnalysis() {
  if (CYTOKINES.length === 0) {
    updateStatus('ERROR: No cytokines configured. Please setup cytokines first.', 'error');
    return;
  }

  console.log('🔄 Starting sequential cytokine analysis with progress bar...');
  
  // Initialize analysis results if needed
  if (!analysisResults || typeof analysisResults !== 'object' || Array.isArray(analysisResults)) {
    analysisResults = {};
  }

  // Show progress bar and disable analyze button
  const progressContainer = document.getElementById('analysisProgress');
  const analyzeBtn = document.getElementById('runAnalysis');
  
  if (progressContainer) {
    progressContainer.style.display = 'block';
  }
  if (analyzeBtn) {
    analyzeBtn.disabled = true;
    analyzeBtn.textContent = 'Analyzing...';
  }

  // Initialize progress
  updateProgress(0, 'Starting analysis...', 'Preparing...');
  
  let currentIndex = 0;
  let successfulAnalyses = 0;
  let failedAnalyses = 0;

  // Process cytokines sequentially
  async function processNextCytokine() {
    if (currentIndex >= CYTOKINES.length) {
      // All cytokines processed - show completion
      const totalProcessed = successfulAnalyses + failedAnalyses;
      updateProgress(100, 'Analysis complete!', `Completed ${successfulAnalyses}/${totalProcessed} cytokines`);
      
      // Hide progress bar after a delay
      setTimeout(() => {
        if (progressContainer) {
          progressContainer.style.display = 'none';
        }
        if (analyzeBtn) {
          analyzeBtn.disabled = false;
          analyzeBtn.textContent = '🔬 Analyze';
        }
      }, 2000);

      // Show final results
      if (successfulAnalyses > 0) {
        updateStatus(`✅ Sequential analysis complete! ${successfulAnalyses} successful, ${failedAnalyses} failed`, 'complete');
        
        // Update UI with results
        populateResultsCytokineSelect(analysisResults);
        const resultsSelect = document.getElementById('resultsCytokineSelect');
        if (resultsSelect) {
          resultsSelect.value = String(currentCytokine);
        }
        displayAnalysisResultsFor(currentCytokine);
        
        // Show results section
        const resultsSection = document.getElementById('resultsSection');
        if (resultsSection) {
          resultsSection.style.display = 'block';
        }
      } else {
        updateStatus('❌ Sequential analysis failed: No cytokines were successfully analyzed', 'error');
      }
      return;
    }

    const cytokineIndex = currentIndex;
    const cytokineName = CYTOKINES[cytokineIndex];
    const progress = Math.round(((currentIndex + 1) / CYTOKINES.length) * 100);

    console.log(`🔄 Processing cytokine ${currentIndex + 1}/${CYTOKINES.length}: ${cytokineName}`);
    
    // Update progress bar
    updateProgress(progress, `Analyzing ${cytokineName}...`, `${cytokineName} (${currentIndex + 1}/${CYTOKINES.length})`);

    try {
      // Step 1: Set current cytokine in dropdown
      currentCytokine = cytokineIndex;
      const mainSelect = document.getElementById('cytokineSelect');
      if (mainSelect) {
        mainSelect.value = String(cytokineIndex);
      }

      // Step 2: Update standards for this cytokine
      updateStandardInputsForCytokine();

      // Step 3: Run analysis for this cytokine
      const result = await analyzeSingleCytokineAsync(cytokineIndex);
      
      if (result.success) {
        // Store the result
        analysisResults[cytokineIndex] = result.data;
        successfulAnalyses++;
        console.log(`✅ Successfully analyzed ${cytokineName}`);
        
        // Step 4: Update the unknowns table for this cytokine
        if (result.data.unknowns && result.data.unknowns.length > 0) {
          // The displayAnalysisResultsFor will be called at the end for the final cytokine
          console.log(`📊 Updated unknowns table for ${cytokineName} with ${result.data.unknowns.length} samples`);
        }
        
      } else {
        failedAnalyses++;
        console.error(`❌ Failed to analyze ${cytokineName}: ${result.error}`);
      }

    } catch (error) {
      failedAnalyses++;
      console.error(`❌ Error analyzing ${cytokineName}:`, error);
    }

    // Move to next cytokine
    currentIndex++;
    
    // Small delay to allow UI updates
    setTimeout(() => {
      processNextCytokine();
    }, 100);
  }

  // Start processing
  processNextCytokine();
}

function updateProgress(percentage, statusText, currentCytokine) {
  const progressFill = document.getElementById('progressFill');
  const progressText = document.getElementById('progressText');
  const currentCytokineSpan = document.getElementById('currentCytokine');
  const progressCount = document.getElementById('progressCount');

  if (progressFill) {
    progressFill.style.width = `${percentage}%`;
  }
  if (progressText) {
    progressText.textContent = statusText;
  }
  if (currentCytokineSpan) {
    currentCytokineSpan.textContent = currentCytokine;
  }
  if (progressCount) {
    progressCount.textContent = `${Math.round(percentage)}%`;
  }
}

function analyzeSingleCytokineAsync(cytokineIndex) {
  return new Promise((resolve) => {
    try {
      const result = analyzeSingleCytokine(cytokineIndex);
      resolve(result);
    } catch (error) {
      resolve({ success: false, error: error.message });
    }
  });
}

function analyzeSingleCytokine(cytokineIndex) {
  try {
    console.log(`📊 Analyzing cytokine ${cytokineIndex}: ${CYTOKINES[cytokineIndex]}`);
    
    // Collect standard data for this cytokine
    const standards = collectStandardData(cytokineIndex);
    const standardsHash = standards.standardsHash;
    console.log(`✅ Standards collected for ${CYTOKINES[cytokineIndex]}:`, standards);
    
    if (standards.length < 3) {
      throw new Error(`Need at least 3 standards for analysis, found ${standards.length}`);
    }
    
    // Get analysis method
    const interpPairs = standards.map(s => [s.signal, s.concentration]);
    let predictor = Predictor.fromInterpPairs(interpPairs);
    let curveQuality = { method: 'Log-Log Interpolation', r2: 'N/A' };
    
    // Optionally attempt 4PL and keep it only if it performs well
    const method = document.getElementById('analysisMethod')?.value || 'fit4pl';
    if (method === 'fit4pl') {
      try {
        const standardPairs = standards.map(s => [s.concentration, s.signal]);
        const fourPL = Predictor.fromFit4PL(standardPairs);
        // Evaluate fit; if poor, keep interpolation for prediction
        const obs = standards.map(s => s.signal);
        const pred = standards.map(s => fourPL.model.f(s.concentration));
        const r2 = AnalysisEngine.calculateR2(obs, pred);
        if (isFinite(r2) && r2 >= 0.9) {
          predictor = fourPL;
          curveQuality = { method: '4PL Curve Fit', r2: r2.toFixed(4) };
        } else {
          curveQuality = { method: 'Log-Log Interpolation (4PL r2=' + (isFinite(r2)?r2.toFixed(3):'N/A') + ')', r2: 'N/A' };
        }
      } catch (e) {
        console.warn(`4PL fitting failed for ${CYTOKINES[cytokineIndex]}, using interpolation:`, e);
      }
    }
    
    // Calculate unknown concentrations with dilution factors
    const unknowns = calculateUnknownConcentrations(predictor);
    
    return {
      success: true,
      data: {
      standards: standards || [],
      standardsHash: standardsHash,
      predictor: predictor || null,
      unknowns: unknowns || [],
        cytokine: CYTOKINES[cytokineIndex] || 'Unknown',
        cytokineIndex: cytokineIndex,
      timestamp: new Date(),
      curve: {
        type: curveQuality.method || '4PL Curve Fit',
        rSquared: parseFloat(curveQuality.r2) || 0.95,
        method: curveQuality.method || '4PL Curve Fit'
      },
      curveQuality: curveQuality || { method: '4PL Curve Fit', r2: '0.950' }
      }
    };
    
  } catch (error) {
    console.error(`❌ Error analyzing ${CYTOKINES[cytokineIndex]}:`, error);
    return {
      success: false,
      error: error.message
    };
  }
}

function hasStandards() {
  let standardCount = 0;
  let standardsWithData = 0;
  let standardsWithConc = 0;
  
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row][col] === 'standard') {
        standardCount++;
        if (getWellSignal(row, col, currentCytokine) !== null) {
          standardsWithData++;
        }
        if (wellConcentrations[row][col] !== null) {
          standardsWithConc++;
        }
      }
    }
  }
  
  console.log(`Standards check: ${standardCount} total, ${standardsWithData} with data, ${standardsWithConc} with concentrations`);
  
  // For analysis, we need at least some standards with concentrations
  // Data (signals) can be added later through demo data or manual input
  return standardCount > 0 && standardsWithConc > 0;
}

function collectStandardData(cytokineIndex = null) {
  console.log('🔍 Collecting standard data for cytokine:', cytokineIndex ?? currentCytokine);
  const standards = [];
  let standardWellsFound = 0;
  let standardsWithData = 0;
  let standardsWithConcentration = 0;
  
  // Use provided cytokine index or fallback to current
  const targetCytokine = cytokineIndex !== null ? cytokineIndex : currentCytokine;

  // Group standards by concentration to average duplicates (e.g., A-row/H-row duplicates)
  const grouped = {};
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row][col] === 'standard') {
        const signal = getWellSignal(row, col, targetCytokine);
        const concentration = wellConcentrations[row][col];
        if (signal !== null) standardsWithData++;
        if (concentration !== null) standardsWithConcentration++;
        if (signal !== null && concentration !== null && signal >= 0 && concentration >= 0) {
          if (!grouped[concentration]) grouped[concentration] = [];
          grouped[concentration].push({ signal, wellId: `${row}${col}` });
        }
      }
    }
  }
  Object.entries(grouped)
    .sort((a,b)=>parseFloat(a[0])-parseFloat(b[0]))
    .forEach(([conc, signalData]) => {
      const signals = signalData.map(d => d.signal);
      const wellIds = signalData.map(d => d.wellId);
      const meanSignal = signals.reduce((a,b)=>a+b,0)/signals.length;
      standards.push({
        well: wellIds.length > 1 ? `Avg(${wellIds.join(',')})` : wellIds[0],
        signal: meanSignal,
        concentration: parseFloat(conc),
        logConc: Math.log10(Math.max(parseFloat(conc), 0.1)),
        logSignal: Math.log10(Math.max(meanSignal, 1)),
        wellIds: wellIds, // Store all contributing wells
        rawSignals: signals // Store individual signals
      });
    });
  
  console.log(`📊 Standards summary: ${standardWellsFound} wells marked as standards, ${standardsWithData} with signal data, ${standardsWithConcentration} with concentrations, ${standards.length} valid for analysis`);
  
  let sorted = standards.sort((a, b) => a.concentration - b.concentration);
  
  // 2) If Modified Analyze is active, filter by the table mask
  if (window.__useStdMask && window.__stdMaskPayload?.mask) {
    const mask = window.__stdMaskPayload.mask;
    console.log('🎯 Modified Analyze: filtering standards by table mask', mask);
    console.log('🎯 Original standards before filtering:', sorted.map(s => ({ conc: s.concentration, signal: s.signal })));
    
    // Filter standards to only include checked rows
    const filtered = [];
    for (let i = 0; i < sorted.length; i++) {
      const std = sorted[i];
      const x = +std.concentration, y = +std.signal;
      if (mask[i] && isFinite(x) && isFinite(y) && x > 0 && y > 0) {
        filtered.push(std);
        console.log(`🎯 Including standard ${i}: conc=${x}, signal=${y}`);
      } else {
        console.log(`🎯 Excluding standard ${i}: conc=${x}, signal=${y}, mask=${mask[i]}`);
      }
    }
    
    if (filtered.length < 4) {
      throw new Error('Not enough included standards for 4PL (need at least 4)');
    }
    
    console.log(`🎯 Modified Analyze: using ${filtered.length} of ${sorted.length} standards`);
    console.log('🎯 Filtered standards:', filtered.map(s => ({ conc: s.concentration, signal: s.signal })));
    sorted = filtered;
  }
  
  // Attach a standards hash used to invalidate caches / detect changes
  const hash = btoa(JSON.stringify(sorted.map(s => [s.concentration, s.signal]))).slice(0, 12);
  sorted.standardsHash = hash;
  return sorted;
}

function fitStandardCurve(standards) {
  if (standards.length < 3) {
    throw new Error('Need at least 3 standards for curve fitting');
  }

  const model = document.getElementById('curveModel').value;
  
  switch (model) {
    case '4pl':
      return fit4PL(standards);
    case 'linear':
      return fitLinear(standards);
    default:
      return fit4PL(standards);
  }
}

function fit4PL(standards) {
  // Simplified 4PL fitting - in practice, you'd use a more robust algorithm
  const signals = standards.map(s => s.signal);
  const concentrations = standards.map(s => s.concentration);
  
  const minSignal = Math.min(...signals);
  const maxSignal = Math.max(...signals);
  const midConc = concentrations[Math.floor(concentrations.length / 2)];
  
  return {
    type: '4PL',
    parameters: {
      a: minSignal,
      b: maxSignal,
      c: midConc,
      d: 1
    },
    predict: function(concentration) {
      const { a, b, c, d } = this.parameters;
      return a + (b - a) / (1 + Math.pow(concentration / c, -d));
    },
    inverse: function(signal) {
      const { a, b, c, d } = this.parameters;
      return c * Math.pow((b - a) / (signal - a) - 1, -1 / d);
    },
    rSquared: 0.95 // Placeholder
  };
}

function fitLinear(standards) {
  // Linear regression on log-log data
  const n = standards.length;
  const sumX = standards.reduce((sum, s) => sum + s.logConc, 0);
  const sumY = standards.reduce((sum, s) => sum + s.logSignal, 0);
  const sumXY = standards.reduce((sum, s) => sum + s.logConc * s.logSignal, 0);
  const sumX2 = standards.reduce((sum, s) => sum + s.logConc * s.logConc, 0);
  
  const slope = (n * sumXY - sumX * sumY) / (n * sumX2 - sumX * sumX);
  const intercept = (sumY - slope * sumX) / n;
  
  return {
    type: 'Linear',
    parameters: { slope, intercept },
    predict: function(concentration) {
      return Math.pow(10, this.parameters.slope * Math.log10(concentration) + this.parameters.intercept);
    },
    inverse: function(signal) {
      return Math.pow(10, (Math.log10(signal) - this.parameters.intercept) / this.parameters.slope);
    },
    rSquared: 0.9 // Placeholder
  };
}

function calculateUnknownConcentrations(predictor) {
  const unknowns = [];
  
  // Get global dilution factor from analysis form
  const globalDilutionFactor = parseFloat(document.getElementById('dilutionFactor')?.value) || 1.0;
  
  console.log(`🧮 Calculating ACTUAL concentrations (pg/mL) for cytokine ${currentCytokine}...`);
  console.log(`📊 Using global dilution factor: ${globalDilutionFactor}x`);
  
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row][col] === 'unknown' || wellRoles[row][col] === 'control') {
        const signal = getWellSignal(row, col, currentCytokine); // Use SINGLE SOURCE OF TRUTH
        // Use global dilution factor for unknowns and controls, per-well factor as additional multiplier if set
        const perWellDilution = wellDilutions[row][col] || 1.0;
        const totalDilutionFactor = globalDilutionFactor * perWellDilution;
        
        if (signal !== null && signal > 0) {
          try {
            const result = predictor.predict(signal, totalDilutionFactor);
            
            // Store ACTUAL calculated concentration (pg/mL) - the real biological measurement
            calculatedConcentrations[currentCytokine][row][col] = result.concentration;
            
            unknowns.push({
              well: `${row}${col}`,
              signal,
              undiluted: result.undiluted,
              actualConcentration: result.concentration, // ACTUAL concentration (pg/mL)
              compoundConcentration: wellConcentrations[row][col], // COMPOUND concentration (experimental design)
              dilutionFactor: result.dilutionFactor,
              compound: wellCompounds[row][col] || 'Unknown',
              role: wellRoles[row][col]
            });
            
            console.log(`  ✅ ${row}${col}: Signal=${signal} → Actual Conc=${result.concentration.toFixed(2)} pg/mL (dilution: ${globalDilutionFactor}x${perWellDilution > 1 ? ` × ${perWellDilution}` : ''}), Compound Conc=${wellConcentrations[row][col] || 'N/A'}`);
          } catch (error) {
            console.warn(`Failed to calculate concentration for well ${row}${col}:`, error);
            calculatedConcentrations[currentCytokine][row][col] = null;
            unknowns.push({
              well: `${row}${col}`,
              signal,
              undiluted: 'Error',
              actualConcentration: 'Error',
              compoundConcentration: wellConcentrations[row][col],
              dilutionFactor: totalDilutionFactor,
              compound: wellCompounds[row][col] || 'Unknown',
              role: wellRoles[row][col],
              error: error.message
            });
          }
        }
      }
    }
  }
  
  console.log(`📊 Calculated ${unknowns.length} actual concentrations for cytokine ${currentCytokine}`);
  return unknowns;
}

function autoAnalyzeForCytokine(cytokineIndex) {
  console.log('🔄 Auto-analyze triggered for cytokine:', cytokineIndex, CYTOKINES[cytokineIndex]);
  
  // If we already have cached results for this cytokine, just display them
  if (analysisResults && analysisResults[cytokineIndex]) {
    console.log('📦 Using cached results for cytokine:', CYTOKINES[cytokineIndex]);
    displayAnalysisResultsFor(cytokineIndex);
    return;
  }
  
  // Cancel any existing analysis
  if (autoAnalyzeState.currentToken) {
    autoAnalyzeState.currentToken.cancelled = true;
    console.log('🚫 Cancelled previous auto-analysis');
  }
  
  // Clear any pending debounced runs
  if (autoAnalyzeState.debounceTimer) {
    clearTimeout(autoAnalyzeState.debounceTimer);
  }
  
  // Check if we need to re-analyze (idempotence)
  const currentState = getAnalysisStateHash(cytokineIndex);
  if (autoAnalyzeState.lastAnalyzedState === currentState && analysisResults[cytokineIndex]) {
    console.log('⏭️ Skipping analysis - no changes detected');
    displayAnalysisResultsFor(cytokineIndex);
    return;
  }
  
  // Debounce rapid changes (300ms)
  autoAnalyzeState.debounceTimer = setTimeout(() => {
    runAutoAnalysis(cytokineIndex, currentState);
  }, 300);
}

function getAnalysisStateHash(cytokineIndex) {
  const standardConcs = standardConcentrationsByCytokine[cytokineIndex] || STANDARD_CONCENTRATIONS[CYTOKINES[cytokineIndex]] || [];
  const wellRolesForHash = {};
  
  for (let row of ROWS) {
    if (!wellRolesForHash[row]) wellRolesForHash[row] = {};
    for (let col of COLS) {
      const role = wellRoles[row][col];
      if (role === 'standard' || role === 'unknown') {
        wellRolesForHash[row][col] = role;
      }
    }
  }

  const plateDataHash = JSON.stringify({
    cytokine: cytokineIndex,
    standards: standardConcs,
    wellRoles: wellRolesForHash
  });
  return btoa(plateDataHash); 
}

function runAutoAnalysis(cytokineIndex, currentState) {
  console.log('🔄 Running auto-analysis for cytokine:', cytokineIndex, CYTOKINES[cytokineIndex]);
  
  // Create cancellation token
  const token = { cancelled: false };
  autoAnalyzeState.currentToken = token;
  autoAnalyzeState.isRunning = true;
  
  // Show loading state
  showAutoAnalyzeLoading(true);
  
  try {
    // Run the analysis
    runAnalysisForCytokine(cytokineIndex, token).then(() => {
      if (!token.cancelled) {
        console.log('✅ Auto-analysis complete for', CYTOKINES[cytokineIndex]);
        autoAnalyzeState.lastAnalyzedState = currentState;
        autoAnalyzeState.isRunning = false;
        showAutoAnalyzeLoading(false);
      } else {
        console.log('🚫 Auto-analysis cancelled for', CYTOKINES[cytokineIndex]);
      }
    }).catch(error => {
      if (!token.cancelled) {
        console.error('❌ Auto-analysis failed:', error);
        autoAnalyzeState.isRunning = false;
        showAutoAnalyzeLoading(false);
        updateStatus(`Auto-analysis failed for ${CYTOKINES[cytokineIndex]}: ${error.message}`, 'error');
      }
    });
    
  } catch (error) {
    if (!token.cancelled) {
      console.error('❌ Auto-analysis error:', error);
      autoAnalyzeState.isRunning = false;
      showAutoAnalyzeLoading(false);
    }
  }
}

function showAutoAnalyzeLoading(show) {
  const analyzeBtn = document.getElementById('runAnalysis');
  const loadingSpinner = document.getElementById('autoAnalyzeSpinner') || createAutoAnalyzeSpinner();
  
  if (show) {
    analyzeBtn.disabled = true;
    analyzeBtn.textContent = 'Analyzing...';
    loadingSpinner.style.display = 'inline-block';
  } else {
    analyzeBtn.disabled = false;
    analyzeBtn.textContent = '🧪 Analyze';
    loadingSpinner.style.display = 'none';
  }
}

function createAutoAnalyzeSpinner() {
  const spinner = document.createElement('span');
  spinner.id = 'autoAnalyzeSpinner';
  spinner.innerHTML = ' ⏳';
  spinner.style.display = 'none';
  spinner.style.color = '#666';
  
  const analyzeBtn = document.getElementById('runAnalysis');
  analyzeBtn.parentNode.insertBefore(spinner, analyzeBtn.nextSibling);
  
  return spinner;
}

function populateResultsCytokineSelect(resultsMap) {
  const select = document.getElementById('resultsCytokineSelect');
  if (!select) return;
  const entries = Object.entries(resultsMap || {});
  select.innerHTML = entries
    .map(([idx, r]) => `<option value="${idx}">${r.cytokine || CYTOKINES[idx]}</option>`) 
    .join('');
  if (entries.length) select.value = entries[0][0];
  
  // Remove any existing event listener to avoid conflicts
  select.onchange = null;
  
  // Set up event listener that synchronizes with main dropdown
  select.addEventListener('change', () => {
    const newCytokine = parseInt(select.value);
    console.log('🔄 Analysis Results cytokine changed to:', newCytokine, CYTOKINES[newCytokine]);

    // Update the global cytokine and main selector
    currentCytokine = newCytokine;
    const mainSelect = document.getElementById('cytokineSelect');
    if (mainSelect) {
      mainSelect.value = String(newCytokine);
    }

    // Update standard concentration inputs for the new cytokine
    updateStandardInputsForCytokine();

    // Update plate schematic to show the new cytokine
    renderPlate();

    // Display cached results (no need to re-analyze since we have results)
    if (analysisResults && analysisResults[newCytokine]) {
    displayAnalysisResultsFor(newCytokine);
    }
  });
}

function runAnalysisForCytokine(cytokineIndex, token = { cancelled: false }) {
  console.log('🔄 Running analysis for cytokine:', cytokineIndex, CYTOKINES[cytokineIndex]);
  
  return new Promise((resolve, reject) => {
    try {
      // Check for cancellation
      if (token.cancelled) {
        reject(new Error('Analysis cancelled'));
        return;
      }
      
      // Collect standards data for this cytokine
      const standardsData = [];
      for (let row of ROWS) {
        for (let col of COLS) {
          if (wellRoles[row][col] === 'standard') {
            const signal = getWellSignal(row, col, cytokineIndex);
            const concentration = wellConcentrations[row][col];
            const compound = wellCompounds[row][col];
            
            if (signal !== null && signal !== undefined && concentration > 0) {
              standardsData.push({
                well: `${row}${col}`,
                wellIds: [`${row}${col}`],
                concentration: concentration,
                signal: signal,
                compound: compound
              });
            }
          }
        }
      }
      
      if (standardsData.length < 2) {
        console.warn('Not enough standards for analysis');
        resolve(); // Complete successfully but with no data
        return;
      }
      
      // Check for cancellation
      if (token.cancelled) {
        reject(new Error('Analysis cancelled'));
        return;
      }
      
      // Create a predictor for this cytokine
      const predictor = new CurvePredictor();
      const standardPoints = standardsData.map(s => ({ concentration: s.concentration, signal: s.signal }));
      predictor.fitCurve(standardPoints);
      
      // Recalculate unknowns with current signals and new standards
      const unknownsData = [];
      for (let row of ROWS) {
        for (let col of COLS) {
          if (wellRoles[row][col] === 'unknown') {
            // Check for cancellation periodically
            if (token.cancelled) {
              reject(new Error('Analysis cancelled'));
              return;
            }
            
            const signal = getWellSignal(row, col, cytokineIndex);
            const compound = wellCompounds[row][col] || 'Unknown';
            const designConc = wellConcentrations[row][col] || 0;
            const dilution = wellDilutions[row][col] || 1.0;
            
            if (signal !== null && signal !== undefined) {
              try {
                const result = predictor.predict(signal, dilution);
                const actualConcentration = result.concentration;
                
                unknownsData.push({
                  well: `${row}${col}`,
                  wellIds: [`${row}${col}`],
                  compound: compound,
                  signal: signal,
                  actualConcentration: actualConcentration,
                  calculatedConcentration: actualConcentration,
                  compoundConcentration: designConc,
                  concentration: designConc,
                  dilution: dilution
                });
              } catch (error) {
                console.warn(`Failed to calculate concentration for ${row}${col}:`, error);
              }
            }
          }
        }
      }
      
      // Update the analysisResults with recalculated data
      if (!analysisResults[cytokineIndex]) {
        analysisResults[cytokineIndex] = {};
      }
      
      analysisResults[cytokineIndex].cytokine = CYTOKINES[cytokineIndex];
      analysisResults[cytokineIndex].standardData = standardsData;
      analysisResults[cytokineIndex].standards = standardsData;
      analysisResults[cytokineIndex].unknowns = unknownsData;
      analysisResults[cytokineIndex].curve = predictor.getCurveInfo();
      analysisResults[cytokineIndex].r2 = predictor.getRSquared();
      analysisResults[cytokineIndex].method = '4PL';
      
      console.log('✅ Analysis complete for', CYTOKINES[cytokineIndex]);
      
      // Display the updated results
      displayAnalysisResultsFor(cytokineIndex);
      
      resolve();
      
    } catch (error) {
      console.error('Error in analysis:', error);
      reject(error);
    }
  });
}

function recalculateAnalysisResultsFor(cytokineIndex) {
  console.log('🔄 Recalculating analysis results for cytokine:', cytokineIndex, CYTOKINES[cytokineIndex]);
  
  try {
    // Collect standards data for this cytokine
    const standardsData = [];
    for (let row of ROWS) {
      for (let col of COLS) {
        if (wellRoles[row][col] === 'standard') {
          const signal = getWellSignal(row, col, cytokineIndex);
          const concentration = wellConcentrations[row][col];
          const compound = wellCompounds[row][col];
          
          if (signal !== null && signal !== undefined && concentration > 0) {
            standardsData.push({
              well: `${row}${col}`,
              wellIds: [`${row}${col}`],
              concentration: concentration,
              signal: signal,
              compound: compound
            });
          }
        }
      }
    }
    
    if (standardsData.length < 2) {
      console.warn('Not enough standards for analysis');
      displayAnalysisResultsFor(cytokineIndex); // Fallback to static display
      return;
    }
    
    // Create a predictor for this cytokine
    const predictor = new CurvePredictor();
    const standardPoints = standardsData.map(s => ({ concentration: s.concentration, signal: s.signal }));
    predictor.fitCurve(standardPoints);
    
    // Recalculate unknowns with current signals and new standards
    const unknownsData = [];
    for (let row of ROWS) {
      for (let col of COLS) {
        if (wellRoles[row][col] === 'unknown') {
          const signal = getWellSignal(row, col, cytokineIndex);
          const compound = wellCompounds[row][col] || 'Unknown';
          const designConc = wellConcentrations[row][col] || 0;
          const dilution = wellDilutions[row][col] || 1.0;
          
          if (signal !== null && signal !== undefined) {
            try {
              const result = predictor.predict(signal, dilution);
              const actualConcentration = result.concentration;
              
              unknownsData.push({
                well: `${row}${col}`,
                wellIds: [`${row}${col}`],
                compound: compound,
                signal: signal,
                actualConcentration: actualConcentration,
                calculatedConcentration: actualConcentration,
                compoundConcentration: designConc,
                concentration: designConc,
                dilution: dilution
              });
            } catch (error) {
              console.warn(`Failed to calculate concentration for ${row}${col}:`, error);
            }
          }
        }
      }
    }
    
    // Update the analysisResults with recalculated data
    if (!analysisResults[cytokineIndex]) {
      analysisResults[cytokineIndex] = {};
    }
    
    analysisResults[cytokineIndex].cytokine = CYTOKINES[cytokineIndex];
    analysisResults[cytokineIndex].standardData = standardsData;
    analysisResults[cytokineIndex].standards = standardsData;
    analysisResults[cytokineIndex].unknowns = unknownsData;
    analysisResults[cytokineIndex].curve = predictor.getCurveInfo();
    analysisResults[cytokineIndex].r2 = predictor.getRSquared();
    analysisResults[cytokineIndex].method = '4PL';
    
    console.log('✅ Recalculation complete for', CYTOKINES[cytokineIndex]);
    
    // Now display the updated results
    displayAnalysisResultsFor(cytokineIndex);
    
  } catch (error) {
    console.error('Error recalculating analysis results:', error);
    // Fallback to static display
    displayAnalysisResultsFor(cytokineIndex);
  }
}

function displayAnalysisResultsFor(cytokineIndex) {
  console.log('📋 Displaying analysis results...');
  console.log('analysisResults map:', analysisResults);
  
  const resultsSection = document.getElementById('resultsSection');
  const resultsDiv = document.getElementById('analysisResults');
  
  if (!analysisResults) {
    console.error('No analysis results to display');
    resultsDiv.innerHTML = '<p>No analysis results available</p>';
    return;
  }
  const res = analysisResults[cytokineIndex];
  if (!res) {
    resultsDiv.innerHTML = '<p>No results for selected cytokine</p>';
    return;
  }

  const cytokine = res.cytokine || CYTOKINES[cytokineIndex] || 'Unknown';
  const curveType = res.method || (res.curve && res.curve.type) || 'Curve';
  const rSquared = (typeof res.r2 === 'string' ? parseFloat(res.r2) : res.r2) || (res.curve && res.curve.rSquared) || NaN;
  const standardsCount = (res.standardData && res.standardData.length) || (res.standards && res.standards.length) || 0;
  
  let html = `
    
    <div class="report-section">
      <h3>❓ Unknowns & Duplicates Analysis</h3>
      <div id="unknownsTableControls" class="table-controls">
        <div class="control-row">
          <div class="search-box">
            <input type="text" id="unknownsSearch" placeholder="Search samples..." onkeyup="filterUnknownsTable()">
            <span class="search-icon">🔍</span>
          </div>
          <div class="replicate-controls">
            <label class="checkbox-label">
              <input type="checkbox" id="showReplicateSummary" onchange="toggleReplicateView()">
              <span class="checkmark"></span>
              Show Replicate Summary
            </label>
          </div>
          <div class="replicate-controls">
            <div class="toggle-switch-container" style="display: flex; align-items: center; gap: 8px;">
              <span style="font-weight: 600; color: #374151;">🎨 Colored Rows</span>
              <label class="toggle-switch">
                <input type="checkbox" id="coloredTableView" onchange="toggleColoredTableView()" checked>
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>
          <div class="adjustment-controls">
            <div class="toggle-switch-container" style="display: flex; align-items: center; gap: 8px;">
              <span style="font-weight: 600; color: #374151;">+5% MSD Adjustment (Above Range Only)</span>
              <label class="toggle-switch">
              <input type="checkbox" id="add5PercentAdjustment" onchange="toggle5PercentAdjustment()">
                <span class="toggle-slider"></span>
            </label>
            </div>
          </div>
          <div class="table-actions">
            <button onclick="toggleColumnVisibility()" class="btn-small">📋 Columns</button>
            <div class="export-dropdown">
              <button class="btn-small export-dropdown-toggle" id="exportDropdownBtn">
                📤 Export <span class="dropdown-arrow">▼</span>
              </button>
              <div class="export-dropdown-menu" id="exportDropdownMenu">
                <button class="export-dropdown-item" onclick="exportVisibleData()">
                  📋 Export Visible Data
                  <small>Current filters, sorting & view</small>
                </button>
                <button class="export-dropdown-item" onclick="exportCompleteTable()">
                  📊 Export Complete Table
                  <small>All data, all columns</small>
                </button>
              </div>
            </div>
            <button onclick="resetUnknownsTable()" class="btn-small">🔄 Reset</button>
          </div>
        </div>
        <div class="filter-row" id="unknownsFilters" style="display: none;">
          <select id="compoundFilter" onchange="filterUnknownsTable()">
            <option value="">All Compounds</option>
          </select>
          <select id="rangeFilter" onchange="filterUnknownsTable()">
            <option value="">All Ranges</option>
            <option value="Within Range">Within Range</option>
            <option value="Below Range">Below Range</option>
            <option value="Above Range">Above Range</option>
          </select>
          <input type="number" id="concMinFilter" placeholder="Min Conc" onchange="filterUnknownsTable()">
          <input type="number" id="concMaxFilter" placeholder="Max Conc" onchange="filterUnknownsTable()">
        </div>
      </div>
      <div class="table-container">
        <table id="unknownsTable" class="report-table interactive-table">
        <thead>
          <tr>
              <th class="sortable" onclick="sortUnknownsTable(0)">Well ↕</th>
              <th class="sortable" onclick="sortUnknownsTable(1)">Compound ↕</th>
              <th class="sortable" onclick="sortUnknownsTable(2)">Signal ↕</th>
              <th class="sortable" onclick="sortUnknownsTable(3)">Actual Concentration (pg/mL) ↕</th>
              <th class="sortable" onclick="sortUnknownsTable(4)">Modified Calculated Concentration (pg/mL) ↕</th>
              <th class="sortable" onclick="sortUnknownsTable(5)">Design Concentration ↕</th>
              <th class="sortable" onclick="sortUnknownsTable(6)">Dilution Factor ↕</th>
              <th class="sortable" onclick="sortUnknownsTable(7)">Mean (Replicates) ↕</th>
              <th class="sortable" onclick="sortUnknownsTable(8)">Std Dev ↕</th>
              <th class="sortable" onclick="sortUnknownsTable(9)">CV% ↕</th>
              <th class="sortable" onclick="sortUnknownsTable(10)">Range Status ↕</th>
              <th class="sortable" onclick="sortUnknownsTable(11)">Recovery % ↕</th>
              <th>Actions</th>
          </tr>
        </thead>
          <tbody id="unknownsTableBody">
  `;
  
  // Group unknowns by compound and concentration to identify duplicates
  const unknowns = res.unknowns || [];
  
  // Calculate standard curve range for range status
  const standards = res.standardData || res.standards || [];
  const standardConcentrations = standards.map(s => s.concentration).filter(c => c > 0);
  const minStandardConc = Math.min(...standardConcentrations);
  const maxStandardConc = Math.max(...standardConcentrations);
  
  // Group unknowns by compound name and compound concentration
  const groupedUnknowns = {};
  unknowns.forEach(unk => {
    const { row, col } = parseWellId(unk.well);
    const compoundName = unk.compound || 'Unknown';
    const designConc = (row && col && wellConcentrations[row] && typeof wellConcentrations[row][col] !== 'undefined') ? wellConcentrations[row][col] : '';
    const key = `${compoundName}_${designConc}`;
    
    if (!groupedUnknowns[key]) {
      groupedUnknowns[key] = [];
    }
    groupedUnknowns[key].push(unk);
  });
  
  // Store unknowns data for interactive table
  const unknownsTableData = [];
  
  // Process grouped unknowns with enhanced duplicate analysis
  Object.keys(groupedUnknowns).forEach((key, groupIndex) => {
    const samples = groupedUnknowns[key];
    const isDuplicateGroup = samples.length > 1;
    
    // Calculate comprehensive statistics for duplicates
    let meanActual = '';
    let stdDev = '';
    let cvPercent = '';
    let rangeStatus = '';
    let accuracy = '';
    let recovery = '';
    
    if (isDuplicateGroup) {
      const actualConcs = samples.map(s => {
        const actual = typeof s.actualConcentration === 'number' ? s.actualConcentration : 
                      (s.concentration && typeof s.concentration === 'number') ? s.concentration : null;
        return actual;
      }).filter(c => c !== null && c !== undefined);
      
      const designConcs = samples.map(s => {
        const { row, col } = parseWellId(s.well);
        return (row && col && wellConcentrations[row] && typeof wellConcentrations[row][col] !== 'undefined') ? 
               wellConcentrations[row][col] : null;
      }).filter(c => c !== null && c !== undefined);
      
      if (actualConcs.length > 0) {
        // Calculate mean
        meanActual = (actualConcs.reduce((a, b) => a + b, 0) / actualConcs.length).toFixed(2);
        
        // Calculate standard deviation
        const mean = parseFloat(meanActual);
        const variance = actualConcs.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / actualConcs.length;
        stdDev = Math.sqrt(variance).toFixed(2);
        
        // Calculate CV% (coefficient of variation)
        cvPercent = mean > 0 ? ((Math.sqrt(variance) / mean) * 100).toFixed(1) : 'N/A';
        
        
        // Calculate recovery percentage
        if (designConcs.length > 0 && designConcs[0] > 0) {
          const designMean = designConcs.reduce((a, b) => a + b, 0) / designConcs.length;
          recovery = ((mean / designMean) * 100).toFixed(1);
        } else {
          recovery = 'N/A';
        }
        
        // Determine range status
        if (mean < minStandardConc) {
          rangeStatus = 'Below Range';
        } else if (mean > maxStandardConc) {
          rangeStatus = 'Above Range';
        } else {
          rangeStatus = 'Within Range';
        }
      }
    }
    
    // Process each sample in the group
    samples.forEach((unk, sampleIndex) => {
      const { row, col } = parseWellId(unk.well);
      const signalConsistent = (row && col) ? getWellSignal(row, col, cytokineIndex) : null;
      const signalDisplay = (signalConsistent !== null && signalConsistent !== undefined) ? signalConsistent : unk.signal;
      
      // Get actual concentration (corrected for dilution)
      let rawActual = typeof unk.actualConcentration === 'number' ? unk.actualConcentration : 
                      (unk.concentration && typeof unk.concentration === 'number') ? unk.concentration : null;
      
      // Apply 5% MSD adjustment if checkbox is checked
      const adjustmentCheckbox = document.getElementById('add5PercentAdjustment');
      if (adjustmentCheckbox && adjustmentCheckbox.checked && rawActual !== null && typeof rawActual === 'number') {
        rawActual = rawActual * 1.05; // Add 5%
      }
      
      const actual = rawActual ? rawActual.toFixed(2) : 'N/A';
      
      // Get design concentration
      const design = (row && col && wellConcentrations[row] && typeof wellConcentrations[row][col] !== 'undefined') ? 
                    wellConcentrations[row][col] : '';
      
      // Get real dilution factor from well data with proper fallback
      let realDilution = 1.0;
      if (row && col && wellDilutions && wellDilutions[row] && wellDilutions[row][col] !== null && wellDilutions[row][col] !== undefined) {
        realDilution = wellDilutions[row][col];
      } else if (unk.dilution && unk.dilution !== null && unk.dilution !== undefined) {
        realDilution = unk.dilution;
      } else {
        // Fallback to global dilution factor
        const globalDilution = document.getElementById('dilutionFactor');
        realDilution = globalDilution ? parseFloat(globalDilution.value) || 1.0 : 1.0;
      }
      
      // Calculate individual recovery and range status for all wells
      let individualRecovery = '';
      let individualRangeStatus = '';
      
      if (rawActual && !isNaN(rawActual)) {
        // Calculate recovery if design concentration is available
        if (design && design > 0) {
          individualRecovery = ((rawActual / design) * 100).toFixed(1);
        }
        
        // Calculate range status for all wells
        if (rawActual < minStandardConc) {
            individualRangeStatus = 'Below Range';
        } else if (rawActual > maxStandardConc) {
            individualRangeStatus = 'Above Range';
          } else {
            individualRangeStatus = 'Within Range';
        }
      }
      
      // Store row data for interactive table
      unknownsTableData.push({
        well: unk.well || 'N/A',
        compound: unk.compound || 'Unknown',
        signal: signalDisplay ?? 'N/A',
        actualConcentration: actual,
        designConcentration: design,
        dilutionFactor: realDilution,
        meanReplicates: isDuplicateGroup ? (sampleIndex === 0 ? meanActual : '') : '',
        stdDev: isDuplicateGroup ? (sampleIndex === 0 ? stdDev : '') : '',
        cvPercent: isDuplicateGroup ? (sampleIndex === 0 ? cvPercent : '') : '',
        rangeStatus: isDuplicateGroup ? (sampleIndex === 0 ? rangeStatus : individualRangeStatus) : individualRangeStatus,
        recovery: isDuplicateGroup ? (sampleIndex === 0 ? recovery : '') : individualRecovery,
        isDuplicateGroup: isDuplicateGroup,
        isFirstInGroup: sampleIndex === 0,
        groupKey: key,
        originalData: unk
      });
    });
  });
  
  html += `
        </tbody>
      </table>
    </div>
  `;
  
  resultsDiv.innerHTML = html;
  
  // Initialize interactive table with data
  initializeUnknownsTable(unknownsTableData, cytokineIndex);
  resultsSection.style.display = 'block';

  // Update the per-cytokine standard curve chart below
  try { createStandardCurveChart(); } catch (e) { console.warn('Curve chart update failed', e); }
}

 function createStandardCurveChart() {
   // Use selected cytokine from selector if available
   const select = document.getElementById('resultsCytokineSelect');
   const idx = select && select.value ? parseInt(select.value) : (typeof analysisResults.cytokineIndex === 'number' ? analysisResults.cytokineIndex : currentCytokine);
   const res = analysisResults[idx] || analysisResults;
   const standards = res.standards || [];
   
   if (standards.length === 0) {
     console.warn('No standards data available for chart');
     return;
   }
   
   // Extract concentrations and signals for the interactive UI
   const stdConcs = standards.map(s => s.concentration);
   const stdSignals = standards.map(s => s.signal);
   
   // Call the new interactive standard curve UI
   mountStandardCurveUI({
     plateId: window.currentPlateId || 'default',
     cytokineId: idx,
     stdConcs: stdConcs,
     stdSignals: stdSignals
   });
 }

// Utility Functions
function updateStatus(message, type) {
  const indicator = document.getElementById('statusIndicator');
  indicator.textContent = message;
  indicator.className = `status-indicator status-${type}`;
}

// Removed duplicate updateSelectionInfo - using updateSelectionDisplay instead

function autoScale() {
  document.getElementById('minScale').value = '';
  document.getElementById('maxScale').value = '';
  renderPlate();
}

function clearAllData() {
  if (confirm('Clear all data? This cannot be undone.')) {
    initializePlateData();
    selectedWells.clear();
    analysisResults = null;
    renderPlate();
    document.getElementById('resultsSection').style.display = 'none';
    document.getElementById('reportSection').style.display = 'none';
    
    // Hide automatic analysis section to restore original layout
    const analysisSection = document.getElementById('automaticAnalysisSection');
    if (analysisSection) {
      analysisSection.style.display = 'none';
    }
    
    updateStatus('Data cleared', 'ready');
  }
}


function clearSelectedWells() {
  // Clear all selected wells (set to empty)
  selectedWells.forEach(wellId => {
    const row = wellId[0];
    const col = parseInt(wellId.slice(1));
    
    wellRoles[row][col] = 'empty';
    wellCompounds[row][col] = '';
    wellConcentrations[row][col] = 0;
    wellDilutions[row][col] = 1.0;
  });
  
  renderPlate();
  updateStatus(`Cleared ${selectedWells.size} wells`, 'complete');
}

// Keyboard shortcuts
document.addEventListener('keydown', function handleKeyboardShortcuts(event) {
  // Only process shortcuts when not typing in input fields
  if (event.target.tagName === 'INPUT' || event.target.tagName === 'TEXTAREA' || event.target.tagName === 'SELECT') {
    return;
  }
  
  if ((event.key === 'Delete' || event.key === 'Backspace') && selectedWells && selectedWells.size > 0) {
    event.preventDefault();
    clearSelectedWells();
  }
});

// Diagnostic function to check analysis calculation accuracy
function diagnoseAnalysisCalculation(cytokineIndex = null) {
  const targetCytokine = cytokineIndex !== null ? cytokineIndex : currentCytokine;
  const globalDilutionFactor = parseFloat(document.getElementById('dilutionFactor')?.value) || 1.0;
  
  console.log(`\n🔬 DIAGNOSIS: Analysis Calculation for ${CYTOKINES[targetCytokine]} (index ${targetCytokine})`);
  console.log(`📊 Global Dilution Factor: ${globalDilutionFactor}x`);
  console.log('=' .repeat(80));
  
  // 1. Check standards data
  console.log('\n📊 STANDARDS CHECK:');
  
  // First, check all wells marked as standards
  console.log('All wells marked as standards:');
  let allStandardWells = 0;
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row][col] === 'standard') {
        allStandardWells++;
        const signal = getWellSignal(row, col, targetCytokine);
        const concentration = wellConcentrations[row][col];
        const included = (signal !== null && concentration !== null && signal >= 0 && concentration >= 0);
        console.log(`  ${row}${col}: Role=standard, Signal=${signal}, Conc=${concentration}, Included=${included}`);
        
        if (!included) {
          if (signal === null) console.log(`    ❌ Excluded: No signal data`);
          if (concentration === null) console.log(`    ❌ Excluded: No concentration data`);
          if (signal !== null && signal < 0) console.log(`    ❌ Excluded: Negative signal (${signal})`);
          if (concentration !== null && concentration < 0) console.log(`    ❌ Excluded: Negative concentration (${concentration})`);
        }
      }
    }
  }
  
  const standards = collectStandardData(targetCytokine);
  console.log(`\nTotal wells marked as standards: ${allStandardWells}`);
  console.log(`Standards included in analysis: ${standards.length}`);
  
  standards.forEach((std, i) => {
    console.log(`  Std ${i+1}: Conc=${std.concentration} pg/mL, Signal=${std.signal.toFixed(1)}, Wells=${std.wellIds?.join(',') || std.well}`);
  });
  
  // 2. Check predictor creation
  console.log('\n🧮 PREDICTOR CHECK:');
  const interpPairs = standards.map(s => [s.signal, s.concentration]);
  console.log('Interpolation pairs [signal, concentration]:');
  interpPairs.forEach(([signal, conc], i) => {
    console.log(`  ${i+1}. Signal ${signal.toFixed(1)} → Conc ${conc} pg/mL`);
  });
  
  const predictor = Predictor.fromInterpPairs(interpPairs);
  console.log('Predictor created:', predictor.mode);
  
  // 3. Test predictor with standard signals (should return same concentrations)
  console.log('\n✅ PREDICTOR VALIDATION (Standards):');
  standards.forEach((std, i) => {
    try {
      const result = predictor.predict(std.signal, 1.0);
      const expectedConc = std.concentration;
      const calculatedConc = result.concentration;
      const error = Math.abs(calculatedConc - expectedConc) / expectedConc * 100;
      
      console.log(`  Std ${i+1}: Signal ${std.signal.toFixed(1)} → Expected ${expectedConc}, Got ${calculatedConc.toFixed(2)}, Error ${error.toFixed(1)}%`);
      
      if (error > 5) {
        console.warn(`    ⚠️ HIGH ERROR! Expected similar to input concentration`);
      }
    } catch (e) {
      console.error(`    ❌ Prediction failed:`, e.message);
    }
  });
  
  // 4. Check some unknown wells
  console.log('\n❓ UNKNOWNS SAMPLE CHECK:');
  let unknownCount = 0;
  for (let row of ROWS) {
    for (let col of COLS) {
      if (wellRoles[row][col] === 'unknown' && unknownCount < 5) {
        const signal = getWellSignal(row, col, targetCytokine);
        if (signal !== null && signal > 0) {
          try {
            const perWellDilution = wellDilutions[row][col] || 1.0;
            const totalDilution = globalDilutionFactor * perWellDilution;
            const result = predictor.predict(signal, totalDilution);
            
            // Find closest standard by signal
            let closestStd = null;
            let minDiff = Infinity;
            standards.forEach(std => {
              const diff = Math.abs(std.signal - signal);
              if (diff < minDiff) {
                minDiff = diff;
                closestStd = std;
              }
            });
            
            console.log(`  ${row}${col}: Signal ${signal.toFixed(1)} → Calc ${result.concentration.toFixed(2)} pg/mL (dilution: ${totalDilution}x)`);
            if (closestStd) {
              const signalDiff = Math.abs(signal - closestStd.signal) / closestStd.signal * 100;
              const concDiff = Math.abs(result.concentration - closestStd.concentration) / closestStd.concentration * 100;
              console.log(`    Closest Std: Signal ${closestStd.signal.toFixed(1)} (${signalDiff.toFixed(1)}% diff), Conc ${closestStd.concentration} (${concDiff.toFixed(1)}% diff)`);
              
              if (signalDiff < 10 && concDiff > 50) {
                console.warn(`    ⚠️ SUSPICIOUS: Similar signals but very different concentrations!`);
              }
            }
            unknownCount++;
          } catch (e) {
            console.error(`    ❌ ${row}${col} prediction failed:`, e.message);
          }
        }
      }
    }
  }
  
  console.log('\n' + '=' .repeat(80));
  return { standards, predictor, interpPairs };
}

// Template Management Functions
function saveTemplate() {
  const templateName = document.getElementById('templateName').value.trim();
  const templateDescription = document.getElementById('templateDescription').value.trim();
  
  if (!templateName) {
    updateStatus('Please enter a template name', 'error');
    return;
  }
  
  // Create comprehensive template data
  const templateData = {
    name: templateName,
    description: templateDescription,
    timestamp: new Date().toISOString(),
    
    // Core plate data
    plateData: JSON.parse(JSON.stringify(plateData)),
    wellRoles: JSON.parse(JSON.stringify(wellRoles)),
    wellCompounds: JSON.parse(JSON.stringify(wellCompounds)),
    wellConcentrations: JSON.parse(JSON.stringify(wellConcentrations)),
    wellDilutions: JSON.parse(JSON.stringify(wellDilutions)),
    calculatedConcentrations: JSON.parse(JSON.stringify(calculatedConcentrations)),
    standardConcentrationsByCytokine: JSON.parse(JSON.stringify(standardConcentrationsByCytokine)),
    
    // UI state
    currentCytokine: currentCytokine,
    selectedWells: Array.from(selectedWells),
    
    // Form values
    formValues: {
      standardStartWell: (document.getElementById('standardStartWell')||{}).value || '',
      standardDirection: (document.getElementById('standardDirection')||{}).value || 'right',
      standardCount: (document.getElementById('standardCount')||{}).value || '8',
      concentrationOrder: (document.getElementById('concentrationOrder')||{}).value || 'highToLow',
      compoundStartWell: (document.getElementById('compoundStartWell')||{}).value || '',
      compoundDirection: (document.getElementById('compoundDirection')||{}).value || 'right',
      compoundDilutions: (document.getElementById('compoundDilutions')||{}).value || '8',
      maxConcentration: (document.getElementById('maxConcentration')||{}).value || '1000',
      dilutionFactor: (document.getElementById('dilutionFactor')||{}).value || '10',
      compoundName: (document.getElementById('compoundName')||{}).value || 'Compound A'
    }
  };
  
  // Save to localStorage
  let templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const existingIndex = templates.findIndex(t => t.name === templateName);
  
  if (existingIndex >= 0) {
    if (!confirm(`Template "${templateName}" already exists. Overwrite?`)) return;
    templates[existingIndex] = templateData;
  } else {
    templates.push(templateData);
  }
  
  localStorage.setItem('msdTemplates', JSON.stringify(templates));
  updateTemplateList();
  updateStatus(`Template "${templateName}" saved`, 'complete');
  
  // Clear template name field for next save
  document.getElementById('templateName').value = '';
  document.getElementById('templateDescription').value = '';
}

function loadTemplate() {
  const list = document.getElementById('templateList');
  const selected = list ? list.querySelector('.template-item.selected') : null;
  
  if (!selected) {
    updateStatus('Please select a template to load', 'warning');
    return;
  }
  
  const index = parseInt(selected.dataset.index);
  let templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const templateData = templates[index];
  
  if (!templateData) {
    updateStatus('Template not found', 'error');
    return;
  }
  
  if (!confirm(`Load template "${templateData.name}"? This will replace your current plate layout.`)) {
    return;
  }
  
  // Restore all data
  plateData = JSON.parse(JSON.stringify(templateData.plateData));
  wellRoles = JSON.parse(JSON.stringify(templateData.wellRoles));
  wellCompounds = JSON.parse(JSON.stringify(templateData.wellCompounds));
  wellConcentrations = JSON.parse(JSON.stringify(templateData.wellConcentrations));
  wellDilutions = JSON.parse(JSON.stringify(templateData.wellDilutions));
  calculatedConcentrations = JSON.parse(JSON.stringify(templateData.calculatedConcentrations));
  standardConcentrationsByCytokine = JSON.parse(JSON.stringify(templateData.standardConcentrationsByCytokine));
  
  // Restore UI state
  currentCytokine = templateData.currentCytokine;
  selectedWells = new Set(templateData.selectedWells);
  
  // Restore form values
  const formValues = templateData.formValues || {};
  const stdStart = document.getElementById('standardStartWell');
  if (stdStart) stdStart.value = formValues.standardStartWell || '';
  
  const stdDir = document.getElementById('standardDirection');
  if (stdDir) stdDir.value = formValues.standardDirection || 'right';
  
  const stdCount = document.getElementById('standardCount');
  if (stdCount) stdCount.value = formValues.standardCount || '8';
  
  const concOrder = document.getElementById('concentrationOrder');
  if (concOrder) concOrder.value = formValues.concentrationOrder || 'highToLow';
  
  const compStart = document.getElementById('compoundStartWell');
  if (compStart) compStart.value = formValues.compoundStartWell || '';
  
  const compDir = document.getElementById('compoundDirection');
  if (compDir) compDir.value = formValues.compoundDirection || 'right';
  
  const compDil = document.getElementById('compoundDilutions');
  if (compDil) compDil.value = formValues.compoundDilutions || '8';
  
  const maxConc = document.getElementById('maxConcentration');
  if (maxConc) maxConc.value = formValues.maxConcentration || '1000';
  
  const dilFac = document.getElementById('dilutionFactor');
  if (dilFac) dilFac.value = formValues.dilutionFactor || '10';
  
  const compName = document.getElementById('compoundName');
  if (compName) compName.value = formValues.compoundName || 'Compound A';
  
  // Restore cytokine dropdown
  const cytoSelect = document.getElementById('cytokineSelect');
  if (cytoSelect) cytoSelect.value = currentCytokine;
  
  const resSel = document.getElementById('resultsCytokineSelect');
  if (resSel) resSel.value = currentCytokine;
  
  // Re-render everything
  renderPlate();
  updateSelectionDisplay();
  updateStatus(`Template "${templateData.name}" loaded`, 'complete');
}

function renameTemplate() {
  let templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const list = document.getElementById('templateList');
  const selected = list ? list.querySelector('.template-item.selected') : null;
  
  if (!selected) {
    updateStatus('Select a template to rename', 'warning');
    return;
  }
  
  const index = parseInt(selected.dataset.index);
  const newName = prompt('Enter new template name:', templates[index].name);
  
  if (!newName) return;
  
  if (templates.some((t, i) => t.name === newName && i !== index)) {
    updateStatus('Name already exists', 'error');
    return;
  }
  
  templates[index].name = newName;
  localStorage.setItem('msdTemplates', JSON.stringify(templates));
  updateTemplateList();
  updateStatus('Template renamed', 'complete');
}

function overwriteTemplate() {
  let templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const list = document.getElementById('templateList');
  const selected = list ? list.querySelector('.template-item.selected') : null;
  
  if (!selected) {
    updateStatus('Select a template to overwrite', 'warning');
    return;
  }
  
  const index = parseInt(selected.dataset.index);
  const templateName = templates[index].name;
  const templateDescription = document.getElementById('templateDescription').value.trim();
  
  if (!confirm(`Overwrite template "${templateName}" with current plate state?`)) {
    return;
  }
  
  const templateData = {
    name: templateName,
    description: templateDescription || templates[index].description,
    timestamp: new Date().toISOString(),
    plateData: JSON.parse(JSON.stringify(plateData)),
    wellRoles: JSON.parse(JSON.stringify(wellRoles)),
    wellCompounds: JSON.parse(JSON.stringify(wellCompounds)),
    wellConcentrations: JSON.parse(JSON.stringify(wellConcentrations)),
    wellDilutions: JSON.parse(JSON.stringify(wellDilutions)),
    calculatedConcentrations: JSON.parse(JSON.stringify(calculatedConcentrations)),
    standardConcentrationsByCytokine: JSON.parse(JSON.stringify(standardConcentrationsByCytokine)),
    currentCytokine: currentCytokine,
    selectedWells: Array.from(selectedWells),
    formValues: {
      standardStartWell: (document.getElementById('standardStartWell')||{}).value || '',
      standardDirection: (document.getElementById('standardDirection')||{}).value || 'right',
      standardCount: (document.getElementById('standardCount')||{}).value || '8',
      concentrationOrder: (document.getElementById('concentrationOrder')||{}).value || 'highToLow',
      compoundStartWell: (document.getElementById('compoundStartWell')||{}).value || '',
      compoundDirection: (document.getElementById('compoundDirection')||{}).value || 'right',
      compoundDilutions: (document.getElementById('compoundDilutions')||{}).value || '8',
      maxConcentration: (document.getElementById('maxConcentration')||{}).value || '1000',
      dilutionFactor: (document.getElementById('dilutionFactor')||{}).value || '10',
      compoundName: (document.getElementById('compoundName')||{}).value || 'Compound A'
    }
  };
  
  templates[index] = templateData;
  localStorage.setItem('msdTemplates', JSON.stringify(templates));
  updateTemplateList();
  updateStatus('Template overwritten', 'complete');
}

function deleteTemplate() {
  let templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const list = document.getElementById('templateList');
  const selected = list ? list.querySelector('.template-item.selected') : null;
  
  if (!selected) {
    updateStatus('Select a template to delete', 'warning');
    return;
  }
  
  const index = parseInt(selected.dataset.index);
  const name = templates[index].name;
  
  if (!confirm(`Delete template "${name}"? This cannot be undone.`)) return;
  
  templates.splice(index, 1);
  localStorage.setItem('msdTemplates', JSON.stringify(templates));
  updateTemplateList();
  updateStatus('Template deleted', 'complete');
}

function updateTemplateList() {
  const templates = JSON.parse(localStorage.getItem('msdTemplates') || '[]');
  const templateListDiv = document.getElementById('templateList');
  
  if (!templateListDiv) return;
  
  if (templates.length === 0) {
    templateListDiv.innerHTML = '<p style="font-size: 11px; color: #999; margin: 4px 0;">No templates saved yet</p>';
    return;
  }
  
  templateListDiv.innerHTML = '';
  templates.forEach((template, index) => {
    const templateDiv = document.createElement('div');
    templateDiv.className = 'template-item';
    templateDiv.dataset.index = String(index);
    templateDiv.style.cssText = 'border:1px solid #ddd;border-radius:4px;padding:8px;margin:4px 0;background:#f8f9fa;cursor:pointer;font-size:11px;transition:all 0.2s;';
    
    const date = new Date(template.timestamp).toLocaleString();
    templateDiv.innerHTML = `
      <div style="font-weight:bold;color:#333;">${template.name}</div>
      <div style="color:#666;margin:2px 0;">${template.description || 'No description'}</div>
      <div style="color:#999;font-size:10px;">Saved: ${date}</div>
    `;
    
    templateDiv.addEventListener('click', () => {
      templateListDiv.querySelectorAll('.template-item').forEach(item => {
        item.classList.remove('selected');
        item.style.background = '#f8f9fa';
        item.style.borderColor = '#ddd';
      });
      templateDiv.classList.add('selected');
      templateDiv.style.background = '#e3f2fd';
      templateDiv.style.borderColor = '#2196f3';
    });
    
    templateListDiv.appendChild(templateDiv);
  });
}

function validateData() {
  let issues = [];
  let wellCount = 0;
  let standardCount = 0;
  let unknownCount = 0;
  
  for (let row of ROWS) {
    for (let col of COLS) {
      if (getWellSignal(row, col, currentCytokine) !== null) {
        wellCount++;
        
        const role = wellRoles[row][col];
        if (role === 'standard') {
          standardCount++;
          if (wellConcentrations[row][col] === null) {
            issues.push(`Standard ${row}${col} missing concentration`);
          }
        } else if (role === 'unknown') {
          unknownCount++;
        }
      }
    }
  }
  
  if (wellCount === 0) issues.push('No data found');
  if (standardCount < 3) issues.push('Need at least 3 standards for analysis');
  if (unknownCount === 0) issues.push('No unknowns defined');
  
  if (issues.length === 0) {
    updateStatus('Data validation passed', 'complete');
  } else {
    updateStatus(`Validation issues: ${issues.join(', ')}`, 'error');
  }
}

function editCompound() {
  if (selectedWells.size === 0) {
    updateStatus('No wells selected', 'error');
    return;
  }
  
  const compound = prompt('Enter compound name:', '');
  const concentration = prompt('Enter concentration (pg/mL):', '');
  
  if (compound || concentration) {
    for (let wellId of selectedWells) {
      const row = wellId[0];
      const col = parseInt(wellId.slice(1));
      
      if (compound) wellCompounds[row][col] = compound;
      if (concentration && !isNaN(parseFloat(concentration))) {
        wellConcentrations[row][col] = parseFloat(concentration);
      }
    }
    renderPlate();
    updateStatus('Compound information updated', 'complete');
  }
}

function copyValues() {
  if (selectedWells.size === 0) {
    updateStatus('No wells selected', 'error');
    return;
  }
  
  let values = [];
  for (let wellId of selectedWells) {
    const row = wellId[0];
    const col = parseInt(wellId.slice(1));
    const value = getWellSignal(row, col, currentCytokine);
    values.push(`${wellId}: ${value !== null ? value : 'No data'}`);
  }
  
  navigator.clipboard.writeText(values.join('\n')).then(() => {
    updateStatus('Values copied to clipboard', 'complete');
  }).catch(() => {
    updateStatus('Failed to copy values', 'error');
  });
}

// Export Functions
// ====== COMPREHENSIVE EXPORT SYSTEM ======

// Export metadata and experimental details
function getExportMetadata() {
  const timestamp = new Date().toISOString();
  const date = new Date().toLocaleDateString();
  const time = new Date().toLocaleTimeString();
  
  return {
    exportDate: date,
    exportTime: time,
    timestamp: timestamp,
    softwareVersion: 'MSD Plate Analyzer v2.0',
    cytokinesConfigured: CYTOKINES.length,
    cytokineNames: CYTOKINES.join(', '),
    dilutionFactor: document.getElementById('dilutionFactor')?.value || '1',
    analysisMethod: document.getElementById('analysisMethod')?.value || 'fit4pl',
    plateFormat: '96-well',
    totalWells: 96,
    dataPoints: Object.keys(plateData).length * 12 || 0
  };
}

// Get experimental assumptions and setup details
function getExperimentalAssumptions() {
  const setupDilutionFactor = document.getElementById('setupDilutionFactor')?.value || '4';
  const setupNumDilutions = document.getElementById('setupNumDilutions')?.value || '8';
  
  return {
    standardDilutionFactor: setupDilutionFactor,
    numberOfStandardDilutions: setupNumDilutions,
    standardConcentrations: STANDARD_CONCENTRATIONS,
    cytokineConfiguration: CYTOKINES.map((cytokine, index) => ({
      spot: index + 1,
      cytokine: cytokine,
      maxConcentration: STANDARD_CONCENTRATIONS[cytokine] ? STANDARD_CONCENTRATIONS[cytokine][0] : 'N/A'
    }))
  };
}

function exportCSV() {
  let csv = 'Well,Role,Compound,Signal,Actual Concentration (pg/mL),Compound Concentration (design),Dilution Factor\n';
  const cytokineIndex = typeof analysisResults.cytokineIndex === 'number' ? analysisResults.cytokineIndex : currentCytokine;
  const parseWellId = (wellId) => ({ row: wellId?.[0], col: parseInt(wellId?.slice(1)) });
  
  // Add standards
  for (let std of analysisResults.standards) {
    const { row, col } = parseWellId(std.well);
    const signal = (row && col) ? getWellSignal(row, col, cytokineIndex) : std.signal;
    csv += `${std.well},Standard,,${signal},${std.concentration},,1.0\n`;
  }
  
  // Add unknowns
  for (let unk of analysisResults.unknowns) {
    const { row, col } = parseWellId(unk.well);
    const signal = (row && col) ? getWellSignal(row, col, cytokineIndex) : unk.signal;
    const compoundConc = (row && col) ? (wellConcentrations[row]?.[col] ?? '') : '';
    const dilution = (row && col) ? (wellDilutions[row]?.[col] ?? 1.0) : 1.0;
    let actual = (typeof unk.actualConcentration === 'number') ? unk.actualConcentration : (unk.concentration?.toFixed ? parseFloat(unk.concentration) : (unk.concentration || 0));
    
    // Apply 5% MSD adjustment if checkbox is checked
    const adjustmentCheckbox = document.getElementById('add5PercentAdjustment');
    if (adjustmentCheckbox && adjustmentCheckbox.checked && typeof actual === 'number') {
      actual = actual * 1.05; // Add 5%
    }
    
    actual = actual.toFixed(2);
    csv += `${unk.well},Unknown,${unk.compound || ''},${signal},${actual},${compoundConc},${dilution}\n`;
  }
  
  const blob = new Blob([csv], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `MSD_Analysis_${analysisResults.cytokine}_${new Date().toISOString().slice(0, 10)}.csv`;
  a.click();
  URL.revokeObjectURL(url);
  
  updateStatus('CSV exported', 'complete');
}

function exportPNG() {
  if (chart) {
    const url = chart.toBase64Image();
    const a = document.createElement('a');
    a.href = url;
    a.download = `MSD_Curve_${analysisResults.cytokine}_${new Date().toISOString().slice(0, 10)}.png`;
    a.click();
    updateStatus('Chart exported as PNG', 'complete');
  } else {
    updateStatus('No chart to export', 'error');
  }
}

function generateReport() {
  if (!analysisResults) {
    updateStatus('No analysis results for report', 'error');
    return;
  }
  
  const reportSection = document.getElementById('reportSection');
  const reportContent = document.getElementById('reportContent');
  
  const html = `
    <div class="report-section">
      <h2>📋 MSD Plate Analysis Report</h2>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 20px 0;">
        <div>
          <h4>Analysis Details</h4>
          <p><strong>Cytokine:</strong> ${analysisResults.cytokine}</p>
          <p><strong>Date:</strong> ${analysisResults.timestamp.toLocaleDateString()}</p>
          <p><strong>Time:</strong> ${analysisResults.timestamp.toLocaleTimeString()}</p>
          <p><strong>Curve Model:</strong> ${analysisResults.curve.type}</p>
          <p><strong>R²:</strong> ${analysisResults.curve.rSquared.toFixed(3)}</p>
        </div>
        <div>
          <h4>Sample Summary</h4>
          <p><strong>Standards:</strong> ${analysisResults.standards.length}</p>
          <p><strong>Unknowns:</strong> ${analysisResults.unknowns.length}</p>
          <p><strong>Dilution Factor:</strong> ${document.getElementById('dilutionFactor').value}</p>
        </div>
      </div>
    </div>
    
    <div class="report-section">
      <h3>📊 Statistical Summary</h3>
      <table class="report-table">
        <thead>
          <tr>
            <th>Parameter</th>
            <th>Value</th>
            <th>Unit</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Mean Unknown Concentration</td>
            <td>${(analysisResults.unknowns.reduce((sum, u) => sum + u.concentration, 0) / analysisResults.unknowns.length).toFixed(2)}</td>
            <td>pg/mL</td>
          </tr>
          <tr>
            <td>Min Unknown Concentration</td>
            <td>${Math.min(...analysisResults.unknowns.map(u => u.concentration)).toFixed(2)}</td>
            <td>pg/mL</td>
          </tr>
          <tr>
            <td>Max Unknown Concentration</td>
            <td>${Math.max(...analysisResults.unknowns.map(u => u.concentration)).toFixed(2)}</td>
            <td>pg/mL</td>
          </tr>
        </tbody>
      </table>
    </div>
    
    <div class="report-section">
      <h3>🔬 Quality Control</h3>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div>
          <h4>Standards Performance</h4>
          <ul>
            ${analysisResults.standards.map(std => {
              let predicted = 'N/A';
              let error = 'N/A';
              try {
                if (analysisResults.predictor && analysisResults.predictor.model && analysisResults.predictor.model.f) {
                  predicted = analysisResults.predictor.model.f(std.concentration);
                  error = Math.abs((predicted - std.signal) / std.signal * 100).toFixed(1) + '%';
                } else {
                  error = 'No predictor available';
                }
              } catch (e) {
                error = 'Calculation error';
              }
              return `<li>Well ${std.well}: ${error} error</li>`;
            }).join('')}
          </ul>
        </div>
        <div>
          <h4>Curve Quality</h4>
          <ul>
            <li>R² = ${analysisResults.curve.rSquared.toFixed(3)} ${analysisResults.curve.rSquared > 0.95 ? '✅' : '⚠️'}</li>
            <li>Standards: ${analysisResults.standards.length} ${analysisResults.standards.length >= 6 ? '✅' : '⚠️'}</li>
            <li>Model: ${analysisResults.curve.type} ✅</li>
          </ul>
        </div>
      </div>
    </div>
  `;
  
  reportContent.innerHTML = html;
  reportSection.style.display = 'block';
  updateStatus('Report generated', 'complete');
}

// ====== NEW COMPREHENSIVE EXPORT FUNCTIONS ======

// Raw Signal Data Export
function exportRawSignalData() {
  if (CYTOKINES.length === 0) {
    updateStatus('No cytokines configured. Please setup cytokines first.', 'error');
    return;
  }
  
  const cytokineSelection = document.getElementById('rawExportCytokine').value;
  const format = document.getElementById('rawExportFormat').value;
  const includeMetadata = document.getElementById('includeMetadata').value === 'yes';
  const decimals = parseInt(document.getElementById('exportDecimals').value) || 3;
  
  const metadata = includeMetadata ? getExportMetadata() : null;
  
  if (format === 'excel') {
    exportRawDataExcel(cytokineSelection, metadata, decimals);
  } else {
    exportRawDataCSV(cytokineSelection, format, metadata, decimals);
  }
}

function exportRawDataCSV(cytokineSelection, format, metadata, decimals) {
  const separator = format === 'tsv' ? '\t' : ',';
  const extension = format === 'tsv' ? 'tsv' : 'csv';
  
  let content = '';
  
  // Add metadata header if requested
  if (metadata) {
    content += `# MSD Plate Analysis - Raw Signal Data\n`;
    content += `# Export Date: ${metadata.exportDate} ${metadata.exportTime}\n`;
    content += `# Software: ${metadata.softwareVersion}\n`;
    content += `# Cytokines: ${metadata.cytokineNames}\n`;
    content += `# Dilution Factor: ${metadata.dilutionFactor}\n`;
    content += `#\n`;
  }
  
  const cytokineIndices = cytokineSelection === 'all' ? 
    Array.from({length: CYTOKINES.length}, (_, i) => i) : [currentCytokine];
  
  cytokineIndices.forEach((cytokineIndex, fileIndex) => {
    if (fileIndex > 0) content += '\n\n';
    
    const cytokine = CYTOKINES[cytokineIndex];
    content += `# ${cytokine} (Spot ${cytokineIndex + 1})\n`;
    
    // Header row
    content += `Well${separator}Row${separator}Column${separator}Role${separator}Compound Name${separator}Compound Concentration${separator}Signal${separator}Dilution Factor\n`;
    
    // Data rows
    for (let row of ROWS) {
      for (let col of COLS) {
        const wellId = `${row}${col}`;
        const signal = getWellSignal(row, col, cytokineIndex);
        const role = wellRoles[row] && wellRoles[row][col] ? wellRoles[row][col] : 'empty';
        const compound = wellCompounds[row] && wellCompounds[row][col] ? wellCompounds[row][col] : '';
        const compoundConc = wellConcentrations[row] && wellConcentrations[row][col] ? wellConcentrations[row][col] : '';
        const dilution = wellDilutions[row] && wellDilutions[row][col] ? wellDilutions[row][col] : 1;
        
        const signalFormatted = signal !== null ? signal.toFixed(decimals) : 'N/A';
        
        content += `${wellId}${separator}${row}${separator}${col}${separator}${role}${separator}${compound}${separator}${compoundConc}${separator}${signalFormatted}${separator}${dilution}\n`;
      }
    }
  });
  
  const filename = cytokineSelection === 'all' ? 
    `msd_raw_signals_all_cytokines.${extension}` : 
    `msd_raw_signals_${CYTOKINES[currentCytokine]?.replace(/[^a-zA-Z0-9]/g, '_')}.${extension}`;
  
  downloadFile(content, filename, `text/${format === 'tsv' ? 'tab-separated-values' : 'csv'}`);
  updateStatus(`Raw signal data exported successfully (${extension.toUpperCase()})`, 'complete');
}

function exportRawDataExcel(cytokineSelection, metadata, decimals) {
  // Excel-compatible CSV with multiple sections
  let content = '';
  
  // Metadata section
  if (metadata) {
    content += `MSD Plate Analysis - Raw Signal Data Export\n\n`;
    content += `Export Information:\n`;
    content += `Date,${metadata.exportDate}\n`;
    content += `Time,${metadata.exportTime}\n`;
    content += `Software,${metadata.softwareVersion}\n`;
    content += `Cytokines,${metadata.cytokineNames}\n`;
    content += `Analysis Method,${metadata.analysisMethod}\n`;
    content += `Dilution Factor,${metadata.dilutionFactor}\n\n`;
  }
  
  // Raw data for each cytokine
  const cytokineIndices = cytokineSelection === 'all' ? 
    Array.from({length: CYTOKINES.length}, (_, i) => i) : [currentCytokine];
  
  cytokineIndices.forEach((cytokineIndex, sheetIndex) => {
    if (sheetIndex > 0) content += '\n\n';
    
    const cytokine = CYTOKINES[cytokineIndex];
    content += `${cytokine} Raw Signals (Spot ${cytokineIndex + 1})\n`;
    content += `Well,Row,Column,Role,Compound Name,Compound Concentration,Signal,Dilution Factor\n`;
    
    for (let row of ROWS) {
      for (let col of COLS) {
        const wellId = `${row}${col}`;
        const signal = getWellSignal(row, col, cytokineIndex);
        const role = wellRoles[row] && wellRoles[row][col] ? wellRoles[row][col] : 'empty';
        const compound = wellCompounds[row] && wellCompounds[row][col] ? wellCompounds[row][col] : '';
        const compoundConc = wellConcentrations[row] && wellConcentrations[row][col] ? wellConcentrations[row][col] : '';
        const dilution = wellDilutions[row] && wellDilutions[row][col] ? wellDilutions[row][col] : 1;
        
        const signalFormatted = signal !== null ? signal.toFixed(decimals) : 'N/A';
        
        content += `${wellId},${row},${col},${role},"${compound}",${compoundConc},${signalFormatted},${dilution}\n`;
      }
    }
  });
  
  const filename = cytokineSelection === 'all' ? 
    'msd_raw_signals_all_cytokines.csv' : 
    `msd_raw_signals_${CYTOKINES[currentCytokine]?.replace(/[^a-zA-Z0-9]/g, '_')}.csv`;
  
  downloadFile(content, filename, 'text/csv');
  updateStatus('Raw signal data exported successfully (Excel-compatible)', 'complete');
}

// Analyzed Data Export
function exportAnalyzedData() {
  if (CYTOKINES.length === 0) {
    updateStatus('No cytokines configured. Please setup cytokines first.', 'error');
    return;
  }
  
  if (!analysisResults || Object.keys(analysisResults).length === 0) {
    updateStatus('No analysis results available. Please run analysis first.', 'error');
    return;
  }
  
  const includeStandards = document.getElementById('analyzedIncludeStandards').value === 'yes';
  const format = document.getElementById('analyzedExportFormat').value;
  const includeMetadata = document.getElementById('includeMetadata').value === 'yes';
  const decimals = parseInt(document.getElementById('exportDecimals').value) || 3;
  
  const metadata = includeMetadata ? getExportMetadata() : null;
  const assumptions = includeMetadata ? getExperimentalAssumptions() : null;
  
  if (format === 'excel') {
    exportAnalyzedDataExcel(includeStandards, metadata, assumptions, decimals);
  } else {
    exportAnalyzedDataCSV(includeStandards, metadata, assumptions, decimals);
  }
}

function exportAnalyzedDataCSV(includeStandards, metadata, assumptions, decimals) {
  let content = '';
  
  // Metadata header
  if (metadata) {
    content += `# MSD Plate Analysis - Analyzed Data\n`;
    content += `# Export Date: ${metadata.exportDate} ${metadata.exportTime}\n`;
    content += `# Software: ${metadata.softwareVersion}\n`;
    content += `# Analysis Method: ${metadata.analysisMethod}\n`;
    content += `# Dilution Factor: ${metadata.dilutionFactor}\n`;
    content += `#\n`;
  }
  
  // Data for each cytokine with results
  Object.keys(analysisResults).forEach((cytokineIndex, fileIndex) => {
    const results = analysisResults[cytokineIndex];
    const cytokine = CYTOKINES[cytokineIndex];
    
    if (!cytokine || !results) return;
    
    if (fileIndex > 0) content += '\n\n';
    
    content += `# ${cytokine} Analysis Results\n`;
    content += `Well,Role,Compound Name,Compound Concentration (design),Signal,Actual Concentration (pg/mL),Dilution Factor,Method\n`;
    
    // Add standards if requested
    if (includeStandards && results.standardData) {
      results.standardData.forEach(std => {
        const wellIds = std.wellIds || [std.well];
        const signals = std.rawSignals || [std.signal];
        
        wellIds.forEach((wellId, idx) => {
          const signal = signals[idx] || std.signal;
          content += `${wellId},Standard,,${std.concentration},${signal.toFixed(decimals)},${std.concentration},1.0,Known Standard\n`;
        });
      });
    }
    
    // Add unknowns and controls
    if (results.unknowns) {
      results.unknowns.forEach(unk => {
        const wellId = unk.well;
        const row = wellId[0];
        const col = parseInt(wellId.slice(1));
        
        const compound = wellCompounds[row] && wellCompounds[row][col] ? wellCompounds[row][col] : '';
        const compoundConc = wellConcentrations[row] && wellConcentrations[row][col] ? wellConcentrations[row][col] : '';
        const dilution = wellDilutions[row] && wellDilutions[row][col] ? wellDilutions[row][col] : 1;
        const role = wellRoles[row] && wellRoles[row][col] ? wellRoles[row][col] : 'unknown';
        
        const actualConc = unk.actualConcentration || unk.concentration || 'N/A';
        const actualConcFormatted = typeof actualConc === 'number' ? actualConc.toFixed(decimals) : actualConc;
        
        content += `${wellId},${role},"${compound}",${compoundConc},${unk.signal.toFixed(decimals)},${actualConcFormatted},${dilution},${results.method || 'Calculated'}\n`;
      });
    }
  });
  
  const filename = `msd_analyzed_data_${new Date().toISOString().slice(0, 10)}.csv`;
  downloadFile(content, filename, 'text/csv');
  updateStatus('Analyzed data exported successfully', 'complete');
}

function exportAnalyzedDataExcel(includeStandards, metadata, assumptions, decimals) {
  let content = '';
  
  // Metadata section
  if (metadata) {
    content += `MSD Plate Analysis - Analyzed Data Export\n\n`;
    content += `Export Information:\n`;
    content += `Date,${metadata.exportDate}\n`;
    content += `Time,${metadata.exportTime}\n`;
    content += `Software,${metadata.softwareVersion}\n`;
    content += `Analysis Method,${metadata.analysisMethod}\n`;
    content += `Dilution Factor,${metadata.dilutionFactor}\n\n`;
    
    if (assumptions) {
      content += `Experimental Setup:\n`;
      content += `Standard Dilution Factor,${assumptions.standardDilutionFactor}\n`;
      content += `Number of Standard Dilutions,${assumptions.numberOfStandardDilutions}\n\n`;
      
      content += `Cytokine Configuration:\n`;
      content += `Spot,Cytokine,Max Concentration (pg/mL)\n`;
      assumptions.cytokineConfiguration.forEach(config => {
        content += `${config.spot},${config.cytokine},${config.maxConcentration}\n`;
      });
      content += '\n\n';
    }
  }
  
  // Analyzed data for each cytokine
  Object.keys(analysisResults).forEach((cytokineIndex, sheetIndex) => {
    const results = analysisResults[cytokineIndex];
    const cytokine = CYTOKINES[cytokineIndex];
    
    if (!cytokine || !results) return;
    
    if (sheetIndex > 0) content += '\n\n';
    
    content += `${cytokine} Analysis Results\n`;
    content += `Well,Role,Compound Name,Compound Concentration (design),Signal,Actual Concentration (pg/mL),Dilution Factor,Method,R²,Standards Used\n`;
    
    const r2 = results.r2 || 'N/A';
    const standardsCount = results.standardData ? results.standardData.length : 0;
    
    // Add standards if requested
    if (includeStandards && results.standardData) {
      results.standardData.forEach(std => {
        const wellIds = std.wellIds || [std.well];
        const signals = std.rawSignals || [std.signal];
        
        wellIds.forEach((wellId, idx) => {
          const signal = signals[idx] || std.signal;
          content += `${wellId},Standard,,${std.concentration},${signal.toFixed(decimals)},${std.concentration},1.0,Known Standard,${r2},${standardsCount}\n`;
        });
      });
    }
    
    // Add unknowns and controls
    if (results.unknowns) {
      results.unknowns.forEach(unk => {
        const wellId = unk.well;
        const row = wellId[0];
        const col = parseInt(wellId.slice(1));
        
        const compound = wellCompounds[row] && wellCompounds[row][col] ? wellCompounds[row][col] : '';
        const compoundConc = wellConcentrations[row] && wellConcentrations[row][col] ? wellConcentrations[row][col] : '';
        const dilution = wellDilutions[row] && wellDilutions[row][col] ? wellDilutions[row][col] : 1;
        const role = wellRoles[row] && wellRoles[row][col] ? wellRoles[row][col] : 'unknown';
        
        const actualConc = unk.actualConcentration || unk.concentration || 'N/A';
        const actualConcFormatted = typeof actualConc === 'number' ? actualConc.toFixed(decimals) : actualConc;
        
        content += `${wellId},${role},"${compound}",${compoundConc},${unk.signal.toFixed(decimals)},${actualConcFormatted},${dilution},${results.method || 'Calculated'},${r2},${standardsCount}\n`;
      });
    }
  });
  
  const filename = `msd_analyzed_data_${new Date().toISOString().slice(0, 10)}.csv`;
  downloadFile(content, filename, 'text/csv');
  updateStatus('Analyzed data exported successfully (Excel-compatible)', 'complete');
}

// Plot Export - Export standard curves and dose-response plots
function exportPlots() {
  if (CYTOKINES.length === 0) {
    updateStatus('No cytokines configured. Please setup cytokines first.', 'error');
    return;
  }
  
  const plotType = document.getElementById('plotExportType').value;
  const cytokineSelection = document.getElementById('plotExportCytokines').value;
  const format = document.getElementById('plotExportFormat').value;
  
  const cytokineIndices = cytokineSelection === 'all' ? 
    Array.from({length: CYTOKINES.length}, (_, i) => i) : [currentCytokine];
  
  let plotsExported = 0;
  
  cytokineIndices.forEach((cytokineIndex, index) => {
    const cytokine = CYTOKINES[cytokineIndex];
    if (!cytokine) return;
    
    // Small delay between exports to prevent browser blocking
    setTimeout(() => {
      if (plotType === 'standard' || plotType === 'both') {
        exportStandardCurvePlot(cytokineIndex, cytokine, format);
        plotsExported++;
      }
      
      
      // Update status after last export
      if (index === cytokineIndices.length - 1) {
        setTimeout(() => {
          updateStatus(`${plotsExported} plot(s) exported successfully as ${format.toUpperCase()}`, 'complete');
        }, 100);
      }
    }, index * 200); // 200ms delay between cytokines
  });
}

function exportStandardCurvePlot(cytokineIndex, cytokine, format) {
  // Check if we have analysis results for this cytokine
  if (!analysisResults || !analysisResults[cytokineIndex]) {
    console.warn(`No analysis results for ${cytokine}, skipping standard curve export`);
    return;
  }
  
  // Get the standard curve chart canvas
  const chartCanvas = document.getElementById('standardCurveChart');
  if (!chartCanvas || !window.chart) {
    console.warn('Standard curve chart not available, creating temporary chart for export');
    createTemporaryStandardCurveChart(cytokineIndex, cytokine, format);
    return;
  }
  
  // Export current chart if it matches the requested cytokine
  const currentCytokineInChart = window.chart.options?.plugins?.title?.text?.includes(cytokine);
  if (currentCytokineInChart) {
    exportChartAsImage(window.chart, `standard_curve_${cytokine}`, format);
  } else {
    // Switch to the requested cytokine and export
    const originalCytokine = currentCytokine;
    currentCytokine = cytokineIndex;
    createStandardCurveChart(cytokineIndex);
    
    setTimeout(() => {
      if (window.chart) {
        exportChartAsImage(window.chart, `standard_curve_${cytokine}`, format);
      }
      // Restore original cytokine
      currentCytokine = originalCytokine;
      createStandardCurveChart(originalCytokine);
    }, 100);
  }
}


function exportChartAsImage(chart, baseName, format) {
  if (!chart || !chart.canvas) {
    console.error('Invalid chart object for export');
    return;
  }
  
  try {
    let imageData;
    const canvas = chart.canvas;
    
    if (format === 'png') {
      imageData = canvas.toDataURL('image/png', 1.0);
    } else if (format === 'svg') {
      // For SVG, we'll export as high-quality PNG since Chart.js doesn't directly support SVG export
      imageData = canvas.toDataURL('image/png', 1.0);
      baseName += '_hq'; // Indicate high quality
    } else if (format === 'pdf') {
      // For PDF, we'll export as PNG and let the user convert if needed
      imageData = canvas.toDataURL('image/png', 1.0);
    }
    
    // Clean filename
    const cleanName = baseName.replace(/[^a-zA-Z0-9_-]/g, '_');
    const filename = `${cleanName}_${new Date().toISOString().slice(0, 10)}.png`;
    
    // Download the image
    const link = document.createElement('a');
    link.download = filename;
    link.href = imageData;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
  } catch (error) {
    console.error('Error exporting chart:', error);
    updateStatus(`Failed to export ${baseName} chart`, 'error');
  }
}

function createTemporaryStandardCurveChart(cytokineIndex, cytokine, format) {
  // Create a temporary chart for export
  const results = analysisResults[cytokineIndex];
  if (!results || !results.standardData) {
    console.warn(`No standard data available for ${cytokine}`);
    return;
  }
  
  // Create temporary canvas
  const tempCanvas = document.createElement('canvas');
  tempCanvas.width = 800;
  tempCanvas.height = 600;
  const tempCtx = tempCanvas.getContext('2d');
  
  // Prepare data for the chart
  const standardData = results.standardData.map(std => ({
    x: std.concentration,
    y: std.signal
  }));
  
  // Create temporary chart
  const tempChart = new Chart(tempCtx, {
    type: 'scatter',
    data: {
      datasets: [{
        label: `${cytokine} Standards`,
        data: standardData,
        backgroundColor: 'rgba(54, 162, 235, 0.8)',
        borderColor: 'rgba(54, 162, 235, 1)',
        pointRadius: 6
      }]
    },
    options: {
      responsive: false,
      animation: false,
      plugins: {
        title: {
          display: true,
          text: `${cytokine} Standard Curve`,
          font: { size: 16, weight: 'bold' }
        }
      },
      scales: {
        x: {
          type: 'logarithmic',
          title: { display: true, text: 'Concentration (pg/mL)' }
        },
        y: {
          type: 'logarithmic', 
          title: { display: true, text: 'Signal' }
        }
      }
    }
  });
  
  // Export after a brief delay to ensure rendering
  setTimeout(() => {
    exportChartAsImage(tempChart, `standard_curve_${cytokine}`, format);
    tempChart.destroy();
  }, 200);
}


// Complete Report Export - Comprehensive package with all data, plots, and plate schematic
function exportCompleteReport() {
  if (CYTOKINES.length === 0) {
    updateStatus('No cytokines configured. Please setup cytokines first.', 'error');
    return;
  }
  
  const includePlate = document.getElementById('reportIncludePlate').value === 'yes';
  const format = document.getElementById('reportFormat').value;
  const includeMetadata = document.getElementById('includeMetadata').value === 'yes';
  const decimals = parseInt(document.getElementById('exportDecimals').value) || 3;
  
  updateStatus('Generating comprehensive report...', 'info');
  
  if (format === 'excel') {
    exportCompleteExcelReport(includePlate, includeMetadata, decimals);
  } else if (format === 'pdf') {
    exportCompletePDFReport(includePlate, includeMetadata, decimals);
  } else if (format === 'html') {
    exportCompleteHTMLReport(includePlate, includeMetadata, decimals);
  }
}

// Complete Report Export Functions
function exportCompleteExcelReport(includePlate, includeMetadata, decimals) {
  const metadata = includeMetadata ? getExportMetadata() : null;
  const assumptions = includeMetadata ? getExperimentalAssumptions() : null;
  
  let content = '';
  
  // Report Header
  content += `MSD Plate Analysis - Complete Report\n`;
  content += `Generated: ${new Date().toLocaleDateString()} ${new Date().toLocaleTimeString()}\n\n`;
  
  // Metadata Section
  if (metadata) {
    content += `EXPORT INFORMATION\n`;
    content += `Software,${metadata.softwareVersion}\n`;
    content += `Export Date,${metadata.exportDate}\n`;
    content += `Export Time,${metadata.exportTime}\n`;
    content += `Plate Format,${metadata.plateFormat}\n`;
    content += `Analysis Method,${metadata.analysisMethod}\n`;
    content += `Global Dilution Factor,${metadata.dilutionFactor}\n\n`;
    
    // Experimental Setup
    if (assumptions) {
      content += `EXPERIMENTAL SETUP\n`;
      content += `Standard Dilution Factor,${assumptions.standardDilutionFactor}\n`;
      content += `Number of Standard Dilutions,${assumptions.numberOfStandardDilutions}\n\n`;
      
      content += `CYTOKINE CONFIGURATION\n`;
      content += `Spot,Cytokine,Max Concentration (pg/mL)\n`;
      assumptions.cytokineConfiguration.forEach(config => {
        content += `${config.spot},${config.cytokine},${config.maxConcentration}\n`;
      });
      content += '\n';
    }
  }
  
  // Analysis Results for Each Cytokine
  if (analysisResults && Object.keys(analysisResults).length > 0) {
    content += `ANALYSIS RESULTS\n`;
    
    Object.keys(analysisResults).forEach((cytokineIndex) => {
      const results = analysisResults[cytokineIndex];
      const cytokine = CYTOKINES[cytokineIndex];
      
      if (!cytokine || !results) return;
      
      content += `\n${cytokine} Analysis (Spot ${parseInt(cytokineIndex) + 1})\n`;
      content += `Analysis Method,${results.method || 'fit4pl'}\n`;
      content += `R² Value,${results.r2 || 'N/A'}\n`;
      content += `Standards Used,${results.standardData ? results.standardData.length : 0}\n\n`;
      
      // Standards
      if (results.standardData && results.standardData.length > 0) {
        content += `Standards\n`;
        content += `Concentration (pg/mL),Mean Signal,Wells\n`;
        results.standardData.forEach(std => {
          const wellIds = std.wellIds || [std.well];
          const wellList = wellIds.join(';');
          content += `${std.concentration},${std.signal.toFixed(decimals)},"${wellList}"\n`;
        });
        content += '\n';
      }
      
      // Unknowns and Controls
      if (results.unknowns && results.unknowns.length > 0) {
        content += `Unknowns & Controls\n`;
        content += `Well,Role,Compound,Compound Conc,Signal,Calculated Conc (pg/mL),Dilution\n`;
        results.unknowns.forEach(unk => {
          const wellId = unk.well;
          const row = wellId[0];
          const col = parseInt(wellId.slice(1));
          
          const compound = wellCompounds[row] && wellCompounds[row][col] ? wellCompounds[row][col] : '';
          const compoundConc = wellConcentrations[row] && wellConcentrations[row][col] ? wellConcentrations[row][col] : '';
          const dilution = wellDilutions[row] && wellDilutions[row][col] ? wellDilutions[row][col] : 1;
          const role = wellRoles[row] && wellRoles[row][col] ? wellRoles[row][col] : 'unknown';
          
          const actualConc = unk.actualConcentration || unk.concentration || 'N/A';
          const actualConcFormatted = typeof actualConc === 'number' ? actualConc.toFixed(decimals) : actualConc;
          
          content += `${wellId},${role},"${compound}",${compoundConc},${unk.signal.toFixed(decimals)},${actualConcFormatted},${dilution}\n`;
        });
        content += '\n';
      }
    });
  }
  
  // Summary Statistics
  content += `SUMMARY STATISTICS\n`;
  content += `Total Cytokines Configured,${CYTOKINES.length}\n`;
  
  let totalStandards = 0, totalUnknowns = 0, totalControls = 0, totalEmpty = 0;
  for (let row of ROWS) {
    for (let col of COLS) {
      const role = wellRoles[row] && wellRoles[row][col] ? wellRoles[row][col] : 'empty';
      if (role === 'standard') totalStandards++;
      else if (role === 'unknown') totalUnknowns++;
      else if (role === 'control') totalControls++;
      else totalEmpty++;
    }
  }
  
  content += `Standards,${totalStandards}\n`;
  content += `Unknowns,${totalUnknowns}\n`;
  content += `Controls,${totalControls}\n`;
  content += `Empty Wells,${totalEmpty}\n`;
  
  const filename = `MSD_Complete_Report_${new Date().toISOString().slice(0, 10)}.csv`;
  downloadFile(content, filename, 'text/csv');
  updateStatus('Complete Excel report exported successfully', 'complete');
}

