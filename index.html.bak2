H 	       117  	       126  	      1539  	      5499  	     21238  	     81394  	    303440  	   1120800  	   1866816  	     16846  	     18174  	     16855	
  	       185  	       148  	       365  	      1000  	      3399  	     14201  	     54196  	    247265  	   1035564  	       909  	      1128  	      1096	
