// Usage Statistics Functions
function updateAIUsageStats(type) {
  const stats = JSON.parse(localStorage.getItem('aiUsageStats') || '{}');
  
  switch (type) {
    case 'question':
      stats.questionsCount = (stats.questionsCount || 0) + 1;
      break;
    case 'table':
      stats.tablesCreated = (stats.tablesCreated || 0) + 1;
      break;
    case 'chart':
      stats.chartsGenerated = (stats.chartsGenerated || 0) + 1;
      break;
  }
  
  localStorage.setItem('aiUsageStats', JSON.stringify(stats));
  displayAIUsageStats();
}

function displayAIUsageStats() {
  const stats = JSON.parse(localStorage.getItem('aiUsageStats') || '{}');
  
  const questionsElement = document.getElementById('aiQuestionsCount');
  const tablesElement = document.getElementById('aiTablesCreated');
  const chartsElement = document.getElementById('aiChartsGenerated');
  
  if (questionsElement) questionsElement.textContent = stats.questionsCount || 0;
  if (tablesElement) tablesElement.textContent = stats.tablesCreated || 0;
  if (chartsElement) chartsElement.textContent = stats.chartsGenerated || 0;
}

