// Well Editor Functions
let currentEditingWell = null;

function openWellEditor(row, col) {
  console.log(`🔧 Opening well editor for ${row}${col}`);
  
  currentEditingWell = { row, col };
  
  // Update modal title
  document.getElementById('wellEditorWellId').textContent = `${row}${col}`;
  
  // Populate form with current well data
  populateWellEditorForm(row, col);
  
  // Show modal
  document.getElementById('wellEditorModal').style.display = 'block';
}

function populateWellEditorForm(row, col) {
  // Get current well data
  const role = wellRoles[row][col] || '';
  const compound = wellCompounds[row][col] || '';
  const concentration = wellConcentrations[row][col] || '';
  const dilution = wellDilutions[row][col] || 1.0;
  const notes = wellNotes && wellNotes[row] && wellNotes[row][col] ? wellNotes[row][col] : '';
  
  // Populate form fields
  document.getElementById('wellEditorRole').value = role;
  document.getElementById('wellEditorCompound').value = compound;
  document.getElementById('wellEditorConcentration').value = concentration;
  document.getElementById('wellEditorDilution').value = dilution;
  document.getElementById('wellEditorNotes').value = notes;
}

function saveWellChanges() {
  if (!currentEditingWell) {
    console.error('No well being edited');
    return;
  }
  
  const { row, col } = currentEditingWell;
  console.log(`💾 Saving changes for well ${row}${col}`);
  
  try {
    // Get form values
    const role = document.getElementById('wellEditorRole').value;
    const compound = document.getElementById('wellEditorCompound').value;
    const concentration = document.getElementById('wellEditorConcentration').value;
    const dilution = parseFloat(document.getElementById('wellEditorDilution').value) || 1.0;
    const notes = document.getElementById('wellEditorNotes').value;
    
    // Update well data
    wellRoles[row][col] = role || null;
    wellCompounds[row][col] = compound || null;
    wellConcentrations[row][col] = concentration ? parseFloat(concentration) : null;
    wellDilutions[row][col] = dilution;
    
    // Initialize wellNotes if it doesn't exist
    if (!wellNotes) {
      wellNotes = {};
    }
    if (!wellNotes[row]) {
      wellNotes[row] = {};
    }
    wellNotes[row][col] = notes || null;
    
    // Update UI
    renderPlate();
    updateStandardInputsForCytokine();
    
    // Close modal
    closeWellEditor();
    
    // Show success message
    updateStatus(`✅ Well ${row}${col} updated successfully`, 'complete');
    
    console.log(`✅ Well ${row}${col} saved:`, {
      role,
      compound,
      concentration,
      dilution,
      notes
    });
    
  } catch (error) {
    console.error('Error saving well changes:', error);
    updateStatus(`❌ Error saving well ${row}${col}: ${error.message}`, 'error');
  }
}

function closeWellEditor() {
  document.getElementById('wellEditorModal').style.display = 'none';
  currentEditingWell = null;
}

// Template Manager Functions
let selectedTemplateIndex = null;
const TEMPLATE_DIR = 'templates'; // Directory for saving templates

function openTemplateManager() {
  console.log('🔧 Opening Template Manager');
  
  // Show modal
  document.getElementById('templateManagerModal').style.display = 'block';
  
  // Load template list
  refreshTemplateList();
  
  // Clear form
