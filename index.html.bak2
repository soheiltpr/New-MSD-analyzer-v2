// Add content to box
function addContent(boxId, contentType) {
  console.log('Adding content to box:', boxId, contentType);
  
  const box = document.getElementById(boxId);
  if (!box) return;
  
  const content = box.querySelector('.layout-box-content');
  const header = box.querySelector('div');
  
  // Close modal
  const modal = document.querySelector('div[style*="z-index: 10001"]');
  if (modal) modal.remove();
  
  // Update header
  const contentTypeNames = {
    'plate-schematic': '🧪 Plate Schematic',
    'standard-curve': '📈 Standard Curve',
    'compounds-chart': '🧬 Compounds Analysis',
    'results-table': '📊 Results Table',
    'plot': '📉 Cytokine Plot',
    'text': '📝 Text'
  };
  
  const headerText = header.querySelector('span');
  if (headerText) {
    headerText.textContent = contentTypeNames[contentType] || 'Unknown Content';
  }
  
  // Populate content based on type
  populateBoxContent(box, content, contentType);
  
  // Update state
  const boxState = layoutState.boxes.find(b => b.id === boxId);
  if (boxState) {
    boxState.contentType = contentType;
  }
}

// Populate box with actual content
function populateBoxContent(box, contentDiv, contentType) {
  contentDiv.style.color = '#1f2937';
  
  switch (contentType) {
    case 'plate-schematic':
      contentDiv.innerHTML = '<div style="text-align: center;"><div style="font-size: 24px; margin-bottom: 10px;">🧪</div><div>Plate schematic will be rendered here</div><div style="font-size: 12px; color: #6b7280; margin-top: 5px;">Simplified plate view</div></div>';
      break;
      
    case 'standard-curve':
      const standardCanvas = document.createElement('canvas');
      standardCanvas.style.width = '100%';
      standardCanvas.style.height = '100%';
      contentDiv.innerHTML = '';
      contentDiv.appendChild(standardCanvas);
      // Copy standard curve chart to this canvas
      copyChartToCanvas('standardCurve', standardCanvas);
      break;
      
    case 'compounds-chart':
      const compoundsCanvas = document.createElement('canvas');
      compoundsCanvas.style.width = '100%';
      compoundsCanvas.style.height = '100%';
      contentDiv.innerHTML = '';
      contentDiv.appendChild(compoundsCanvas);
      // Copy compounds chart to this canvas
      copyChartToCanvas('compoundsChart', compoundsCanvas);
      break;
      
    case 'results-table':
      const tableData = getResultsTableHTML();
      contentDiv.innerHTML = `<div style="width: 100%; height: 100%; overflow: auto;">${tableData}</div>`;
      break;
      
    case 'plot':
      contentDiv.innerHTML = '<div style="text-align: center;"><div style="font-size: 24px; margin-bottom: 10px;">📉</div><div>Select a cytokine plot to display</div><select onchange="loadPlotToBox(this.value, \'' + box.id + '\')" style="margin-top: 10px; padding: 5px;"><option value="">-- Select Plot --</option></select></div>';
      populatePlotSelector(box.id);
      break;
      
    case 'text':
      contentDiv.innerHTML = '<textarea style="width: 100%; height: 100%; border: 1px solid #e5e7eb; border-radius: 4px; padding: 10px; font-family: Arial, sans-serif; resize: none;" placeholder="Enter your notes here..."></textarea>';
      break;
  }
}

// Copy chart to canvas
function copyChartToCanvas(sourceCanvasId, targetCanvas) {
  const sourceCanvas = document.getElementById(sourceCanvasId);
  if (!sourceCanvas) {
    console.warn('Source canvas not found:', sourceCanvasId);
    return;
  }
  
  const ctx = targetCanvas.getContext('2d');
  targetCanvas.width = sourceCanvas.width;
  targetCanvas.height = sourceCanvas.height;
  ctx.drawImage(sourceCanvas, 0, 0);
}

// Get results table HTML
function getResultsTableHTML() {
  const tableBody = document.getElementById('unknownsTableBody');
  if (!tableBody) return '<div>No results table available</div>';
  
  const rows = Array.from(tableBody.querySelectorAll('tr'));
  const tableHTML = `
    <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
      <thead>
        <tr style="background: #f3f4f6;">
          <th style="padding: 4px; border: 1px solid #e5e7eb;">Well</th>
          <th style="padding: 4px; border: 1px solid #e5e7eb;">Compound</th>
          <th style="padding: 4px; border: 1px solid #e5e7eb;">Concentration</th>
        </tr>
      </thead>
      <tbody>
        ${rows.slice(0, 10).map(row => {
          const cells = Array.from(row.querySelectorAll('td'));
          return `<tr>${cells.slice(0, 3).map(cell => `<td style="padding: 4px; border: 1px solid #e5e7eb;">${cell.textContent}</td>`).join('')}</tr>`;
        }).join('')}
      </tbody>
    </table>
  `;
  return tableHTML;
}

// Populate plot selector
function populatePlotSelector(boxId) {
  const box = document.getElementById(boxId);
  if (!box) return;
  
  const select = box.querySelector('select');
  if (!select) return;
  
  // Add available plots
  CYTOKINES.forEach((cytokine, index) => {
    const option = document.createElement('option');
    option.value = `plot_${index}`;
    option.textContent = cytokine;
    select.appendChild(option);
  });
}

// Load plot to box
function loadPlotToBox(plotId, boxId) {
  console.log('Loading plot', plotId, 'to box', boxId);
  // Implementation for loading specific plot
}

// Delete layout box
function deleteLayoutBox(boxId) {
  const box = document.getElementById(boxId);
  if (box) {
    box.remove();
    layoutState.boxes = layoutState.boxes.filter(b => b.id !== boxId);
  }
}

// Clear layout canvas
function clearLayoutCanvas() {
  const canvas = document.getElementById('layoutCanvas');
  if (!canvas) return;
  
  // Remove all boxes
  canvas.querySelectorAll('.layout-box').forEach(box => box.remove());
  layoutState.boxes = [];
  layoutState.nextBoxId = 1;
  
  console.log('Layout cleared');
}

// Save layout to file
function saveLayoutToFile() {
  const layoutData = {
    boxes: layoutState.boxes,
    timestamp: new Date().toISOString()
  };
  
  const blob = new Blob([JSON.stringify(layoutData, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `layout-${new Date().toISOString().slice(0, 19).replace(/:/g, '-')}.json`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  
  console.log('Layout saved');
}

