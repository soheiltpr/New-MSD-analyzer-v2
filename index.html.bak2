// AI Interpretation Functions
function openAIInterpret() {
  const modal = document.getElementById('aiInterpretModal');
  modal.style.display = 'flex';
  
  // Check if AI is configured
  if (!AIConfig.apiKey || !AIConfig.apiUrl) {
