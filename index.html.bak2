function createStandardCurveChart(result, container) {
  // Create canvas for this cytokine's standard curve
  const canvas = document.createElement('canvas');
  canvas.width = 280;
  canvas.height = 200;
  canvas.style.cssText = 'display: inline-block; margin: 5px; border: 1px solid #ccc; max-width: 280px; vertical-align: top;';
  
  const wrapper = document.createElement('div');
  wrapper.style.cssText = 'display: inline-block; margin: 10px; text-align: center;';
  wrapper.innerHTML = `<h4>${result.cytokine} Standard Curve (R² = ${result.r2})</h4>`;
  wrapper.appendChild(canvas);
  container.appendChild(wrapper);
  
  // Create chart
  const ctx = canvas.getContext('2d');
  
  // Prepare standard points
  const standardPoints = result.standardData.map(s => ({
    x: s.concentration,
    y: s.signal
  }));
  
  // Create curve points if we have a predictor
  let curvePoints = [];
  if (result.predictor && result.predictor.mode === 'fit4pl') {
    const minConc = Math.min(...result.standardData.map(s => s.concentration));
    const maxConc = Math.max(...result.standardData.map(s => s.concentration));
    
    for (let i = 0; i <= 50; i++) {
      const logMin = Math.log10(Math.max(minConc, 0.1));
      const logMax = Math.log10(maxConc);
      const logConc = logMin + (logMax - logMin) * i / 50;
      const concentration = Math.pow(10, logConc);
      
      try {
        const signal = result.predictor.model.f(concentration);
        curvePoints.push({ x: concentration, y: signal });
      } catch (e) {
        // Skip invalid points
      }
    }
  }
  
  const chartConfig = {
    type: 'scatter',
    data: {
      datasets: [{
        label: 'Standards',
        data: standardPoints,
        backgroundColor: COMPOUND_COLORS['Standards'],
        borderColor: COMPOUND_COLORS['Standards'],
        pointRadius: 4
      }]
    },
    options: {
      responsive: false,
      maintainAspectRatio: true,
      plugins: {
        legend: { display: false }
      },
      scales: {
        x: {
          type: 'logarithmic',
          title: { display: true, text: 'Concentration (pg/mL)' }
        },
        y: {
          type: 'logarithmic',
          title: { display: true, text: 'Signal (ECL)' }
        }
      }
    }
  };
  
  // Add curve if available
  if (curvePoints.length > 0) {
    chartConfig.data.datasets.push({
      label: 'Fitted Curve',
      data: curvePoints,
      type: 'line',
      borderColor: '#FF6B6B',
      backgroundColor: 'transparent',
      borderWidth: 2,
      pointRadius: 0
    });
  }
  
  const stdChart = new Chart(ctx, chartConfig);

  
  // Bind axis controls
  const xSel = document.getElementById('stdXScale');
  const ySel = document.getElementById('stdYScale');
  const applyScale = () => {
    const map = (v)=> v==='ln' ? 'logarithmic' : (v==='log' ? 'logarithmic' : 'linear');
    stdChart.options.scales.x.type = map(xSel.value);
    stdChart.options.scales.y.type = map(ySel.value);
    stdChart.update();
  };
  if (xSel && ySel) {
    xSel.onchange = applyScale;
    ySel.onchange = applyScale;
    // Default standard curve to log-log
    if (!xSel.dataset.init) { xSel.value = 'log'; ySel.value = 'log'; xSel.dataset.init = '1'; applyScale(); }
  }
}


function createCompoundConcentrationPlots(results, container) {
  // Create a summary chart showing calculated concentrations for all compounds
  const canvas = document.createElement('canvas');
  canvas.width = 450;
  canvas.height = 300;
  canvas.style.cssText = 'display: block; margin: 20px auto; border: 1px solid #ccc;';
  
  const wrapper = document.createElement('div');
  wrapper.style.cssText = 'text-align: center; margin: 20px 0;';
  wrapper.innerHTML = '<h4>📊 Compound Concentrations Summary</h4>';
  wrapper.appendChild(canvas);
  container.appendChild(wrapper);
  
  // Collect compound concentration data
  const compoundData = collectCompoundConcentrationData();
  
  if (compoundData.length === 0) {
    wrapper.innerHTML += '<p>No compound concentration data available</p>';
    return;
  }
  
  const ctx = canvas.getContext('2d');
  
  // Create datasets for each compound
  const datasets = [];
  const compounds = ['Compound A', 'Compound B', 'Compound C', 'Compound D'];
  
  compounds.forEach((compound, index) => {
    const compoundConcs = compoundData.filter(d => d.compound === compound);
    if (compoundConcs.length > 0) {
      const compoundColor = getCompoundColor(compound);
      datasets.push({
        label: compound,
        data: compoundConcs.map(d => ({ x: d.expectedConc, y: d.calculatedConc })),
        backgroundColor: compoundColor,
        borderColor: compoundColor,
        pointRadius: 5
      });
    }
  });
  
  new Chart(ctx, {
    type: 'scatter',
    data: { datasets },
    options: {
      responsive: false,
      plugins: {
        title: { display: true, text: 'Compound Concentration vs Actual Concentration (pg/mL)' }
      },
      scales: {
        x: {
          type: 'logarithmic',
          title: { display: true, text: 'Compound Concentration (Experimental Design)' }
        },
        y: {
          type: 'logarithmic', 
          title: { display: true, text: 'Actual Concentration (pg/mL) - Calculated from Signal' }
        }
      }
    }
  });
}

function collectCompoundConcentrationData() {
  const data = [];
  
  console.log('🔍 Collecting compound concentration data for plotting...');
  console.log('  X-axis: COMPOUND concentrations (experimental design)');
  console.log('  Y-axis: ACTUAL concentrations (calculated from signals)');
  
  // Collect data from sample wells (B-G, columns 2-9)
  const sampleRows = ['B', 'C', 'D', 'E', 'F', 'G'];
  const groupColumns = [[2, 3], [4, 5], [6, 7], [8, 9]];
  const compoundNames = ['Compound A', 'Compound B', 'Compound C', 'Compound D'];
  const expectedConcentrations = [1000, 100, 10, 1, 0.1, 0.01];
  
  sampleRows.forEach((row, rowIndex) => {
    const expectedConc = expectedConcentrations[rowIndex];
    
    groupColumns.forEach((colPair, groupIndex) => {
      const compound = compoundNames[groupIndex];
      
      colPair.forEach(col => {
        // X-axis: COMPOUND concentration (experimental design parameter)
        const compoundConc = wellConcentrations[row][col] || expectedConc;
        
        // Y-axis: ACTUAL concentration (calculated from signal data)
        let actualConc = null;
        if (calculatedConcentrations && calculatedConcentrations[currentCytokine] && 
            calculatedConcentrations[currentCytokine][row] && 
            calculatedConcentrations[currentCytokine][row][col]) {
          actualConc = calculatedConcentrations[currentCytokine][row][col];
        }
        
        if (actualConc && actualConc > 0 && compoundConc > 0) {
          data.push({
            well: `${row}${col}`,
            compound: compound,
            expectedConc: compoundConc, // COMPOUND concentration (X-axis)
            calculatedConc: actualConc  // ACTUAL concentration (Y-axis)
          });
          
          console.log(`  📊 ${row}${col}: ${compound} - Compound: ${compoundConc}, Actual: ${actualConc.toFixed(2)} pg/mL`);
        }
      });
    });
  });
  
  console.log(`📈 Collected ${data.length} data points for compound concentration plot`);
  return data;
}

// ===================================================================
// EXCEL-LIKE SELECTION SYSTEM FOR PLATE SCHEMATIC
// ===================================================================

// Selection state
let activeCell = null; // {row: 'A', col: 1} - the cursor/focus
let anchorCell = null; // {row: 'A', col: 1} - where ranges extend from
let isDragging = false;
let dragStart = null;
let isExtendMode = false; // F8 toggle
let isAddMode = false; // Shift+F8 toggle

// Well Event Handlers
function handleWellClick(event, row, col) {
  console.log(`🖱️ Well clicked: ${row}${col}`, {
    ctrlKey: event.ctrlKey,
    metaKey: event.metaKey,
    shiftKey: event.shiftKey,
    button: event.button,
    isDragging: isDragging
  });

  // Ignore if drag just happened (check window flag set by mouseup)
  if (window.__clickShouldBeIgnored) {
    console.log('⚠️ Ignoring click after drag');
    window.__clickShouldBeIgnored = false;
    return;
  }

  event.preventDefault();
  event.stopPropagation();

  // Check if user is in "set starting well" mode
  const startWellInput = document.getElementById('standardStartWell');
  const compoundStartWellInput = document.getElementById('compoundStartWell');
  
  if (startWellInput && document.activeElement === startWellInput) {
    startWellInput.value = `${row}${col}`;
    startWellInput.blur();
    updateStatus(`Set ${row}${col} as starting well for standards`, 'complete');
    return;
  }
  
  if (compoundStartWellInput && document.activeElement === compoundStartWellInput) {
    compoundStartWellInput.value = `${row}${col}`;
    compoundStartWellInput.blur();
    updateStatus(`Set ${row}${col} as starting well for compounds`, 'complete');
    return;
  }

  const clickedCell = {row, col};

  // Excel-like selection logic
  const hasCtrl = event.ctrlKey || event.metaKey || false;
  const hasShift = event.shiftKey || false;
  const hasAlt = event.altKey || false;
  
  console.log('🔍 Modifier keys:', { ctrl: hasCtrl, shift: hasShift, alt: hasAlt });

  if (hasCtrl && !hasShift && !hasAlt) {
    // Ctrl/Cmd + Click ONLY: Toggle single well
    console.log('🔄 Toggle mode');
    toggleSingleWell(row, col);
    activeCell = clickedCell;
    // Anchor stays unchanged
  } else if (hasShift && !hasCtrl && !hasAlt) {
    // Shift + Click ONLY: Extend selection from anchor
    console.log('📍 Range extend mode');
    if (!anchorCell && activeCell) {
      anchorCell = activeCell;
    }
    if (anchorCell) {
      extendSelectionFromAnchor(anchorCell, clickedCell);
  } else {
      // No anchor, treat as normal selection
      selectedWells.clear();
    selectWell(row, col);
      anchorCell = clickedCell;
    }
    activeCell = clickedCell;
  } else {
    // Normal click (NO modifiers): Replace selection with single well
    console.log('🎯 SINGLE SELECTION MODE - NO MODIFIERS');
    console.log('   Before clear:', Array.from(selectedWells));
    
    // CRITICAL: Clear ALL selections
    selectedWells.clear();
    console.log('   After Set.clear():', Array.from(selectedWells));
    
    // Remove selected class from all wells in DOM
    document.querySelectorAll('.well.selected').forEach(el => {
      el.classList.remove('selected');
    });
    console.log('   Removed .selected class from all wells');
    
    // Now add ONLY the clicked well
    const wellId = `${row}${col}`;
    selectedWells.add(wellId);
    console.log('   After adding clicked well:', Array.from(selectedWells));
    
    // Add selected class to clicked well
    const clickedWellElement = document.querySelector(`[data-row="${row}"][data-col="${col}"]`);
    if (clickedWellElement) {
      clickedWellElement.classList.add('selected');
    }
    
    activeCell = clickedCell;
    anchorCell = clickedCell;
  }

  // Update visual state immediately
  updatePlateVisuals();
  
  // Update selection display and starting well fields
  updateSelectionDisplay();
  
  console.log('🔄 Final selection after updatePlateVisuals:', {
    selected: Array.from(selectedWells),
    active: activeCell,
    anchor: anchorCell
  });
}

function handleWellDoubleClick(event, row, col) {
  event.preventDefault();
  console.log(`🖱️ Double-click: ${row}${col}`);
  
  // Double-click opens well editor modal
  openWellEditor(row, col);
}

function handleWellMouseDown(event, row, col) {
  // Only process left mouse button
  if (event.button !== 0) return;
  
  console.log(`🖱️ Mouse down: ${row}${col}`);
  
  isDragging = false; // Will be set to true in mousemove if dragged
  dragStart = {row, col};
  
  // Prepare for potential drag
  const isCtrl = event.ctrlKey || event.metaKey;
  const isShift = event.shiftKey;
  const isAlt = event.altKey;
  
  // Set up drag mode
  window.__dragMode = isCtrl ? 'add' : (isAlt ? 'subtract' : (isShift ? 'extend' : 'replace'));
  
  // Store initial anchor for drag operations
  if (window.__dragMode === 'extend' && anchorCell) {
    window.__dragAnchor = anchorCell;
  } else if (window.__dragMode === 'replace') {
    window.__dragAnchor = {row, col};
  } else {
    window.__dragAnchor = anchorCell || {row, col};
  }
  
  // Add global listeners for drag
  document.addEventListener('mouseup', handleGlobalMouseUp, {once: true});
}

function handleWellMouseEnter(event, row, col) {
  // Call original hover handler
  handleWellHover(event);
  
  // Handle drag selection
  if (dragStart && event.buttons === 1) { // Left button is pressed
    isDragging = true;
    const dragEnd = {row, col};
    
    console.log(`🖱️ Dragging to: ${row}${col}`, {mode: window.__dragMode});
    
    // Update selection based on drag mode
    updateDragSelection(dragStart, dragEnd, window.__dragMode);
  }
}

function handleGlobalMouseUp(event) {
  console.log('🖱️ Mouse up (global)', {isDragging, dragStart});
  
  if (isDragging && dragStart) {
    // Drag completed - prevent the click event from firing
    console.log('✅ Drag completed, will ignore next click');
    window.__clickShouldBeIgnored = true;
    
    // Clear the flag after a short delay (in case click doesn't fire)
    setTimeout(() => {
      window.__clickShouldBeIgnored = false;
    }, 100);
  } else {
    // Was just a click, not a drag - allow click to proceed
    console.log('✅ Click (no drag), will allow click');
    window.__clickShouldBeIgnored = false;
  }
  
  // Always reset drag state
  isDragging = false;
  dragStart = null;
  window.__dragMode = null;
  window.__dragAnchor = null;
}

function handleWellRightClick(event, row, col) {
  event.preventDefault();

  console.log(`🔧 Right-clicked well: ${row}${col}`);

  // Temporarily select this well for context actions
  clearSelection();
  selectWell(row, col);
  updateSelectionDisplay();
  renderPlate(); // Update visual selection
  
  // Store context for menu actions
  contextMenuWell = { row, col };
  
  // Update context menu header
  document.getElementById('contextWellId').textContent = `Well ${row}${col}`;
  
  // Show context menu
  const contextMenu = document.getElementById('contextMenu');
  contextMenu.style.display = 'block';
  contextMenu.style.left = event.pageX + 'px';
  contextMenu.style.top = event.pageY + 'px';
  
  // Ensure it's visible on screen
  const rect = contextMenu.getBoundingClientRect();
  if (rect.right > window.innerWidth) {
    contextMenu.style.left = (event.pageX - rect.width) + 'px';
  }
  if (rect.bottom > window.innerHeight) {
    contextMenu.style.top = (event.pageY - rect.height) + 'px';
  }
}

// ===================================================================
// EXCEL-LIKE SELECTION HELPER FUNCTIONS
// ===================================================================

function toggleSingleWell(row, col) {
  const wellId = `${row}${col}`;
  if (selectedWells.has(wellId)) {
    selectedWells.delete(wellId);
    console.log(`➖ Removed ${wellId} from selection`);
  } else {
    selectedWells.add(wellId);
    console.log(`➕ Added ${wellId} to selection`);
  }
}

function extendSelectionFromAnchor(anchor, target) {
  const startRowIdx = ROWS.indexOf(anchor.row);
  const startCol = anchor.col;
  const endRowIdx = ROWS.indexOf(target.row);
  const endCol = target.col;
  
  const minRowIdx = Math.min(startRowIdx, endRowIdx);
  const maxRowIdx = Math.max(startRowIdx, endRowIdx);
  const minCol = Math.min(startCol, endCol);
  const maxCol = Math.max(startCol, endCol);
  
  // Clear and select rectangle
  clearSelection();
  for (let r = minRowIdx; r <= maxRowIdx; r++) {
    for (let c = minCol; c <= maxCol; c++) {
      selectedWells.add(`${ROWS[r]}${c}`);
    }
  }
  console.log(`📍 Extended selection from ${anchor.row}${anchor.col} to ${target.row}${target.col}`);
}

function updateDragSelection(start, end, mode) {
  const startRowIdx = ROWS.indexOf(start.row);
  const startCol = start.col;
  const endRowIdx = ROWS.indexOf(end.row);
  const endCol = end.col;
  
  const minRowIdx = Math.min(startRowIdx, endRowIdx);
  const maxRowIdx = Math.max(startRowIdx, endRowIdx);
  const minCol = Math.min(startCol, endCol);
  const maxCol = Math.max(startCol, endCol);
  
  if (mode === 'replace') {
    // Replace selection with dragged rectangle
    clearSelection();
    for (let r = minRowIdx; r <= maxRowIdx; r++) {
      for (let c = minCol; c <= maxCol; c++) {
        selectedWells.add(`${ROWS[r]}${c}`);
      }
    }
  } else if (mode === 'add') {
    // Add dragged rectangle to selection
    for (let r = minRowIdx; r <= maxRowIdx; r++) {
      for (let c = minCol; c <= maxCol; c++) {
        selectedWells.add(`${ROWS[r]}${c}`);
      }
    }
  } else if (mode === 'subtract') {
    // Remove dragged rectangle from selection
    for (let r = minRowIdx; r <= maxRowIdx; r++) {
      for (let c = minCol; c <= maxCol; c++) {
        selectedWells.delete(`${ROWS[r]}${c}`);
      }
    }
  } else if (mode === 'extend') {
    // Extend from anchor
    if (window.__dragAnchor) {
      extendSelectionFromAnchor(window.__dragAnchor, end);
    }
  }
  
  updatePlateVisuals();
}

function updatePlateVisuals() {
  // Update visual selection on plate
  document.querySelectorAll('.well').forEach(well => {
    const row = well.dataset.row;
    const col = parseInt(well.dataset.col);
    const wellId = `${row}${col}`;
    
    // Remove all selection classes
    well.classList.remove('selected', 'active', 'anchor');
    
    // Add appropriate classes
    if (selectedWells.has(wellId)) {
      well.classList.add('selected');
    }
    
    if (activeCell && activeCell.row === row && activeCell.col === col) {
      well.classList.add('active');
      // Add focus ring indicator
      well.style.outline = '3px solid #10b981';
      well.style.outlineOffset = '2px';
      well.style.zIndex = '10';
    } else {
      well.style.outline = '';
      well.style.outlineOffset = '';
      well.style.zIndex = '';
    }
    
    if (anchorCell && anchorCell.row === row && anchorCell.col === col) {
      well.classList.add('anchor');
      // Add subtle corner marker for anchor
      if (!well.querySelector('.anchor-marker')) {
        const marker = document.createElement('div');
        marker.className = 'anchor-marker';
        marker.style.cssText = `
          position: absolute;
          top: 2px;
          left: 2px;
          width: 6px;
          height: 6px;
          background: #f59e0b;
          border-radius: 50%;
          z-index: 20;
          pointer-events: none;
        `;
        well.appendChild(marker);
      }
    } else {
      const marker = well.querySelector('.anchor-marker');
      if (marker) marker.remove();
    }
  });
  
  // Update selection count display
  updateSelectionDisplay();
}

// ===================================================================
// EXCEL-LIKE KEYBOARD NAVIGATION
// ===================================================================

document.addEventListener('keydown', function(event) {
  // Only handle keyboard events when plate tab is visible
  const plateTab = document.getElementById('plate-tab');
  if (!plateTab || plateTab.style.display === 'none') return;
  
  // Don't interfere with input fields
  if (event.target.tagName === 'INPUT' || event.target.tagName === 'TEXTAREA' || event.target.tagName === 'SELECT') return;
  
  const key = event.key;
  const isCtrl = event.ctrlKey || event.metaKey;
  const isShift = event.shiftKey;
  
  console.log(`⌨️ Key: ${key}, Ctrl: ${isCtrl}, Shift: ${isShift}`);
  
  switch(key) {
    case 'ArrowUp':
    case 'ArrowDown':
    case 'ArrowLeft':
    case 'ArrowRight':
      event.preventDefault();
      handleArrowKey(key, isShift, isCtrl);
      break;
      
    case 'Home':
      event.preventDefault();
      handleHomeKey(isCtrl, isShift);
      break;
      
    case 'Escape':
      event.preventDefault();
      handleEscapeKey();
      break;
      
    case 'F8':
      event.preventDefault();
      toggleExtendMode();
      break;
      
    case 'a':
      if (isCtrl) {
        event.preventDefault();
        selectAllWells();
      }
      break;
      
    case ' ':
      if (isShift) {
        event.preventDefault();
        selectCurrentRow();
      } else if (isCtrl) {
        event.preventDefault();
        selectCurrentColumn();
      }
      break;
  }
});

function handleArrowKey(direction, isShift, isCtrl) {
  if (!activeCell) {
    // Set initial active cell
    activeCell = {row: 'A', col: 1};
    anchorCell = activeCell;
    clearSelection();
    selectWell('A', 1);
    updatePlateVisuals();
    return;
  }
  
  let newRow = activeCell.row;
  let newCol = activeCell.col;
  
  const rowIndex = ROWS.indexOf(newRow);
  const colIndex = COLS.indexOf(newCol);
  
  switch(direction) {
    case 'ArrowUp':
      if (isCtrl) {
        newRow = ROWS[0]; // Jump to top
      } else {
        newRow = ROWS[Math.max(0, rowIndex - 1)];
      }
      break;
    case 'ArrowDown':
      if (isCtrl) {
        newRow = ROWS[ROWS.length - 1]; // Jump to bottom
      } else {
        newRow = ROWS[Math.min(ROWS.length - 1, rowIndex + 1)];
      }
      break;
    case 'ArrowLeft':
      if (isCtrl) {
        newCol = COLS[0]; // Jump to left
      } else {
        newCol = COLS[Math.max(0, colIndex - 1)];
      }
      break;
    case 'ArrowRight':
      if (isCtrl) {
        newCol = COLS[COLS.length - 1]; // Jump to right
      } else {
        newCol = COLS[Math.min(COLS.length - 1, colIndex + 1)];
      }
      break;
  }
  
  const newCell = {row: newRow, col: newCol};
  
  if (isShift || isExtendMode) {
    // Extend selection
    if (!anchorCell) {
      anchorCell = activeCell;
    }
    extendSelectionFromAnchor(anchorCell, newCell);
  } else {
    // Move active cell
    clearSelection();
    selectWell(newRow, newCol);
    anchorCell = newCell;
  }
  
  activeCell = newCell;
  updatePlateVisuals();
  
  // Scroll active cell into view
  const activeWell = document.querySelector(`[data-row="${newRow}"][data-col="${newCol}"]`);
  if (activeWell) {
    activeWell.scrollIntoView({behavior: 'smooth', block: 'nearest', inline: 'nearest'});
  }
}

function handleHomeKey(isCtrl, isShift) {
  if (!activeCell) return;
  
  let targetCell;
  if (isCtrl) {
    targetCell = {row: 'A', col: 1}; // A1
  } else {
    targetCell = {row: activeCell.row, col: 1}; // First column of current row
  }
  
  if (isShift || isExtendMode) {
    if (!anchorCell) {
      anchorCell = activeCell;
    }
    extendSelectionFromAnchor(anchorCell, targetCell);
  } else {
    clearSelection();
    selectWell(targetCell.row, targetCell.col);
    anchorCell = targetCell;
  }
  
  activeCell = targetCell;
  updatePlateVisuals();
}

function handleEscapeKey() {
  if (selectedWells.size > 1) {
    // Collapse to active cell only
    clearSelection();
    if (activeCell) {
      selectWell(activeCell.row, activeCell.col);
      anchorCell = activeCell;
    }
  } else {
    // Clear all selection
    clearSelection();
    activeCell = null;
    anchorCell = null;
  }
  isExtendMode = false;
  isAddMode = false;
  updatePlateVisuals();
}

function toggleExtendMode() {
  isExtendMode = !isExtendMode;
  console.log(`🔄 Extend mode: ${isExtendMode ? 'ON' : 'OFF'}`);
  updateStatus(`Extend mode ${isExtendMode ? 'enabled' : 'disabled'}`, isExtendMode ? 'info' : 'complete');
}

function selectAllWells() {
  clearSelection();
  for (let row of ROWS) {
    for (let col of COLS) {
      selectedWells.add(`${row}${col}`);
    }
  }
  anchorCell = {row: 'A', col: 1};
  activeCell = {row: 'H', col: 12};
  updatePlateVisuals();
}

function selectCurrentRow() {
  if (!activeCell) return;
  
  clearSelection();
  for (let col of COLS) {
    selectedWells.add(`${activeCell.row}${col}`);
  }
  anchorCell = {row: activeCell.row, col: 1};
  updatePlateVisuals();
}

function selectCurrentColumn() {
  if (!activeCell) return;
  
  clearSelection();
  for (let row of ROWS) {
    selectedWells.add(`${row}${activeCell.col}`);
  }
  anchorCell = {row: 'A', col: activeCell.col};
  updatePlateVisuals();
}

