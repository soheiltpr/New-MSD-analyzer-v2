    alert('HTML report generated! To create PDF:\n1. Open the HTML file in your browser\n2. Press Ctrl+P (Cmd+P on Mac)\n3. Select "Save as PDF" as destination');
  }, 1000);
}

// Helper function for file downloads
function downloadFile(content, filename, mimeType) {
  const blob = new Blob([content], { type: mimeType });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

// Pivot Table Export Function
function exportPivotTable() {
  console.log('📊 Starting pivot table export...');
  
  if (CYTOKINES.length === 0) {
    updateStatus('No cytokines configured. Please setup cytokines first.', 'error');
    return;
  }

  // Get export parameters
  const rows = document.getElementById('pivotRows').value;
  const columns = document.getElementById('pivotColumns').value;
  const values = document.getElementById('pivotValues').value;
  const scale = document.getElementById('pivotScale').value;
  const cytokineSelection = document.getElementById('pivotCytokines').value;
  const includeStandards = document.getElementById('pivotIncludeStandards').value === 'yes';

  // Validate that rows and columns are different
  if (rows === columns) {
    updateStatus('Rows and columns must be different. Please select different dimensions.', 'error');
    return;
  }

  console.log('Pivot parameters:', { rows, columns, values, scale, cytokineSelection, includeStandards });

  // Determine which cytokines to include
  const cytokinesToProcess = cytokineSelection === 'all' ? 
    CYTOKINES.map((_, index) => index) : 
    [currentCytokine];

  // Collect all data points
  const allDataPoints = [];
  
  cytokinesToProcess.forEach(cytokineIndex => {
    const cytokine = CYTOKINES[cytokineIndex];
    if (!cytokine) return;

    // Get analysis results for this cytokine
    const results = analysisResults && analysisResults[cytokineIndex];
    
    // Process standards if included
    if (includeStandards && results && results.standardData) {
      results.standardData.forEach(std => {
        const wellIds = std.wellIds || [std.well];
        const signals = std.rawSignals || [std.signal];
        
        wellIds.forEach((wellId, idx) => {
          const signal = signals[idx] || std.signal;
          const dataPoint = createDataPoint(wellId, cytokine, 'Standard', std.concentration, std.concentration, signal, rows, columns, values, scale, allDataPoints);
          if (dataPoint) allDataPoints.push(dataPoint);
        });
      });
    }

    // Process unknowns and controls with proper replicate grouping
    if (results && results.unknowns) {
      // Group by compound name and concentration to identify true replicates
      const groupedData = new Map();
      
      results.unknowns.forEach(unk => {
        const { row, col } = parseWellId(unk.well);
        const signal = (row && col) ? getWellSignal(row, col, cytokineIndex) : unk.signal;
        const actualConc = unk.actualConcentration || unk.concentration;
        const compoundConc = (row && col && wellConcentrations[row] && typeof wellConcentrations[row][col] !== 'undefined') ? wellConcentrations[row][col] : '';
        const compoundName = unk.compound || 'Unknown';
        
        // Create key for grouping replicates (same compound name and concentration)
        const replicateKey = `${compoundName}_${compoundConc}`;
        
        if (!groupedData.has(replicateKey)) {
          groupedData.set(replicateKey, []);
        }
        
        groupedData.get(replicateKey).push({
          well: unk.well,
          cytokine: cytokine,
          compound: compoundName,
          compoundConc: compoundConc,
          actualConc: actualConc,
          signal: signal
        });
      });
      
      // Create data points from grouped data
      groupedData.forEach((group, replicateKey) => {
        group.forEach(item => {
          const dataPoint = createDataPoint(item.well, item.cytokine, item.compound, item.compoundConc, item.actualConc, item.signal, rows, columns, values, scale, allDataPoints);
          if (dataPoint) allDataPoints.push(dataPoint);
        });
      });
    }
  });

  if (allDataPoints.length === 0) {
    updateStatus('No data available for pivot table export.', 'error');
    return;
  }

  console.log('Collected data points:', allDataPoints.length);

  // Create pivot table structure
  const pivotTable = createPivotTableStructure(allDataPoints, rows, columns, values);
  
  // Generate Excel-compatible CSV
  const csvContent = generatePivotTableCSV(pivotTable, rows, columns, values);
  
  // Create filename
  const timestamp = new Date().toISOString().slice(0, 19).replace(/:/g, '-');
  const filename = `pivot_table_${rows}_x_${columns}_${values}_${scale}_${timestamp}.csv`;
  
  // Download file
  downloadFile(csvContent, filename, 'text/csv;charset=utf-8;');
  
  updateStatus(`Pivot table exported: ${filename}`, 'complete');
  console.log('✅ Pivot table export completed');
}

// Helper function to create a data point for pivot table
function createDataPoint(well, cytokine, compound, compoundConc, actualConc, signal, rows, columns, values, scale, allDataPoints = []) {
  try {
    const dataPoint = {
      well: well,
      cytokine: cytokine,
      compound: compound,
      compoundConc: compoundConc,
      actualConc: actualConc,
      signal: signal
    };

    // Get row and column values
    const rowValue = getDimensionValue(dataPoint, rows);
    const colValue = getDimensionValue(dataPoint, columns);
    const value = getValueValue(dataPoint, values, scale, allDataPoints);

    if (rowValue === null || colValue === null || value === null) {
      return null;
    }

    return {
      rowValue: rowValue,
      colValue: colValue,
      value: value,
      well: well,
      cytokine: cytokine
    };
  } catch (error) {
    console.warn('Error creating data point for well', well, error);
    return null;
  }
}

// Helper function to get dimension value (row/column)
function getDimensionValue(dataPoint, dimension) {
  switch (dimension) {
    case 'cytokine':
      return dataPoint.cytokine;
    case 'compound':
      return dataPoint.compound || 'Unknown';
    case 'concentration':
      return dataPoint.compoundConc || '';
    case 'well':
      return dataPoint.well;
    default:
      return null;
  }
}

// Helper function to get value with appropriate scaling
function getValueValue(dataPoint, valueType, scale, allDataPoints = []) {
  let value;
  
  switch (valueType) {
    case 'signal':
      value = dataPoint.signal;
      break;
    case 'actual':
      value = dataPoint.actualConc;
      break;
    case 'actual_mean':
      // Calculate mean of actual concentrations for same compound+concentration group
      value = calculateMeanActualConcentration(dataPoint, allDataPoints);
      break;
    case 'fold_change':
      // Calculate fold change vs mean of controls
      value = calculateFoldChange(dataPoint, allDataPoints);
      break;
    case 'compound':
      value = dataPoint.compoundConc;
      break;
    default:
      return null;
  }

  if (value === null || value === undefined || value === '') {
    return null;
  }

  // Apply scaling
  if (scale === 'log' && value > 0) {
    return Math.log10(value);
  }
  
  return parseFloat(value);
}

// Helper function to calculate mean actual concentration for same compound+concentration group
function calculateMeanActualConcentration(dataPoint, allDataPoints) {
  const actualConc = parseFloat(dataPoint.actualConc);
  if (isNaN(actualConc) || actualConc <= 0) return null;
  
  // Find all data points with same compound and compound concentration
  const sameGroup = allDataPoints.filter(dp => 
    dp.compound === dataPoint.compound && 
    dp.compoundConc === dataPoint.compoundConc &&
    dp.cytokine === dataPoint.cytokine
  );
  
  if (sameGroup.length === 0) return actualConc;
  
  // Calculate mean of actual concentrations
  const actualConcs = sameGroup
    .map(dp => parseFloat(dp.actualConc))
    .filter(conc => !isNaN(conc) && conc > 0);
  
  if (actualConcs.length === 0) return actualConc;
  
  return actualConcs.reduce((sum, conc) => sum + conc, 0) / actualConcs.length;
}

// Helper function to calculate fold change vs mean of controls
function calculateFoldChange(dataPoint, allDataPoints) {
  const actualConc = parseFloat(dataPoint.actualConc);
  if (isNaN(actualConc) || actualConc <= 0) return null;
  
  // Find control data points for the same cytokine
  const controls = allDataPoints.filter(dp => 
    dp.cytokine === dataPoint.cytokine &&
    (dp.compound === 'Blank' || dp.compound === 'Control' || dp.well?.includes('Control'))
  );
  
  if (controls.length === 0) return null;
  
  // Calculate mean of control actual concentrations
  const controlConcs = controls
    .map(dp => parseFloat(dp.actualConc))
    .filter(conc => !isNaN(conc) && conc > 0);
  
  if (controlConcs.length === 0) return null;
  
  const meanControlConc = controlConcs.reduce((sum, conc) => sum + conc, 0) / controlConcs.length;
  
  if (meanControlConc <= 0) return null;
  
  return actualConc / meanControlConc;
}

// Helper function to create pivot table structure
function createPivotTableStructure(dataPoints, rows, columns, values) {
  const pivotMap = new Map();
  const rowSet = new Set();
  const colSet = new Set();

  // Collect unique row and column values
  dataPoints.forEach(dp => {
    rowSet.add(dp.rowValue);
    colSet.add(dp.colValue);
  });

  // Sort row and column values
  const sortedRows = Array.from(rowSet).sort();
  const sortedCols = Array.from(colSet).sort();

  // Initialize pivot map
  sortedRows.forEach(row => {
    pivotMap.set(row, new Map());
    sortedCols.forEach(col => {
      pivotMap.get(row).set(col, []);
    });
  });

  // Populate pivot map
  dataPoints.forEach(dp => {
    const rowMap = pivotMap.get(dp.rowValue);
    if (rowMap && rowMap.has(dp.colValue)) {
      rowMap.get(dp.colValue).push(dp.value);
    }
  });

  // For actual concentration values, we need to create separate columns for replicates
  if (values === 'actual') {
    return createReplicatePivotStructure(dataPoints, rows, columns, pivotMap, sortedRows, sortedCols);
  }

  return {
    rows: sortedRows,
    columns: sortedCols,
    data: pivotMap
  };
}

// Helper function to create pivot structure for actual concentration replicates
function createReplicatePivotStructure(dataPoints, rows, columns, originalPivotMap, sortedRows, sortedCols) {
  console.log('Creating replicate pivot structure...');
  console.log('Data points:', dataPoints.length);
  
  // Group data points by row and column values
  const groupedData = new Map();
  
  dataPoints.forEach(dp => {
    const key = `${dp.rowValue}_${dp.colValue}`;
    if (!groupedData.has(key)) {
      groupedData.set(key, []);
    }
    groupedData.get(key).push(dp);
  });

  console.log('Grouped data:', groupedData);

  // Create new structure with replicate columns
  const replicatePivotMap = new Map();
  const replicateColumns = [];
  
  // Initialize pivot map
  sortedRows.forEach(row => {
    replicatePivotMap.set(row, new Map());
  });

  // Find maximum number of replicates for each column
  const maxReplicatesPerCol = new Map();
  sortedCols.forEach(col => {
    let maxReplicates = 0;
    sortedRows.forEach(row => {
      const key = `${row}_${col}`;
      const group = groupedData.get(key);
      if (group && group.length > maxReplicates) {
        maxReplicates = group.length;
      }
    });
    maxReplicatesPerCol.set(col, maxReplicates);
    console.log(`Max replicates for column ${col}: ${maxReplicates}`);
  });

  // Create column headers for replicates
  sortedCols.forEach(col => {
    const maxReplicates = maxReplicatesPerCol.get(col);
    console.log(`Column ${col}: maxReplicates = ${maxReplicates}`);
    
    if (maxReplicates === 1) {
      replicateColumns.push(col);
    } else {
      // Only create replicate columns if we actually have multiple values
      for (let i = 1; i <= maxReplicates; i++) {
        replicateColumns.push(`${col}_Rep${i}`);
      }
    }
  });
  
  console.log('Replicate columns:', replicateColumns);

  // Populate the replicate pivot map
  sortedRows.forEach(row => {
    sortedCols.forEach(col => {
      const key = `${row}_${col}`;
      const group = groupedData.get(key);
      
      if (group && group.length > 0) {
        const maxReplicates = maxReplicatesPerCol.get(col);
        
        if (maxReplicates === 1) {
          // Single replicate - use original column name
          replicatePivotMap.get(row).set(col, [group[0].value]);
        } else {
          // Multiple replicates - create separate columns
          for (let i = 0; i < maxReplicates; i++) {
            const colName = `${col}_Rep${i + 1}`;
            if (group[i]) {
              replicatePivotMap.get(row).set(colName, [group[i].value]);
            } else {
              replicatePivotMap.get(row).set(colName, []);
            }
          }
        }
      } else {
        // No data for this row/column combination
        const maxReplicates = maxReplicatesPerCol.get(col);
        if (maxReplicates === 1) {
          replicatePivotMap.get(row).set(col, []);
        } else {
          for (let i = 1; i <= maxReplicates; i++) {
            const colName = `${col}_Rep${i}`;
            replicatePivotMap.get(row).set(colName, []);
          }
        }
      }
    });
  });

  return {
    rows: sortedRows,
    columns: replicateColumns,
    data: replicatePivotMap
  };
}

// Helper function to generate CSV content
function generatePivotTableCSV(pivotTable, rows, columns, valueType) {
  const { rows: sortedRows, columns: sortedCols, data: pivotMap } = pivotTable;
  
  let csv = '';
  
  // Add header row
  csv += rows + ' \\ ' + columns;
  sortedCols.forEach(col => {
    csv += ',"' + col + '"';
  });
  csv += '\n';

  // Add data rows
  sortedRows.forEach(row => {
    csv += '"' + row + '"';
    sortedCols.forEach(col => {
      const values = pivotMap.get(row)?.get(col) || [];
      let cellValue = '';
      
      if (valueType === 'actual') {
        // For actual concentration, each cell should have only one value (individual replicate)
        if (values.length === 1) {
          const numValue = parseFloat(values[0]);
          cellValue = isNaN(numValue) ? '' : numValue.toFixed(6);
        }
      } else {
        // For other value types, use the original logic
        if (values.length === 1) {
          // Single value - ensure it's numeric
          const numValue = parseFloat(values[0]);
          cellValue = isNaN(numValue) ? '' : numValue.toFixed(6);
        } else if (values.length > 1) {
          // Multiple values - calculate mean and ensure it's numeric
          const validValues = values.filter(v => !isNaN(parseFloat(v)));
          if (validValues.length > 0) {
            const mean = validValues.reduce((a, b) => a + parseFloat(b), 0) / validValues.length;
            cellValue = isNaN(mean) ? '' : mean.toFixed(6);
          }
        }
      }
      
      csv += ',"' + cellValue + '"';
    });
    csv += '\n';
  });

  // Add summary row
  csv += '\n';
  csv += 'Summary Statistics\n';
  csv += 'Total Data Points,' + sortedRows.length * sortedCols.length + '\n';
  csv += 'Rows,' + sortedRows.length + '\n';
  csv += 'Columns,' + sortedCols.length + '\n';
  
  return csv;
}

// Helper function to parse well ID
function parseWellId(wellId) {
  return { row: wellId?.[0], col: parseInt(wellId?.slice(1)) };
}

