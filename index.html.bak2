function plotStandardCurve() {
  if (!analysisResults) {
    updateStatus('Run analysis first to generate standard curve', 'error');
    return;
  }
  
  updateStatus('Plotting standard curve...', 'processing');
  
  try {
    const standards = analysisResults.standards;
    const cytokine = CYTOKINES[currentCytokine];
    
    // Get scale preferences
    const xScale = document.getElementById('xAxisScale')?.value || 'log';
    const yScale = document.getElementById('yAxisScale')?.value || 'log';
    
    // Prepare data
    const standardPoints = standards.map(s => ({
      x: s.concentration,
      y: s.signal
    }));
    
    // Create curve points if we have a predictor
    let curvePoints = [];
    if (analysisResults.predictor) {
      const minConc = Math.min(...standards.map(s => s.concentration));
      const maxConc = Math.max(...standards.map(s => s.concentration));
      
      for (let i = 0; i <= 100; i++) {
        const logMin = Math.log10(Math.max(minConc, 0.1));
        const logMax = Math.log10(maxConc);
        const logConc = logMin + (logMax - logMin) * i / 100;
        const concentration = Math.pow(10, logConc);
        
        try {
          if (analysisResults.predictor.mode === 'fit4pl') {
            const signal = analysisResults.predictor.model.f(concentration);
            curvePoints.push({ x: concentration, y: signal });
          }
        } catch (e) {
          // Skip invalid points
        }
      }
    }
    
    // Create chart
    const ctx = document.getElementById('chart');
    if (!ctx) {
      updateStatus('Chart canvas not found', 'error');
      return;
    }
    
    // Clear existing chart
    if (window.currentChart) {
      window.currentChart.destroy();
    }
    
    const chartConfig = {
      type: 'scatter',
      data: {
        datasets: [{
          label: `${cytokine} Standards`,
          data: standardPoints,
          backgroundColor: COMPOUND_COLORS['Standards'],
          borderColor: COMPOUND_COLORS['Standards'],
          pointRadius: 6,
          pointHoverRadius: 8
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          title: {
            display: true,
            text: `Standard Curve - ${cytokine}`
          },
          legend: {
            display: true
          }
        },
        scales: {
          x: {
            type: xScale === 'log' ? 'logarithmic' : 'linear',
            display: true,
            title: {
              display: true,
              text: 'Concentration (pg/mL)'
            }
          },
          y: {
            type: yScale === 'log' ? 'logarithmic' : 'linear',
            display: true,
            title: {
              display: true,
              text: 'Signal (ECL)'
            }
          }
        }
      }
    };
    
    // Add curve line if available
    if (curvePoints.length > 0) {
      chartConfig.data.datasets.push({
        label: 'Fitted Curve',
        data: curvePoints,
        type: 'line',
        borderColor: '#FF6B6B',
        backgroundColor: 'transparent',
        borderWidth: 2,
        pointRadius: 0,
        tension: 0.4
      });
    }
    
    window.currentChart = new Chart(ctx, chartConfig);
    
    updateStatus(`Standard curve plotted for ${cytokine}`, 'complete');
    
  } catch (error) {
    console.error('Plotting error:', error);
    updateStatus(`Plotting failed: ${error.message}`, 'error');
  }
}

