// Remove a section
function removeLayoutSection(sectionId) {
  console.log('Removing section:', sectionId);
  
  const section = document.getElementById(sectionId);
  if (section) {
    section.remove();
  }
  
  // Remove from array
  LAYOUT_SECTIONS = LAYOUT_SECTIONS.filter(s => s.id !== sectionId);
  
  // Show empty message if no sections
  if (LAYOUT_SECTIONS.length === 0) {
    const emptyMsg = document.getElementById('layout_empty_msg');
    if (emptyMsg) {
      emptyMsg.style.display = 'block';
    }
  }
}

// Move section up
function moveLayoutSectionUp(sectionId) {
  const index = LAYOUT_SECTIONS.findIndex(s => s.id === sectionId);
  if (index <= 0) return;
  
  // Swap in array
  [LAYOUT_SECTIONS[index - 1], LAYOUT_SECTIONS[index]] = [LAYOUT_SECTIONS[index], LAYOUT_SECTIONS[index - 1]];
  
  // Re-render
  renderLayoutSections();
}

// Move section down
function moveLayoutSectionDown(sectionId) {
  const index = LAYOUT_SECTIONS.findIndex(s => s.id === sectionId);
  if (index === -1 || index >= LAYOUT_SECTIONS.length - 1) return;
  
  // Swap in array
  [LAYOUT_SECTIONS[index], LAYOUT_SECTIONS[index + 1]] = [LAYOUT_SECTIONS[index + 1], LAYOUT_SECTIONS[index]];
  
  // Re-render
  renderLayoutSections();
}

// Render all sections in order
function renderLayoutSections() {
  const container = document.getElementById('layout_sections_area');
  if (!container) return;
  
  // Clear container
  container.innerHTML = '';
  
  // Re-add all sections in order
  LAYOUT_SECTIONS.forEach(section => {
    container.appendChild(section.element);
  });
}

// Clear all sections
function clearAllLayoutSections() {
  if (!confirm('Remove all sections from layout?')) return;
  
  const container = document.getElementById('layout_sections_area');
  if (container) {
    container.innerHTML = '';
  }
  
  LAYOUT_SECTIONS = [];
  
  const emptyMsg = document.getElementById('layout_empty_msg');
  if (emptyMsg) {
    emptyMsg.style.display = 'block';
  }
  
  console.log('All sections cleared');
}

// Save layout configuration
function saveLayoutConfig() {
  const config = LAYOUT_SECTIONS.map(s => ({
    type: s.type,
    id: s.id
  }));
  
  const json = JSON.stringify(config, null, 2);
  const blob = new Blob([json], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  
  const link = document.createElement('a');
  link.href = url;
  link.download = 'layout_config.json';
  link.click();
  
  URL.revokeObjectURL(url);
  alert('Layout configuration saved!');
}

