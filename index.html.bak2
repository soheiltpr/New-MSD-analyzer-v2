}

// Auto scale function (moved from old plate setup)
function autoScale() {
  if (!plateData || Object.keys(plateData).length === 0) {
    updateStatus('No data available for auto scaling', 'error');
    return;
  }
  
  let allSignals = [];
  const cytokineIndex = currentCytokine;
  
  // Collect all signal values for current cytokine
  for (let row of ROWS) {
    for (let col of COLS) {
      const signal = getWellSignal(row, col, cytokineIndex);
      if (signal !== null && signal !== undefined) {
        allSignals.push(signal);
      }
    }
  }
  
  if (allSignals.length === 0) {
    updateStatus('No signal data found for auto scaling', 'error');
    return;
  }
  
  const minSignal = Math.min(...allSignals);
  const maxSignal = Math.max(...allSignals);
  
  // Add 5% padding
  const padding = (maxSignal - minSignal) * 0.05;
  const minScale = Math.max(0, minSignal - padding);
  const maxScale = maxSignal + padding;
  
  // Update scale inputs
  document.getElementById('minScale').value = minScale.toFixed(0);
  document.getElementById('maxScale').value = maxScale.toFixed(0);
  
  // Apply immediately
  window.scaleSettings = { min: minScale, max: maxScale };
  renderPlate();
  
  updateStatus(`Auto scale applied: ${minScale.toFixed(0)} - ${maxScale.toFixed(0)}`, 'complete');
}

// Interactive Unknowns Table System
let unknownsTableState = {
  data: [],
  filteredData: [],
  sortColumn: -1,
  sortDirection: 'asc',
  currentCytokine: -1,
  columnVisibility: {
    well: true,
    compound: true,
    signal: true,
    actualConcentration: true,
    modifiedConcentration: true,
    designConcentration: true,
    dilutionFactor: true,
    meanReplicates: true,
    stdDev: true,
    cvPercent: true,
    rangeStatus: true,
    recovery: true,
    actions: true
  }
};

function initializeUnknownsTable(data, cytokineIndex) {
  console.log('🔧 Initializing interactive unknowns table with', data.length, 'rows');
  
  unknownsTableState.data = data;
  unknownsTableState.filteredData = [...data];
  unknownsTableState.currentCytokine = cytokineIndex;
  
  // Populate compound filter
  const compoundFilter = document.getElementById('compoundFilter');
  if (compoundFilter) {
    const compounds = [...new Set(data.map(row => row.compound))].sort();
    compoundFilter.innerHTML = '<option value="">All Compounds</option>' +
      compounds.map(comp => `<option value="${comp}">${comp}</option>`).join('');
  }
  
  // Setup export dropdown
  setupExportDropdown();
  
  renderUnknownsTable();
}

function renderUnknownsTable() {
  const tbody = document.getElementById('unknownsTableBody');
  if (!tbody) return;
  
  const { filteredData, columnVisibility } = unknownsTableState;
  
  // Check if 5% adjustment is enabled
  const adjustmentCheckbox = document.getElementById('add5PercentAdjustment');
  const applyAdjustment = adjustmentCheckbox && adjustmentCheckbox.checked;
  
  // Check if colored view is enabled
  const coloredViewCheckbox = document.getElementById('coloredTableView');
  const useColoredView = coloredViewCheckbox && coloredViewCheckbox.checked;
  
  tbody.innerHTML = filteredData.map((row, index) => {
    const rowClass = row.isDuplicateGroup ? 'duplicate-row' : '';
    const firstInGroupClass = row.isFirstInGroup ? 'first-in-group' : '';
    
    // Get compound color with 30% transparency
    let rowStyle = '';
    if (useColoredView && row.compound) {
      const compoundColor = getCompoundColor(row.compound);
      // Convert hex to RGBA with 30% opacity
      const rgb = hexToRgb(compoundColor);
      if (rgb) {
        rowStyle = `background-color: rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.3) !important;`;
      }
    }
    
    return `
      <tr class="${rowClass} ${firstInGroupClass}" data-index="${index}" style="${rowStyle}">
        ${columnVisibility.well ? `<td>${row.well}</td>` : ''}
        ${columnVisibility.compound ? `<td>${row.compound}</td>` : ''}
        ${columnVisibility.signal ? `<td>${row.signal}</td>` : ''}
        ${columnVisibility.actualConcentration ? `<td>${getOriginalConcentration(row.well, applyAdjustment)}</td>` : ''}
        ${columnVisibility.modifiedConcentration ? `<td>${getModifiedConcentration(row.well, applyAdjustment)}</td>` : ''}
        ${columnVisibility.designConcentration ? `<td>${row.designConcentration}</td>` : ''}
        ${columnVisibility.dilutionFactor ? `<td>${row.dilutionFactor}</td>` : ''}
        ${columnVisibility.meanReplicates ? `<td>${getAdjustedConcentration(row.meanReplicates, applyAdjustment, row.rangeStatus, row.isAboveULOQ)}</td>` : ''}
        ${columnVisibility.stdDev ? `<td>${row.stdDev}</td>` : ''}
        ${columnVisibility.cvPercent ? `<td>${row.cvPercent}</td>` : ''}
        ${columnVisibility.rangeStatus ? `<td><span class="range-badge range-${row.rangeStatus.toLowerCase().replace(' ', '-')}">${row.rangeStatus}</span></td>` : ''}
        ${columnVisibility.recovery ? `<td>${row.recovery}</td>` : ''}
        <td>
          <button class="btn-tiny" onclick="highlightOnPlot('${row.well}')" title="Highlight on plot">📍</button>
          <button class="btn-tiny" onclick="showSampleDetails('${row.well}')" title="Show sample details">ℹ️</button>
          <button class="btn-tiny" onclick="exportSampleData('${row.well}')" title="Export sample data">📤</button>
          <button class="btn-tiny" onclick="recalculateSample('${row.well}')" title="Recalculate concentration">🔄</button>
        </td>
      </tr>
    `;
  }).join('');
  
  // Update row count display
  updateRowCount();
}

// Helper function to convert hex color to RGB
function hexToRgb(hex) {
  const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  return result ? {
    r: parseInt(result[1], 16),
    g: parseInt(result[2], 16),
    b: parseInt(result[3], 16)
  } : null;
}

// Toggle function for colored table view
function toggleColoredTableView() {
  renderUnknownsTable();
}

function getAdjustedConcentration(value, applyAdjustment, rangeStatus = null, isAboveULOQ = false) {
  if (!applyAdjustment || value === 'N/A' || value === '' || value === null || value === undefined) {
    return value;
  }
  
  // Only apply adjustment if concentration is above range
  const isAboveRange = rangeStatus === 'Above Range' || isAboveULOQ;
  if (!isAboveRange) {
    return value;
  }
  
  // Parse the value if it's a string
  let numericValue = value;
  if (typeof value === 'string') {
    numericValue = parseFloat(value);
    if (isNaN(numericValue)) {
      return value; // Return original if not a number
    }
  }
  
  if (typeof numericValue === 'number' && numericValue > 0) {
    const adjusted = numericValue * 1.05; // Add 5%
    return adjusted.toFixed(2);
  }
  
  return value;
}

function getModifiedConcentration(wellId, applyAdjustment) {
  // Get the current cytokine results
  const select = document.getElementById('resultsCytokineSelect');
  const idx = select && select.value ? parseInt(select.value) : currentCytokine;
  const res = analysisResults[idx] || analysisResults;
  
  console.log('🔍 getModifiedConcentration debug:', {
    wellId,
    idx,
    hasRes: !!res,
    hasModifiedConcentrations: !!(res && res.modifiedConcentrations),
    hasOriginalConcentrations: !!(res && res.originalConcentrations)
  });
  
  // If we have modified concentrations (from Modified Analyze), use those
  if (res && res.modifiedConcentrations) {
    console.log('🔍 Looking for well', wellId, 'in modified concentrations:', res.modifiedConcentrations.length, 'entries');
    console.log('🔍 Available modified wells:', res.modifiedConcentrations.map(m => m.well));
    const modifiedData = res.modifiedConcentrations.find(item => item.well === wellId);
    console.log('🔍 Found modified data:', modifiedData);
    
    if (modifiedData && modifiedData.modifiedConcentration !== null && modifiedData.modifiedConcentration !== undefined) {
      const concentration = modifiedData.modifiedConcentration;
      
      // Apply 5% adjustment if enabled and above ULOQ
      if (applyAdjustment) {
        const standards = res.standards || [];
        const maxStdConc = Math.max(...standards.map(s => s.concentration));
        if (concentration > maxStdConc * 0.8) { // Rough ULOQ check
          return (concentration * 1.05).toFixed(2);
        }
      }
      
      console.log('✅ Returning modified concentration for well', wellId, ':', concentration);
      return concentration.toFixed(2);
    }
  }
  
  // If no modified concentrations available, return N/A
  console.log('❌ No modified concentrations found for well', wellId);
  return 'N/A';
}

function getOriginalConcentration(wellId, applyAdjustment) {
  // Get the current cytokine results
  const select = document.getElementById('resultsCytokineSelect');
  const idx = select && select.value ? parseInt(select.value) : currentCytokine;
  const res = analysisResults[idx] || analysisResults;
  
  // If we have original concentrations (from before Modified Analyze), use those
  if (res && res.originalConcentrations) {
    const originalData = res.originalConcentrations.find(item => item.well === wellId);
    if (originalData && originalData.originalConcentration !== null && originalData.originalConcentration !== undefined) {
      const concentration = originalData.originalConcentration;
      
      // Apply 5% adjustment if enabled and above ULOQ
      if (applyAdjustment) {
        const standards = res.standards || [];
        const maxStdConc = Math.max(...standards.map(s => s.concentration));
        if (concentration > maxStdConc * 0.8) { // Rough ULOQ check
          return (concentration * 1.05).toFixed(2);
        }
      }
      
      return concentration.toFixed(2);
    }
  }
  
  // Fallback to current concentration if no original data
  const currentData = res?.unknowns?.find(item => item.well === wellId);
  if (currentData && currentData.actualConcentration !== null && currentData.actualConcentration !== undefined) {
    const concentration = currentData.actualConcentration;
    
    // Apply 5% adjustment if enabled and above ULOQ
    if (applyAdjustment) {
      const standards = res.standards || [];
      const maxStdConc = Math.max(...standards.map(s => s.concentration));
      if (concentration > maxStdConc * 0.8) { // Rough ULOQ check
        return (concentration * 1.05).toFixed(2);
      }
    }
    
    return concentration.toFixed(2);
  }
  
  return 'N/A';
}

function sortUnknownsTable(columnIndex) {
  const { sortColumn, sortDirection } = unknownsTableState;
  
  if (sortColumn === columnIndex) {
    unknownsTableState.sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
  } else {
    unknownsTableState.sortColumn = columnIndex;
    unknownsTableState.sortDirection = 'asc';
  }
  
  const columnNames = ['well', 'compound', 'signal', 'actualConcentration', 'modifiedConcentration', 'designConcentration', 'dilutionFactor', 'meanReplicates', 'stdDev', 'cvPercent', 'rangeStatus', 'recovery'];
  const columnName = columnNames[columnIndex];
  
  unknownsTableState.filteredData.sort((a, b) => {
    let aVal = a[columnName];
    let bVal = b[columnName];
    
    // Handle numeric values
    if (columnName === 'signal' || columnName === 'actualConcentration' || columnName === 'modifiedConcentration' || columnName === 'designConcentration' || columnName === 'dilutionFactor' || columnName === 'meanReplicates' || columnName === 'stdDev' || columnName === 'cvPercent' || columnName === 'recovery') {
      aVal = parseFloat(aVal) || 0;
      bVal = parseFloat(bVal) || 0;
    }
    
    // Handle string values
    if (typeof aVal === 'string') aVal = aVal.toLowerCase();
    if (typeof bVal === 'string') bVal = bVal.toLowerCase();
    
    if (unknownsTableState.sortDirection === 'asc') {
      return aVal > bVal ? 1 : aVal < bVal ? -1 : 0;
    } else {
      return aVal < bVal ? 1 : aVal > bVal ? -1 : 0;
    }
  });
  
  renderUnknownsTable();
  updateSortIndicators();
}

function filterUnknownsTable() {
  const searchTerm = document.getElementById('unknownsSearch')?.value.toLowerCase() || '';
  const compoundFilter = document.getElementById('compoundFilter')?.value || '';
  const rangeFilter = document.getElementById('rangeFilter')?.value || '';
  const concMinFilter = parseFloat(document.getElementById('concMinFilter')?.value) || null;
  const concMaxFilter = parseFloat(document.getElementById('concMaxFilter')?.value) || null;
  
  unknownsTableState.filteredData = unknownsTableState.data.filter(row => {
    // Search filter
    if (searchTerm && !row.well.toLowerCase().includes(searchTerm) && 
        !row.compound.toLowerCase().includes(searchTerm)) {
      return false;
    }
    
    // Compound filter
    if (compoundFilter && row.compound !== compoundFilter) {
      return false;
    }
    
    // Range filter
    if (rangeFilter && row.rangeStatus !== rangeFilter) {
      return false;
    }
    
    // Concentration range filter
    const actualConc = parseFloat(row.actualConcentration);
    if (concMinFilter !== null && (isNaN(actualConc) || actualConc < concMinFilter)) {
      return false;
    }
    if (concMaxFilter !== null && (isNaN(actualConc) || actualConc > concMaxFilter)) {
      return false;
    }
    
    return true;
  });
  
  renderUnknownsTable();
}

function updateSortIndicators() {
  // Update column headers with sort indicators
  const headers = document.querySelectorAll('#unknownsTable th.sortable');
  headers.forEach((header, index) => {
    const text = header.textContent.replace(' ↕', '').replace(' ↑', '').replace(' ↓', '');
    if (index === unknownsTableState.sortColumn) {
      const indicator = unknownsTableState.sortDirection === 'asc' ? ' ↑' : ' ↓';
      header.textContent = text + indicator;
    } else {
      header.textContent = text + ' ↕';
    }
  });
}

function updateRowCount() {
  const count = unknownsTableState.filteredData.length;
  const total = unknownsTableState.data.length;
  
  // Add row count display if it doesn't exist
  let countDisplay = document.getElementById('unknownsRowCount');
  if (!countDisplay) {
    countDisplay = document.createElement('div');
    countDisplay.id = 'unknownsRowCount';
    countDisplay.className = 'row-count';
    document.getElementById('unknownsTableControls').appendChild(countDisplay);
  }
  
  countDisplay.textContent = `Showing ${count} of ${total} samples`;
}

function toggleColumnVisibility() {
  const filters = document.getElementById('unknownsFilters');
  if (filters) {
    filters.style.display = filters.style.display === 'none' ? 'block' : 'none';
  }
}

// Export Dropdown Functions
function setupExportDropdown() {
  const dropdown = document.getElementById('exportDropdownBtn');
  const menu = document.getElementById('exportDropdownMenu');
  const dropdownContainer = dropdown.closest('.export-dropdown');
  
  // Toggle dropdown on button click
  dropdown.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdownContainer.classList.toggle('open');
  });
  
  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (!dropdownContainer.contains(e.target)) {
      dropdownContainer.classList.remove('open');
    }
  });
}

function exportVisibleData() {
  console.log('🔍 Starting exportVisibleData function');
  
  // Check if unknownsTableState exists, if not try to get data from current analysis
  let filteredData, columnVisibility, filters;
  
  if (!unknownsTableState) {
    console.warn('⚠️ unknownsTableState not available, trying to get data from current analysis');
    
    // Try to get data from current analysis results
    const currentCytokineIndex = currentCytokine || 0;
    if (analysisResults && analysisResults[currentCytokineIndex] && analysisResults[currentCytokineIndex].unknowns) {
      console.log('📊 Using data from current analysis results');
      filteredData = analysisResults[currentCytokineIndex].unknowns.map(unk => ({
        well: unk.well || 'N/A',
        compound: unk.compound || 'Unknown',
        signal: unk.signal || 'N/A',
        actualConcentration: unk.concentration || unk.actualConcentration || 'N/A',
        designConcentration: '',
        dilutionFactor: unk.dilution || 1.0,
        meanReplicates: '',
        stdDev: '',
        cvPercent: '',
        rangeStatus: '',
        recovery: ''
      }));
      
      columnVisibility = {
        well: true, compound: true, signal: true, actualConcentration: true,
        designConcentration: true, dilutionFactor: true, meanReplicates: true,
        stdDev: true, cvPercent: true, rangeStatus: true, recovery: true
      };
      
      filters = { search: '', compound: '', range: '', concMin: null, concMax: null };
    } else {
      console.error('❌ No analysis results available for export');
      updateStatus('Error: No analysis data available. Please run analysis first.', 'error');
      return;
    }
  } else {
    ({ filteredData, columnVisibility, filters } = unknownsTableState);
  }
  
  const isReplicateSummary = document.getElementById('showReplicateSummary')?.checked || false;
  
  console.log('📊 Exporting visible/filtered data:', {
    rowCount: filteredData ? filteredData.length : 'undefined',
    hasColumnVisibility: !!columnVisibility,
    replicateSummary: isReplicateSummary,
    filters: filters
  });
  
  if (!filteredData || filteredData.length === 0) {
    console.warn('⚠️ No filtered data available');
    updateStatus('No data to export', 'warning');
    return;
  }
  
  // If replicate summary is enabled, create the summary data structure
  let dataToExport = filteredData;
  if (isReplicateSummary) {
    console.log('🔄 Creating replicate summary data for export');
    dataToExport = createReplicateSummaryData(filteredData);
    console.log('📊 Summary data created:', { originalRows: filteredData.length, summaryRows: dataToExport.length });
  }
  
  // Determine headers based on visible columns
  const headers = [];
  const columnNames = ['well', 'compound', 'signal', 'actualConcentration', 'modifiedConcentration', 'designConcentration', 'dilutionFactor', 'meanReplicates', 'stdDev', 'cvPercent', 'rangeStatus', 'recovery'];
  const displayNames = ['Well', 'Compound', 'Signal', 'Actual Concentration (pg/mL)', 'Modified Calculated Concentration (pg/mL)', 'Design Concentration (pg/mL)', 'Dilution Factor', 'Mean (Replicates)', 'Std Dev', 'CV%', 'Range Status', 'Recovery %'];
  
  columnNames.forEach((col, index) => {
    if (columnVisibility[col]) {
      headers.push(displayNames[index]);
    }
  });
  
  try {
    // Create CSV data
    const csvData = [headers];
    
    dataToExport.forEach(row => {
      const csvRow = [];
      columnNames.forEach(col => {
        if (columnVisibility[col]) {
          csvRow.push(row[col] || '');
        }
      });
      csvData.push(csvRow);
    });
    
    console.log('📝 Created CSV data:', { headers: headers.length, rows: csvData.length - 1 });
    
    const csvContent = csvData.map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');
    
    // Add metadata comment
    const metadata = `# MSD Unknowns Table Export - Visible Data\n# Generated: ${new Date().toLocaleString()}\n# Rows: ${dataToExport.length}\n# View: ${isReplicateSummary ? 'Replicate Summary' : 'Detailed View'}\n# Filters Applied: ${filters ? Object.values(filters).some(f => f) ? 'Yes' : 'No' : 'Unknown'}\n\n`;
    
    console.log('💾 Creating download...');
    
    const blob = new Blob([metadata + csvContent], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `MSD_Unknowns_Visible_${new Date().toISOString().split('T')[0]}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    console.log('✅ Export completed successfully');
    updateStatus(`Exported ${dataToExport.length} ${isReplicateSummary ? 'summary' : 'visible'} rows to CSV`, 'complete');
    
    // Close dropdown
    const dropdownContainer = document.getElementById('exportDropdownBtn').closest('.export-dropdown');
    if (dropdownContainer) {
      dropdownContainer.classList.remove('open');
    }
    
  } catch (error) {
    console.error('❌ Error during export:', error);
    updateStatus(`Export failed: ${error.message}`, 'error');
  }
}

function exportCompleteTable() {
  const { data, columnVisibility } = unknownsTableState;
  
  console.log('Exporting complete table:', {
    totalRows: data.length,
    allColumns: true
  });
  
  if (data.length === 0) {
    updateStatus('No data to export', 'warning');
    return;
  }
  
  // Use all columns for complete export
  const headers = ['Well', 'Compound', 'Signal', 'Actual Concentration (pg/mL)', 'Modified Calculated Concentration (pg/mL)', 'Design Concentration (pg/mL)', 'Dilution Factor', 'Mean (Replicates)', 'Std Dev', 'CV%', 'Range Status', 'Recovery %'];
  const columnNames = ['well', 'compound', 'signal', 'actualConcentration', 'modifiedConcentration', 'designConcentration', 'dilutionFactor', 'meanReplicates', 'stdDev', 'cvPercent', 'rangeStatus', 'recovery'];
  
  // Create CSV data
  const csvData = [headers];
  
  data.forEach(row => {
    const csvRow = columnNames.map(col => row[col] || '');
    csvData.push(csvRow);
  });
  
  const csvContent = csvData.map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');
  
  // Add metadata comment
  const metadata = `# MSD Unknowns Table Export - Complete Data\n# Generated: ${new Date().toLocaleString()}\n# Total Rows: ${data.length}\n# All Columns Included\n\n`;
  
  const blob = new Blob([metadata + csvContent], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `MSD_Unknowns_Complete_${new Date().toISOString().split('T')[0]}.csv`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  
  updateStatus(`Exported complete table with ${data.length} rows to CSV`, 'complete');
  
  // Close dropdown
  const dropdownContainer = document.getElementById('exportDropdownBtn').closest('.export-dropdown');
  dropdownContainer.classList.remove('open');
}

