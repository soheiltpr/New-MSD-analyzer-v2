  // Export settings
  if (settings.defaultDecimals) document.getElementById('defaultDecimals').value = settings.defaultDecimals;
  if (settings.includeMetadataDefault !== undefined) document.getElementById('includeMetadataDefault').checked = settings.includeMetadataDefault;
  if (settings.filePrefix) document.getElementById('filePrefix').value = settings.filePrefix;
  
  // Advanced settings
  if (settings.debugMode !== undefined) document.getElementById('debugMode').checked = settings.debugMode;
  if (settings.verboseLogging !== undefined) document.getElementById('verboseLogging').checked = settings.verboseLogging;
}

function applySettings() {
  // Collect all settings
  const settings = {
    // Display settings
    minScale: document.getElementById('minScale').value,
    maxScale: document.getElementById('maxScale').value,
    fontSize: document.getElementById('fontSize').value,
    colorPalette: document.getElementById('paletteSelect').value,
    showWellLabels: document.getElementById('showWellLabels').checked,
