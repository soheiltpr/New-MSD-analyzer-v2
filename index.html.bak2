function generateDoseResponseDisplay(results) {
  let html = `<div style="background: white; border: 1px solid #e5e7eb; border-radius: 6px; padding: 16px;">
    <h4 style="margin: 0 0 12px 0; color: #374151; font-size: 14px; font-weight: 600;">Dose-Response Parameters</h4>`;
  
